:param rows => {"rows": [{"recipe_id": "rec_1", "props": {"title": "4 Minute Spicy Garlic Shrimp", "instructions": "[Instructions] 1) Heat a large skillet over medium high heat. | 2) Add olive oil, garlic, red pepper flakes, and shrimp. | 3) Season with grill seasoning or salt & pepper. | 4) Cook shrimp 3 minutes or until just pink. | 5) Toss with lemon zest, juice, & chopped parsley. | 6) Remove shrimp to a serving platter, leaving the garlic cloves in the pan.", "tags": [], "cook_time_min": 7, "servings": null, "cuisine": ["All"], "rating_avg": 4.84, "rating_count": 345, "popularity_score": 4.835887323943662, "nutrition_calories": 152.4, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/10/79/97/picSxulFo.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": [], "ingredients": []}, {"recipe_id": "rec_2", "props": {"title": "Amazing Nacho Dip for a Crowd", "instructions": "[Instructions] 1) Lighty grease a shallow 3-quart oven-proof dish. | 2) In a frypan, brown the ground beef with onion and garlic (if using), crumbling with a fork into fine pieces; drain, season with salt (or seasoning salt if using). | 3) Spread the refried beans into the bottom of the dish. | 4) Top the green chilies over beans. | 5) Top with cooked beef over beans. | 6) Top with shredded cheese. | 7) Drizzle taco sauce over all. | 8) AT THIS POINT, you may cover and refrigerate to bake later. | 9) Bake at 400 degrees for about 20 minutes. | 10) Spread the mashed avocado over baked mixture. | 11) Then top with sour cream. | 12) Sprinkle/garnish with chopped green onions and olives. | 13) Serve with Tortilla chips. | 14) **NOTE** if preparing this in advance and refrigerating, you might want to bake it longer than 20 minutes.", "tags": ["meat", "brunch", "60 mins", "for large groups"], "cook_time_min": 20, "servings": null, "cuisine": ["All"], "rating_avg": 4.91, "rating_count": 11, "popularity_score": 4.807142857142857, "nutrition_calories": 249.2, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/12/83/47/q2QRJodrQlG0wfpYYrkj_amazing-nacho-dip-3056.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["meat", "brunch", "60 mins", "for large groups"], "ingredients": []}, {"recipe_id": "rec_3", "props": {"title": "Appetizer Grape Jelly and Chili Sauce Meatballs or Lil Smokies", "instructions": "[Instructions] 1) In a pot combine the grape jelly with the chili sauce; add in the meatballs and simmer for about 45 minutes uncovered or until the sauce has thickened. | 2) If you are making my Parmesan meatball recipe use 2-1/2 to 3 pounds lean ground beef or use half beef and ground pork shape. | 3) Shape into about 1-inch balls. | 4) Place on a baking sheet. | 5) Bake in a 350 degree F oven for 20-25 minutes or until cooked through. | 6) Place in the prepared sauce.", "tags": ["christmas", "weeknight", "60 mins", "easy"], "cook_time_min": 45, "servings": null, "cuisine": ["All"], "rating_avg": 4.73, "rating_count": 122, "popularity_score": 4.727272727272728, "nutrition_calories": 61.8, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/73/36/2/gXeAo1gxRVqOzjgkZkwS-Cocktail-Meatballs-2.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["christmas", "weeknight", "60 mins", "easy"], "ingredients": []}, {"recipe_id": "rec_4", "props": {"title": "Baba Ganoush - the Best in the World!", "instructions": "[Instructions] 1) Prepare a medium-hot fire in a charcoal grill. | 2) Preheat an oven to 375\u00b0F. | 3) Prick the eggplant with a fork in several places and place on the grill rack 4 to 5 inches from the fire. | 4) Grill, turning frequently, until the skin blackens and blisters and the flesh just begins to feel soft, 10 to 15 minutes. | 5) Transfer the eggplant to a baking sheet and bake until very soft, 15 to 20 minutes. | 6) Remove from the oven, let cool slightly, and peel off and discard the skin. | 7) Place the eggplant flesh in a bowl. | 8) Using a fork, mash the eggplant to a paste. | 9) Add the 1/4 cup tahini, the garlic, the 1/4 cup lemon juice and the cumin and mix well. | 10) Season with salt, then taste and add more tahini and/or lemon juice, if needed. | 11) Transfer the mixture to a serving bowl and spread with the back of a spoon to form a shallow well. | 12) Drizzle the olive oil over the top and sprinkle with the parsley. | 13) Place the olives around the sides. | 14) Serve at room temperature.", "tags": ["lunch snacks", "lebanese", "southwest asia middle east", "asian", "european", "spring", "summer", "winter", "savory", "brunch", "60 mins"], "cook_time_min": 20, "servings": null, "cuisine": ["All"], "rating_avg": 4.51, "rating_count": 103, "popularity_score": 4.526283185840708, "nutrition_calories": 103.6, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/67/57/0/SYJG5GzTVu3mPghifQNF_baba-ghanoush-eggplant-dip-0945.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["lunch snacks", "lebanese", "southwest asia middle east", "asian", "european", "spring", "summer", "winter", "savory", "brunch", "60 mins"], "ingredients": []}, {"recipe_id": "rec_5", "props": {"title": "Bacon Bites Flambe", "instructions": "[Instructions] 1) Peel and deveine the shrimp. Warm the rum in a small saucepan over low heat. | 2) Wrap each shrimp in a narrow strip of bacon and fasten with a toothpick. | 3) Place shrimp in a shallow pan and bake at 450 degrees for about 10 minutes, turning often, until bacon is crispy. | 4) Put the shrimp in a chafing dish or ceramic dish. Pour rum over shrimp and ignite. | 5) Serve immediately.", "tags": ["30 mins", "easy"], "cook_time_min": 10, "servings": null, "cuisine": ["All"], "rating_avg": 4.67, "rating_count": 4, "popularity_score": 4.687142857142857, "nutrition_calories": 323.9, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/33/90/16/9JovFi5RLeZrSDrq7IJt_BaconBites_2.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["30 mins", "easy"], "ingredients": []}, {"recipe_id": "rec_6", "props": {"title": "Bacon Wrapped Scallops", "instructions": "[Instructions] 1) Cut bacon strips in half. | 2) Wrap a piece of bacon around each scallop; secure with toothpick. | 3) Arrange the wrapped scallops on a baking sheet. | 4) Broil 5 inches from heat for 3 minutes per side, or until bacon is crisp. | 5) In small skillet, melt butter; add garlic and saute 1 minute,. | 6) Add broth and bring to a boil. | 7) Cook 2 minutes. | 8) Place scallops in large bowl; pour broth over, Gently toss to coat.", "tags": ["christmas", "broil grill", "60 mins", "oven", "easy"], "cook_time_min": 12, "servings": null, "cuisine": ["All"], "rating_avg": 4.85, "rating_count": 51, "popularity_score": 4.824426229508196, "nutrition_calories": 127.8, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/49/50/6/9dQKMeh5RUightQZa4UP_mediterranean-stuffed-chicken-7070.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["christmas", "broil grill", "60 mins", "oven", "easy"], "ingredients": []}, {"recipe_id": "rec_7", "props": {"title": "Baked Hush Puppies", "instructions": "[Instructions] 1) Preheat oven to 425 degrees. | 2) Spray cups of mini muffin pans with nonstick vegetable spray. | 3) Blend cornmeal, flour,baking powder, salt, sugar and red pepper in medium bowl. | 4) Stir in onion. | 5) Beat eggs, milk and oil in small bowl. | 6) Add to cornmeal mixture and stir just until blended. | 7) Spoon batter into prepared muffin pan, filling cups 1/2 to 2/3 full. | 8) Bake until golden, about 15 to 20 minutes, or until a toothpick inserted into center comes out clean. | 9) Serve immediately.", "tags": ["breads", "60 mins", "easy"], "cook_time_min": 20, "servings": null, "cuisine": ["All"], "rating_avg": 4.0, "rating_count": 11, "popularity_score": 4.33047619047619, "nutrition_calories": 141.3, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/23/11/41/picJK3hV0.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["breads", "60 mins", "easy"], "ingredients": []}, {"recipe_id": "rec_8", "props": {"title": "Baked Pot Stickers- Sweet Asian Dipping Sauce - Chicken Egg Roll", "instructions": "[Instructions] 1) Preheat oven to 425\u00b0F. | 2) In a large bowl, combine chicken, water chestnuts, green onions, carrot, ginger, soy sauce, egg white, mayo and garlic. Mix well. | 3) To assemble potstickers, place 12 wonton wrappers onto a smooth, clean and dry surface. Lightly brush the edges of each wonton with water. Place about 1 tablespoon of filling onto the center of each wonton. Fold corners of the wonton to the middle to secure the filling inside (envelope style works well, but you can be creative). | 4) Place wontons on a cookie sheet and lightly spray with Pam or olive oil. Repeat with remaining wontons. | 5) Bake 12-15 min until golden brown. | 6) For dipping sauce, place jelly in a small bowl. Microwave on high 30-40 sec or until warm. Add vinegar and soy sauce. Whisk until well blended. | 7) Serve potstickers with dipping sauce and enjoy!", "tags": ["for large groups", "oven"], "cook_time_min": 15, "servings": null, "cuisine": ["All"], "rating_avg": 5.0, "rating_count": 7, "popularity_score": 4.82, "nutrition_calories": 67.8, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/26/65/38/vtPIvYIXQHGeQ94TjJTU_baked%20potstickers%20SITE-2.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["for large groups", "oven"], "ingredients": []}, {"recipe_id": "rec_9", "props": {"title": "Batter-Fried Shrimp", "instructions": "[Instructions] 1) Preheat oil to 350 degrees. | 2) Combine 1/2 cup oil and egg; beat well. | 3) Add remaining ingredients except oil for frying and stir until well blended. | 4) Dip shrimp into batter to coat. | 5) Drop shrimp into hot oil and fry for 30-60 seconds or until golden brown. | 6) Remove with slotted spoon; drain on paper towel. | 7) Add a 1/2 teaspoon of baking powder to batter to make a much lighter crust, or use beer instead of milk for a barley flavor.", "tags": ["brunch", "60 mins", "deep fried", "stove top"], "cook_time_min": 30, "servings": null, "cuisine": ["All"], "rating_avg": 4.04, "rating_count": 34, "popularity_score": 4.188636363636364, "nutrition_calories": 341.9, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/55/97/1/kL5fCPAQCEgdALAz0XDg_1shrimp.1.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["brunch", "60 mins", "deep fried", "stove top"], "ingredients": []}, {"recipe_id": "rec_10", "props": {"title": "Beer Batter Fried Mushrooms", "instructions": "[Instructions] 1) Pour about 3 inches (more if needed to cover the mushrooms) of oil into a large pot. | 2) Heat until it reaches about 375 degrees Farenhieght. | 3) Meanwhile Mix beer, flour, garlic powder, salt, pepper and parsley flakes in a large bowl. | 4) Mix until smooth and well blended without any lumps. | 5) Dip mushrooms into batter and coat well. | 6) Fry mushrooms in batches in oil until crispy and brown. | 7) Time will vary depending on temperature of oil and the amount of mushrooms being fried. | 8) I usually do about 10 mushrooms at a time and it takes about 8 minutes. | 9) When done, remove mushrooms to a plate or bowl lined with paper towels to drain off excess oil. | 10) Place in a shallow bowl sprinkle with salt and toss to coat evenly. | 11) Serve with favorite dipping sauce!", "tags": ["low protein", "30 mins", "deep fried", "inexpensive"], "cook_time_min": 15, "servings": null, "cuisine": ["All"], "rating_avg": 4.79, "rating_count": 21, "popularity_score": 4.759032258064516, "nutrition_calories": 1755.8, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/98/01/9/7TVfxeVLThKqdDK2U4Lg_m2.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["low protein", "30 mins", "deep fried", "inexpensive"], "ingredients": []}, {"recipe_id": "rec_11", "props": {"title": "Best Ever Bruschetta", "instructions": "[Instructions] 1) In a medium mixing bowl, add the tomatoes, garlic, basil, vinegar, olive oil, cheese, salt and pepper. | 2) Mix thoroughly and let sit for at least 15 minutes at room temperature to let the flavors marinate. | 3) Slice the bread into individual pieces and spoon the mixture on top.", "tags": ["vegetable", "european", "egg free", "free of", "summer", "weeknight", "30 mins", "beginner cook", "easy", "inexpensive"], "cook_time_min": 15, "servings": null, "cuisine": ["All"], "rating_avg": 4.88, "rating_count": 68, "popularity_score": 4.856153846153847, "nutrition_calories": 887.9, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/44/39/87/ncBmKBnmRbCtu4iOlIG0_easy-bruschetta-9766.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["vegetable", "european", "egg free", "free of", "summer", "weeknight", "30 mins", "beginner cook", "easy", "inexpensive"], "ingredients": []}, {"recipe_id": "rec_12", "props": {"title": "Better Than Sex Appetizer Sandwiches", "instructions": "[Instructions] 1) Preheat oven to 350 degrees. | 2) Do not separate the rolls, just slice them all at once with a long serrated knife. Place both packages of bottoms on a sheet pan. Cover the bottoms with the sliced ham and Swiss and put the tops back on. Cut around the individual sandwiches. | 3) Melt the butter and combine with the next four ingredients. Pour over the sandwiches. Bake for 15 minutes or until browned.", "tags": ["weeknight", "brunch", "30 mins", "easy", "inexpensive"], "cook_time_min": 15, "servings": null, "cuisine": ["All"], "rating_avg": 5.0, "rating_count": 4, "popularity_score": 4.781428571428571, "nutrition_calories": 230.5, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/45/57/49/picQr7WLE.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["weeknight", "brunch", "30 mins", "easy", "inexpensive"], "ingredients": []}, {"recipe_id": "rec_13", "props": {"title": "Boursin Cheese (Homemade)", "instructions": "[Instructions] 1) Have cheeses and butter at room temperature. | 2) Crush garlic. | 3) Mix cheeses, butter and garlic. | 4) Add remaining ingredients, mix well. | 5) Pack into a container just large enough to hold the boursin and store in refrigerator. | 6) To serve, bring to room temperature. | 7) Serve with crackers.", "tags": ["cheese", "christmas", "thanksgiving", "savory", "15 mins"], "cook_time_min": 10, "servings": null, "cuisine": ["All"], "rating_avg": 4.88, "rating_count": 96, "popularity_score": 4.86245283018868, "nutrition_calories": 1087.3, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/80/67/5/CxAyLJnnS4CpHf9TvU2K_homemade-boursin-cheeseball-2205.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["cheese", "christmas", "thanksgiving", "savory", "15 mins"], "ingredients": []}, {"recipe_id": "rec_14", "props": {"title": "Buffalo Chicken Cheese Balls With Blue Cheese Dip", "instructions": "[Instructions] 1) Have oil heated to 350 degrees F. | 2) Pick the meat from the chicken and discard the skin, then dice.Place the chicken in a large bowl and add the hot sauce, pepper, cheese, and green onions, and toss to combine. Roll the chicken into 2-ounce balls, about the size of a golf ball. | 3) Place the flour, eggs, and Panko crumbs in 3 separate bowls. Roll each ball in the flour, then the egg and then the bread crumbs. Set aside. | 4) When the oil is hot fry the chicken balls in batches. Cook for about 2 minutes per batch. Drain on paper towels. | 5) To make the dip, combine all ingredients in a large bowl and adjust the seasoning if necessary. Serve the chicken alongside the dipping sauce.", "tags": ["poultry", "meat", "30 mins"], "cook_time_min": 10, "servings": null, "cuisine": ["All"], "rating_avg": 5.0, "rating_count": 16, "popularity_score": 4.882307692307693, "nutrition_calories": 269.1, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/35/24/25/sRnEB7oRfCMhC3ZyNI7A_0S9A2216.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["poultry", "meat", "30 mins"], "ingredients": []}, {"recipe_id": "rec_15", "props": {"title": "Buffalo Chicken Monkey Bread", "instructions": "[Instructions] 1) Preheat the oven to 375 degrees F. Spray a 6-cup tube pan with non-stick cooking spray or brush with a bit of vegetable oil using a pastry brush. | 2) In a medium bowl, mix the chicken with 6 tbsp of the buffalo chicken sauce. | 3) Cut 5 of the biscuits into quarters, making 20 smaller pieces. Flatten each piece into a circle. | 4) Place 1 teaspoon of blue cheese crumbles into the centre of each circle. Bring the edges of the dough up to cover the cheese and pinch together to seal the cheese inside the dough. | 5) Set these aside. | 6) Cut the remaining 7 biscuits in half, making 14 medium pieces. Flatten each piece into a circle. | 7) Place 1 tablespoon of chicken in the centre of each circle. Bring the edges of the dough up to cover the chicken and pinch together to seal the chicken inside the dough. | 8) Pour the remaining 2 tablespoons of buffalo chicken sauce into the bottom of the tube pan in an even layer. | 9) Brush the dough balls with the melted butter. Layer them into the tube pan \u2013 try to alternate between cheese and chicken so you get them evenly distributed throughout. | 10) Bake for 30-35 minutes until golden-brown on top. | 11) Place a serving plate upside down over the tube pan. Flip the plate and tube pan together to tip the monkey bread out. | 12) Drizzle the ranch dressing over the top of the monkey bread. Sprinkle with the chives and parsley to decorate. Serve warm with the cut celery. | 13) TIPS:. | 14) If you only have a 12-cup tube pan, you can use it, but the monkey bread will not fill the pan.", "tags": ["poultry", "meat", "baking", "oven", "4 hours"], "cook_time_min": 35, "servings": null, "cuisine": ["All"], "rating_avg": null, "rating_count": 0, "popularity_score": null, "nutrition_calories": 327.2, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/52/90/33/k7TZHRbVT4WngAifiGTW_Obsessions%203-0536.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["poultry", "meat", "baking", "oven", "4 hours"], "ingredients": []}, {"recipe_id": "rec_16", "props": {"title": "Buffalo Chicken Wing Dip", "instructions": "[Instructions] 1) Preaheat oven top 350. | 2) In a large bowl, mix shredded chicken, celery and cheese. | 3) In a saucepan over med-low heat, combine cream cheese and salad dressing and stir until smooth. Stir in bottle of hot sauce ( don't have to use entire bottle if you want it milder). Pour heated mixture into bowl with chicken mixture. Stir to mix well. | 4) Pour into a 13\" x 9\" baking pan. Bake uncovered for 40 minutes or until bubbly----make sure top doesn't get browned. Let stand for 10 minutes. Serve warm OR cold-----tastes best warm--- with celery or other veggies and crackers.", "tags": ["poultry", "meat", "very low carbs", "potluck", "60 mins", "for large groups"], "cook_time_min": 50, "servings": null, "cuisine": ["All"], "rating_avg": 4.89, "rating_count": 76, "popularity_score": 4.8672093023255805, "nutrition_calories": 196.8, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/11/62/66/picBeJt2K.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["poultry", "meat", "very low carbs", "potluck", "60 mins", "for large groups"], "ingredients": []}, {"recipe_id": "rec_17", "props": {"title": "Cajun Guacamole Shrimp Cups", "instructions": "[Instructions] 1) For the cups:. | 2) Preheat the oven to 350 degrees F. | 3) If using cooking spray, spray a 24-cup non-stick mini muffin pan with cooking spray. If using vegetable oil, brush both sides of each wonton wrapper with a thin layer of vegetable oil using a pastry brush. | 4) Push each wonton wrapper into a well of the mini muffin pan. | 5) Bake for 10-12 minutes until golden. Remove from the oven and increase the heat to 400 degrees F for the shrimp later on. | 6) Remove the baked wonton cups to a wire rack to cool completely. | 7) For the guacamole:. | 8) Halve the avocados and remove their pits. Scoop out the flesh and discard the skins. Roughly chop the avocado into cubes (you should have about 1 1/4 cups of cubed avocado). | 9) Add the avocado to a wide, shallow bowl. Use a fork to mash as smooth as you like it. | 10) Stir the lime and hot sauce into the mashed avocado. | 11) Finely chop the cherry tomatoes and add the avocado along with the cilantro and scallion. Gently fold together until combined. Season with salt to taste (usually just a pinch). | 12) For the shrimp:. | 13) Combine the shrimp, olive oil, garlic and Cajun seasoning in a medium bowl along with a pinch each of salt and black pepper. Stir to coat the shrimp. | 14) Tip the contents of the bowl out onto a rimmed baking sheet. Bake for 6-7 minutes (the oven should be at 400 degrees F from earlier) until pink and cooked throughout. | 15) Assemble:. | 16) Fill each baked wonton cup with a slightly heaped teaspoonful of guacamole. Top each one with a shrimp. Sprinkle with the chopped cilantro. | 17) Serve immediately \u2013 the wontons will start to become soft very quickly once filled. | 18) NOTE:. | 19) If you need to make these ahead \u2013 prep the wonton wrappers and shrimp in advance. You can keep the baked wontons in an airtight container at room temperature for up to 2 days. You can keep the cooked shrimp in an airtight container in the fridge for up to 1 day. Make the guacamole just before filling and serving otherwise it will start to oxidize, turning brown.", "tags": [], "cook_time_min": 20, "servings": null, "cuisine": ["All"], "rating_avg": 4.89, "rating_count": 12, "popularity_score": 4.800909090909091, "nutrition_calories": 89.7, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/53/04/78/hILjjomQlWplUCGJYs5g_untitled-1006.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": [], "ingredients": []}, {"recipe_id": "rec_18", "props": {"title": "Caramelized Onion-Cranberry Cream Cheese Bites", "instructions": "[Instructions] 1) Melt butter in a large skillet over medium heat; add onions, and saut\u00e9 15 to 18 minutes or until golden and tender. Stir in vinegar and remaining ingredients; cook, stirring occasionally, 2 to 4 minutes or until liquid is reduced to about 2 tablespoons. | 2) Caramelized Onion-Cranberry-Cream Cheese Bites: Spread 16 whole grain crackers each with 1 1/2 teaspoons 1/3-less-fat cream cheese; top each with 1 tablespoons Caramelized Onion-Cranberry Compote. Garnish with fresh cilantro or parsley leaves.", "tags": ["onions", "vegetable", "60 mins", "for large groups", "easy"], "cook_time_min": 22, "servings": null, "cuisine": ["All"], "rating_avg": 5.0, "rating_count": 4, "popularity_score": 4.781428571428571, "nutrition_calories": 177.9, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/36/00/22/96AI3DoYToaTb7VjJRCw_caramelized-onion-cranberry-cream-cheese-bites-2487.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["onions", "vegetable", "60 mins", "for large groups", "easy"], "ingredients": []}, {"recipe_id": "rec_19", "props": {"title": "Cheese and Herb Bites", "instructions": "[Instructions] 1) In a small bowl mix together mascarpone, one tablespoon herbs and pepper till well blended. | 2) Combine the cheddar, Havarti and Parmesan in a separate bowl. Top Pretzel Crisps\u00ae with a dollop of mascarpone mixture and then sprinkle with cheese blend and remaining herbs.", "tags": ["easy"], "cook_time_min": 10, "servings": 4, "cuisine": ["All"], "rating_avg": null, "rating_count": 0, "popularity_score": null, "nutrition_calories": 25.4, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/submissions/recipe/1803232610/BATLMzuaSE2vBD5Vd8o3_CheeseHerbBites.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["easy"], "ingredients": []}, {"recipe_id": "rec_20", "props": {"title": "Cheese Bites (Totally Addictive)", "instructions": "[Instructions] 1) Combine cheese, butter, flour, salt, and cayenne in a large bowl: knead into a dough. | 2) Roll dough into 1 inch balls and place on an un-greased baking sheet. | 3) If using olives, form each ball around 1 olive. | 4) If using pecans, press 1 pecan half onto each ball. | 5) Can bake them right now (see instructions below) or freeze for later. | 6) Place in trays in freezer for 30 minutes. | 7) Remove from freezer and place in freezer bags or container. | 8) Seal and freeze. | 9) Can bake them straight from freezer. | 10) Preheat oven to 425\u00b0F. | 11) Place cheese balls 3 inches apart on an un-greased baking sheet. | 12) Bake 15-17 minutes if frozen, 13-15 minutes if thawed.", "tags": ["cheese", "high in", "60 mins", "for large groups"], "cook_time_min": 15, "servings": null, "cuisine": ["All"], "rating_avg": 4.8, "rating_count": 5, "popularity_score": 4.729333333333333, "nutrition_calories": 574.7, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/34/53/44/zJ747KqrS62bPmnpp7fj_cheese-bites-totally-addictive_2046.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["cheese", "high in", "60 mins", "for large groups"], "ingredients": []}, {"recipe_id": "rec_21", "props": {"title": "Cheesy Artichoke Chicken Balls", "instructions": "[Instructions] 1) Combine all ingredients except for the bread crumbs. Roll chicken mixture into one inch balls then coat with bread crumbs. Bake at 350 degrees for approximately 40 minutes.", "tags": ["easy"], "cook_time_min": 40, "servings": null, "cuisine": ["All"], "rating_avg": 4.5, "rating_count": 2, "popularity_score": 4.661666666666667, "nutrition_calories": 260.5, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/46/37/02/Wcs4lGZWQeV1RegQH1PO_0S9A5340.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["easy"], "ingredients": []}, {"recipe_id": "rec_22", "props": {"title": "Cheesy Fried Chicken Parm Balls", "instructions": "[Instructions] 1) Cut each mozzarella stick in half lengthwise. Then cut each piece horizontally into 4 pieces. You should have small 16 pieces. | 2) Add the ground chicken, 1/2 teaspoon Italian seasoning, 1/2 teaspoon salt and 1/4 teaspoon pepper to a bowl. Mix to combine thoroughly. | 3) Flatten about 1 1/2 tablespoons of the ground chicken mixture into the palm of your hand. Add a piece of mozzarella in the center. Seal and cover the cheese, rolling into a ball, and place onto a parchment-lined baking sheet. Freeze until solid, about 4-6 hours. | 4) Add about 3 inches of oil to a Dutch oven and heat to 350\u00b0F. | 5) Add the panko, parmesan and garlic powder to a large bowl and whisk to combine. | 6) Add the flour, Italian seasoning, 2 teaspoons of salt and 1/2 teaspoon pepper to a separate large bowl and whisk to combine. | 7) Add eggs and about 2 tablespoons of water to a separate bowl and whisk to combine. | 8) Dredge the frozen chicken in the flour, then coat in the egg wash, then cover in the panko mixture. Place on a sheet pan while you finish the rest. | 9) Fry nuggets until cooked and the cheese is melted, about 5-7 minutes. Let drain on a paper towel lined sheet tray. | 10) Serve with marinara sauce.", "tags": ["poultry", "cheese", "meat", "european", "60 mins"], "cook_time_min": 15, "servings": null, "cuisine": ["All"], "rating_avg": null, "rating_count": 0, "popularity_score": null, "nutrition_calories": 151.7, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/53/77/94/0uOopcvGTlOvwkJCaZhi_cheesy%20fried%20chicken%20parm%20balls%20537794-4.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["poultry", "cheese", "meat", "european", "60 mins"], "ingredients": []}, {"recipe_id": "rec_23", "props": {"title": "Cheesy Shell Taco Bites", "instructions": "[Instructions] 1) For Shells:. | 2) Preheat oven to 350 degrees F. | 3) Using a tablespoon, scoop shredded cheese on to parchment and shape into a disk. Make sure each cheese disk does not touch the one next to it. | 4) Bake on a parchment-lined baking sheet for 7 minutes. | 5) Lift the melted cheese disks off of the parchment paper and press into mini-muffin tins. Let the cheese cool for 1-minute (or more) in the muffin tin so that they will hold their shape. Remove from muffin tin and set aside. | 6) For the Taco Filling: | 7) Cook hamburger until browned. | 8) Drain the fat and stir in taco mix and 1/2 cup salsa/picante sauce. | 9) Simmer for 3-5 minutes. | 10) Assembly:. | 11) Spoon beef mixture in cooled cheese cups and top with the 3 shredded cheese, sour cream, salsa, cubed avocados and cilantro.", "tags": ["mexican", "high protein", "high in", "30 mins", "easy"], "cook_time_min": 10, "servings": null, "cuisine": ["All"], "rating_avg": 5.0, "rating_count": 2, "popularity_score": 4.745, "nutrition_calories": 193.7, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/53/48/97/si1leg2LQHOzue4NvdYd_0294661_GK_Genius-Obsessions_Cheesy-Shell-Taco-Bites_16x9_v1_H.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["mexican", "high protein", "high in", "30 mins", "easy"], "ingredients": []}, {"recipe_id": "rec_24", "props": {"title": "Chicken Enchilada Ring", "instructions": "[Instructions] 1) Preheat oven to 375F. | 2) Chop chicken and olives using Food Chopper; place in mixing bowl. | 3) Add cheese, green chilies, mayonnaise, and seasoning mix. | 4) Seed and chop 1 tomato. | 5) Slice lime in half. | 6) Using Juicer, juice one half of lime to measure 1 teaspoon juice. | 7) Reserve remaining lime for garnish. | 8) Add chopped tomato and lime juice to chicken mixture. | 9) Reserve 2 tablespoons crushed chips; add remaining chips to chicken mixture and mix well. | 10) Sprinkle reserved crushed chips over cutting board. | 11) Unroll crescent dough. | 12) Place dough, sticky-side down, onto crushed chips; press down lightly, so chips adhere to dough. | 13) Separate dough into triangles. | 14) Arrange triangles, chip side down, in a circle on round baking stone (or round pizza baking sheet) with wide ends overlapping in the center and points towards outside. | 15) (There should be a 5-inch diameter opening in center.) Scoop chicken mixture evenly onto the wide ends of each triangle. | 16) Bring points of triangles up over filling and tuck under wide ends of dough at center of ring. | 17) (Filling will not be completely covered.) Bake 20-25 minutes or until golden. | 18) For garnish, cut remaining tomato into 8 wedges. | 19) Cut remaining half of lime into 4 slices; cut in half. | 20) Arrange between openings of ring. | 21) Cut and serve with salsa and sour cream.", "tags": ["poultry", "meat", "60 mins", "for large groups"], "cook_time_min": 20, "servings": null, "cuisine": ["All"], "rating_avg": 5.0, "rating_count": 26, "popularity_score": 4.915, "nutrition_calories": 161.1, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/25/46/4/2lkYtUFQa6UX2qPX7rFg_chicken-enchilada-ring-7206.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["poultry", "meat", "60 mins", "for large groups"], "ingredients": []}, {"recipe_id": "rec_25", "props": {"title": "Chicken Phyllo Mini Tarts", "instructions": "[Instructions] 1) Preheat oven to 350f degrees | 2) Heat 1 tablespoon butter in a nonstick frypan, add shallots, red pepper, ginger, basil, mushroom, salt and pepper, saute for 5 minutes; set aside to cool | 3) Combine in a bowl, the ground chicken, bread crumbs, lemon zest and juice, parsley and egg | 4) Add the cooled mixture from the frypan; stir to mix thouroughly | 5) Refrigerate until ready to use | 6) Melt 1/4 cup butter | 7) Brush some of the melted butter on mini muffin tin, set aside | 8) Prepare 8 phyllo sheets to make crust for tarts | 9) Keep the phyllo sheets covered with a damp teatowel so that they don't dry out | 10) Brush butter on one sheet of pastry, lay a second sheet on top and butter it; continue to top each of 4 sheets with butter | 11) Cut the 4 piled sheets into 12 equel squares | 12) Fit the 12 squares into the mimi muffin tin to make tarts | 13) Fill each tart with 1 tablespoon of chicken mix; top with shredded cheese | 14) Bake in preheated 350f degree oven for 30 minutes or until browned and bubbling and the cheese is melted | 15) Repeat with the other 4 phyllo sheets to fill 12 more tarts", "tags": ["chicken", "poultry", "meat", "canadian", "savory", "brunch", "60 mins"], "cook_time_min": 35, "servings": null, "cuisine": ["All"], "rating_avg": 4.33, "rating_count": 4, "popularity_score": 4.59, "nutrition_calories": 278.9, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/11/63/99/AdlMuzfmSAo8cgdgdQoQ_mufood2.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["chicken", "poultry", "meat", "canadian", "savory", "brunch", "60 mins"], "ingredients": []}, {"recipe_id": "rec_26", "props": {"title": "Chinese Egg Rolls", "instructions": "[Instructions] 1) Brown pork with ginger and garlic in pan; drain any grease. | 2) Mix salt, sugar, soy sauce and sesame oil. Add to pork and mix well. | 3) In large bowl combine cabbage mix and green onions. | 4) Pour hot meat over vegetables and stir well. Let cool slightly. | 5) Lay wrap in front of you so that it looks like a diamond. | 6) Place 3 tablespoons pork filling in center of egg roll wrapper. | 7) Fold bottom point up over filling and roll once. | 8) Fold in right and left points. | 9) Brush beaten egg on top point. | 10) Finish rolling. | 11) Set aside and repeat with remaining filling. | 12) Heat 2-3 inches oil in large frying pan to very hot (350\u00baF). | 13) Fry a few egg rolls in pan at a time, 2-3 minutes per side. | 14) Drain on paper towels. | 15) Serve with sweet and sour sauce, plum sauce, hoisin sauce or jalape\u00f1o pepper jelly.", "tags": ["meat", "chinese", "asian", "30 mins"], "cook_time_min": 30, "servings": null, "cuisine": ["All"], "rating_avg": 4.73, "rating_count": 124, "popularity_score": 4.727313432835821, "nutrition_calories": 159.8, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/13/40/53/OdK1PcmnRty3BpIy3qb9_egg-rolls-5361.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["meat", "chinese", "asian", "30 mins"], "ingredients": []}, {"recipe_id": "rec_27", "props": {"title": "Cold Appetizer", "instructions": "[Instructions] 1) Unroll crescent dough onto cookie sheet you have covered with foil and sprayed with Pam. | 2) Pinch all the seams together to form one big rectangle. | 3) Bake at 375\u00b0F for about 11 minutes until golden brown. | 4) Set aside to cool. | 5) Meanwhile, whip cream cheese with a fork and add herbs and spices. | 6) Set aside. | 7) Mix your veggies together in a separate bowl. | 8) Spread herbed cream cheese mixture over cooled crust, sprinkle with veggie mixture. | 9) Pat down lightly to make veggies stick. | 10) Sprinkle cheese over veggies. | 11) Cut into bite size pieces.", "tags": ["lunch snacks", "cheese", "onions", "peppers", "vegetable", "potluck", "spring", "summer", "spicy", "savory", "brunch", "30 mins", "oven", "beginner cook", "easy", "inexpensive"], "cook_time_min": 11, "servings": null, "cuisine": ["All"], "rating_avg": 4.67, "rating_count": 3, "popularity_score": 4.688461538461539, "nutrition_calories": 134.2, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/61/02/2/61022.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["lunch snacks", "cheese", "onions", "peppers", "vegetable", "potluck", "spring", "summer", "spicy", "savory", "brunch", "30 mins", "oven", "beginner cook", "easy", "inexpensive"], "ingredients": []}, {"recipe_id": "rec_28", "props": {"title": "Crab Cake Croquettes", "instructions": "[Instructions] 1) Mix together the mayonnaise, chili-garlic sauce and lemon juice in a small bowl. Cover and refrigerate to chill. Heat a straight-sided 10-inch heavy-bottomed skillet over medium-high heat. Add the canola oil and heat until glossy. Add the celery, jalapenos, onions and bell peppers and cook until softened, about 3 minutes. Transfer the vegetables to a large bowl and let cool to room temperature, 10 to 12 minutes. Wipe out the skillet and set aside. | 2) Add the crabmeat, 1 1/2 cups of the breadcrumbs, the egg and 1/2 cup of the chili mayonnaise to the cooled vegetables. Sprinkle with salt and black pepper and stir to combine. Place the remaining 2 1/2 cups breadcrumbs in a shallow bowl and set aside. Shape the crab mixture into bite-size (about 1 1/2 tablespoons) croquettes, 25 to 30 total. Dredge each croquette in the breadcrumbs, turning to coat. Arrange the croquettes on a parchment-lined baking sheet, cover and refrigerate for at least 1 hour and up to 8 hours. | 3) Heat 1/4 inch canola oil in the same heavy-bottomed skillet over medium-high heat. Working in batches, cook the croquettes until golden brown and cooked through, turning once, 2 to 3 minutes. Transfer to a serving platter and sprinkle with salt and black pepper. Serve with the remaining chili mayonnaise.", "tags": ["4 hours", "easy"], "cook_time_min": 1, "servings": null, "cuisine": ["All"], "rating_avg": null, "rating_count": 0, "popularity_score": null, "nutrition_calories": 321.4, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/submissions/recipe/33186/bo3a8dVjS3WS63qG1SBW_CCKEL408H_51186_2017.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["4 hours", "easy"], "ingredients": []}, {"recipe_id": "rec_29", "props": {"title": "Crab Cakes", "instructions": "[Instructions] 1) Sautee the red pepper, celery, and onion in the butter 5 minute. | 2) or until tender. | 3) Cool slightly. | 4) In a bowl, combine all the rest of the ingredients EXCEPT crabmeat. | 5) Combine sauteed vegetables with mixture. | 6) Pick through crabmeat for shells or cartlidge. | 7) Using your fingers, gently blend the crab into the mixture. | 8) This helps preserve the large pieces of crab. | 9) Shape crab mixture into cakes. | 10) Chill in the refrigerator for at least 1 hour. | 11) I've made the the day before and left in frig overnight. | 12) Broil cakes for 3-4 minute. | 13) or until browned. | 14) Turn them over carefully. | 15) I use a spatula and my fingers so they don't fall apart. | 16) Broil other side for 3-4 minute. | 17) I place them on a platter and garnish with parsley and lemon. | 18) I serve cocktail sauce and tartar sauce with them. | 19) I've also made the cakes much smaller and served them as appetizers.", "tags": ["30 mins"], "cook_time_min": 8, "servings": null, "cuisine": ["All"], "rating_avg": 4.62, "rating_count": 53, "popularity_score": 4.631746031746031, "nutrition_calories": 116.6, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/81/65/6/Z2nUolqQhaHanH7RCb2v_crab-cakes-5741.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["30 mins"], "ingredients": []}, {"recipe_id": "rec_30", "props": {"title": "Cranberry and Brie Bites", "instructions": "[Instructions] 1) Preheat oven to 400 degrees. Line a baking sheet with parchment paper, set aside. | 2) Place pastry on a clean work surface and cut into 36 squares. Brush all squares with egg wash, then place one square on top of the other to make 18 stacks, each with 2 squares of pastry. | 3) Place on prepared sheet, about 2 inches apart, and bake until puffed and golden, about 13-15 minutes. | 4) Remove baking sheet from oven and top each puffed square with a piece of brie cheese. Return to oven and bake until cheese melts, about 3-5 minutes. | 5) Place on a serving platter and top each with a small spoonful of cranberry sauce and a small sprig of thyme for garnish.", "tags": ["fruit", "60 mins", "for large groups", "easy"], "cook_time_min": 20, "servings": null, "cuisine": ["All"], "rating_avg": 4.0, "rating_count": 2, "popularity_score": 4.578333333333333, "nutrition_calories": 132.9, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/53/40/02/7Wnlte0QT1ijNdNAHXKS_0287839_GK_Level-Eats-300-4-Ingredient-Cranberry-%26-Brie-Bites-4x3_V4.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["fruit", "60 mins", "for large groups", "easy"], "ingredients": []}, {"recipe_id": "rec_31", "props": {"title": "Cucumber and Caramelized Onion Salad Bites", "instructions": "[Instructions] 1) Caramelize onion in bacon fat, then drain excess fat from onions on a paper towel. In a bowl, mix onions, cucumber and pepper. | 2) Top all Pretzel Crisps\u00ae with a spoonful of the mixture and cheese.", "tags": ["low protein", "low cholesterol", "15 mins", "easy"], "cook_time_min": 10, "servings": 4, "cuisine": ["All"], "rating_avg": null, "rating_count": 0, "popularity_score": null, "nutrition_calories": 0.0, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/submissions/recipe/1803232610/qtDhFdGRiylUdrOKpKBw_SaladBites.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["low protein", "low cholesterol", "15 mins", "easy"], "ingredients": []}, {"recipe_id": "rec_32", "props": {"title": "Dainty Egg and Chive Tea Sandwiches for Tea-Time", "instructions": "[Instructions] 1) Place the eggs in a small pan and cover with water. Bring to the boil and cook for 6 minutes. Drain and run the eggs under cold water until cool. | 2) Peel and then coarsely grate or crumble the eggs into a bowl. Mix with the salad cream, mayonnaise and chives and season with salt and pepper to taste. | 3) Cut off the bread crusts with a serrated knife - put them to one side for home-made breadcrumbs. | 4) Butter the bread and divide the egg mixture between 4 bread slices. Top with the remaining bread. Stack 2 sandwiches together and cut into 3 fingers, then serve. | 5) Cook's tips: Pierce the rounded end of each egg with a pin before cooking to help stop the shell from cracking. | 6) Cooling the eggs under cold water stops them from cooking further and prevents a dark ring forming around the yolk. | 7) For easy peeling, peel the eggs under cold running water over a colander to collect all the bits of shell. The water stops the shell from sticking to your fingers and the egg.", "tags": ["scottish", "welsh", "european", "kid friendly", "15 mins", "beginner cook", "easy"], "cook_time_min": 6, "servings": null, "cuisine": ["All"], "rating_avg": 4.71, "rating_count": 7, "popularity_score": 4.700588235294117, "nutrition_calories": 252.7, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/35/56/87/BD76HiyAThu1d0jV1lT9_EggSandwich2.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["scottish", "welsh", "european", "kid friendly", "15 mins", "beginner cook", "easy"], "ingredients": []}, {"recipe_id": "rec_33", "props": {"title": "Dancer's Potato Skins", "instructions": "[Instructions] 1) You can add these ingredients to the mashed potato centers if desired. | 2) 1/3 cup milk 1/4 cup butter salt and pepper a few drops hot sauce Scrub potatoes, dry, then pierce with fork several times. | 3) Arrange on a baking sheet and bake in 375 degree oven for about 1 hour or until tender. | 4) Let stand until cool enough to handle. Cut potatoes in half lengthwise and scoop out centers, leaving 1/8\" potato in shell. | 5) Cover. | 6) Chill shells up to 2 days until ready to use for the skins. | 7) If desired, add the 1/3 cup milk, 1/4 cup butter, salt and pepper to use potato centers as mashed potatoes. | 8) When ready to prepare skins, melt the 1/3 cup butter. | 9) Brush shells with the butter, inside and out. Place, cut side up, on baking sheet. Bake in a 500 degree oven for 20 minutes or until brown and crisp. | 10) Distribute some bacon, onion, and cheese in each shell. | 11) Bake just until cheese melts. | 12) Serve hot. If the potatoes are large, you may want to cut in half crosswise before serving. | 13) You may want to double this recipe if you are serving several people, especially if they are hungry! Serves: 6.", "tags": ["vegetable", "oven", "4 hours"], "cook_time_min": 1, "servings": null, "cuisine": ["All"], "rating_avg": 4.91, "rating_count": 25, "popularity_score": 4.848285714285714, "nutrition_calories": 304.0, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/50/33/IGN0fxEHQM28V8iTrWf2_bacon-potato-skins-1.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["vegetable", "oven", "4 hours"], "ingredients": []}, {"recipe_id": "rec_34", "props": {"title": "Delight Your Guests With Turkey and Brie Puff Pastry Bites", "instructions": "[Instructions] 1) Place puff pastry on work surface. Roll pastry out in one direction to form a rectangle; cut into 24 equal pieces. Press each piece into the cups of a 24-cup mini muffin pan, allowing some overhang. Freeze for 10 minutes. | 2) In small bowl, stir together turkey and mayonnaise. Remove muffin pan from freezer; divide turkey mixture among the cups. Top each with a piece of Brie, pressing down slightly. | 3) Bake in centre of oven for 20 to 22 minutes or until pastry is golden on bottom and cheese is melted and starting to brown. | 4) Meanwhile, in small bowl, stir together Dijon and honey. Transfer pastry bites to a long platter; drizzle Dijon mixture over top and garnish with parsley leaves. | 5) Makes 24 servings.", "tags": ["60 mins", "for large groups"], "cook_time_min": 22, "servings": null, "cuisine": ["All"], "rating_avg": null, "rating_count": 0, "popularity_score": null, "nutrition_calories": 76.0, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/50/82/85/pic7AIqq4.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["60 mins", "for large groups"], "ingredients": []}, {"recipe_id": "rec_35", "props": {"title": "Deviled Eggs With Candied Bacon", "instructions": "[Instructions] 1) Preheat the oven to 350 degrees F. | 2) In a small bowl, mix together the brown sugar, a pinch of cayenne and the cinnamon. Place the bacon on a wire rack set over a rimmed baking sheet. Sprinkle each slice of bacon with some of the spiced sugar and bake, about 10 minutes. Flip the bacon, sprinkle with the remaining spiced sugar and continue to cook until crispy, about 10 more minutes. Remove the bacon from the oven and allow to cool. When the bacon is cool, mince it and set aside, reserving a quarter of it for garnishing the eggs. | 3) Put the cold eggs in the bottom of a medium saucepan and cover with cold water. Bring water to a boil and remove the pan from the heat. Cover the pan with a lid and let stand for 12 minutes. Drain the eggs and rinse with cold water. Let the eggs cool a bit and then peel when they are still warm (eggs are much easier to peel when they are warm). After they are peeled, you can then store them, covered, in the fridge. | 4) Mix together the mayonnaise, mustard, dill, cider vinegar, Worcestershire sauce, 1/4 teaspoon cayenne, the scallions and the minced bacon in a medium mixing bowl. Season with the salt. | 5) Slice the eggs in half lengthwise. Gently remove the yolks by pressing your thumb against the back of the yolk to pop it out of the white. Add the yolks to the bowl with the mayonnaise mixture. Mash together, using a fork, until smooth. | 6) Put the filling in a re-sealable bag. Cut one end off and pipe the filling into the egg whites. Sprinkle with the paprika, extra bacon bits and dill before serving. | 7) Cook's Notes:. | 8) A wire rack is a great way to cook bacon because the air can circulate around the bacon making it crispy and delicious. | 9) Plastic bags are a great tool to use in place of a piping bag, easy and disposable.", "tags": ["meat", "60 mins", "easy"], "cook_time_min": 42, "servings": null, "cuisine": ["All"], "rating_avg": null, "rating_count": 0, "popularity_score": null, "nutrition_calories": 155.8, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/submissions/recipe/33186/mtrvpNUMR7r4bfPo7hVe_CCKEL204_Deviled-Eggs-with-Candied-Bacon-2_s4x3.jpg.rend.hgtvcom.616.462.jpeg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["meat", "60 mins", "easy"], "ingredients": []}, {"recipe_id": "rec_36", "props": {"title": "Deviled Eggs With Lemon", "instructions": "[Instructions] 1) Place eggs in pot and cover with water. Bring to a rolling boil. When the water reaches the boiling point, turn the flame off and put a lid on the pot and set aside for twenty minutes. | 2) Peel and discard all of the egg shells. Take 3 of the eggs and remove the yolk and discard the whites. With the remaining hard boiled eggs carefully slice through the eggs length wise and remove the yolks. | 3) Place all the yolks in a bowl. Finely chop parsley and add all the ingredients to the egg yolks, then combine well with a fork. Consistency should be smooth, add olive oil if needed and taste for seasoning. Transfer egg yolk mixture to a plastic bag, maneuvering to one corner of the bag, twist the excess of the bag pushing the yolks down to the corner. | 4) With scissors snip a small opening in the corner of the bag. Fill the egg white halves with the yolk mixture. | 5) Garnish with finely chopped scallions or parsley.", "tags": [], "cook_time_min": 30, "servings": null, "cuisine": ["All"], "rating_avg": 4.67, "rating_count": 3, "popularity_score": 4.688461538461539, "nutrition_calories": 139.9, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/42/08/05/FD9THhYSMyJb5KcZcBwi_Lemon-Parsley-Devilled-Eggs-4.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": [], "ingredients": []}, {"recipe_id": "rec_37", "props": {"title": "Died and Went to Pimento Cheese Heaven (Pimiento)", "instructions": "[Instructions] 1) Using a hand held mixer, beat cream cheese until soft. | 2) Add the remaining ingredients and beat until creamy and combined. | 3) Cover and refrigerate for about an hour.", "tags": ["lunch snacks", "cheese", "kid friendly", "potluck", "camping", "15 mins", "for large groups", "beginner cook", "easy"], "cook_time_min": 10, "servings": null, "cuisine": ["All"], "rating_avg": 4.64, "rating_count": 50, "popularity_score": 4.649, "nutrition_calories": 16.1, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/16/76/13/O6RXJW4HQbmB5uTCRvXI_0S9A0887.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["lunch snacks", "cheese", "kid friendly", "potluck", "camping", "15 mins", "for large groups", "beginner cook", "easy"], "ingredients": []}, {"recipe_id": "rec_38", "props": {"title": "Easy Apricot Bites", "instructions": "[Instructions] 1) Stir cream cheese until smooth; pipe or spoon into apricot halves. Sprinkle tops with pistachios.", "tags": ["fruit", "15 mins", "easy"], "cook_time_min": 15, "servings": null, "cuisine": ["All"], "rating_avg": 4.75, "rating_count": 4, "popularity_score": 4.71, "nutrition_calories": 78.0, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/39/52/80/pic56xVZC.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["fruit", "15 mins", "easy"], "ingredients": []}, {"recipe_id": "rec_39", "props": {"title": "Easy Bacon-Wrapped Dates", "instructions": "[Instructions] 1) Microwave bacon for about 2 minutes, until partially cooked, but not browned. | 2) Wrap each date with a strip of bacon and secure with a wooden toothpick. | 3) Broil on low 3 minutes, turn dates, and continue broiling 3 to 4 minutes longer, or until browned. | 4) Drain on paper towel and serve warm.", "tags": ["european", "30 mins", "easy"], "cook_time_min": 10, "servings": null, "cuisine": ["All"], "rating_avg": 4.78, "rating_count": 19, "popularity_score": 4.750344827586207, "nutrition_calories": 46.0, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/16/90/50/SYWvrUBfTwCPgGJrb4Lt_bacon-wrapped-dates-IMG_9226.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["european", "30 mins", "easy"], "ingredients": []}, {"recipe_id": "rec_40", "props": {"title": "Easy Cheese Ball", "instructions": "[Instructions] 1) mix cheddar cheese, sour cream, cream cheese, and ranch dressing mix. | 2) chill for 1 hour or until set. | 3) roll in chopped pecans. | 4) serve with Ritz crackers.", "tags": ["15 mins", "beginner cook", "easy", "inexpensive"], "cook_time_min": 5, "servings": null, "cuisine": ["All"], "rating_avg": 4.8, "rating_count": 6, "popularity_score": 4.73375, "nutrition_calories": 253.1, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/20/21/42/InHM77bS6qQlYvnA0Vlk_IMG_2886-easy-cheese-ball.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["15 mins", "beginner cook", "easy", "inexpensive"], "ingredients": []}, {"recipe_id": "rec_41", "props": {"title": "Fried Macaroni and Cheese Balls", "instructions": "[Instructions] 1) Lightly grease a 13x9-inch baking dish. In large saucepan, bring water and 1/2 t salt to a boil over high heat. Add pasta, and cook 6-8 minutes, or until tender; drain well. | 2) In a large bowl, combine hot cooked pasta, 1/2 cup milk, cheese spread, mozzarella cheese, 1/2 teaspoon salt and pepper; stir until cheeses are melted. Spoon into prepared baking dish; cover, and refrigerate 8 hours. | 3) Roll macaroni and cheese into 1-inch balls; place on a baking sheet, and freeze 2 hours. | 4) In a small bowl, whisk together eggs and remaining milk. | 5) In a separate small bowl, combine breadcrumbs and cornmeal. | 6) Dip balls into egg mixture, then dredge in breadcrumb mixture. | 7) In a large Dutch oven, pour oil to a depth of 2 inches; heat to 350 degrees over medium heat. | 8) Fry macaroni and cheese balls in batches, 3-4 minutes, or until golden brown. Drain on paper towels.", "tags": ["kid friendly", "for large groups"], "cook_time_min": 10, "servings": null, "cuisine": ["All"], "rating_avg": 4.67, "rating_count": 15, "popularity_score": 4.679600000000001, "nutrition_calories": 55.1, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/27/58/13/Fqiyyb1RToymcEfIsxQC_untitled-2860.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["kid friendly", "for large groups"], "ingredients": []}, {"recipe_id": "rec_42", "props": {"title": "German Sauerkraut and Potato Balls", "instructions": "[Instructions] 1) Place potatoes in a medium sized saucepan and cover with water; salt lightly. | 2) Bring to a boil over medium heat and cook until fork-tender; drain. | 3) Place potatoes in a large bowl and mash; then allow to cool for 5-10 minutes. | 4) Stir onions, drained sauerkraut, egg, salt, pepper, caraway, flour, and breadcrumbs into potatoes, forming a thick mixture. | 5) Pour some flour in a small bowl; do likewise to some bread crumbs. | 6) Beat 2 eggs in a small bowl also, set aside (Add more egg later if necessary). | 7) Heat deep fryer or oil (several inches deep in a frying skillet) to a temperature of 350 degrees. | 8) Take heaping tablespoonfuls of the potato mixture and roll in flour. | 9) Then coat with egg, then roll in bread crumbs. | 10) Do the same with several others. | 11) Fry balls (which should be the size of large meatballs) in small batches for 2-4 minutes or until golden brown. | 12) Drain on paper toweling, and serve hot. | 13) Makes 25 extra-large balls, or enough to serve about 6 people.", "tags": ["potato", "grains", "vegetable", "german", "european", "low protein", "low cholesterol", "healthy", "kid friendly", "winter", "30 mins", "deep fried", "stove top", "inexpensive"], "cook_time_min": 3, "servings": null, "cuisine": ["All"], "rating_avg": 4.69, "rating_count": 36, "popularity_score": 4.690869565217392, "nutrition_calories": 48.4, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/35/38/5/NoSLW9lgSbu4C7XVwVlE_sauerkraut-potato-balls-4.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["potato", "grains", "vegetable", "german", "european", "low protein", "low cholesterol", "healthy", "kid friendly", "winter", "30 mins", "deep fried", "stove top", "inexpensive"], "ingredients": []}, {"recipe_id": "rec_43", "props": {"title": "Goi Cuon (Vietnamese Cold Spring Rolls)", "instructions": "[Instructions] 1) Have all meats precooked and cold and the rice noodles prepared already (the noodles should be white, long and at room temp). | 2) Make sure all veggies and herbs are cleaned, dried, and set out before you start. | 3) Dip a sheet of rice paper wrapper into water very quickly, no longer than a second or two (or they will get too soggy) and lay flat on a work surface. | 4) On one edge, lay a small handful of noodles, a few strips of meat, some shrimp, some cilantro and mint leaves, a lettuce leaf, some cucumber strips and bean sprouts, all to taste but don't overstuff. | 5) Carefully start to roll up eggroll style, tucking in the sides, then continue to roll up-but not too tightly or the spring roll will split. | 6) These rolls will be thicker than the typical Chinese-style fried eggrolls. | 7) Combine a few spoonfulls of hoisin sauce with some chopped peanuts to use as a dipping sauce (or serve with prepared spicy fish sauce dip called Nuoc Mam, available at Asian markets). | 8) Serve immediately- these do not keep and will harden up in the fridge, so it is best to make just as many as you plan to serve (store any extra unassembled fillings in fridge and roll later). | 9) Note: Please be sure to get the correct spring roll rice papers- these are not the same as wonton/eggroll wrappers, which must be cooked. | 10) Look for edible rice paper wrappers, rice noodle vermicelli, and hoisin sauce in Asian markets.", "tags": ["poultry", "vegetable", "meat", "vietnamese", "asian", "30 mins"], "cook_time_min": 30, "servings": null, "cuisine": ["All"], "rating_avg": 4.75, "rating_count": 47, "popularity_score": 4.740175438596491, "nutrition_calories": 32.5, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/20/44/5/86AJD9ZkTESnkKw3zjIL_Goi%20Con%20Vietnamese%20Cold%20Spring%20Rolls%2020445%20-%20final%202.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["poultry", "vegetable", "meat", "vietnamese", "asian", "30 mins"], "ingredients": []}, {"recipe_id": "rec_44", "props": {"title": "Green Onion Blinis With Red Pepper Relish and Goat Cheese", "instructions": "[Instructions] 1) Turn the oven to 375 degrees. Lightly oil your bell pepper on all sides. I like to cut mine in half and put them on foil lined baking sheet, cut side down. Bake until skin is blackened and loose. Allow pepper to cool and peel skin. Chop into very small pieces (like pickle relish). | 2) Whip the soft goat cheese, sour cream and lemon juice in a smooth consistency. Add salt to taste. Set in the refrigerator. | 3) Heat a nonstick griddle or pan to medium heat. Mix the Simply Potatoes mashed potatoes, flour, egg, baking powder, and sour cream to a smooth consistency. Add enough milk to make a pancake like batter. Mix in the green onions. (No need to salt the batter as Simply Potatoes is already seasoned unless you wish to.) Spoon one tablespoon of batter onto pan, as many as you can handle at one time. When bubbles form then pop, flip the pancake. Cook each side to golden brown. | 4) To plate your blinis, top with a dollop of goat cheese cream and a small amount of roasted red pepper relish and a sprig of dill. Enjoy!", "tags": ["vegetable", "russian", "european", "60 mins", "easy"], "cook_time_min": 45, "servings": null, "cuisine": ["All"], "rating_avg": 4.88, "rating_count": 43, "popularity_score": 4.844905660377359, "nutrition_calories": 117.2, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/47/46/94/picExKL7I.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["vegetable", "russian", "european", "60 mins", "easy"], "ingredients": []}, {"recipe_id": "rec_45", "props": {"title": "Grilled Stuffed Jalapenos", "instructions": "[Instructions] 1) Preheat grill to medium-high heat. | 2) Cook bacon in a skilletover medium heat until crispy. | 3) Remove bacon, and drain on paper towels, and crumble bacon. | 4) Combine bacon, cheeses, and the next 4 ingredients through garlic in a bowl, stirring to combine. | 5) Divide cheese evenly, and fill pepper halves. | 6) Place peppers cheese side up on grill, cover and grill peppers 8 minutes, or until bottoms of peppers are charred, and cheese mixture is lightly browned. | 7) Place peppers on serving platter. | 8) Sprinkle with tomato, and cilantro.", "tags": ["mexican", "weeknight", "60 mins"], "cook_time_min": 30, "servings": null, "cuisine": ["All"], "rating_avg": 4.85, "rating_count": 15, "popularity_score": 4.787599999999999, "nutrition_calories": 86.4, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/45/89/83/Q5h7g3CYTsKBSxdnzyLr_JALAPENO3%20(1%20of%201).jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["mexican", "weeknight", "60 mins"], "ingredients": []}, {"recipe_id": "rec_46", "props": {"title": "Guacamole - Real Authentic Mexican \"Guac\"", "instructions": "[Instructions] 1) Slice avocados in half. Discard the seed. Scoop out of shell with a spoon. Place in bowl. | 2) Add juice of one fresh lime immediately to prevent browning. Use a fork and mash to desired consistency. | 3) Add chopped onions, tomato, and cilantro. Stir gently to mix ingredients. | 4) Add juice of second lime and then salt to taste. Stir just slightly, until incorporated. | 5) Add jalape\u00f1o to taste. | 6) Serve with your favorite tortilla chips for a dip, or use with your favorite Mexican dish. | 7) a side note: this is to make a chunky, yet creamy guacamole. Some people prefer to use a food processor with all the ingredients to make for a VERY creamy dip.", "tags": ["mexican", "low protein", "low cholesterol", "kid friendly", "potluck", "15 mins", "no cook", "beginner cook", "easy"], "cook_time_min": 15, "servings": null, "cuisine": ["All"], "rating_avg": 4.62, "rating_count": 59, "popularity_score": 4.630724637681159, "nutrition_calories": 206.2, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/13/50/48/0AX5KN91TnOQX6IUswKd_untitled-8206.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["mexican", "low protein", "low cholesterol", "kid friendly", "potluck", "15 mins", "no cook", "beginner cook", "easy"], "ingredients": []}, {"recipe_id": "rec_47", "props": {"title": "Honey Glazed Fried Manchego Cheese", "instructions": "[Instructions] 1) Place the flour, egg, and panko bread crumbs in 3 separate dishes. | 2) Dip the cheese cubes into each ingredient to coat, starting with the flour and ending with the panko. | 3) Preheat the canola oil in a deep fryer to 375 degrees F, (or in a large heavy-bottomed saucepan, pour enough oil to fill the pan about a third of the way. Heat over medium heat until a deep-frying thermometer inserted in the oil reaches 375 degrees F.) If you don't have a thermometer, a cube of bread will brown in about 3 minutes. | 4) Add the breaded cheese to the hot oil, in batches, and deep fry until the cubes are crisp and golden. | 5) Remove the cheese from the oil and place on a paper towel-lined baking sheet to absorb the excess oil. Transfer the cheese to a serving platter, drizzle with the honey, and dust with the paprika.", "tags": ["spanish", "european", "30 mins", "deep fried"], "cook_time_min": 5, "servings": null, "cuisine": ["All"], "rating_avg": 4.75, "rating_count": 4, "popularity_score": 4.71, "nutrition_calories": 238.3, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/44/99/80/umKjDtPGTIqiooZKUq6u_ch6.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["spanish", "european", "30 mins", "deep fried"], "ingredients": []}, {"recipe_id": "rec_48", "props": {"title": "Hot and Spicy Peanuts", "instructions": "[Instructions] 1) In a skillet, heat oil over medium heat. Stir in the peanuts, chili powder, and red pepper. | 2) Cook and stir for 2 minutes or until peanuts are warm. Drain well on paper towels. | 3) Sprinkle garlic salt over peanuts and toss to combine. Cool completely. | 4) May be stored in a tightly covered container at room temperature.", "tags": ["fruit", "high protein", "high in", "spicy", "christmas", "15 mins", "for large groups", "easy", "inexpensive"], "cook_time_min": 10, "servings": null, "cuisine": ["All"], "rating_avg": 4.81, "rating_count": 17, "popularity_score": 4.767037037037037, "nutrition_calories": 117.0, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/19/04/70/picVliTRU.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["fruit", "high protein", "high in", "spicy", "christmas", "15 mins", "for large groups", "easy", "inexpensive"], "ingredients": []}, {"recipe_id": "rec_49", "props": {"title": "Italian Appetizer Bites", "instructions": "[Instructions] 1) Heat oven to 350\u00b0F. | 2) Spray a 13x9x2-inch glass baking dish with cooking spray. | 3) Unroll one package of crescent rolls and use them to line the bottom of the dish. Pinch the seams together with your fingers. | 4) Cover rolls with half of the salami, provolone and ham. | 5) Lightly beat 6 of the eggs with the parmesan; pour half over top of the deli meat. | 6) Top with half of the peppers. | 7) Repeat layering the remaining salami, provolone, ham, egg mixture and peppers. | 8) Top with remaining package of rolls. | 9) Lightly beat the remaining egg and brush over top. | 10) Cover dish with foil; bake for 30 minutes. | 11) Uncover and bake for 30 minutes more. | 12) Cool 1 hour; cut into 32 squares and serve.", "tags": ["4 hours"], "cook_time_min": 1, "servings": null, "cuisine": ["All"], "rating_avg": 4.8, "rating_count": 10, "popularity_score": 4.747, "nutrition_calories": 129.8, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/18/48/89/laFE2T09Txafpo48OeHW_image.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["4 hours"], "ingredients": []}, {"recipe_id": "rec_50", "props": {"title": "Jalapeno Poppers", "instructions": "[Instructions] 1) Cut jalapenos in half and remove seeds and veins. | 2) (Use gloves to work with peppers). | 3) Fill jalpenos with cream cheese and wrap a slice of bacon around each one. | 4) Secure with a toothpick. | 5) Bake at 425 degrees until bacon appears to be done, about 15-20 minutes.", "tags": ["spicy", "60 mins", "oven", "easy"], "cook_time_min": 20, "servings": null, "cuisine": ["All"], "rating_avg": 4.86, "rating_count": 146, "popularity_score": 4.849358974358975, "nutrition_calories": 59.2, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/16/33/3/0bkxoGnERR28EABnWZvw_0S9A3914.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["spicy", "60 mins", "oven", "easy"], "ingredients": []}, {"recipe_id": "rec_51", "props": {"title": "Kims Bite Size Sandwiches", "instructions": "[Instructions] 1) Make sandwiches with rolls, beef, and cheese. | 2) Mix the Worcestershire sauce with butter and spread over tops of sandwiches. | 3) Bake at 350\u00b0F til butter is melted and tops of sandwiches are slightly browned. | 4) ENJOY.", "tags": ["potluck", "brunch", "30 mins", "for large groups", "easy"], "cook_time_min": 10, "servings": null, "cuisine": ["All"], "rating_avg": 4.67, "rating_count": 6, "popularity_score": 4.685, "nutrition_calories": 183.9, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/34/72/33/oJXkL4QIqVPA116MAcgt_sweet-hawaiian-baked-sandwich-sliders-6513.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["potluck", "brunch", "30 mins", "for large groups", "easy"], "ingredients": []}, {"recipe_id": "rec_52", "props": {"title": "Kittencal's Chinese Chicken Balls With Sweet and Sour Sauce", "instructions": "[Instructions] 1) To make the sweet and sour sauce sauce; in a saucepan combine the first 5 ingredients until combined. | 2) In a cup or bowl whisk the cold water or pineapple juice with cornstarch until smooth and well blended, then whisk vigorously into the ketchup mixture; bring to a boil stirring or whisking constantly over medium-high heat until bubbly. | 3) Reduce the heat to medium-low and continue simmering and mixing until thickened (be patient the sauce takes a few minutes to thicken up) remove from heat and allow to sit at room temperature while making the chicken balls or you may cool to room temperature then refrigerate until ready to use (I prefer the sauce at room temperature). | 4) To make the chicken balls: in a large bowl combine flour, cornstarch, baking powder, baking soda, garlic powder; add in water and sesame oil; whisk vigorously until smooth. | 5) Add in chicken pieces; using clean handsand mix until well coated. | 6) Heat oil in a deep-fryer or Dutch oven to 375 degrees. | 7) Carefully dip the battered chicken pieces in hot oil and fry until golden brown (about 3-4 minutes). | 8) Remove to a paper towel. | 9) Sprinkle with seasoning salt immediately after frying if desired. | 10) Serve immediately with sweet and sour sauce. | 11) Delicious!", "tags": ["chicken", "pineapple", "poultry", "tropical fruits", "fruit", "vegetable", "meat", "healthy", "kid friendly", "christmas", "brunch", "30 mins", "oven", "deep fried", "easy"], "cook_time_min": 5, "servings": null, "cuisine": ["All"], "rating_avg": 4.72, "rating_count": 197, "popularity_score": 4.718743961352657, "nutrition_calories": 555.0, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/13/25/46/uNGG7ogZTxmcgvA1WlUD_sweet-and-sour-chicken-chinese-1811.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["chicken", "pineapple", "poultry", "tropical fruits", "fruit", "vegetable", "meat", "healthy", "kid friendly", "christmas", "brunch", "30 mins", "oven", "deep fried", "easy"], "ingredients": []}, {"recipe_id": "rec_53", "props": {"title": "Linda's Ham Salad Sandwich (Sandwiches) or Finger Rolls", "instructions": "[Instructions] 1) Grind the ham shoulder with a meat grinder. You can use a blender for this also, just make sure you don't put in too much at a time. | 2) Put ground meat in a bowl and add mayonnaise, mustard, and relish. Mix well. | 3) Chill until ready to make sandwiches or rolls. | 4) When ready to make sandwiches, put a good amount of meat filling on the roll. | 5) Add a slice of onion, or as much as you want. I love making these with vidalia onions, they are so sweet. | 6) Put the top piece of bread or roll on, and serve.", "tags": ["ham", "pork", "meat", "30 mins", "beginner cook", "easy"], "cook_time_min": 20, "servings": null, "cuisine": ["All"], "rating_avg": 4.96, "rating_count": 24, "popularity_score": 4.881764705882353, "nutrition_calories": 485.8, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/23/45/42/buQCn5WgSKuHjMTkJsZb_HAMSALAD3.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["ham", "pork", "meat", "30 mins", "beginner cook", "easy"], "ingredients": []}, {"recipe_id": "rec_54", "props": {"title": "Marinated Cheese Appetizer", "instructions": "[Instructions] 1) Cut cheddar cheese and cream cheese into 1/4 inch slices, then again in half. | 2) Using a small dish, place cheese slices on end alternating cheddar and cream cheese. | 3) Make the marinade by combining sugar, basil, salt, pepper, oil, vinegar, pimento, parsley, onion and garlic. | 4) Pour marinade over cheese, cover and refrigerate overnight. | 5) Serve with crackers.", "tags": ["30 mins", "no cook", "refrigerator"], "cook_time_min": 30, "servings": null, "cuisine": ["All"], "rating_avg": 4.76, "rating_count": 23, "popularity_score": 4.74, "nutrition_calories": 451.4, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/33/50/1/GznzFiI4RVmT4yL8o0G2_DSC01842.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["30 mins", "no cook", "refrigerator"], "ingredients": []}, {"recipe_id": "rec_55", "props": {"title": "Marinated Cocktail Shrimp", "instructions": "[Instructions] 1) Place the frozen shrimp in a colander in the sink, and run hot water over them while stirring occasionally until they separate and begin to thaw, about 1 minute. | 2) Set aside to drain for another 5 minutes or so until they're thawed yet still chilled in the middles, then place them in a large bowl. | 3) To the bowl add the sherry, lime juice, seasoning salt, black pepper, ancho powder, and 1/2 teaspoon cocktail sauce, and stir well to coat; set aside for another 10 minutes or so, stirring occasionally. | 4) (You can put them in a container in the fridge for later, if need be, or into a container for taking to a picnic or potluck.). | 5) Serve with your favorite cocktail sauce for dipping. | 6) Note: you can, of course, use the marinade on thawed cooked shrimp - just toss them well in the marinade and let sit for at least 10 minutes.", "tags": ["potluck", "brunch", "30 mins", "easy"], "cook_time_min": 16, "servings": null, "cuisine": ["All"], "rating_avg": 5.0, "rating_count": 4, "popularity_score": 4.781428571428571, "nutrition_calories": 73.2, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/11/55/02/Xc8vZIm7Ru7EmAmTTEw6_ShrimpCocktail2.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["potluck", "brunch", "30 mins", "easy"], "ingredients": []}, {"recipe_id": "rec_56", "props": {"title": "Marinated Shrimp Canapes", "instructions": "[Instructions] 1) Marinated cooked shrimp for 1 hour in dressing in the refrigerator. | 2) Drain and place shrimp on individual slices of cucumbers then place this on the Melba Rounds and top with dabs of sour cream. | 3) Arrange on serving dish and refrigerate until ready to serve.", "tags": ["60 mins", "refrigerator", "easy"], "cook_time_min": 1, "servings": null, "cuisine": ["All"], "rating_avg": 5.0, "rating_count": 3, "popularity_score": 4.764615384615385, "nutrition_calories": 1495.8, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/37/40/0/s3vOGFtTLar1ibhnkyXA_IMG_6083-shrimp-canapes.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["60 mins", "refrigerator", "easy"], "ingredients": []}, {"recipe_id": "rec_57", "props": {"title": "Mexican Ceviche", "instructions": "[Instructions] 1) Dice the fish (approximately 1/2-inch dice if using shrimp use cleaned shrimp). | 2) Marinate fish in the lime juice in the fridge overnight (this step cooks the fish). | 3) Stir often. | 4) Pour off most of the lime juice (just leave it moist). | 5) Add remaining ingredients except lettuce, avocado and olive. Do this preferably a few hours before serving & refrigerate. | 6) Toss well and arrange in individual serving bowls that are lined with the lettuce leaves. | 7) If you wish garnish with sliced avocado and sliced black olives.", "tags": ["mexican", "healthy", "spicy", "weeknight", "no cook", "refrigerator"], "cook_time_min": 8, "servings": null, "cuisine": ["All"], "rating_avg": 4.37, "rating_count": 54, "popularity_score": 4.420625, "nutrition_calories": 181.7, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/88/99/zKK1YEbS0G92b050ZWtP_Mexican%20Ceviche_final%204.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["mexican", "healthy", "spicy", "weeknight", "no cook", "refrigerator"], "ingredients": []}, {"recipe_id": "rec_58", "props": {"title": "Mexican Rice Balls - Leftover Rice", "instructions": "[Instructions] 1) Mix chilled rice, eggs, and peas together. | 2) Roll into balls about the size of a tangerine and place one cube of cheese into the rice ball. Reform balls firmly to hold shape. | 3) Place flour, egg and breadcrumbs into 3 separate bowls. | 4) Dip each ball in flour, shaking off excess and reform if needed. Dip in egg, letting excess drip off, then dredge in bread crumbs, reforming and transfer to a sheet of wax paper. Repeat with remaining balls. | 5) Meanwhile heat 2 inches of oil in a 4- to 5-quart heavy pot until thermometer registers 350-360 degrees F. Working in batches of 4-6 balls, lower rice balls into oil with a slotted spoon and fry, turning occasionally, until golden brown, 2 to 3 minutes per batch. Transfer with slotted spoon to paper towels to drain. Return oil to 350-360\u00b0F between batches. | 6) Serve with a tomato sauce.", "tags": ["cheese", "mexican", "potluck", "savory", "60 mins", "for large groups", "deep fried", "stove top"], "cook_time_min": 20, "servings": null, "cuisine": ["All"], "rating_avg": 5.0, "rating_count": 3, "popularity_score": 4.764615384615385, "nutrition_calories": 143.7, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/27/13/08/sK4Kv5EOQQmXvoNIxio4_rice%20balls-3.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["cheese", "mexican", "potluck", "savory", "60 mins", "for large groups", "deep fried", "stove top"], "ingredients": []}, {"recipe_id": "rec_59", "props": {"title": "Middle Eastern Tahini and Yogurt Appetizer", "instructions": "[Instructions] 1) Put yogurt, tahini, cilantro, vinegar, garlic, salt, pepper and cayenne in medium bowl and stir with wooden spoon until blended. | 2) Spread mixture on small serving platter. | 3) Decorate with tomato and drizzle with olive oil before serving with assorted veggies and/or pita bread.", "tags": ["asian", "kid friendly", "weeknight", "15 mins", "no cook", "beginner cook", "easy", "inexpensive"], "cook_time_min": 10, "servings": null, "cuisine": ["All"], "rating_avg": 4.0, "rating_count": 3, "popularity_score": 4.533846153846154, "nutrition_calories": 150.1, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/42/41/46/NIShngIdTgycHxdrAw3n_DSC05430-2.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["asian", "kid friendly", "weeknight", "15 mins", "no cook", "beginner cook", "easy", "inexpensive"], "ingredients": []}, {"recipe_id": "rec_60", "props": {"title": "Mini Pigs-In-A-Blanket", "instructions": "[Instructions] 1) Preheat oven according to directions on crescent roll package. | 2) Unroll but leave intact 2 triangles of crescent rolls. | 3) Pinch seam together and cut lengthwise into 5 strips and then cross-wise to make 10 strips. | 4) Roll each strip around one sausage and place in baking pan that has been sprayed with non-stick cooking oil. | 5) Sprinkle each pig with parmesan and garlic salt. | 6) Bake according to crescent roll package directions.", "tags": ["pork", "meat", "very low carbs", "low protein", "low cholesterol", "thanksgiving", "brunch", "30 mins", "easy"], "cook_time_min": 15, "servings": null, "cuisine": ["All"], "rating_avg": 4.72, "rating_count": 100, "popularity_score": 4.7176363636363625, "nutrition_calories": 0.0, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/79/71/5/picOcpHe6.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["pork", "meat", "very low carbs", "low protein", "low cholesterol", "thanksgiving", "brunch", "30 mins", "easy"], "ingredients": []}, {"recipe_id": "rec_61", "props": {"title": "Mini Smoky Bacon Wraps", "instructions": "[Instructions] 1) Set oven to 350\u00b0F. | 2) Grease a baking sheet. | 3) Cut each bacon slice into thirds. | 4) Wrap each slice around each of the small smokies. | 5) Place in foil-lined baking pan. | 6) Bake for about 10 minutes. | 7) Meanwhile in a small bowl mix together the ketchup with brown sugar to form a thick mixture. | 8) Remove the cocktail wieners from oven and brush about 1 teaspoon of the ketchup/brown sugar mixture over the wiener. | 9) Place back in the oven and bake until the bacon is lightly crisp (do not overcook or the bacon will be too hard!).", "tags": ["60 mins", "for large groups", "easy"], "cook_time_min": 30, "servings": null, "cuisine": ["All"], "rating_avg": 5.0, "rating_count": 17, "popularity_score": 4.886666666666667, "nutrition_calories": 25.4, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/77/13/6/3HaUdUklRBOWEk44vqs9_IMG_2902%20bacon%20wrapped%20smokies.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["60 mins", "for large groups", "easy"], "ingredients": []}, {"recipe_id": "rec_62", "props": {"title": "Mini Taco Quiches", "instructions": "[Instructions] 1) Preheat oven to 350\u00b0F Grease 12 muffin pan cups. Set aside. | 2) Cook beef and onions in large nonstick skillet until meat is browned; drain. Remove from heat. Stir in olives, tomato sauce, 1/4 cup water, taco seasoning, hot sauce and egg; mix well. | 3) Using a 4-inch round cookie cutter, cut each flour tortilla into 3 rounds. Fit tortilla rounds into prepared muffin cups. Fill each tortilla cup wih 1/4 cup meat mixture. Top each with sour ceam and cheese. Bake 25 minutes or until heated through.", "tags": ["beginner cook", "easy"], "cook_time_min": 30, "servings": null, "cuisine": ["All"], "rating_avg": 4.56, "rating_count": 11, "popularity_score": 4.623809523809523, "nutrition_calories": 151.4, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/35/95/40/buw103uFQcG9ksyytHu8_0S9A9777.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["beginner cook", "easy"], "ingredients": []}, {"recipe_id": "rec_63", "props": {"title": "Mojito Shrimp Taco Cups", "instructions": "[Instructions] 1) For the shrimp marinade: Combine the mint leaves, rum, sugar, oil, lime pieces and 2 teaspoons salt in a medium bowl. Use a muddler or wooden spoon to mash, making sure to release the juices in the limes. Stir in the shrimp, then cover and refrigerate for 20 to 30 minutes. | 2) For the taco cups: Preheat the oven to 350 degrees F. | 3) Brush both sides of each wonton wrapper with oil, then press into the wells of a muffin tin, making sure to gently press into the bottoms and up the sides. Bake until lightly golden and crisp, 8 to 10 minutes. Remove the cups from the muffin tin immediately to a rack. Preheat the broiler. | 4) For the mango avocado salsa: Stir to combine the mango, mint leaves, lime juice, red onion, rum and avocado in a medium bowl, then season with salt and pepper. Set aside. | 5) Drain the shrimp from the marinade and place on a baking sheet. Broil the shrimp until cooked through, 2 to 3 minutes per side. | 6) For the garnishes: Spoon the mango avocado salsa into the taco cups and top each with a shrimp. Garnish with chopped mint and queso fresco and serve with lime wedges.", "tags": [], "cook_time_min": 1, "servings": null, "cuisine": ["All"], "rating_avg": null, "rating_count": 0, "popularity_score": null, "nutrition_calories": 157.7, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/53/85/34/HoZMHCKR8iyh2FETO0tg_0S9A0350.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": [], "ingredients": []}, {"recipe_id": "rec_64", "props": {"title": "Mozzarella Sticks", "instructions": "[Instructions] 1) Whisk eggs and milk together. | 2) Coat each piece of cheese with flour, then dip in egg and then roll in bread crumbs. | 3) Dip in egg and crumbs again. | 4) Freeze for 6 to 24 hours before frying. | 5) Heat oil in skillet and cook sticks for about a minute on each side, or until golden and before cheese starts to leak. | 6) Drain on paper towels. | 7) Serve with sauce for dipping.", "tags": ["cheese", "kid friendly", "high in", "potluck", "15 mins", "beginner cook", "stove top", "easy", "inexpensive"], "cook_time_min": 5, "servings": null, "cuisine": ["All"], "rating_avg": 4.8, "rating_count": 92, "popularity_score": 4.789607843137254, "nutrition_calories": 182.7, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/30/97/7/7GmgWw4TTUCCw7xGKQAP_0S9A6434.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["cheese", "kid friendly", "high in", "potluck", "15 mins", "beginner cook", "stove top", "easy", "inexpensive"], "ingredients": []}, {"recipe_id": "rec_65", "props": {"title": "Mozzarella, Tomato and Basil Salad", "instructions": "[Instructions] 1) Slice tomatoes and mozzarella cheese same thickness. | 2) Arrange the tomatoes, mozzarella, and basil alternating in a circle around a decorative serving dish. | 3) Drizzle with olive oil (and balsamic vinegar if desired). | 4) Serve with salt and pepper to individual taste.", "tags": ["european", "15 mins", "no cook", "easy"], "cook_time_min": 5, "servings": null, "cuisine": ["All"], "rating_avg": 4.93, "rating_count": 56, "popularity_score": 4.894242424242424, "nutrition_calories": 320.3, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/85/07/X7Y8sBBcTrSju0SO0EVy_untitled-7798.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["european", "15 mins", "no cook", "easy"], "ingredients": []}, {"recipe_id": "rec_66", "props": {"title": "Panko Fried Oysters for Two", "instructions": "[Instructions] 1) HOT SAUCE: Mix all ingredients together. | 2) To allow flavors to blend, refrigerate several hours. | 3) Hot Sauce will keep several days in the refrigerator. | 4) Be sure to cover it tightly. | 5) Line colander with two layers of paper towel. | 6) Rinse oysters, drain and put in colander, patting to dry. | 7) EGG DIP: In small bowl, add egg and milk; whisk to blend well. | 8) If using only egg whites, do not whisk enough to be dry/frothy. | 9) FLOUR COATING: Put all ingredients in small plastic bag and shake to mix well. | 10) PANKO COATING: in a small bowl, add ingredients and mix well. | 11) TO BREAD OYSTERS: Step 1: Dip 2 or 3 oysters in Egg Dip, letting any excess drain off. | 12) Step 2: Place them in Flour Coating, shaking to completely coat oysters. | 13) Remove from Flour Mixture. | 14) Step 3: Repeat step 1. | 15) Step 4: Place them in Panko Coating bowl. | 16) Roll them over and get them completely coated with bread crumbs. | 17) With tongs, gently remove them from breadcrumbs and place in a single layer on a baking tray lined with plastic wrap. | 18) Repeat Steps 1-4 until all oysters are breaded. | 19) Cover breaded oysters with plastic wrap and refrigerate at least 2 hours or more. | 20) This breading can be done up to 8 hours ahead. | 21) TO FRY OYSTERS: Heat frying oil in deep pan to 375 degrees Fahrenheit. | 22) With tongs, gently remove oysters from baking sheet and gently drop them into the hot oil. | 23) Fry the oysters in small (6-8 oysters each) batches to keep from lowering the temperature of the oil too much. | 24) Fry about 2 minutes or until golden brown on one side, turn and brown other side (about 1-2 minutes). | 25) Remove from oil and drain on layers of paper towels. | 26) NOTE: After cooking one batch of oysters, let the temperature of the oil return to about 375, before cooking the next batch. | 27) If the oil temperature is not hot enough before adding the oysters, they will taste greasy, rather than light. | 28) Serve immediately with Hot Sauce.", "tags": ["deep fried", "oysters"], "cook_time_min": 20, "servings": null, "cuisine": ["All"], "rating_avg": 5.0, "rating_count": 33, "popularity_score": 4.928837209302325, "nutrition_calories": 378.3, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/54/32/8/RDxdbGNvSMCdTDLEYy96_pieoyster-939.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["deep fried", "oysters"], "ingredients": []}, {"recipe_id": "rec_67", "props": {"title": "Parmesan crisps", "instructions": "[Instructions] 1) Preheat oven to 400 degrees. | 2) Cover baking sheets with non-stick baking parchment and lightly brush parchment with butter. | 3) Sprinkle cheese in mounds on baking sheets and flatten slightly with a fork to 2-inch rounds. | 4) Bake for 2-1/2 minutes. | 5) Sprinkle Parmesan rounds with chives and bake for 30 seconds or until golden brown. | 6) Remove Parmesan rounds from oven. | 7) Leave for 2 minutes to become crisp. | 8) Using a metal palette knife, transfer to a wire rack to cool.", "tags": ["high protein", "high in", "15 mins", "easy"], "cook_time_min": 3, "servings": null, "cuisine": ["All"], "rating_avg": 4.8, "rating_count": 12, "popularity_score": 4.751818181818181, "nutrition_calories": 61.3, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/60/47/1/fnjvi4knQhSOnXWGmAKe_DSC05403-2.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["high protein", "high in", "15 mins", "easy"], "ingredients": []}, {"recipe_id": "rec_68", "props": {"title": "Party Salad Boats", "instructions": "[Instructions] 1) Assemble the salad dressing an hour ahead, so the onion and salad dressing have time to blend but the onion is still crunchy. | 2) Bring the water to a boil with the salt. Add the pasta and cook for 12 minutes. Drain immediately and cool completely. | 3) Chop the romaine, tomatoes and pepperoni. Drain and add the olives. Crumble the cheese over the salad. | 4) Toss the salad dressing and salad. The dressing will be clumpy. Add the dressing a little at a time, being careful to not add too much. Add garlic salt to taste. | 5) (I usually spoon out the onions with a large non-slotted spoon. I use the dressing that comes along with the onions, leaving any excess dressing for another day.). | 6) Fill the pasta shells.", "tags": ["brunch", "4 hours"], "cook_time_min": 1, "servings": null, "cuisine": ["All"], "rating_avg": 4.93, "rating_count": 17, "popularity_score": 4.842592592592593, "nutrition_calories": 222.2, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/20/19/15/lVQfuAyHTXe6E5Eojagf_DSC05546-2.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["brunch", "4 hours"], "ingredients": []}, {"recipe_id": "rec_69", "props": {"title": "Patatas Bravas - Potatoes for the Brave, Spanish Style!", "instructions": "[Instructions] 1) (Serves 10-12 with other dishes). | 2) Prepare ahead by heating the oil in a pan, add the onion and fry for about 5 minutes until softened. Add the garlic, tomatoes, tomato pur\u00e9e, two types of paprika, chilli powder, sugar and salt and bring to the boil, stirring. Simmer for 10 minutes until pulpy. Set aside for up to 24 hours. | 3) To serve, preheat the oven to 200C/gas 6/fan oven 180\u00b0C Cut the potatoes into small cubes and pat dry with kitchen paper. | 4) Spread over a roasting tin and toss in the oil, then season. Roast for 40-50 minutes, until the potatoes are crisp and golden. | 5) Tip the potatoes into dishes and spoon over the reheated sauce. | 6) Sprinkle with the parsley. Serve with cocktail sticks.", "tags": ["onions", "vegetable", "spanish", "portuguese", "european", "low protein", "vegan", "low cholesterol", "spicy", "brunch", "4 hours", "easy"], "cook_time_min": 50, "servings": null, "cuisine": ["All"], "rating_avg": 4.92, "rating_count": 12, "popularity_score": 4.817272727272727, "nutrition_calories": 145.9, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/22/56/44/WbneE9H1T7OnhGt0Yh8y_pb2.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["onions", "vegetable", "spanish", "portuguese", "european", "low protein", "vegan", "low cholesterol", "spicy", "brunch", "4 hours", "easy"], "ingredients": []}, {"recipe_id": "rec_70", "props": {"title": "Perky Olive Penguins", "instructions": "[Instructions] 1) Cut a slit from the top to the bottom of 12 jumbo olives; set aside. | 2) In a mixing bowl, combine the next six ingredients; mix well. | 3) Fill a small heavy-duty plastic bag with cream cheese mixture. | 4) Cut a small hole in the corner of the plastic bag; carefully pipe mixture into jumbo olives. | 5) Set aside. | 6) Cut a small triangle out of each carrot slice; press triangles into small olives for a beak. | 7) On each notched carrot slice, position a jumbo olive so the white chest is lined up with the notch for the feet. | 8) Place the small olive, hole side down, over the jumbo olive so the beak, chest and feet are aligned. | 9) Carefully insert a toothpick through the top of the head into the body and carrot base. | 10) Wrap a pimento around the neck for a scarf.", "tags": ["cheese", "vegetable", "kid friendly", "potluck", "christmas", "15 mins", "no cook", "refrigerator", "beginner cook", "easy"], "cook_time_min": 10, "servings": null, "cuisine": ["All"], "rating_avg": 4.94, "rating_count": 72, "popularity_score": 4.91, "nutrition_calories": 47.2, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/40/46/3/AbKu6i6wT1qjbGHBnnZr_0S9A0309.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["cheese", "vegetable", "kid friendly", "potluck", "christmas", "15 mins", "no cook", "refrigerator", "beginner cook", "easy"], "ingredients": []}, {"recipe_id": "rec_71", "props": {"title": "Pigs in a blanket", "instructions": "[Instructions] 1) Heat oven to 375. | 2) Separate dough into 8 triangles. | 3) Cut each triangle lengthwise into thirds. | 4) Place sausage on shortest side and roll to opposite points. | 5) Bake at 375 on ungreased cookie sheet until golden brown. | 6) Serve warm.", "tags": ["30 mins", "easy"], "cook_time_min": 10, "servings": null, "cuisine": ["All"], "rating_avg": 4.62, "rating_count": 28, "popularity_score": 4.639473684210526, "nutrition_calories": 156.6, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/25/19/8/picJl2FOO.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["30 mins", "easy"], "ingredients": []}, {"recipe_id": "rec_72", "props": {"title": "Pistachio-Goat Cheese Bites", "instructions": "[Instructions] 1) Toast nuts in small skillet over medium heat until fragrant, about 3 minutes; chop finely. | 2) Combine goat cheese and cream cheese in a medium bowl. Drop mixture by heaping teaspoons onto a parchment-lined baking sheet; refrigerate 15 minutes. | 3) Roll into balls, then roll in chopped nuts. | 4) Refrigerate, tightly covered, up to 1 day.", "tags": ["fruit", "nuts", "high protein", "high in", "30 mins", "beginner cook", "easy"], "cook_time_min": 3, "servings": null, "cuisine": ["All"], "rating_avg": 4.68, "rating_count": 28, "popularity_score": 4.683684210526315, "nutrition_calories": 98.7, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/16/18/52/picyIdrac.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["fruit", "nuts", "high protein", "high in", "30 mins", "beginner cook", "easy"], "ingredients": []}, {"recipe_id": "rec_73", "props": {"title": "Pizza Bouquet", "instructions": "[Instructions] 1) Preheat oven to 400 degrees F. Unroll pizza dough onto work surface with the long side parallel to the edge of the counter. Cut into 12 equal strips, about 1 \u00bd-2 inches wide. Spread pizza sauce over dough, then sprinkle over parmesan cheese, mozzarella cheese and Italian seasoning. | 2) Working with one strip at a time, place 7-8 slices pepperoni down each strip of dough, overlapping slightly. The top of the pepperoni should stick out over the top of the dough. Roll the dough into a cylinder to look like a rose bud and transfer to a 12-well muffin tin with the pepperoni edge up. | 3) Bake for 15-20 minutes until golden and and crisp. To serve, place a skewer in the bottom of each pizza rose and tie together.", "tags": ["easy"], "cook_time_min": 20, "servings": null, "cuisine": ["All"], "rating_avg": null, "rating_count": 0, "popularity_score": null, "nutrition_calories": 188.3, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/53/75/03/llLJfNGDTIONuC6CZMSy_0S9A2874.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["easy"], "ingredients": []}, {"recipe_id": "rec_74", "props": {"title": "Pizza Meatloaf Cups", "instructions": "[Instructions] 1) In a bowl, combine the egg, pizza sauce, bread crumbs and Italian seasoning. | 2) Fold beef into mixture and mix well. | 3) Divide meat mixture into 12 greased muffin cups. | 4) Press mixture into bottom and up the sides. | 5) Fill center with cheese. | 6) Bake at 375\u00b0F for 15-18 minutes or until meat is no longer pink. | 7) Serve immediately with additional pizza sauce and cheese if desired. | 8) Or cool, place in freezer bags and freeze for up to 3 months. | 9) To use frozen pizza cups:. | 10) Thaw in the refrigerator for 24 hours. | 11) Heat in microwave on high for 2-3 minutes or until heated through. | 12) Top with additional pizza sauce and cheese if desired.", "tags": ["kid friendly", "microwave", "30 mins", "freezer", "small appliance"], "cook_time_min": 20, "servings": null, "cuisine": ["All"], "rating_avg": 4.42, "rating_count": 34, "popularity_score": 4.482272727272727, "nutrition_calories": 215.2, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/32/06/58/uIVLPeQZRb6heOydsVi4_PIZZA1%20(1%20of%201).jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["kid friendly", "microwave", "30 mins", "freezer", "small appliance"], "ingredients": []}, {"recipe_id": "rec_75", "props": {"title": "Puff Pastry Canapes", "instructions": "[Instructions] 1) Heat oven to 400F (200C). Line two rimmed baking sheets with parchment. | 2) Unroll one sheet of puff pastry. Cut pastry evenly into 4 strips. Cut each strip evenly into 4 parts to make 16 squares. Place on prepared pan, score 2 or 3 times with a fork and brush with egg wash. Bake until golden and puffed; about 14 minutes. Repeat with remaining sheet. Cool 5 minutes. | 3) Spread each square with 1 1/2 tsp (7 mL) ricotta cheese. Top 16 squares with pear slices, walnuts and a drizzle of honey. Top remaining 16 squares with arugula, prosciutto and sundried tomatoes.", "tags": ["60 mins", "easy"], "cook_time_min": 30, "servings": null, "cuisine": ["All"], "rating_avg": null, "rating_count": 0, "popularity_score": null, "nutrition_calories": 434.1, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/submissions/recipe/1938173/grODBQ6DQBmP7yePX9rZ_91159H.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["60 mins", "easy"], "ingredients": []}, {"recipe_id": "rec_76", "props": {"title": "Salmon Croquettes", "instructions": "[Instructions] 1) In a large frypan, heat butter over medium high heat, and saut\u00e9 onion and garlic powder. | 2) Add salmon, season with salt and pepper (you may wish to add dill) and heat through. | 3) Add flour and stir well. | 4) Add milk gradually stirring constantly until mixture thickens and forms a ball. | 5) Remove mixture to plate and allow to cool completely (this may be done the day before, and the mixture placed in the refrigerator--it's easier to work with this way). | 6) Form into oval shaped croquettes, dip in egg and dredge in bread crumbs. | 7) Deep fry in hot oil, and drain on paper towels. | 8) This recipe can be made with practically anything, fish, chicken, ham, vegetables (spinach is lovely).", "tags": ["poultry", "vegetable", "meat", "spanish", "european", "30 mins", "deep fried", "easy", "inexpensive"], "cook_time_min": 20, "servings": null, "cuisine": ["All"], "rating_avg": 3.8, "rating_count": 15, "popularity_score": 4.1576, "nutrition_calories": 284.1, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/31/79/3/vJFc0J26RRaJhPyyX6Ok_IMG_3357-salmon-croquettes.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["poultry", "vegetable", "meat", "spanish", "european", "30 mins", "deep fried", "easy", "inexpensive"], "ingredients": []}, {"recipe_id": "rec_77", "props": {"title": "Sauerkraut Balls", "instructions": "[Instructions] 1) Cook sausage and onion until meat is brown. | 2) Drain. | 3) Add sauerkraut and 2 T bread crumbs to the mixture. | 4) Combine cream cheese,parsley, mustard, garlic salt and pepper. | 5) Add to sauerkraut mixture. | 6) Chill one hour. | 7) Form into small balls and coat with flour. | 8) Dip in egg-milk mixture and roll in bread crumbs. | 9) Fry in deep fat until brown (can be frozen at this point) -- OR -- bake in a 375 degree oven for 15-20 minutes SERVE HOT.", "tags": ["pork", "vegetable", "meat", "weeknight", "oven", "deep fried", "4 hours", "easy"], "cook_time_min": 15, "servings": null, "cuisine": ["All"], "rating_avg": 4.6, "rating_count": 17, "popularity_score": 4.634814814814815, "nutrition_calories": 325.5, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/13/70/0/mwAveJyhTi34GDgqSccO_0S9A3194.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["pork", "vegetable", "meat", "weeknight", "oven", "deep fried", "4 hours", "easy"], "ingredients": []}, {"recipe_id": "rec_78", "props": {"title": "Sausage Balls", "instructions": "[Instructions] 1) Allow cheese and sausage to reach room temperature. | 2) Place in mixing bowl with Bisquick and blend until smooth. (I've had great success using my hand-held electric mixer to incorporate ingredients). | 3) NOTE: Mixture will be quite dry. | 4) Line a cookie sheet with aluminum foil. | 5) Spray well with vegetable oil spray. | 6) Press/roll mixture into 1 inch balls by hand; place on cookie sheet about 1 inch apart. | 7) Bake in 400 degree Fahrenheit oven for 10 to 12 minutes, or until golden brown. | 8) Drain on paper toweling. | 9) Serve warm with Versatile Mustard Dip (Recipe ).", "tags": ["pork", "meat", "high protein", "high in", "christmas", "thanksgiving", "15 mins", "for large groups", "easy"], "cook_time_min": 10, "servings": null, "cuisine": ["All"], "rating_avg": 4.54, "rating_count": 178, "popularity_score": 4.548191489361702, "nutrition_calories": 82.2, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/46/07/8/skZUmjWtRVqTrNGCPPLJ_1sausauge.1%20(1%20of%201).jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["pork", "meat", "high protein", "high in", "christmas", "thanksgiving", "15 mins", "for large groups", "easy"], "ingredients": []}, {"recipe_id": "rec_79", "props": {"title": "Shrimp and Bacon Presents", "instructions": "[Instructions] 1) Preheat oven to 375 degrees F. Line a baking sheet with parchment paper; set aside. | 2) Heat oil in a large nonstick skillet over medium high heat. Season shrimp with salt and pepper, then saut\u00e9 until pink and cooked through, about 1-2 minutes per side. Drain on a towel-lined plate; set aside. | 3) Working with 1 phyllo sheet at a time and keeping the rest covered with a towel until ready to use, lay sheet out on a clean, dry work surface. Brush lightly with melted butter, then use a sharp knife to cut the sheet into quarters. Place one sheet on top of the other, making 2 doubled-up squares. | 4) Place a shrimp in the center of each square, top with a piece of cream cheese, then a teaspoon of bacon, 1/2 teaspoon chives, and season with salt and pepper. Pull up the corners, gently twist together, use a chive to tie around purses and place on prepared baking sheet. Brush the purse lightly with butter. Repeat with remaining ingredients. | 5) Bake purses for 10-12 minutes until golden and crisp.", "tags": ["for large groups"], "cook_time_min": 15, "servings": null, "cuisine": ["All"], "rating_avg": null, "rating_count": 0, "popularity_score": null, "nutrition_calories": 116.2, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/53/40/25/CxwdDGgQ0uB39Mc2afI9_0287840_GK_Next-Level-Eats-300-Shrimp-%26-Bacon-Presents-4x3_V8.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["for large groups"], "ingredients": []}, {"recipe_id": "rec_80", "props": {"title": "Shrimp Fried Rice Cups", "instructions": "[Instructions] 1) Preheat the oven to 400 degrees F. Spray a 12-cup muffin tin with nonstick cooking spray. | 2) Heat the canola oil in a large skillet or wok over medium-high heat. Add the onions, peppers and carrots and cook, stirring occasionally, until softened and slightly charred, 3 to 5 minutes. Stir in the peas and bean sprouts and cook another 2 minutes. Transfer to a large bowl and stir in the rice, scallions, chopped shrimp, soy sauce, sesame oil, eggs, flour, a pinch red pepper flakes and salt. | 3) Spoon the rice mixture into the wells of the muffin tin, filling to the top and pressing gently with the back of a spoon. Top each with a whole shrimp and sprinkle the shrimp with salt and a pinch red pepper flakes. Bake until sides of the cups are golden and the shrimp is cooked through, 20 to 24 minutes. | 4) Let sit 5 minutes, then remove the rice cups with a small offset spatula and top with sliced scallions. Serve with soy sauce for drizzling.", "tags": ["healthy", "60 mins"], "cook_time_min": 1, "servings": null, "cuisine": ["All"], "rating_avg": 5.0, "rating_count": 3, "popularity_score": 4.764615384615385, "nutrition_calories": 147.4, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/53/85/39/TWp7YbCVQRq6sLNOO6Ud_0S9A0381.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["healthy", "60 mins"], "ingredients": []}, {"recipe_id": "rec_81", "props": {"title": "Shrimp Wonton Cups", "instructions": "[Instructions] 1) Set oven to 350 degrees. | 2) Lightly spray mini-muffin pan with non-stick cooking spray. | 3) With a a pastry brush, brush one side of each wonton wrapper with melted butter. | 4) Press wonton buttered side up into muffin cup; bake 8 minutes, or until edges turn a light golden brown. | 5) Remove the pan from oven. | 6) Meanwhile, reserve 24 shrimp. | 7) Finely chop remaining shrimp. | 8) Combine the cream cheese, garlic, Worcestershire sauce in a bowl; blend well. | 9) Stir in chopped shrimp, green onions, carrot and Mozarella cheese. | 10) Using a small scoop, fill each wonton cup with a rounded scoop of cream cheese mixture; top with reserved shrimp. | 11) Bake for 5 minutes, or until wontons are golden brown, and the filling is bubbly around the edges. | 12) Delicious!", "tags": ["easy"], "cook_time_min": 18, "servings": null, "cuisine": ["All"], "rating_avg": 4.31, "rating_count": 15, "popularity_score": 4.4636, "nutrition_calories": 71.1, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/83/25/5/Uq42K5GTaw3qjbueqEpw_shrimp-wonton-cups-6220.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["easy"], "ingredients": []}, {"recipe_id": "rec_82", "props": {"title": "Sizzling Spanish Garlic Prawns - Tapas Style", "instructions": "[Instructions] 1) Heat the oven to 220C/fan 200C/gas 7. | 2) Preparing prawns:To butterfly the prawns simply slit the prawns lengthways but don't go all the way through and remove the vein. | 3) Divide the prawns, garlic, chilli or pimenton, sherry and olive oil between 6 small ovenproof dishes or use 1 large one. | 4) Cook for 8 - 12 minutes, depending on the size of the dish or dishes, or until pink and sizzling. | 5) Sprinkle with the parsley and serve with crusty bread & lemon wedges.", "tags": ["spanish", "portuguese", "european", "very low carbs", "summer", "spicy", "savory", "15 mins", "easy"], "cook_time_min": 8, "servings": null, "cuisine": ["All"], "rating_avg": 4.83, "rating_count": 6, "popularity_score": 4.745, "nutrition_calories": 199.2, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/22/93/63/MmIa0VUkSYqhgWzKBpjI_IMG_7198.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["spanish", "portuguese", "european", "very low carbs", "summer", "spicy", "savory", "15 mins", "easy"], "ingredients": []}, {"recipe_id": "rec_83", "props": {"title": "Sloppy Joe Sliders", "instructions": "[Instructions] 1) Heat oil in a large pot. Saute onions 3 minutes until tender. | 2) Add ground beef to pot. Cook until brown, stirring to separate meat. Drain well. | 3) Stir in BBQ sauce (or Ketchup), mustard and Worcestershire. | 4) Simmer about 5 minutes until flavors are blended. | 5) Spoon onto slider rolls.", "tags": ["meat", "healthy", "potluck", "weeknight", "30 mins"], "cook_time_min": 15, "servings": null, "cuisine": ["All"], "rating_avg": 5.0, "rating_count": 3, "popularity_score": 4.764615384615385, "nutrition_calories": 518.6, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/41/08/61/CAlvWlNWQ4u3RClsfelF_IMG_0277.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["meat", "healthy", "potluck", "weeknight", "30 mins"], "ingredients": []}, {"recipe_id": "rec_84", "props": {"title": "Smoked Salmon Spread", "instructions": "[Instructions] 1) Puree the cream cheese, sour cream, lemon juice and tabasco in a food processor. | 2) Add the scallions, capers, salmon, chopped dill and pepper, and pulse to blend. | 3) Garnish with the dill and serve chilled or at room temperature with crackers.", "tags": ["very low carbs", "15 mins", "easy"], "cook_time_min": 10, "servings": null, "cuisine": ["All"], "rating_avg": 4.92, "rating_count": 65, "popularity_score": 4.889866666666667, "nutrition_calories": 809.8, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/83/12/3/pice3CylX.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["very low carbs", "15 mins", "easy"], "ingredients": []}, {"recipe_id": "rec_85", "props": {"title": "Spanakopita (Greek Spinach Pie)", "instructions": "[Instructions] 1) Heat 4 tablespoons of olive oil in a large saucepan and saut\u00e9 the onions and leek until translucent, about 2-3 minutes. Add the spinach and saute until the leaves have wilted and the liquid has cooked off, about 8-10 minutes. | 2) Remove the pan from the heat and allow to cool somewhat. When cool enough to handle, finely chop the spinach and place in a large bowl. | 3) Preheat the oven to 375\u00b0F. | 4) Lightly oil (always use olive oil!) a 12 inch in diameter, metal baking pan (you can use a larger baking pan - you will just have a thinner pita, but don't use a smaller one), or a 10 x 15 inch rectangular baking pan. | 5) Add dill and feta cheese to the spinach. Add salt and pepper to taste (careful with the salt - the feta will add quite a bit of its own). Pour the eggs over and give a stir to combine well. | 6) Open up the phyllo pastry and place on a work surface. If using the country style pastry proceed, if using the thinner phyllo; cover with a damp cloth. (Continue to cover the pastry sheets with the damp cloth each time you remove one as you prepare the pie.). | 7) Layer the phyllo in the pan, allowing the edges to hang over the sides of the pan, brushing each phyllo layer generously with olive oil. | 8) Use up half the phyllo sheets to make the bottom pastry layer, allowing excess pastry to drape over edge of pan. | 9) Put the spinach mixture in and press the top down gently to smooth filling. Tuck in the pastry draping over the edges. | 10) Repeat layering with the remaining phyllo, oiling each sheet generously. | 11) Using a sharp knife, score the upper layers of pastry into the size pieces you will want to serve once the pie is baked- BE CAREFUL NOT TO CUT THROUGH BOTTOM PASTRY. | 12) Bake the pie in the middle of the oven for approximately 40-45 minutes until it is golden brown. For the last 15-20 minutes, I put my baking pan directly on the oven floor to crisp it better. | 13) Cool till just warm (we never, but never eat this hot! The flavours just wouldn't come through properly). Cut into serving pieces and serve either just warm or at room temperature. | 14) Note: If my spinach filling appears to be too 'wet', I often take 2 of the phyllo sheets and use them as a 'layer' between the spinach filling; these sheets absorb the extra liquid (they must not be brushed with oil). | 15) It's also worth noting that Greeks love their olive oil! I have used olive oil with a lighter hand than most Greeks in this recipe - but it may still be too much for you. Feel free to add the amount you feel most comfortable with, but be aware that flavour may be compromised.", "tags": ["spinach", "cheese", "greens", "vegetable", "greek", "european", "kid friendly", "christmas", "brunch", "for large groups", "oven", "4 hours"], "cook_time_min": 45, "servings": null, "cuisine": ["All"], "rating_avg": 4.74, "rating_count": 82, "popularity_score": 4.735, "nutrition_calories": 263.1, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/84/77/0/IZJNQhMVT62fUfV9B2OC_Spanakopita%20Greek%20Spinach%20Pie_final_3.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["spinach", "cheese", "greens", "vegetable", "greek", "european", "kid friendly", "christmas", "brunch", "for large groups", "oven", "4 hours"], "ingredients": []}, {"recipe_id": "rec_86", "props": {"title": "Spicy Sausage Won Ton Appetizer", "instructions": "[Instructions] 1) Preheat oven to 350 degrees. | 2) Press won tons into muffin or mini cup cake pans and bake 3-4 minutes, until stiff. | 3) Remove won tons & place on cookie sheet. | 4) Combine all ingredients. | 5) Spoon onto cooked won ton. | 6) Bake 3-5 minutes until cheese is bubbly. | 7) Enjoy!", "tags": ["inexpensive"], "cook_time_min": 10, "servings": null, "cuisine": ["All"], "rating_avg": 5.0, "rating_count": 3, "popularity_score": 4.764615384615385, "nutrition_calories": 88.3, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/27/71/11/w5P4ocyTT6t97G5gHdO2_IMG_0372.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["inexpensive"], "ingredients": []}, {"recipe_id": "rec_87", "props": {"title": "Spinach and Artichoke Wreath(Pampered Chef Copycat)", "instructions": "[Instructions] 1) Preheat oven to 375*F. | 2) In bowl, combine artichokes, spinach, mozzarella cheese, feta cheese(or Parmesan, red bell pepper, mayonnaise, garlic and black pepper. Mix well. Set aside. | 3) Unroll the 2 packages of crescent rolls onto work surface. Separate into 16 triangles in a circle on a large round pizza pan(or baking stone) with wide ends 3\" from edge of pan and points towards the outside. Points will extend off the edge of the baking stone or pan(depending on size). | 4) Arrange remaining triangles in center of baking stone or pan; matching wide ends with triangles already in place Points will overlap in the center. | 5) Using rolling pin, roll over seams of triangles where the wide ends meet, creating a smooth surface for filling. Do not seal center triangles. | 6) Using an ice cream scoop, scoop filling evenly over dough in a continuous circle. | 7) Beginning with the last triangle placed in center of baking stone or pan, bring point of triangle straight across filling. | 8) Next, bring point of opposite outside triangle diagonally across point of previous triangle. The filling will show. | 9) Repeat, overlapping points of inside and outside triangles to form a wreath. Tuck last end under first. | 10) Brush top of wreath with egg white. Sprinkle with grated Parmesan cheese. | 11) Bake 25-30 minutes or until golden brown. Enjoy!.", "tags": ["cheese", "vegetable", "greek", "european", "60 mins"], "cook_time_min": 25, "servings": null, "cuisine": ["All"], "rating_avg": 4.86, "rating_count": 8, "popularity_score": 4.767777777777778, "nutrition_calories": 327.0, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/32/19/15/v14oc52mRZSyZn8nmPEA_SPINACH%20%26%20ARTICHOKE%20WREATH.jpeg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["cheese", "vegetable", "greek", "european", "60 mins"], "ingredients": []}, {"recipe_id": "rec_88", "props": {"title": "Spinach Artichoke Wontons", "instructions": "[Instructions] 1) Preheat oven to 375F and place rack in upper third of oven. | 2) Heat oil in a skillet over medium heat, add onion and shallots, sauteing for about 4 minutes or until softened. | 3) Add garlic and saute for 30 seconds, then remove mixture from heat to a bowl, set aside. | 4) In a food processor, process cream cheese, mayonnaise, artichoke hearts and cayenne until smooth. | 5) Put cream cheese mixture in a medium bowl, and add onion mix, spinach, and asiago, mixing well to combine. | 6) Taste and add salt if needed. Mine didn't need any with the brined artichokes and the cheese. | 7) Lay out 24 wonton wrappers on counter and place about 1 heaping teaspoon of mixture on each wonton. | 8) Wet edges of wontons with water, fold in half to make triangles, pressing edges together so they stick. | 9) Place on a baking sheet lightly sprayed with cooking spray and bake for 10 minutes, until bottoms and edges are beginning to brown, turn over and continue to bake for about 4 more minutes or until both sides are crisped and slightly browned. | 10) Serve right out of the oven.", "tags": ["greens", "vegetable", "60 mins", "oven", "stove top"], "cook_time_min": 15, "servings": null, "cuisine": ["All"], "rating_avg": 5.0, "rating_count": 5, "popularity_score": 4.795999999999999, "nutrition_calories": 50.1, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/28/30/92/ygFXeE7lTiCVKCEfYY7w_spinach-artichoke-wontons-7848.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["greens", "vegetable", "60 mins", "oven", "stove top"], "ingredients": []}, {"recipe_id": "rec_89", "props": {"title": "Spinach Balls", "instructions": "[Instructions] 1) In a large bowl, combine all ingredients until well mixed. | 2) Roll into 2 inch, walnut-sized balls. | 3) Chill in the refrigerator for 2 hours. | 4) Place on an ungreased cookie sheet and bake at 350\u00baF for 20 minutes.", "tags": ["spinach", "cheese", "greens", "vegetable", "toddler friendly", "kid friendly", "brunch", "oven", "refrigerator", "beginner cook", "4 hours", "easy", "inexpensive"], "cook_time_min": 20, "servings": null, "cuisine": ["All"], "rating_avg": 4.65, "rating_count": 31, "popularity_score": 4.6607317073170735, "nutrition_calories": 287.3, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/14/63/71/Kv6BrY4GT8qgfOlymHI7_untitled-2626.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["spinach", "cheese", "greens", "vegetable", "toddler friendly", "kid friendly", "brunch", "oven", "refrigerator", "beginner cook", "4 hours", "easy", "inexpensive"], "ingredients": []}, {"recipe_id": "rec_90", "props": {"title": "Bread Bowl Spinach Dip", "instructions": "[Instructions] 1) Mix first four ingredients well and refrigerate 6 hours. | 2) Create cavity inside french or sour dough bread loaf. | 3) Reserve pieces for dip. | 4) Fill the cavity with Spinach Dip. | 5) Makes 2 cups.", "tags": ["weeknight", "refrigerator", "easy"], "cook_time_min": 6, "servings": null, "cuisine": ["All"], "rating_avg": 5.0, "rating_count": 38, "popularity_score": 4.936249999999999, "nutrition_calories": 84.9, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/43/92/4s8AFQhT9qYlbXYo08gj_Image0734_spinach-dip-4392.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["weeknight", "refrigerator", "easy"], "ingredients": []}, {"recipe_id": "rec_91", "props": {"title": "Stuffed Mushrooms With Roasted Red Peppers and Manchego Cheese", "instructions": "[Instructions] 1) Wipe the mushroom caps clean. Remove stems completely. | 2) Rinse the roasted red pepper. Pat dry. Slice into thin strips. | 3) Put oven rack in lower one-third of oven and preheat to 450. Line a baking sheet with foil. Toss mushroom caps with oil, salt and pepper. Lay gill side down on sheet. Roast until they release juices and shrink, about 25 minutes. | 4) Remove them from oven. Let cool slightly. When cool enough to handle, flip, fill with cheese and place a few strips of red pepper on top. (At this point, they can be covered and chilled for up to 2 days. You may need to cook them a couple extra minutes tho.). | 5) Bake until mushrooms are hot and cheese is melted and bubbling, about 20 minutes. Remove to serving platter. Sprinkle with parsley and let sit for 5 minutes before serving.", "tags": ["spanish", "european", "60 mins"], "cook_time_min": 35, "servings": null, "cuisine": ["All"], "rating_avg": 4.75, "rating_count": 4, "popularity_score": 4.71, "nutrition_calories": 14.1, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/36/98/95/bL11QUvPRwWTNFOH8f8C_manchego-stuffed-mushrooms-6003.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["spanish", "european", "60 mins"], "ingredients": []}, {"recipe_id": "rec_92", "props": {"title": "Sun-Dried Tomato, Mozzarella and Basil Rice Balls", "instructions": "[Instructions] 1) Pour the stock into a large saucepan. Bring to the boil. Add the rice, cover and simmer for 15-20 minutes, until the rice is cooked through and the liquid has been absorbed. | 2) Meanwhile, finely chop the basil leaves. Finely dice the yellow pepper. Peel and finely dice the onion. Set aside, keeping the basil separate from the onion and pepper. | 3) When the rice is done, uncover it and put the whole pan in a sink of cold water to cool the rice. | 4) While the rice cools, put the olive oil and onion in a large skillet over medium heat. Cook for 2-3 minutes. Then add the yellow pepper and garlic. Cook around 5 minutes, until soft. | 5) Add the passata to the skillet with the onion and pepper. Turn the heat to low. Give the passata mixture a chance to simmer and thicken slightly. | 6) While it simmers, make the rice balls- add the cheese, egg yolk, flour, tomato paste, basil leaves and sundried tomatoes to the cooled rice. Stir it together well. | 7) Shape the rice mixture into about 16 balls and place them on top of the sauce. Allow to simmer for 20 minutes, until the rice balls are cooked through. | 8) Serve hot, sprinkled with parmesan cheese if desired.", "tags": ["60 mins"], "cook_time_min": 45, "servings": null, "cuisine": ["All"], "rating_avg": 5.0, "rating_count": 1, "popularity_score": 4.721818181818181, "nutrition_calories": 717.0, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/36/70/85/gfaqXrOLSyusXhpZ5OZB_tomato-basil-rice-balls_1407.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["60 mins"], "ingredients": []}, {"recipe_id": "rec_93", "props": {"title": "Sweet Chicken Bacon Wraps (Paula Deen)", "instructions": "[Instructions] 1) Preheat oven to 350\u00b0F. | 2) Cut chicken breasts into 1-inch cubes. | 3) Cut each bacon slice into thirds. Wrap each chicken cube with bacon and secure with a wooden pick inserted on the diagonal starting where bacon seam overlaps. | 4) Stir together brown sugar and chili powder. Dredge wrapped chicken in mixture. | 5) Coat a rack and broiler pan with non-stick cooking spray. Place chicken on rack in broiler pan. | 6) Bake at 350\u00b0F for 30 to 35 minutes, or until bacon is crisp.", "tags": ["chicken", "pork", "poultry", "meat", "high protein", "kid friendly", "high in", "60 mins", "oven", "beginner cook", "easy"], "cook_time_min": 35, "servings": null, "cuisine": ["All"], "rating_avg": 4.72, "rating_count": 177, "popularity_score": 4.718609625668449, "nutrition_calories": 293.8, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/14/64/27/lb8t3AMKSEuB1g7bhfa7_IMG_5255-sweet-bacon-chicken-wraps.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["chicken", "pork", "poultry", "meat", "high protein", "kid friendly", "high in", "60 mins", "oven", "beginner cook", "easy"], "ingredients": []}, {"recipe_id": "rec_94", "props": {"title": "Taco Meatball Bites", "instructions": "[Instructions] 1) Preheat oven to 400 degrees F. Line a baking sheet with parchment paper; set aside. | 2) In a large bowl, combine ground beef, taco seasoning, tomato paste, 2 tablespoons chopped chilis, egg, breadcrumbs and chopped cilantro. Form into 2-inch meatballs and place on prepared baking sheet. | 3) Bake for 15-20 minutes until cooked through. Remove and place each meatball in a corn chip scoop. Drizzle with queso, and top with guacamole, pico de gallo and chopped cilantro. Serve with a side of sour cream. | 4) For the Queso:. | 5) In a large bowl, toss to combine cheddar cheese, pepper jack cheese and cornstarch. In a medium saucepan, bring milk to a simmer. Whisk in cheeses and chopped chilis. Bring to a simmer to thicken, about 1-2 minutes.", "tags": ["mexican", "30 mins"], "cook_time_min": 20, "servings": null, "cuisine": ["All"], "rating_avg": null, "rating_count": 0, "popularity_score": null, "nutrition_calories": 528.2, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/53/74/81/ve5tPcQ5SZqKlQhBXzla_0S9A7120.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["mexican", "30 mins"], "ingredients": []}, {"recipe_id": "rec_95", "props": {"title": "Texas Best Cheese Dip (Chile Con Queso)", "instructions": "[Instructions] 1) Melt cheeses together in microwave or on stove top. | 2) Stir in all other ingredients. | 3) Serve warm.", "tags": ["cheese", "microwave", "30 mins", "for large groups", "stove top", "easy"], "cook_time_min": 10, "servings": null, "cuisine": ["All"], "rating_avg": 4.78, "rating_count": 38, "popularity_score": 4.762083333333333, "nutrition_calories": 165.8, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/54/84/5/lqEwccSLygUMPjsK2QbQ_1.queso.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["cheese", "microwave", "30 mins", "for large groups", "stove top", "easy"], "ingredients": []}, {"recipe_id": "rec_96", "props": {"title": "The Original Chex Party Mix", "instructions": "[Instructions] 1) Heat oven to 250 degrees. | 2) Melt butter in large roasting pan in oven. Stir in seasonings. Gradually stir in remaining ingredients until evenly coated. | 3) Bake 1 hour, stirring every 15 minutes. Spread on paper towels to cool. Store in airtight container.", "tags": ["for large groups", "4 hours", "easy"], "cook_time_min": 1, "servings": null, "cuisine": ["All"], "rating_avg": 4.77, "rating_count": 39, "popularity_score": 4.754489795918367, "nutrition_calories": 142.6, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/12/80/94/wypaq6rhTC61YyTDCRVu_original-chex-mix-5948.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["for large groups", "4 hours", "easy"], "ingredients": []}, {"recipe_id": "rec_97", "props": {"title": "Toasted Ravioli", "instructions": "[Instructions] 1) Cook ravioli in boiling salted water until they float to the top; remove from water and drain. | 2) Set aside to cool. | 3) Heat vegetable oil in fryer at least 2\" deep to a temperature of 375 degrees. | 4) Dip ravioli in beaten egg, then cover in breadcrumbs. | 5) Fry in batches in hot oil until golden brown, about 5 minutes; drain. | 6) Sprinkle hot ravioli with parmesan cheese. | 7) Heat marinara sauce and set aside in serving bowl. | 8) Serve ravioli with dipping sauce.", "tags": ["meat", "european", "kid friendly", "thanksgiving", "15 mins", "beginner cook", "deep fried", "stove top", "easy", "inexpensive"], "cook_time_min": 5, "servings": null, "cuisine": ["All"], "rating_avg": 4.79, "rating_count": 104, "popularity_score": 4.781578947368422, "nutrition_calories": 25.1, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/26/82/0/6BvTCUPeTIqIypacuCY1_TR%205%20-%20final_3.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["meat", "european", "kid friendly", "thanksgiving", "15 mins", "beginner cook", "deep fried", "stove top", "easy", "inexpensive"], "ingredients": []}, {"recipe_id": "rec_98", "props": {"title": "Tomato and Basil Bruschetta", "instructions": "[Instructions] 1) Whisk together chopped garlic, vinegar, salt, pepper, and basil. | 2) When combined slowly drizzle in oil. | 3) Add tomatoes and let sit for 20 minutes at room temp. | 4) Meanwhile back at the bat cave, toast the bread. | 5) This can be done either in the toaster (if it's got really wide slots) or under the broiler (if using this method watch closely so it doesn't become a brickette). | 6) When the bread is toasted rub each piece, on one side, with the whole garlic pieces. | 7) Place the bread on a cookie sheet and top with tomato mixture. | 8) Sprinkle on a little cheese and broil till the cheese melts (you can skip that last broiling bit and it's equally as wonderful). | 9) Serve immediately. | 10) The tomato mixture also makes a wonderful vinegrette for an antipasto salad. | 11) Enjoy!", "tags": ["european", "low cholesterol", "60 mins", "easy"], "cook_time_min": 35, "servings": null, "cuisine": ["All"], "rating_avg": 4.91, "rating_count": 214, "popularity_score": 4.900357142857144, "nutrition_calories": 232.8, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/44/23/2/AzjouSK8QBSapWby5N0N_TBB%205%20-%20final_2.png"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["european", "low cholesterol", "60 mins", "easy"], "ingredients": []}, {"recipe_id": "rec_99", "props": {"title": "Turkey and Spinach Bites", "instructions": "[Instructions] 1) Preheat oven to 400 degrees F. Prepare two muffin tins (for a total of 24 pieces) by spraying with cooking spray and line each tin with parchment paper cups. | 2) In a frying pan on medium heat, heat olive oil in a large skillet and add onion, garlic, salt, pepper, thyme, oregano, and red pepper flakes. Saut\u00e9 until onion is tender (about 5-6 minutes total time). | 3) Add spinach to pan and combine with onion mixture. Add Worcestershire sauce and chicken broth and mix well to combine. Cook until most of the liquid has reduced and the mixture is totally solid. Remove from heat and allow to cool to room temperature. | 4) In a large bowl, combine the turkey, 3/4 cup of the bread crumbs, and egg. Combine with your hands and then add in the spinach mixture. Mix to combine. | 5) Spoon the mixture into the muffin tins nearly to the top of each tin, and gently smooth down surface. Sprinkle with remaining bread crumbs and bake until cooked through with an internal temperature of 160 degrees F - about 20-25 minutes. Remove from oven and let cool slightly before piping or dolloping small mounds of mashed potato on top.", "tags": [], "cook_time_min": 45, "servings": null, "cuisine": ["All"], "rating_avg": null, "rating_count": 0, "popularity_score": null, "nutrition_calories": 242.2, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/53/41/98/YoZRRd1yR2WSZeNDWH3k_V2-2.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": [], "ingredients": []}, {"recipe_id": "rec_100", "props": {"title": "Unbelievable Baked Buffalo Wings", "instructions": "[Instructions] 1) Fill a large pot half way with water and then add the first 4 ingredients. | 2) Bring water mixture and wings to a boil and then boil for 30 minutes. | 3) Transfer wings to an oven safe container coated with cooking spray. Bake wings on \"Broil\" (high) for 15 minutes on each side.(For crispier wings, cook longer on each side, maybe 20 minutes per side). | 4) While waiting for wings, combine the Hot Sauce and Margarine in a microwave safe container and cook in microwave for 2 minutes or until melted. (You can cook the sauce longer for a thicker sauce). | 5) When wings are done, shake 'em up with the sauce and enjoy!", "tags": ["poultry", "meat", "very low carbs", "spicy", "60 mins", "oven", "easy"], "cook_time_min": 30, "servings": null, "cuisine": ["All"], "rating_avg": 4.84, "rating_count": 186, "popularity_score": 4.832551020408164, "nutrition_calories": 570.5, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/15/50/21/hikO3r8IQLGS3aCiI5Mc_DSC_0063.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["poultry", "meat", "very low carbs", "spicy", "60 mins", "oven", "easy"], "ingredients": []}, {"recipe_id": "rec_101", "props": {"title": "Wonderful Parmesan Zucchini Strips", "instructions": "[Instructions] 1) Preheat oven to 450 degrees. | 2) In a bowl, combine bread crumbs and cheese topping. | 3) Dip zucchini strips into egg, then into crumb mixture. | 4) Place on baking sheet coated with nonstick cooking spray. | 5) Bake at 450 degrees for 20-25 minutes or until golden brown and tender.", "tags": ["vegetable", "summer", "60 mins", "oven", "easy"], "cook_time_min": 25, "servings": null, "cuisine": ["All"], "rating_avg": 4.73, "rating_count": 67, "popularity_score": 4.725324675324675, "nutrition_calories": 103.1, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/99/08/6/bbXGh5liQuOmptceL1Ld_parmesan-zucchini-strips-4164.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["vegetable", "summer", "60 mins", "oven", "easy"], "ingredients": []}, {"recipe_id": "rec_102", "props": {"title": "Yummy Baked Potato Skins", "instructions": "[Instructions] 1) Cut potatoes in half lengthwise; scoop out pulp and discard (or save for another use) leaving 1/4-inch shell. | 2) Place on a greased baking sheet. | 3) Combine oil, Parmesan cheese, salt, garlic powder, paprika and pepper and brush all over potato skins. | 4) Bake at 475\u00b0 for about 8 minutes and turn over. | 5) Bake for another 8 minutes or so and then turn right side up. | 6) Sprinkle bacon and cheddar evenly inside of skins. | 7) Bake 2 minutes longer or until cheese is melted. | 8) Top with sour cream and onions, if desired.", "tags": ["pork", "potato", "cheese", "vegetable", "meat", "kid friendly", "potluck", "60 mins", "oven", "easy"], "cook_time_min": 18, "servings": null, "cuisine": ["All"], "rating_avg": 4.91, "rating_count": 172, "popularity_score": 4.898131868131868, "nutrition_calories": 263.9, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/43/90/8/xbeEgrNvSHyJVxgOElLg_potato skins SITE-3.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["pork", "potato", "cheese", "vegetable", "meat", "kid friendly", "potluck", "60 mins", "oven", "easy"], "ingredients": []}, {"recipe_id": "rec_103", "props": {"title": "Zucchini Bites", "instructions": "[Instructions] 1) Heat the oil in a large pan and saut\u00c3\u00a9 onion until translucent. Add the bacon and fry until it starts to colour. Add the carrot and zucchini and cook for about 2 minutes. | 2) Transfer mixture to a bowl to cool. | 3) Beat the eggs, cream and cheese together; season to taste. | 4) Stir the egg mixture into the cooled zucchini mixture. Stir in the flour. | 5) Grease and flour little muffin/bun tins. Spoon mixture into the holes. | 6) Bake at 180\u00c2\u00b0C/350\u00c2\u00b0F/Gas 4 for 15-20 minutes.", "tags": ["cheese", "vegetable", "australian", "european", "toddler friendly", "kid friendly", "savory", "60 mins", "oven", "beginner cook", "stove top", "easy", "inexpensive"], "cook_time_min": 20, "servings": null, "cuisine": ["All"], "rating_avg": 4.72, "rating_count": 95, "popularity_score": 4.717523809523809, "nutrition_calories": 51.3, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/31/42/90/gJt9pUyzSBCfWSWOj96j_Zucchini%20Bites%20314290_final%202.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["cheese", "vegetable", "australian", "european", "toddler friendly", "kid friendly", "savory", "60 mins", "oven", "beginner cook", "stove top", "easy", "inexpensive"], "ingredients": []}, {"recipe_id": "rec_104", "props": {"title": "All-Star Breakfast Rice", "instructions": "[Instructions] 1) Combine rice, milk, brown sugar and cinnamon in small saucepan. Cook over medium heat until thick and creamy, about 10 minutes. | 2) Spoon into serving bowl, let cool 3 minutes. Top with fresh berries.", "tags": ["fruit", "low protein", "low cholesterol", "healthy", "brunch", "30 mins", "beginner cook", "easy", "inexpensive"], "cook_time_min": 13, "servings": null, "cuisine": ["All"], "rating_avg": 4.88, "rating_count": 8, "popularity_score": 4.776666666666666, "nutrition_calories": 400.0, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/12/22/99/bUyy2tfTTNCDORe9b5yV_untitled-0942.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["fruit", "low protein", "low cholesterol", "healthy", "brunch", "30 mins", "beginner cook", "easy", "inexpensive"], "ingredients": []}, {"recipe_id": "rec_105", "props": {"title": "Amazing and Easy Basic Crepes", "instructions": "[Instructions] 1) In medium bowl, beat eggs slightly. | 2) Add remaining ingredients and beat until smooth. | 3) (Batter may be covered and refrigerated up to 2 hours or cooked immediately). | 4) Heat crepe pan or 7 or 8-inch skillet over medium-high heat (375*F). | 5) A few drops of water sprinkled on the pan sizzle and bounce when heat is just right. | 6) Grease pan lightly. | 7) Pour about 3 tablespoons batter into pan, tilting pan to spread evenly. | 8) When crepe is light brown and set, turn to brown other side. | 9) Remove from pan. | 10) Repeat with remaining batter to make about 14 crepes; stack cooked crepes. | 11) Fill crepes with desired filling or cool, wrap and refrigerate up to 2 days. | 12) FOR DESSERT CREPES, add 2 tablespoons sugar to batter. | 13) To freeze, layer crepes with 2 sheets of waxed paper; wrap and store up to 3 months.", "tags": ["dessert", "danish", "swedish", "scandinavian", "european", "toddler friendly", "kid friendly", "sweet", "brunch", "60 mins", "for large groups", "beginner cook", "stove top", "easy", "inexpensive"], "cook_time_min": 25, "servings": null, "cuisine": ["All"], "rating_avg": 5.0, "rating_count": 7, "popularity_score": 4.82, "nutrition_calories": 85.0, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/24/90/42/sMn5uPOUTeyXvliAe7Zr_basic-crepes-4.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["dessert", "danish", "swedish", "scandinavian", "european", "toddler friendly", "kid friendly", "sweet", "brunch", "60 mins", "for large groups", "beginner cook", "stove top", "easy", "inexpensive"], "ingredients": []}, {"recipe_id": "rec_106", "props": {"title": "Artichoke Dip Breakfast Sandwiches", "instructions": "[Instructions] 1) Preheat oven to 350 degrees. Spray a 9x13 baking dish with nonstick spray and line with parchment, leaving the sides overhanging. Spray parchment. | 2) In a large bowl, whisk to combine the eggs, milk, salt and pepper. Pour into the prepared dish and bake until eggs are set, about 20 minutes. Remove from oven and set aside. | 3) In a medium bowl, stir to combine the cream cheese and sour cream until smooth. Fold in the parmesan cheese, spinach and artichokes and season with salt and pepper. | 4) Use a serrated knife to cut the rolls in half horizontally, then place bottom half in a 9x13 baking dish. Top the bread with the spinach artichoke dip, then shredded mozzarella. Turn the eggs out of the pan on top of the cheese, then top with the ham. Place the top half of the bread over the ham and brush with melted butter. | 5) Bake until the cheeses are melted and the tops are golden, about 20-25 minutes. Cut the bread into sandwiches and serve.", "tags": ["lunch snacks", "60 mins"], "cook_time_min": 40, "servings": null, "cuisine": ["All"], "rating_avg": null, "rating_count": 0, "popularity_score": null, "nutrition_calories": 302.2, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/53/86/58/lK4CLygzQHKfb8IEQbXx_0S9A1859.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["lunch snacks", "60 mins"], "ingredients": []}, {"recipe_id": "rec_107", "props": {"title": "Bacon and Egg Breakfast Baskets", "instructions": "[Instructions] 1) Cut a slice from the top of each bun reserving the tops. | 2) Hollow out each bun, being careful to leave a thick shell. | 3) Saute bacon and onion in pan; place on absorbent paper to drain off any excess oil. | 4) Melt the butter in a saucepan; stir in the Worcestershire sauce. | 5) Brush the inside of buns with the half the butter mixture. | 6) Carefully break an egg into each bun. | 7) Spoon bacon and onion mixture over eggs. | 8) Season eggs; top with grated cheese; replace the bun lids. | 9) Brush each of the bun lids with the remaining butter. | 10) Bake in oven at 200 degree Celsius (400 degrees Fahrenheit) for 15 minutes or until eggs have cooked.", "tags": ["cheese", "high in", "60 mins"], "cook_time_min": 25, "servings": null, "cuisine": ["All"], "rating_avg": 5.0, "rating_count": 6, "popularity_score": 4.80875, "nutrition_calories": 437.7, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/21/47/98/dcmnlckcTIKCNg5QIU3h_DSC_0183.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["cheese", "high in", "60 mins"], "ingredients": []}, {"recipe_id": "rec_108", "props": {"title": "Bacon and Hash Browns Casserole", "instructions": "[Instructions] 1) Preheat oven to 350\u00b0. | 2) Combine turkey gravy, 1/2 cup cheese, onions, pepper, potatoes, and sour cream. Spoon into a shallow 1-quart casserole coated with cooking spray. | 3) Bake at 350\u00b0 for 35 minutes. Sprinkle with 1/4 cup cheese and bacon. Bake an additional 5 minutes or until the cheese melts.", "tags": ["pork", "potato", "vegetable", "meat", "60 mins", "oven", "easy"], "cook_time_min": 40, "servings": null, "cuisine": ["All"], "rating_avg": 4.17, "rating_count": 6, "popularity_score": 4.4975, "nutrition_calories": 198.2, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/25/46/17/nBIHvqhxQCQQWZXHiag6_DSC05151-2.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["pork", "potato", "vegetable", "meat", "60 mins", "oven", "easy"], "ingredients": []}, {"recipe_id": "rec_109", "props": {"title": "Bacon, Egg and Cheddar Scones", "instructions": "[Instructions] 1) Note before you get started: Shredding or cubing the cheese depends on personal preference; the shredded blends into the pastry, but the cubed leaves little chunks of cheese throughout. I'm a Libra, so I do both. (shred half and cube half,-) | 2) Preheat the oven to 450\u00b0F (230\u00b0C). Lightly butter a baking sheet or line it with parchment paper. | 3) Sift the flour, baking powder, and salt together. Place in either a medium bowl or the work bowl of a food processor fitted with a steel blade. Cut the butter into the flour so that it is completely incorporated, using two knives, a pastry blender, your hands, or food processor until incorporated. | 4) Beat 2 of the raw eggs and the cream together and add to the dry ingredients. Mix or process just to incorporate the eggs into the flour and butter; do not overmix. Dump the flour-and-butter mixture into a clean bowl. | 5) Fold the cheese, scrambled eggs, and bacon into the flour mixture. It will be sticky and chunky. Stir and knead the dough as little as possible while distributing the cheese, scrambled eggs, and bacon throughout. | 6) Transfer the dough to a well-floured work surface. Pat the dough into a rectangle about 12 x 4 x 3/4 inch high. Cut the dough into three 4-inch squares. Cut the squares on the diagonal to form six triangles. Place the scones at least 1 inch apart on the baking sheet. | 7) Beat the remaining 1 egg with 2 tablespoons water and use this wash to brush the tops of the scones. | 8) Bake for 10 to 12 minutes, or until golden brown. Remove and serve warm.", "tags": ["quick breads", "breads", "breakfast", "pork", "cheese", "meat", "kid friendly", "high in", "brunch", "60 mins", "oven"], "cook_time_min": 12, "servings": null, "cuisine": ["All"], "rating_avg": 4.71, "rating_count": 30, "popularity_score": 4.706, "nutrition_calories": 601.5, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/92/16/0/rnGQtqWKQCSEMX2esZ4X_Bacon%2C%20Egg%20And%20Cheddar%20Scones_final%202.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["quick breads", "breads", "breakfast", "pork", "cheese", "meat", "kid friendly", "high in", "brunch", "60 mins", "oven"], "ingredients": []}, {"recipe_id": "rec_110", "props": {"title": "Bacon, Egg and Cheese Biscuit", "instructions": "[Instructions] 1) Preheat oven to 425 degrees. | 2) Spray a 6 cup muffin tin with non-stick cooking spray and set aside. | 3) In a small bowl, beat together the eggs and milk; salt and pepper to taste. | 4) Divide the egg mixture evenly between the prepared muffin tins and place in preheated oven. | 5) Bake for 8 to 10 minutes or until eggs are set; immediately sprinkle with grated cheese. | 6) Remove from muffin tin and allow eggs to cool completely. | 7) Split the biscuits and top each with a slice of the Canadian bacon. | 8) When the eggs are cooled, place one on top of each slice of bacon. | 9) Wrap in foil and freeze until ready to enjoy. | 10) When ready to reheat, place in the refrigerator the night before, in the morning, wrap in a paper towel and reheat in the microwave at 70 percent power for 1 minute or until heated, turning after 30 seconds. | 11) Please note that the microwave times are only estimates. Each microwave is different.", "tags": ["cheese", "30 mins", "oven", "easy"], "cook_time_min": 12, "servings": null, "cuisine": ["All"], "rating_avg": 4.89, "rating_count": 10, "popularity_score": 4.792, "nutrition_calories": 341.6, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/23/73/94/02K3XFTRfqoji6twlwza_0S9A9432.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["cheese", "30 mins", "oven", "easy"], "ingredients": []}, {"recipe_id": "rec_111", "props": {"title": "Bacon and Egg Casserole", "instructions": "[Instructions] 1) Grease a 9x13 glass baking dish and set aside. | 2) Fry the bacon, drain on paper toweling, cut into 1 inch pieces. | 3) Cube the bread into 3/4 inch pieces and set aside. | 4) In a large bowl, beat the eggs. | 5) Add the milk, mustard powder, salt, and blend well. | 6) Stir in the bacon, cheese, and bread cubes. | 7) Stir well to combine. | 8) Pour the mixture into the baking dish, cover with plastic wrap, and refrigerate overnight. | 9) Preheat oven to 350\u00b0F and bake for one hour.", "tags": ["pork", "meat", "oven", "4 hours"], "cook_time_min": 1, "servings": null, "cuisine": ["All"], "rating_avg": 4.66, "rating_count": 34, "popularity_score": 4.667727272727273, "nutrition_calories": 460.4, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/83/63/4/FCiUPz3yTeaA4GWtR6hH_bacon-egg-bread-cheese-breakfast-casserole-1762.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["pork", "meat", "oven", "4 hours"], "ingredients": []}, {"recipe_id": "rec_112", "props": {"title": "Bagel French Toast Casserole", "instructions": "[Instructions] 1) Cut the bagels in half and spread evenly with the Laughing Cow Cheese. Cut each half into eights and place cut side down in an 8X8 inch pan that has been sprayed with non-stick cooking spray. | 2) In a small bowl, mix together the eggs or egg substitute, vanilla and maple syrup; pour over bagels and sprinkle with chopped pecans. | 3) Cover the dish with foil, place in refrigerator overnight. The next morning, remove from refrigerator 30 minutes prior to baking and allow to stand on counter. | 4) Preheat oven to 350 degrees and place covered dish in oven. Cook for 30 minutes, uncover, sprinkle liberally with cinnamon sugar and bake an additional 20 to 30 minutes or until center is firm and surface is lightly brown. | 5) Serve with warmed maple syrup.", "tags": ["toddler friendly", "kid friendly", "high in", "brunch", "oven", "refrigerator", "beginner cook", "4 hours", "easy"], "cook_time_min": 1, "servings": null, "cuisine": ["All"], "rating_avg": 5.0, "rating_count": 3, "popularity_score": 4.764615384615385, "nutrition_calories": 404.1, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/36/21/99/7YOiCPxdTkeIVDQ8e9w2_0S9A3939.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["toddler friendly", "kid friendly", "high in", "brunch", "oven", "refrigerator", "beginner cook", "4 hours", "easy"], "ingredients": []}, {"recipe_id": "rec_113", "props": {"title": "Bahama Mamma Breakfast Spread", "instructions": "[Instructions] 1) Combine all ingredients in small bowl. | 2) Mix well. | 3) Serve on top of toast, English muffins, waffles, bagels or fruit.", "tags": ["breakfast", "pineapple", "cheese", "tropical fruits", "fruit", "nuts", "15 mins", "no cook", "refrigerator", "easy", "inexpensive"], "cook_time_min": 5, "servings": null, "cuisine": ["All"], "rating_avg": 4.67, "rating_count": 12, "popularity_score": 4.68090909090909, "nutrition_calories": 617.9, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/48/27/9/OfVCilaT2acFev5XA9cA_bahamamama1.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["breakfast", "pineapple", "cheese", "tropical fruits", "fruit", "nuts", "15 mins", "no cook", "refrigerator", "easy", "inexpensive"], "ingredients": []}, {"recipe_id": "rec_114", "props": {"title": "Baked Honey Granola", "instructions": "[Instructions] 1) Preheat oven to 325 degrees. | 2) In a large bowl, combine oats, brown sugar, cinnamon, salt and almonds. In a glass measuring cup, warm honey in microwave for about 30 seconds. Add olive oil to the honey and stir. | 3) Drizzle the honey-oil over the dry ingredients and mix to combine. Spread the mixture on a baking sheet sprayed with Pam. | 4) Bake granola until golden and crunchy, stirring once, anywhere from 15 to 25 minutes, depending on your oven and pan. | 5) Pour onto a sheet of wax paper or parchment paper to cool. Stir in the dried fruit. When cool, store in a sealed container. If it clumps, just give it a toss.", "tags": ["lunch snacks", "grains", "camping", "60 mins", "beginner cook", "easy", "inexpensive"], "cook_time_min": 25, "servings": null, "cuisine": ["All"], "rating_avg": 4.82, "rating_count": 11, "popularity_score": 4.76, "nutrition_calories": 162.6, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/17/67/53/picsoNas4.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["lunch snacks", "grains", "camping", "60 mins", "beginner cook", "easy", "inexpensive"], "ingredients": []}, {"recipe_id": "rec_115", "props": {"title": "Baked Swiss Cheese Omelet", "instructions": "[Instructions] 1) Preheat oven to 350 degrees F. | 2) Grease a 13x9x2 inch glass baking dish. | 3) Spread the cheese over the bottom of the baking dish. | 4) Dot with butter. | 5) Pour half the heavy cream over the cheese. | 6) Add the eggs and then the remaining cream. | 7) Sprinkle with pepper. | 8) Bake for 40 to 45 minutes or until set. | 9) Serves 8.", "tags": ["cheese", "very low carbs", "60 mins", "oven", "easy"], "cook_time_min": 45, "servings": null, "cuisine": ["All"], "rating_avg": 4.92, "rating_count": 13, "popularity_score": 4.821739130434782, "nutrition_calories": 261.0, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/50/43/2/piclGkmPM.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["cheese", "very low carbs", "60 mins", "oven", "easy"], "ingredients": []}, {"recipe_id": "rec_116", "props": {"title": "Banana Bread Breakfast Bake", "instructions": "[Instructions] 1) Preheat the oven to 375\u00b0F Brush a sheet pan with the melted butter. | 2) Whisk together the eggs, milk, cream, sugar, vanilla, cinnamon, nutmeg and salt in a medium bowl. | 3) Slice the banana bread into 1/2 inch to 3/4 inch slices. | 4) Dip the slices into the egg mixture to coat and layer into the sheet pan. The bread should be slightly overlapping. | 5) Pour any remaining custard over the banana bread. | 6) Bake for 30-35 minutes, rotating the pan halfway through. | 7) Meanwhile, add the ingredients for the cream cheese glaze to a bowl. Beat with a hand mixer until creamy and combined. | 8) Drizzle the glaze over the French toast and garnish with sliced strawberries and bananas. | 9) Serve any remaining glaze on the side.", "tags": ["breads", "tropical fruits", "fruit", "european", "60 mins"], "cook_time_min": 35, "servings": null, "cuisine": ["All"], "rating_avg": null, "rating_count": 0, "popularity_score": null, "nutrition_calories": 1202.3, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/53/77/98/AwfT3QTmRRW5S5vpeyzw_banana%20bread%20french%20toast%20SITE-3.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["breads", "tropical fruits", "fruit", "european", "60 mins"], "ingredients": []}, {"recipe_id": "rec_117", "props": {"title": "Berry Cream Cheese Coffee Cake", "instructions": "[Instructions] 1) Heat oven to 350 degrees. | 2) Grease and flour bottom and sides of 9 or 10 inch springform pan. | 3) Combine flour and 3/4 cup sugar. | 4) Add the butter to the sugar-flour mixture and cut with pastry blender or fork until it resembles coarse crumbs. | 5) Reserve 1 cup of crumb mixture. | 6) To remaining mixture, add baking powder, soda, salt, sour cream, one egg and almond extract; blend well. | 7) Spread batter over bottom and up sides of pan 2 inches (batter should be 1/4 inch thick on sides). | 8) Combine cream cheese, 1/4 cup sugar and 1 egg; blend well. | 9) Pour over batter in pan. | 10) Carefully spread preserves over all. | 11) Combine reserved crumbs and sliced almonds. | 12) Sprinkle over top. | 13) Bake 55 minutes or until filling is set. | 14) Cool 15 minutes. | 15) Remove sides of pan. | 16) Serve warm or cool. | 17) Refrigerate leftovers.", "tags": ["breads", "breakfast", "weeknight", "oven", "small appliance", "4 hours", "easy"], "cook_time_min": 55, "servings": null, "cuisine": ["All"], "rating_avg": 5.0, "rating_count": 37, "popularity_score": 4.9348936170212765, "nutrition_calories": 415.8, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/24/76/8/qyPGwtQY6JpWyfNnIhQX_Berry%20Cream%20Cheese%20Coffee%20Cake%2024768%20-%20final%202.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["breads", "breakfast", "weeknight", "oven", "small appliance", "4 hours", "easy"], "ingredients": []}, {"recipe_id": "rec_118", "props": {"title": "Best Ever Banana Muffins", "instructions": "[Instructions] 1) Mash bananas. | 2) Add sugar and slightly beaten egg. | 3) Add melted butter. | 4) Add the dry ingredients and bake at 375 degrees for 20 minutes.", "tags": ["breads", "breakfast", "toddler friendly", "healthy", "kid friendly", "sweet", "brunch", "60 mins", "oven", "beginner cook", "freezer", "easy", "inexpensive"], "cook_time_min": 20, "servings": null, "cuisine": ["All"], "rating_avg": 4.84, "rating_count": 138, "popularity_score": 4.830135135135135, "nutrition_calories": 249.1, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/62/28/6/X6IbE4EzSmwJ6NutMhQl_0S9A2157.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["breads", "breakfast", "toddler friendly", "healthy", "kid friendly", "sweet", "brunch", "60 mins", "oven", "beginner cook", "freezer", "easy", "inexpensive"], "ingredients": []}, {"recipe_id": "rec_119", "props": {"title": "Biltmore Goldenrod Eggs", "instructions": "[Instructions] 1) Separate yolks and whites of boiled eggs. | 2) Chop whites finely and add to white sauce. | 3) Pour sauce over 4 pieces of the toast. | 4) Rub egg yolks through a strainer or crumble very finely and sprinkle over the top. | 5) Cut remaining toast in triangles and place on side of dish. | 6) Garnish with parsley.", "tags": ["brunch", "30 mins", "easy", "inexpensive"], "cook_time_min": 10, "servings": null, "cuisine": ["All"], "rating_avg": 5.0, "rating_count": 6, "popularity_score": 4.80875, "nutrition_calories": 245.2, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/27/73/67/2AGbtmDORUmBhG9TCede_0S9A3649.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["brunch", "30 mins", "easy", "inexpensive"], "ingredients": []}, {"recipe_id": "rec_120", "props": {"title": "Biscuits and Gravy Breakfast Casserole", "instructions": "[Instructions] 1) Preheat oven to 350\u00b0F Take a 13 x 9 pan and spray with cooking spray (or smear with butter). Cut biscuit dough into 1\" pieces and place evenly in the bottom of the pan. | 2) Brown the sausage and drain. Scatter the browned sausage over the biscuit pieces, then top with shredded cheese. | 3) Whisk the eggs and milk with a pinch of salt and pepper, then pour over the pan. | 4) Make gravy according to instructions on package and pour over the pan. Bake for 30 - 45 minutes, depending on how hot your oven runs. | 5) Cut and serve. It's delicious warm right out of the oven!", "tags": ["pork", "cheese", "meat", "brunch", "60 mins", "easy"], "cook_time_min": 30, "servings": null, "cuisine": ["All"], "rating_avg": 4.7, "rating_count": 11, "popularity_score": 4.6971428571428575, "nutrition_calories": 613.7, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/51/08/74/awdUNE0eTyyvXKDknA4t_Biscuit%20gravy%20breakfast%20SITE-3.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["pork", "cheese", "meat", "brunch", "60 mins", "easy"], "ingredients": []}, {"recipe_id": "rec_121", "props": {"title": "Blueberry Almond Tart With Frangipane", "instructions": "[Instructions] 1) Frangipane:. | 2) in a medium saucepan, bring the milk and vanilla to a boil. Set aside. | 3) In another saucepan, combine the flour, sugar, and beaten egg yolks. | 4) Gradually add the hot milk till combined. | 5) Cook slowly over low heat, stirring constantly, till cream thickens. | 6) (at this point, I put it through a strainer to get rid of any cooked-egg lumps). | 7) Pour the cream into a bowl and stir in the crushed macaroons. Set aside to cool to room temperature. | 8) Crust:. | 9) Preheat oven to 350. Using a mixer, cream together the butter and sugar; add the egg yolks, almond extract and lemon zest. Beat till smooth. | 10) Add the flour and baking powder and mix well. | 11) Using a 9 or 10 inch tart or springform pan with removable bottome, press 2/3 of the dough in the bottom of the pan with your fingers and work the dough up the rim about 1/2 inch. Set the remaining dough aside (refrigerating is a good idea - it may help rolling out later). | 12) Filling:. | 13) in a medium bowl, mix together the sugar, flour and cornstarch. Stir in the blueberries, sprinkle with lemon (and cinnamon if desired)and toss to coat blueberries evenly. | 14) Assembly:. | 15) spread an even layer of the frangipane in the bottom of the crust, using just enough to cover. | 16) Pour in the blueberry mixture and dot the top with 2 T of butter. | 17) On a floured surface, roll out the remaining dough to 1/16 inch thick (I found this dough quite moist and fragile, so sprinkle with flour). | 18) Cut strips of dough 1/2 inch wide and arrange them diagonally, 1/2 inch apart, to form a lattice top. Trim away overhanging dough. | 19) Bake for 40 minutes or till lightly browned. | 20) Dust with powdered sugar and serve warm.", "tags": ["dessert", "berries", "fruit", "4 hours"], "cook_time_min": 40, "servings": null, "cuisine": ["All"], "rating_avg": null, "rating_count": 0, "popularity_score": null, "nutrition_calories": 5266.6, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/21/53/48/picpTrJd5.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["dessert", "berries", "fruit", "4 hours"], "ingredients": []}, {"recipe_id": "rec_122", "props": {"title": "Breakfast in a Hurry", "instructions": "[Instructions] 1) Spray an 8 inch x 8 inch glass dish with non-stick coating. | 2) Place cooked bacon in the bottom of the dish. | 3) Sprinkle cheese on top. | 4) Pour beaten eggs over the top. | 5) Bake for 25 to 30 minutes in a 350 degree Fahrenheit oven. | 6) Cut into squares, serve.", "tags": ["cheese", "very low carbs", "high protein", "high in", "60 mins", "easy"], "cook_time_min": 30, "servings": null, "cuisine": ["All"], "rating_avg": 4.0, "rating_count": 5, "popularity_score": 4.462666666666666, "nutrition_calories": 630.0, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/15/52/56/RYJ0V9JbQKuDPSOJO6dD_DSC05190-2.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["cheese", "very low carbs", "high protein", "high in", "60 mins", "easy"], "ingredients": []}, {"recipe_id": "rec_123", "props": {"title": "Breakfast Sandwich", "instructions": "[Instructions] 1) heat butter in frying pan until it melts. | 2) Fry sausage, or whatever you chose. | 3) toast bagel until brown or however you desire it. | 4) Spread your butter, mayo, etc. | 5) onto the bagel. | 6) when pan is hot, crack egg into the pan, and scramble it well. | 7) next, add the cheese to the egg and leave it there till it melts. | 8) put the egg onto your bagel and then add the sausage or bacon etc. | 9) Enjoy your sandwich.", "tags": ["lunch snacks", "cheese", "south american", "kid friendly", "15 mins", "beginner cook", "stove top", "easy"], "cook_time_min": 5, "servings": null, "cuisine": ["All"], "rating_avg": 4.6, "rating_count": 5, "popularity_score": 4.6626666666666665, "nutrition_calories": 1229.5, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/10/82/4/6occjgA3SbqzjMWMxjq9_breakfast-sandwich-bagel-3766.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["lunch snacks", "cheese", "south american", "kid friendly", "15 mins", "beginner cook", "stove top", "easy"], "ingredients": []}, {"recipe_id": "rec_124", "props": {"title": "Breakfast Tater-Tot Casserole", "instructions": "[Instructions] 1) Prepare a glass baking dish (at least 8x10) by spreading butter along the bottom and sides. | 2) In a bowl, mix eggs, milk, sour cream, chives, seasoned salt, hot sauce and salt and pepper and whisk until well blended. | 3) Add 2 cups cheddar and 1 cup mozzarella cheese and tots to mixture. Mix well until all tots are coated and all ingredients mixed. | 4) In small pan, cook sausage until just before done (sausage will finish in the oven), drain well and add to tot mixture. | 5) Pour the mixture into your pre-greased baking pan and top with the rest of the cheese and the bread crumbs. Spread topping evenly. | 6) Bake at 350 degrees for 45 minutes or until topping is golden brown.", "tags": ["breakfast", "pork", "cheese", "meat", "brunch", "oven", "beginner cook", "stove top", "4 hours", "easy", "inexpensive"], "cook_time_min": 50, "servings": null, "cuisine": ["All"], "rating_avg": 4.38, "rating_count": 10, "popularity_score": 4.537, "nutrition_calories": 1587.5, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/26/04/76/tnFRdHRiS3GZ4bpRVlRT_breakfast-tater-tot-casserole-3522.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["breakfast", "pork", "cheese", "meat", "brunch", "oven", "beginner cook", "stove top", "4 hours", "easy", "inexpensive"], "ingredients": []}, {"recipe_id": "rec_125", "props": {"title": "Brie and Bacon Sandwiches", "instructions": "[Instructions] 1) Heat a pan over medium heat, cook bacon to your liking. | 2) Meanwhile butter bread if you wish; spread one side with a little chutney. | 3) Divide hot bacon between chutnied bread slices, top with cheese, bread and cut to serve. | 4) Eat at once. | 5) Good served with a green salad on the side.", "tags": ["lunch snacks", "pork", "cheese", "meat", "savory", "brunch", "15 mins", "stove top", "easy"], "cook_time_min": 5, "servings": null, "cuisine": ["All"], "rating_avg": 5.0, "rating_count": 4, "popularity_score": 4.781428571428571, "nutrition_calories": 253.3, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/19/14/13/SFggAsdSEi8eBlPlJzG4_THE%20FOOD%20GAYS%20-%20Bacon%20Brie%20Sandwich.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["lunch snacks", "pork", "cheese", "meat", "savory", "brunch", "15 mins", "stove top", "easy"], "ingredients": []}, {"recipe_id": "rec_126", "props": {"title": "Brown Sugar Bacon", "instructions": "[Instructions] 1) Line a cookie sheet with parchment paper and preheat oven to 425. | 2) Lay bacon on paper and sprinkle with sugar. | 3) Bake 10 minutes then drain fat from pan (carefully!). | 4) Bake 5 to 10 minutes more, until it's as crisp as you like.", "tags": ["pork", "meat", "kid friendly", "30 mins", "easy"], "cook_time_min": 20, "servings": null, "cuisine": ["All"], "rating_avg": 4.65, "rating_count": 53, "popularity_score": 4.656984126984128, "nutrition_calories": 623.9, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/33/64/9/26qRJpRuKRCVC9S5yfvg_brown-sugar-bacon-05894.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["pork", "meat", "kid friendly", "30 mins", "easy"], "ingredients": []}, {"recipe_id": "rec_127", "props": {"title": "Cheesy Home Fries With Spinach and Peppers. #SP5", "instructions": "[Instructions] 1) Lightly cover the bottom of a 10-inch non-stick skillet with butter. Heat butter over medium-low heat until hot. | 2) Add one package Simply Potatoes Diced Potatoes with Onion to skillet. Cover with lid. Cook for 10 minutes, turning every 3 to 4 minutes. | 3) Add 3 cups of chopped bell peppers. Cover with lid. Cook for 3-4 minutes, turning every 2 minutes. | 4) Add 2 cups of grated sharp cheddar cheese and 4 cups of spinach. Cook for 2 minutes, turning constantly until cheese is melted and spinach is wilted.", "tags": ["potato", "vegetable", "weeknight", "brunch", "30 mins", "easy"], "cook_time_min": 20, "servings": null, "cuisine": ["All"], "rating_avg": 5.0, "rating_count": 16, "popularity_score": 4.882307692307693, "nutrition_calories": 282.4, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/51/51/51/3W3RgsL4ToqNhCLCtKlx_cheesy-potatoes-peppers-spinach-hash-05910.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["potato", "vegetable", "weeknight", "brunch", "30 mins", "easy"], "ingredients": []}, {"recipe_id": "rec_128", "props": {"title": "Chocolate and Banana Overnight Oats", "instructions": "[Instructions] 1) In a medium bowl, mix the oats, milk, cocoa powder and sugar. | 2) Mash one of the bananas and stir into the oats. | 3) Divide between two bowls or mason jars and store in the fridge overnight. | 4) In the morning, slice the other banana and top the oats with the sliced banana and chocolate chunks and serve.", "tags": ["breakfast", "vegan", "low cholesterol", "healthy", "15 mins"], "cook_time_min": 5, "servings": null, "cuisine": ["All"], "rating_avg": 5.0, "rating_count": 3, "popularity_score": 4.764615384615385, "nutrition_calories": 368.6, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/submissions/recipe/2001201872/kO3BWtURQW2yhom2qkQG_untitled-6428.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["breakfast", "vegan", "low cholesterol", "healthy", "15 mins"], "ingredients": []}, {"recipe_id": "rec_129", "props": {"title": "Cinnamon Roll Casserole", "instructions": "[Instructions] 1) Heat oven to 375\u00b0F Pour melted butter into ungreased 13x9-inch (3-quart) glass baking dish. | 2) Separate both cans of dough into 16 rolls; set icing aside. | 3) Cut each roll into 8 pieces; place pieces over butter in dish. | 4) In a medium bowl, beat eggs. | 5) Beat in cream, cinnamon and vanilla until well blended; gently pour over roll pieces. | 6) Sprinkle with pecans; drizzle with 1/4 cup syrup. | 7) Bake 20 to 28 minutes or until golden brown. | 8) Cool 15 minutes. | 9) Meanwhile, remove covers from icing; microwave on Medium (50%) 10 to 15 seconds or until thin enough to drizzle. | 10) Drizzle icing over top. | 11) If desired, spoon syrup over individual servings.", "tags": ["brunch", "60 mins", "easy"], "cook_time_min": 25, "servings": null, "cuisine": ["All"], "rating_avg": 5.0, "rating_count": 5, "popularity_score": 4.795999999999999, "nutrition_calories": 157.9, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/48/41/34/3RlhhZkTgWSxqG38aF5D_IMG_9052.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["brunch", "60 mins", "easy"], "ingredients": []}, {"recipe_id": "rec_130", "props": {"title": "Scallion Crab Quiche", "instructions": "[Instructions] 1) Preheat oven to 350 degrees F. | 2) In a medium bowl, whisk together eggs, sour cream, milk, butter, flour, salt and pepper until thoroughly blended. | 3) Fold in crab, cheese and onions, blending well, spread into prepared pie shell. | 4) Bake for 40 to 45 minutes or until a knife inserted in the center comes out clean.", "tags": ["crab", "weeknight", "brunch", "4 hours", "easy"], "cook_time_min": 45, "servings": null, "cuisine": ["All"], "rating_avg": 4.75, "rating_count": 16, "popularity_score": 4.728461538461539, "nutrition_calories": 474.5, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/72/56/7/UEAujvnnS22w9YWFvO3B_december%20files-22.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["crab", "weeknight", "brunch", "4 hours", "easy"], "ingredients": []}, {"recipe_id": "rec_131", "props": {"title": "Cream Cheese Stuffed French Toast W/Strawberries and Whip Cream", "instructions": "[Instructions] 1) Mix cream cheese filling ingredients in bowl using enough powdered sugar to make a spreading consistency, and set aside. | 2) Spread out the slices of the cinnamon bread and spread a little cream cheese filling on each and put two together to make a \"sandwich\". | 3) In another bowl mix the 3 eggs, 1 tbsp sugar, 1 tsp vanilla well with a whisk and dip the sandwiches in this mixture and then fry them in a little melted butter until browned on each side. | 4) We use the large electric griddle for this. | 5) Top the fried sandwiches with a little powdered sugar dusting and then strawberry sauce and whip cream and serve.", "tags": ["kid friendly", "brunch", "60 mins", "stove top"], "cook_time_min": 15, "servings": null, "cuisine": ["All"], "rating_avg": 4.87, "rating_count": 32, "popularity_score": 4.828095238095238, "nutrition_calories": 354.7, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/58/49/7/fCDQvyJnT5eisnDqqMif_CCSFT%207%20-%20final_4.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["kid friendly", "brunch", "60 mins", "stove top"], "ingredients": []}, {"recipe_id": "rec_132", "props": {"title": "Creamed Eggs on Toast", "instructions": "[Instructions] 1) Melt butter over medium-high heat. | 2) Whisk in flour. | 3) When bubbly, whisk in milk a little at a time. | 4) Add salt. | 5) Continue to whisk til thick and bubbly. | 6) Remove from heat and add chopped eggs. | 7) Toast and butter slices of bread. | 8) Lay slices on individual plates and spoon on Creamed Eggs. | 9) Serve.", "tags": ["60 mins", "stove top"], "cook_time_min": 20, "servings": null, "cuisine": ["All"], "rating_avg": 4.58, "rating_count": 25, "popularity_score": 4.612571428571428, "nutrition_calories": 685.2, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/50/81/6/XIACZdAqRsGaSo2Ckjzd_creamed-eggs-on-toast_3406.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["60 mins", "stove top"], "ingredients": []}, {"recipe_id": "rec_133", "props": {"title": "Croque Monsieur", "instructions": "[Instructions] 1) Preheat the oven to 400 degrees F. | 2) Melt the butter over low heat in a small saucepan and add the flour all at once, stirring with a wooden spoon for 2 minutes. Slowly pour the hot milk into the butter\u2013flour mixture and cook, whisking constantly, until the sauce is thickened. Off the heat add the salt, pepper, nutmeg, 1/2 cup grated Gruyere, and the Parmesan and set aside. | 3) To toast the bread, place the slices on 2 baking sheets and bake for 5 minutes. Turn each slice and bake for another 2 minutes, until toasted. | 4) Lightly brush half the toasted breads with mustard, add a slice of ham to each, and sprinkle with half the remaining Gruyere. Top with another piece of toasted bread. Slather the tops with the cheese sauce, sprinkle with the remaining Gruyere, and bake the sandwiches for 5 minutes. Turn on the broiler and broil for 3 to 5 minutes, or until the topping is bubbly and lightly browned. Serve hot.", "tags": ["lunch snacks", "european", "high in", "30 mins", "easy"], "cook_time_min": 25, "servings": null, "cuisine": ["All"], "rating_avg": 4.86, "rating_count": 7, "popularity_score": 4.76235294117647, "nutrition_calories": 907.7, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/24/42/00/QAKpU1SUQtWd1u3AKAkU_0S9A8964.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["lunch snacks", "european", "high in", "30 mins", "easy"], "ingredients": []}, {"recipe_id": "rec_134", "props": {"title": "Delicious Homemade Donuts", "instructions": "[Instructions] 1) In a small bowl mix the yeast with the milk and sugar. Let sit until foamy, about 10 minutes. In a mixing bowl of a stand mixer fitted with the dough hook, combine flour and salt. When yeast is ready, add that to the mixing bowl. | 2) Add the egg and butter. Begin to mix the ingredients into a soft, but not sticky, dough. (Add a little extra milk or extra flour, 1 tablespoon at a time as needed). Knead dough until smooth and elastic. Transfer the dough to a lightly oiled bowl, cover, and let rise until doubled in size, about 2 hours. | 3) Punch down the dough. Turn out onto a lightly floured surface and knead for a few seconds. With a lightly floured rolling pin, gradually roll out the dough to about 1/2-inch thick. (When rolling dough, let it rest periodically to relax). Cut out into 3\" rounds with a lightly floured biscuit cutter. Re-roll the scraps to make more rounds. | 4) Place the doughnuts on lightly floured baking sheets, spacing them apart, and cover lightly with a dry towel. Let rise in a warm spot until doubled in size, about 20 minutes. | 5) Using a deep fryer (or fill a heavy pot with 3\" vegetable oil) and heat to 325\u00b0F Fry the doughnuts, a few at a time, until golden and puffed, 4-5 minutes, turning frequently using a slotted spoon. | 6) Lift the doughnuts from the oil and place onto a cooling rack. Once cooled, fill a pastry bag using your filling of choice. Insert the tip into the end of each doughnut and pipe approximately 1-2 tsp filling into them. Dust with confectioners' sugar, coat with chocolate icing, or dip in glaze. Best eaten the same day.", "tags": ["breakfast", "fruit", "healthy", "brunch", "4 hours", "easy"], "cook_time_min": 5, "servings": null, "cuisine": ["All"], "rating_avg": 4.8, "rating_count": 5, "popularity_score": 4.729333333333333, "nutrition_calories": 121.6, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/32/94/63/76TyyrrSIOJo7j8n4mXc_untitled-2091.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["breakfast", "fruit", "healthy", "brunch", "4 hours", "easy"], "ingredients": []}, {"recipe_id": "rec_135", "props": {"title": "Dutch Baby", "instructions": "[Instructions] 1) Fifteen minutes before baking preheat the oven to 450\u00b0; have a pie plate or oven-proof skillet ready. | 2) Whisk together the milk, flour, eggs, sugar and vanilla; put the butter in the pie plate or skillet and place the pan in the oven just until the butter is melted; with a brush coat the rim and entire inside of the pan. | 3) Slowly pour batter into hot pan; bake for 20 minutes; reduce heat to 350\u00b0 and bake another 8-10 minutes, until pancake is well-browned; remove from oven and sieve confectioners' sugar over the top; serve immediately with fruit spooned into the center of the pancake.", "tags": ["dessert", "lunch snacks", "raspberries", "strawberry", "plums", "berries", "fruit", "christmas", "sweet", "brunch", "60 mins", "oven", "beginner cook", "easy", "inexpensive"], "cook_time_min": 30, "servings": null, "cuisine": ["All"], "rating_avg": 4.58, "rating_count": 79, "popularity_score": 4.592808988764045, "nutrition_calories": 451.7, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/74/14/6/FGe5KRTRQoeXrA54SKUN_DB%205%20-%20final_3.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["dessert", "lunch snacks", "raspberries", "strawberry", "plums", "berries", "fruit", "christmas", "sweet", "brunch", "60 mins", "oven", "beginner cook", "easy", "inexpensive"], "ingredients": []}, {"recipe_id": "rec_136", "props": {"title": "Easy Breakfast Bake", "instructions": "[Instructions] 1) In a heavy skillet, brown sausage, breaking up with spatula. | 2) Drain off excess fat; set aside. | 3) In a saucepan, bring salted water to a boil and stir in grits. | 4) Cover, reduce heat to low, and continue cooking for 5 minutes longer, stirring occasionally. | 5) In a medium saucepan, melt butter; stir in flour, pepper and milk. | 6) Cook, stirring constantly, until thickened. Add cheese, stirring until blended. | 7) Add sausage and half of the cheese sauce to cooked grits. | 8) Pour mixture into lightly greased casserole. With back of a large serving spoon, make 4 indentations in grits. | 9) Break an egg into each indentation. | 10) Bake at 325\u00b0 for 15 to 18 minutes, or until eggs are done as desired. | 11) Reheat remaining cheese sauce to serve with grits and eggs.", "tags": ["grains", "savory", "brunch", "60 mins"], "cook_time_min": 15, "servings": null, "cuisine": ["All"], "rating_avg": 3.25, "rating_count": 5, "popularity_score": 4.212666666666666, "nutrition_calories": 513.4, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/22/90/69/M0U6agwkTqqC2anyDdge_grits-breakfast-casserole-sausage-eggs-3211.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["grains", "savory", "brunch", "60 mins"], "ingredients": []}, {"recipe_id": "rec_137", "props": {"title": "Easy Breakfast Tacos", "instructions": "[Instructions] 1) Toast tortillas on stovetop over medium flame. | 2) Set out bowls containing the fillings: eggs, cheese, Pico de Gallo, cilantro, and lime. | 3) Build taco by placing the eggs in first and topping it with cheese, Pico de Gallo, and cilantro, adding a squeeze of lime to taste.", "tags": ["tex mex", "southwestern u s", "15 mins", "easy"], "cook_time_min": 2, "servings": null, "cuisine": ["All"], "rating_avg": null, "rating_count": 0, "popularity_score": null, "nutrition_calories": 226.1, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/53/31/69/ELgFayABRNG0moIXb212__MGL9090-2.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["tex mex", "southwestern u s", "15 mins", "easy"], "ingredients": []}, {"recipe_id": "rec_138", "props": {"title": "Eggs in Clouds", "instructions": "[Instructions] 1) Separate eggs, putting whites in 1 large bowl and yolks in 4 separate small bowls. | 2) Whip whites until stiff peaks form. | 3) Fold in cheese, chives and bacon. | 4) Spoon into 4 mounds on parchment-lined baking sheet; make a deep well in center of each. | 5) Bake at 450 degrees for 3 minutes. | 6) Then add 1 yolk to each well; season with pepper. Bake until yolks are just set, 2 to 3 minutes.", "tags": ["cheese", "very low carbs", "free of", "15 mins", "easy"], "cook_time_min": 6, "servings": null, "cuisine": ["All"], "rating_avg": 4.18, "rating_count": 14, "popularity_score": 4.394166666666667, "nutrition_calories": 140.6, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/51/30/62/mh16i4krTLeNEoEnP0Mw_EIC%203%204%20-%20final_2.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["cheese", "very low carbs", "free of", "15 mins", "easy"], "ingredients": []}, {"recipe_id": "rec_139", "props": {"title": "English Muffins With Bacon Butter", "instructions": "[Instructions] 1) In a bowl combine butter and mustard; stir in bacon. | 2) Toast english muffins; spread with bacon butter. | 3) Refrigerate any leftover butter.", "tags": ["weeknight", "brunch", "15 mins", "easy"], "cook_time_min": 5, "servings": null, "cuisine": ["All"], "rating_avg": 5.0, "rating_count": 13, "popularity_score": 4.86695652173913, "nutrition_calories": 370.1, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/43/20/13/MQdDAzZkTIyK8hoBgrim_BACONBUTTER1%20(1%20of%201).jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["weeknight", "brunch", "15 mins", "easy"], "ingredients": []}, {"recipe_id": "rec_140", "props": {"title": "Farmer's Quiche", "instructions": "[Instructions] 1) Place rice in a saucepan along with 1 tablespoon butter, 2 cups water, and 1 teaspoon salt. | 2) Bring mixture to a boil, then cover pan, lower heat, and simmer for 40 minutes (do not lift lid during this time) or until rice is tender. | 3) Allow rice to sit off heat, covered, for 5-10 minutes more. | 4) Take 2 cups of the cooked rice and place in a mixing bowl along with 1 egg and 1/4 cup melted butter, mixing well (may use leftover rice for another use). | 5) Preheat oven to 350\u00b0F. | 6) Take mixed rice and press evenly in the bottom and sides of a 9-inch glass pie pan. | 7) Blind bake rice crust for 15 minutes at 350F and then remove from oven until filling (the rice should feel a little dry and not excessively tacky). | 8) In a small mixing bowl, blend together lightly 3 eggs, the buttermilk, heavy cream, chopped sage, salt, and pepper. | 9) Place crumbled bacon in the bottom of the rice crust. | 10) Top bacon with chopped zucchini, and then the peas, making sure filling is spread evenly. | 11) Pour egg mixture over the top of the vegetables and bacon. | 12) Sprinkle with grated cheese. | 13) Dot with little pieces of butter. | 14) Bake at 350F for 30-35 minutes or until top is domed, golden brown, and a thin knife can be removed cleanly from the center of the quiche. | 15) Allow to stand 30 minutes before slicing and serving.", "tags": ["breakfast", "brown rice", "rice", "cheese", "savory", "brunch", "oven", "stove top", "4 hours"], "cook_time_min": 1, "servings": null, "cuisine": ["All"], "rating_avg": 4.5, "rating_count": 8, "popularity_score": 4.607777777777778, "nutrition_calories": 898.8, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/93/03/7/UedChZI8R7ylnLU3hH77_farmer%27s-quiche_0699.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["breakfast", "brown rice", "rice", "cheese", "savory", "brunch", "oven", "stove top", "4 hours"], "ingredients": []}, {"recipe_id": "rec_141", "props": {"title": "Fluffy Matcha Hotcakes", "instructions": "[Instructions] 1) Combine flour, sugar, matcha and baking soda in a large bowl. Whisk in the wet ingredients (milk, yogurt and egg) until the batter is smooth. | 2) Heat a saute pan over medium-low heat. Brush the inside of a metal ring mold or cookie cutter (about 3 inches across) with oil. Add remaining oil to pan and place the ring mold in the middle of the pan. Fill the ring mold 2/3 of the way up with the batter and place a lid on the pan. Make sure that the lid does not rest on top of the ring mold. | 3) Cook for 5 minutes, then remove lid and cook for 1 more minute (or until bubbles start to form on top of the hotcake). Carefully flip the pancake and ring mold and cook the other side for 5 minutes with the lid, then 1 minute without. | 4) Remove from the pan and and run a knife along the inside of the ring mold to unmold the hotcake. Serve warm with syrup.", "tags": ["30 mins"], "cook_time_min": 12, "servings": null, "cuisine": ["All"], "rating_avg": null, "rating_count": 0, "popularity_score": null, "nutrition_calories": 135.7, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/52/97/65/y7yaPeNMQ6qlCOvcxPmp_FluffyMatchaHotcakes_02.JPG"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["30 mins"], "ingredients": []}, {"recipe_id": "rec_142", "props": {"title": "Four Cheese Egg Casserole", "instructions": "[Instructions] 1) Beat together the eggs, milk and sugar. Add the cheeses, butter and basil. | 2) Mix well then add the flour and baking powder. | 3) Pour into greased 9x13 baking dish. | 4) Bake in a 325 degree oven for approximately 50 minutes or until knife inserted in the center comes out clean.", "tags": ["high in", "brunch", "60 mins", "oven"], "cook_time_min": 50, "servings": null, "cuisine": ["All"], "rating_avg": 4.92, "rating_count": 13, "popularity_score": 4.821739130434782, "nutrition_calories": 342.9, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/21/51/97/W6BtGjHScCeaCe1yTslG_DSC_0520.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["high in", "brunch", "60 mins", "oven"], "ingredients": []}, {"recipe_id": "rec_143", "props": {"title": "Fragrant Egg Curry", "instructions": "[Instructions] 1) Place onion, ginger and garlic in a food processor and process to form a paste. | 2) Heat the oil in a heavy-based saucepan, add the paste and cook over low heat for 2-3 minutes. Add the spices and cook for 1 minute, stirring to release the flavours. Add the tomatoes and 500ml (2 cups) water and bring to the boil. Reduce heat to medium and simmer for 15 minutes. | 3) Meanwhile, shell and halve the eggs and add to the pan with the lentils and peas - if mixture is too thick add an extra 125ml (1/2 cup water). Cook over low heat for 15 minutes or until lentils are soft. Stir in the coriander and serve with cooked rice.", "tags": ["60 mins", "easy"], "cook_time_min": 45, "servings": null, "cuisine": ["All"], "rating_avg": 4.5, "rating_count": 2, "popularity_score": 4.661666666666667, "nutrition_calories": 289.6, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/33/10/61/jb4MnQyTRaPEbzKjvNk9_fragrant-egg-curry_0712.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["60 mins", "easy"], "ingredients": []}, {"recipe_id": "rec_144", "props": {"title": "French Toast Roll Ups", "instructions": "[Instructions] 1) On a flat surface, using your hand, or a rolling pin, flatten each slice of bread. Leaving a 1/4\u201d border from the bottom edge, spread 1 teaspoons Nutella on the bottom third of the bread. Top with chopped strawberries. Starting from the bottom, tightly roll up the bread. Repeat with remaining bread. | 2) Add eggs to a shallow dish. Whisk in milk, vanilla extract, and a pinch of salt. Add the bread rolls, allowing the bread to soak up the milk mixture, turning once or twice as needed. Remove from mixture and allow excess to drip off before adding to the pan. | 3) Heat a large skillet over medium-high. Add 2 Tbs. butter. Add the bread rolls, and cook, turning occasionally, until golden brown on all sides, about 5 minutes. | 4) In a shallow bowl, combine cinnamon and sugar. Roll warm roll ups in the sugar mixture and serve immediately with maple syrup.", "tags": ["15 mins"], "cook_time_min": 5, "servings": null, "cuisine": ["All"], "rating_avg": 4.5, "rating_count": 2, "popularity_score": 4.661666666666667, "nutrition_calories": 173.4, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/53/31/91/FNOCiS7oR4ygqdXpbRm8_8CC65802-B5EA-4C2E-8075-8CAA3CF80877.jpeg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["15 mins"], "ingredients": []}, {"recipe_id": "rec_145", "props": {"title": "French Vanilla Almond Granola", "instructions": "[Instructions] 1) Heat oven to 200 degrees F. Line a large, rimmed cookie sheet with parchment paper. | 2) In a large bowl mix together the oats and almonds. | 3) In a small saucepan over medium heat, stir the sugar and salt into the water. Cook and stir until sugar is dissolved. Remove from heat. Stir in canola oil and vanilla. Pour into the oat and almond mixture and stir until thoroughly combined. | 4) Spread mixture out on the lined cookie sheet and bake for 2 hours, or until dry to the touch. Do not stir! Remove from oven and let cool before breaking apart into chunks. Store in an air-tight container.", "tags": ["grains", "low cholesterol", "brunch", "4 hours", "from scratch"], "cook_time_min": 2, "servings": null, "cuisine": ["All"], "rating_avg": 4.0, "rating_count": 1, "popularity_score": 4.63090909090909, "nutrition_calories": 187.1, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/49/99/65/picKQ5m3M.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["grains", "low cholesterol", "brunch", "4 hours", "from scratch"], "ingredients": []}, {"recipe_id": "rec_146", "props": {"title": "Gordon Ramsay's Scrambled Eggs", "instructions": "[Instructions] 1) Break eggs into a pan and add the cubed butter. | 2) Stir over a medium heat until the eggs start to cook. Remove from heat continue stirring eggs for about 20 second. Return to heat, continue to stir eggs until they start to clump, remove from heat and add the creme fraiche. Return to heat stirring in cr\u00e8me fraiche. | 3) Remove from heat when eggs are clumpy, but soft. | 4) Season with freshly ground black pepper and garnish with a sprinkling of chopped chives.", "tags": ["15 mins", "easy"], "cook_time_min": 5, "servings": null, "cuisine": ["All"], "rating_avg": 4.9, "rating_count": 34, "popularity_score": 4.8531818181818185, "nutrition_calories": 240.4, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/18/62/94/QCnEQxSWWr26hT0bVLYA_0S9A3033.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["15 mins", "easy"], "ingredients": []}, {"recipe_id": "rec_147", "props": {"title": "Gourmet Huevos Rancheros", "instructions": "[Instructions] 1) Preheat the broiler. | 2) Heat the tortillas by toasting them one at a time in a dry cast-iron skillet or directly over a gas flame until lightly toasted; Place on a baking sheet, spread each tortilla with \u00bc cup of refried beans, and cover to keep warm. | 3) Working in batches as needed, heat the butter in a large skillet over medium-high heat until it is very hot but not smoking and the foaming has subsided; Crack the eggs directly into the hot butter and reduce the heat to medium-low or low; Fry the eggs, shaking the pan occasionally to keep the eggs from sticking; Season the eggs with salt and pepper; Fry to the desired doneness, about 2 minutes for \"sunny-side up,\" 3 minutes for medium yolks, and 4 minutes for hard yolks; Or, once the whites are just opaque, turn the eggs and cook for 30 seconds more for \"over easy,\" 1 minute more for \"over medium,\" or 2 minutes more for \"over hard.\". | 4) Top each tortilla with 2 fried eggs and 2 tablespoons of the grated cheese; Slide the tortillas under the broiler to melt the cheese. | 5) Meanwhile, dice the avocado and toss with the lime juice to prevent the avocado from discoloring. | 6) Top each serving with 2 tablespoons salsa and 2 tablespoons sour cream; Divide the avocado among the tortillas; Garnish each tortilla with 1 tablespoon cilantro and 1 tablespoon green onion and serve.", "tags": ["cheese", "tropical fruits", "fruit", "tex mex", "southwestern u s", "mexican", "kid friendly", "brunch", "30 mins"], "cook_time_min": 20, "servings": null, "cuisine": ["All"], "rating_avg": 4.82, "rating_count": 17, "popularity_score": 4.773333333333333, "nutrition_calories": 499.8, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/12/92/03/iJpwUzywTxuK8MVziaZm_huevos-rancheros-2.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["cheese", "tropical fruits", "fruit", "tex mex", "southwestern u s", "mexican", "kid friendly", "brunch", "30 mins"], "ingredients": []}, {"recipe_id": "rec_148", "props": {"title": "Grandma B's Super Waffles", "instructions": "[Instructions] 1) note: if you do not have sour milk or buttermilk measure 2 tablespoons vinegar into your 2-cup measuring cup and fill to the two-cup mark with sweet milk and let it stand while you prepare other ingredients. | 2) Sift together: 2 cups all-purpose flour 3 teaspoons baking powder 1 teaspoon baking soda 1 teaspoon salt. | 3) Combine: 2 cups sour milk or butter milk 4 eggs well beaten Add the milk and eggs to dry ingredients,beat until smooth with a hand mixer or electric mixer on high speed. | 4) Stir in 3/4 cup melted margarine or salad oil. | 5) Bake in preheated waffle iron until crisp and golden. For large maker 2 cups for small maker 1 cup batter. | 6) Serve with your favorite toppings.", "tags": ["brunch", "30 mins"], "cook_time_min": 5, "servings": null, "cuisine": ["All"], "rating_avg": 4.84, "rating_count": 38, "popularity_score": 4.809583333333333, "nutrition_calories": 452.9, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/89/57/5/3L7sziKSZGMeZPftbS2L_0S9A9055.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["brunch", "30 mins"], "ingredients": []}, {"recipe_id": "rec_149", "props": {"title": "Grilled Breakfast Burrito", "instructions": "[Instructions] 1) Heat 1/4 cup of vegetable oil in a large skillet over medium heat. Fry potatoes until almost cooked through, then add onions and peppers, continuing to cook until vegetables are tender. Drain, set aside. | 2) In the same skillet, melt butter or margarine over medium heat. Scramble eggs, adding potatoes, vegetables, and sausage during the last few moments of cooking. Add salt and pepper to taste. | 3) Top each tortilla with cheese and part of the egg mixture, roll into a burrito. Spray a hot grill (I use a family size George Foreman) with cooking spray. Grill for approximately 10 minutes or until lightly browned. | 4) Serve hot with homemade Pico De Gallo, salsa, sour cream, or perhaps Spanish rice and refried beans.", "tags": ["cheese", "tex mex", "southwestern u s", "mexican", "spicy", "brunch", "60 mins", "beginner cook", "easy"], "cook_time_min": 15, "servings": null, "cuisine": ["All"], "rating_avg": 4.5, "rating_count": 4, "popularity_score": 4.638571428571428, "nutrition_calories": 1612.1, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/24/17/28/VKExjrzgTn8a0r18M54g_0S9A5142.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["cheese", "tex mex", "southwestern u s", "mexican", "spicy", "brunch", "60 mins", "beginner cook", "easy"], "ingredients": []}, {"recipe_id": "rec_150", "props": {"title": "Hashbrown Breakfast Skillet", "instructions": "[Instructions] 1) In a large skillet add the sausage and cook until most of it is brown. | 2) Drain and return to pan. | 3) Add the grated potatoes, onion, and salt to the skillet. | 4) Cook on medium heat until the hashbrowns are golden brown. | 5) Push the mixture to one side of the pan and scramble the eggs in the empty space. | 6) Once cooked, stir them into the hashbrowns. | 7) Add the hot sauce, tomatoes, and cheese. | 8) Stir well and serve immediately.", "tags": ["breakfast", "spicy", "60 mins", "from scratch"], "cook_time_min": 20, "servings": null, "cuisine": ["All"], "rating_avg": 5.0, "rating_count": 3, "popularity_score": 4.764615384615385, "nutrition_calories": 315.8, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/45/90/95/mZGs5tpRS2mIYxeZF8kU_IMG_6571.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["breakfast", "spicy", "60 mins", "from scratch"], "ingredients": []}, {"recipe_id": "rec_151", "props": {"title": "Homemade Brown Rice Hot Cereal", "instructions": "[Instructions] 1) In clean, dry skillet (preferably cast iron) toast brown rice on medium heat. Lower heat if rice starts to smoke. | 2) Toast rice for about 10 minutes, stirring constantly so that grains do not burn. Rice should turn a medium brown. Set aside to cool slightly. | 3) In blender fitted with steel blade, or in grain mill or food processor grind browned rice to the consistency of medium coarse cornmeal (grainy but not powdered.). | 4) The grinding process will have to be done in 3/4 cup portions to allow the rice grains to grind effectively. | 5) To store: Place ground rice cereal in airtight container or \"ziploc\" bag. The cereal must be kept either refrigerated or frozen. Brown rice goes rancid quickly if stored in cupboard. | 6) To prepare hot cereal: (1 serving/thick consistency*). | 7) In small saucepan with 1 cup of rapidly boiling, salted water gradually add 1/3 cup scant of prepared brown rice cereal using a fork to stir well. *For thinner consistency cereal, either increase amount of water, or reduce amount of cereal. Continue to cook rice on high for about 30 seconds breaking up any lumps. Reduce heat until boiling subsides, cover pan tightly and simmer for 10 minutes. | 8) Serve with your favorite toppings if desired. Season with salt if necessary. My favorite additions are toasted nuts, raisins and cardamom!", "tags": ["brown rice", "rice", "vegan", "low cholesterol", "healthy", "15 mins", "easy", "inexpensive"], "cook_time_min": 10, "servings": null, "cuisine": ["All"], "rating_avg": 4.75, "rating_count": 4, "popularity_score": 4.71, "nutrition_calories": 2751.2, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/12/57/32/do0viq2QIa9zRqyK72za_0S9A7100.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["brown rice", "rice", "vegan", "low cholesterol", "healthy", "15 mins", "easy", "inexpensive"], "ingredients": []}, {"recipe_id": "rec_152", "props": {"title": "Honey Pecan French Toast", "instructions": "[Instructions] 1) In a medium bowl, combine eggs, milk, and vanilla; beat well with a wire whisk. | 2) Add pancake mix, beating until smooth. Pour mixture into a greased 13x9x2\" baking dish. | 3) Place bread slices in egg mixture turning slices to coat evenly. | 4) Let stand for 5 minutes or until all liquid is absorbed. | 5) In a large skillet, melt 1 Tablespoon butter. Add 3 slices of bread; cook over medium heat for 3 minutes on each side or until golden brown. | 6) Remove from the pan and keep warm. Repeat the process with the remaining butter and bread slices. | 7) Serve immediately with the Honey Pecan Topping. | 8) Honey Pecan Topping:. | 9) In a small bowl, combine the butter and honey, stirring until smooth. | 10) Add nuts, and stir well.", "tags": ["breakfast", "fruit", "nuts", "30 mins", "easy"], "cook_time_min": 10, "servings": null, "cuisine": ["All"], "rating_avg": 4.85, "rating_count": 14, "popularity_score": 4.785, "nutrition_calories": 967.0, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/21/06/21/vUlP5WniSCO6ZwxL9gmL_honey-pecan-french-toast_0236-3840x2160.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["breakfast", "fruit", "nuts", "30 mins", "easy"], "ingredients": []}, {"recipe_id": "rec_153", "props": {"title": "Hot Jam Sandwich", "instructions": "[Instructions] 1) Lightly beat together the egg, caster sugar and vanilla essence in a shallow dish and set aside. | 2) Spread the jam on to one slice of the bread and then place the other slice on top, pressing together firmly. | 3) Melt the butter in a large skillet over a medium-low heat. | 4) Soak the sandwich in the egg mixture until all of the egg has been absorbed. | 5) Fry in the butter for 1-2 minutes each side until golden brown. | 6) Slice the sandwich in half and sprinkle with the extra caster sugar. | 7) You may serve with a scoop of ice cream, yoghurt or a dollop of whipped cream or all by itself.", "tags": ["lunch snacks", "kid friendly", "15 mins", "easy"], "cook_time_min": 5, "servings": null, "cuisine": ["All"], "rating_avg": 3.5, "rating_count": 2, "popularity_score": 4.495, "nutrition_calories": 400.5, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/22/14/60/z8wEYH5wS76gLzxAQBEZ_hot-jam-sandwich-3811.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["lunch snacks", "kid friendly", "15 mins", "easy"], "ingredients": []}, {"recipe_id": "rec_154", "props": {"title": "Instant Pot Sausage and Potato Breakfast Casserole", "instructions": "[Instructions] 1) Set a 6-quart or large Instant Pot to saut\u00e9 on high. Once hot, add the oil, butter and sausage. Cook, breaking up the sausage with a wooden spoon, until no longer pink, about 5 minutes. Stir in the onion and potatoes and cook for another 2 minutes. Add the spinach, salt, pepper and crushed red pepper flakes, cooking until the spinach as wilted. Turn the machine off and transfer the mixture to a greased 7-inch round baking dish; set aside. | 2) Clean out the inner bowl and return to the Instant Pot. Insert a metal trivet or wire rack and pour in the water. | 3) In a large bowl, whisk together the eggs and milk until smooth. Pour into the baking dish over the sausage and vegetable mixture, stirring slightly to evenly incorporate. Sprinkle the top with the shredded cheese and place the dish in the Instant Pot. Lock the lid in place, making sure the valve is set to seal. Pressure cook on high for 30 minutes, and allow to natural release for 10 minutes before manually releasing any residual steam inside. | 4) Carefully open the lid, remove the baking dish and garnish with chives before serving. | 5) Note: You can brown the top of the casserole by placing under the broiler until golden brown before serving.", "tags": ["very low carbs", "brunch", "pressure cooker", "60 mins", "stove top"], "cook_time_min": 35, "servings": null, "cuisine": ["All"], "rating_avg": null, "rating_count": 0, "popularity_score": null, "nutrition_calories": 493.6, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/53/96/09/Oyp61nJvRG2mZ4HJpD07_0S9A7555.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["very low carbs", "brunch", "pressure cooker", "60 mins", "stove top"], "ingredients": []}, {"recipe_id": "rec_155", "props": {"title": "Israeli Shakshuka", "instructions": "[Instructions] 1) You need a large nonstick deep saut\u00e9 pan that has a cover. Saut\u00e9 onions in olive oil until opaque and tender. | 2) Add red bell pepper and continue sauteeing until it softens up. | 3) Reduce heat to low. Add the fresh chopped tomatoes, cook until they are breaking apart. | 4) With a slotted spoon, add the chunkiest parts of the contents of the \"Pomi\" - the majority of the sauce should remain in the carton. Add the jalapeno now also. | 5) Cook for 30-40 minutes, partially cover, and stir every once in a while. If it starts to look dry, add some of the sauce from the carton, slowly, as you need it. Add the salt and pepper - I like a lot because I love salt on tomatoes. | 6) The final product should be a thick sauce that just looks like a whole lot of tomatoes stuck together - with very little to no juice, that is about 1-1 1/2 inches high. | 7) Crack open the eggs on top of the shakshuka, one by one, giving each their own space. The whites should overlap, but the yolk should be spaced about 4 fingerwidths from each other. My pan can fit 6-8 eggs very comfortably. | 8) Cover tightly with a lid and simmer for 20 minutes.", "tags": ["vegetable", "low protein", "kosher", "brunch", "4 hours", "inexpensive"], "cook_time_min": 1, "servings": null, "cuisine": ["All"], "rating_avg": 5.0, "rating_count": 4, "popularity_score": 4.781428571428571, "nutrition_calories": 145.0, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/28/18/77/ZyG0h2VYRjei7iPFSWNI_food.com-14.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["vegetable", "low protein", "kosher", "brunch", "4 hours", "inexpensive"], "ingredients": []}, {"recipe_id": "rec_156", "props": {"title": "Italian Egg Sandwiches", "instructions": "[Instructions] 1) toast your bread. I like D'Annuzios. Use a good quality french, italian or ciabatta. Fry egg to your personal preference, me, i like it over easy. sprinkle with garlic salt to taste. Heat pizza sauce in microwave, then spread on toasted bread.You may use more than 1 tbsp if you like it saucey. Place your egg on top of sauce and sprinkle liberally with freshly grated parmesan. You may use marina, spaghetti or plain tomato sauce, but i found i really prefer a good quality pizza sauce. Enjoy!", "tags": ["lunch snacks", "15 mins", "easy"], "cook_time_min": 5, "servings": null, "cuisine": ["All"], "rating_avg": 3.6, "rating_count": 5, "popularity_score": 4.3293333333333335, "nutrition_calories": 278.1, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/28/49/84/bYZhdvX7QnuQ7twNMx2o_DSC_0406.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["lunch snacks", "15 mins", "easy"], "ingredients": []}, {"recipe_id": "rec_157", "props": {"title": "Korean-Inspired Breakfast Sandwich", "instructions": "[Instructions] 1) In a small bowl combine Bacon slices, Korean Chile Seasoning, and Chipotle Seasoning. Heat a saut\u00e9 pan to medium-high and fry the seasoned bacon \u2013 about 3 minutes a side until it is jerky-like and slightly crispy. Remove and set aside. | 2) On your bread slices spread a Tbsp of butter on each side. Toast to golden brown in a saut\u00e9 pan or toaster oven. Set aside. | 3) Finally fry up your egg. Over medium-high heat, spray your saut\u00e9 pan with non-stick spray, crack your eggs and then immediately turn down to low. Allow it to cook for about 3 to 4 minutes. The goal here is to leave a runny yolk so you can go sunny-side up or over-easy. Remove and set aside. | 4) Let's get to building! With one side of toasted bread on a plate, add a layer of Kimchi on the bottom, fold your bacon in half and add, and top with your freshly fried and runny egg. . | 5) Wash, pick and clean Basil, Parsley and Cilantro. Throw all the ingredients into a blender. Puree on high until completely combined. Taste to make sure seasoning is correct. Put in container or squeeze bottle, use right away or refrigerate. Finally drizzle Chimichurri sauce and garnish with cilantro. Enjoy!", "tags": ["15 mins"], "cook_time_min": 10, "servings": null, "cuisine": ["All"], "rating_avg": null, "rating_count": 0, "popularity_score": null, "nutrition_calories": 1570.6, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/53/41/75/QrKIyDpSRkmaXxhnDPkl_0S9A3270.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["15 mins"], "ingredients": []}, {"recipe_id": "rec_158", "props": {"title": "Low Calorie Asparagus and Egg Whites", "instructions": "[Instructions] 1) Microwave asparagus according to package directions. | 2) Drain well and separate into halves. | 3) Put half the asparagus in a 8\" pan sprayed with pam (save other half for another time). | 4) Pour egg whites over asparagus and cook 2 minutes over med heat. | 5) sprinkle with parmesan and broil for 4-5 minutes or until cheese is brown & bubbly and eggs are set. | 6) Turn out onto plate & enjoy!", "tags": ["lunch snacks", "cheese", "vegetable", "very low carbs", "low cholesterol", "healthy", "brunch", "15 mins", "easy", "inexpensive"], "cook_time_min": 8, "servings": null, "cuisine": ["All"], "rating_avg": 4.8, "rating_count": 5, "popularity_score": 4.729333333333333, "nutrition_calories": 115.3, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/18/24/86/iVVVaI4hShmVUyf59Oms_egg-white-asparagus-frittata-2685.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["lunch snacks", "cheese", "vegetable", "very low carbs", "low cholesterol", "healthy", "brunch", "15 mins", "easy", "inexpensive"], "ingredients": []}, {"recipe_id": "rec_159", "props": {"title": "Low Carb Breakfast Balls", "instructions": "[Instructions] 1) Mix all the ingredients together until thoroughly blended (it is best to use your hands or an electric mixer). | 2) Form into about 4 dozen 1 to 1 1/2 inch balls and place on a cookie sheet or broiler pan. | 3) Bake at 375\u00b0F for about 25 minutes. | 4) Once they are cool, they can be sorted into individual zip bags and frozen for a grab-and-go breakfast. | 5) NOTE: for Scotch Eggs, mold a bit of the raw meat mixture around a peeled hard-boiled egg (or eggs) and bake at 350\u00b0F for 30 minutes.", "tags": ["lunch snacks", "pork", "cheese", "meat", "very low carbs", "high protein", "high in", "brunch", "60 mins", "oven", "easy"], "cook_time_min": 30, "servings": null, "cuisine": ["All"], "rating_avg": 4.74, "rating_count": 94, "popularity_score": 4.735576923076923, "nutrition_calories": 403.0, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/98/77/4/ebRhPzUSNO95aIz3RqzA_Low-Carb-Breakfast-Balls-6.png"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["lunch snacks", "pork", "cheese", "meat", "very low carbs", "high protein", "high in", "brunch", "60 mins", "oven", "easy"], "ingredients": []}, {"recipe_id": "rec_160", "props": {"title": "Magic Crust Blender Quiche", "instructions": "[Instructions] 1) Preheat oven to 350 degrees F. Grease a 9-inch deep glass dish pie plate with 1 tablespoon olive oil. | 2) In a blender, combine milk, eggs, baking mix, 1 teaspoon salt, and 3/4 teaspoon pepper. Blend until smooth. Add parsley and blend just to combine. | 3) Sprinkle cheddar in an even layer on bottom of pie plate. Top with zucchini, broccoli, and scallions. Pour egg mixture over vegetables. Top with tomatoes and drizzle with remaining 2 tablespoons olive oil. Transfer to oven. | 4) Bake until quiche is puffed and golden brown and bottom of quiche look baked about 1 hour. Remove and let cool, 15 minutes, before slicing into wedges.", "tags": ["brunch", "4 hours"], "cook_time_min": 1, "servings": null, "cuisine": ["All"], "rating_avg": 4.5, "rating_count": 2, "popularity_score": 4.661666666666667, "nutrition_calories": 288.8, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/53/11/71/GheTn6qKT5JVAzOTZRZD_0S9A9657.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["brunch", "4 hours"], "ingredients": []}, {"recipe_id": "rec_161", "props": {"title": "Maple Cream Cheese French Toast Casserole", "instructions": "[Instructions] 1) Place the bread cubes in a buttered 13 x 9-inch baking dish. | 2) In a bowl beat the softened cream cheese with sugar at medium speed with an electric mixer until smooth and well combined. | 3) Add in eggs one at a time mixing well after each addition. | 4) Add in milk, half and half cream, maple syrup and vanilla; beat until well combined. | 5) Pour the cream cheese mixture over the bread cubes in the baking dish, using a fork or spoon gently lift the cubes so that they coat evenly with the egg mixture. | 6) Cover with plastic wrap and refrigerate for 8-24 hours. | 7) Next morning set oven to 375\u00b0F. | 8) Remove the dish from the fridge and let sit out at room temperature for 30 minutes. | 9) Bake uncovered for about 45-50 minutes or until set and a golden brown colour. | 10) Sprinkle with powdered sugar and serve with maple more maple syrup. | 11) Delicious!", "tags": ["kid friendly", "christmas", "sweet", "brunch", "oven", "refrigerator", "beginner cook", "easy"], "cook_time_min": 50, "servings": null, "cuisine": ["All"], "rating_avg": 4.41, "rating_count": 24, "popularity_score": 4.493529411764706, "nutrition_calories": 548.9, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/16/03/90/8suDiGr7S6aIS42DZ4Gl_0S9A3951.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["kid friendly", "christmas", "sweet", "brunch", "oven", "refrigerator", "beginner cook", "easy"], "ingredients": []}, {"recipe_id": "rec_162", "props": {"title": "Microwave Egg Frittata", "instructions": "[Instructions] 1) Spray a microwave safe cereal sized bowl with the Pam. | 2) Wash the spinach, pat it dry, remove the stems, and tear it into edible sized pieces. (1/2 cup is my guess, I usually just grab a small fistful.) Toss into bottom of bowl. | 3) Either slice or dice the tomato and toss it inches Likewise with the bacon. Throw the cheese on top of that. (you can change any of the veggies to suit your tastes). | 4) Beat the two eggs and milk in a separate cup lightly with a fork, pour over the mess in the bottom of the bowl (a lot of the stuff will float, especially the spinach and bacon). Sprinkle lightly with salt and pepper. | 5) Microwave on high for 3 minutes. (I don't know how many watts my microwave is--let it cook for about 20 seconds after the center puffs up even with the rest, and it should be done) Avoid overcooking or it will form a yucky crust of crunchy egg. The sooner you eat it, the fluffier it is. After 15 minutes of sitting, it will be cold, and about half of the size it was coming out of the microwave. I don't recommend letting it sit that long.", "tags": ["cheese", "high in", "microwave", "15 mins", "easy"], "cook_time_min": 3, "servings": null, "cuisine": ["All"], "rating_avg": 4.5, "rating_count": 11, "popularity_score": 4.592380952380952, "nutrition_calories": 434.7, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/16/93/74/r1ZRbiZ3TzG7j99oerky_THE%20FOOD%20GAYS%20-%20Fritata-2.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["cheese", "high in", "microwave", "15 mins", "easy"], "ingredients": []}, {"recipe_id": "rec_163", "props": {"title": "Mini Cinnamon Twists (Oamc)", "instructions": "[Instructions] 1) Preheat oven to 375\u00b0F. | 2) Spray a baking sheet with no-fat cooking spray. | 3) Mix sugar with cinnamon in a small bowl. | 4) Separate dough into triangles. | 5) Cut each triangle in half, lengthwise. | 6) Brish each triangle with melted butter. | 7) Sprinkle with cinnamon-sugar. | 8) Place a marshmallow and the wide end of each triangle. | 9) Roll up each triangle starting from the wide end to enclose marshmallow, pinch edges of dough to seal. | 10) Place twists on prepared baking sheet, seam side down about 2in apart. | 11) Bake for 10 minutes or until golden brown. | 12) Blend icing sugar with milk in a small bol. | 13) Drizzle over warm twists. | 14) Please also try this without the marshmallows, just a yummy with a little less sweetness!", "tags": ["breakfast", "healthy", "kid friendly", "sweet", "60 mins", "for large groups", "oven", "beginner cook", "easy"], "cook_time_min": 30, "servings": null, "cuisine": ["All"], "rating_avg": 5.0, "rating_count": 8, "popularity_score": 4.83, "nutrition_calories": 83.9, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/21/72/67/46CjOeipTtKlPRgbh7kS_untitled-8944.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["breakfast", "healthy", "kid friendly", "sweet", "60 mins", "for large groups", "oven", "beginner cook", "easy"], "ingredients": []}, {"recipe_id": "rec_164", "props": {"title": "Mini Sausage and Cheese Breakfast Biscuit Sandwiches", "instructions": "[Instructions] 1) Bake biscuits according to package directions. | 2) Meanwhile, if using the pork sausage roll, cut into round slices/form into small patties. | 3) In a large skillet, cook patties in oil. | 4) Slice cheese into 1/2 inch square slices. | 5) Butter biscuit halves and make biscuit sandwiches; serve.", "tags": ["lunch snacks", "kid friendly", "brunch", "30 mins", "beginner cook", "easy"], "cook_time_min": 20, "servings": null, "cuisine": ["All"], "rating_avg": 5.0, "rating_count": 12, "popularity_score": 4.86090909090909, "nutrition_calories": 458.9, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/76/01/0/dAgrUeSQLCthN6QzhU3H_SB%204%20-%20final_2.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["lunch snacks", "kid friendly", "brunch", "30 mins", "beginner cook", "easy"], "ingredients": []}, {"recipe_id": "rec_165", "props": {"title": "Mom's Favorite Cheese Strata", "instructions": "[Instructions] 1) Lightly grease casserole. | 2) Cut 3 slices of bread into 3 strips each. Fit into casserole. Sprinkle with salt, pepper and 1/3 of the onion. | 3) Add 1/3 of the cheese. Repeat layers two more times. | 4) Beat eggs, add milk, Worcestershire sauce and mustard. Pour over bread mixture. | 5) Allow to set in the refrigerator overnight. | 6) Take out 2 hours before baking. | 7) Preheat oven to 325 degrees Fahrenheit, then bake for 50 minutes.", "tags": ["cheese"], "cook_time_min": 50, "servings": null, "cuisine": ["All"], "rating_avg": 4.5, "rating_count": 3, "popularity_score": 4.649230769230769, "nutrition_calories": 537.5, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/31/99/33/1cfQiGSrTeWWnaurWJ7B_IMG_6618%20copy.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["cheese"], "ingredients": []}, {"recipe_id": "rec_166", "props": {"title": "Monte Cristo Sandwich", "instructions": "[Instructions] 1) Heat oven to 425\u00b0F. | 2) Lightly butter a baking sheet pan. I use the spray. | 3) Spread 1/2 teaspoon mustard on each slice of bread. | 4) Layer between mustard sides of two slices of bread, 1 slice cheese, 2 slices ham, 2 slices turkey, and another slice of cheese. | 5) Repeat to make four sandwiches. Whisk eggs, flour, butter, salt and pepper in a shallow dish until smooth. | 6) Blend in milk. | 7) DIP both sides of sandwiches into egg mixture until bread is lightly soaked. | 8) Place on baking sheet; drizzle any remaining egg mixture over top of sandwiches. | 9) Bake 8-10 minutes until bottom is golden brown. | 10) Turn with wide spatula and continue baking 8-10 minutes or until second side is golden brown. | 11) Serve warm dusted with powdered sugar and dip or spread raspberry preserves on sandwiches. | 12) Garnish with fresh raspberries.", "tags": ["lunch snacks", "ham", "raspberries", "pork", "poultry", "cheese", "berries", "fruit", "meat", "60 mins", "oven"], "cook_time_min": 20, "servings": null, "cuisine": ["All"], "rating_avg": 4.75, "rating_count": 47, "popularity_score": 4.740175438596491, "nutrition_calories": 535.6, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/82/11/9/hjuSNYQ6mtIctGEqGs7Q_21.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["lunch snacks", "ham", "raspberries", "pork", "poultry", "cheese", "berries", "fruit", "meat", "60 mins", "oven"], "ingredients": []}, {"recipe_id": "rec_167", "props": {"title": "Neapolitan Overnight Oat", "instructions": "[Instructions] 1) In a pint sized jar with a lid, stir together the milk with cocoa powder and agave until well combined. Stirl in the oats, cover and refrigerate overnight. | 2) In a small food processor add the frozen strawberries, sugar and 2 tablespoons vanilla yogurt. Process until smooth. | 3) Top the chocolate oats with the remaining vanilla yogurt in an even layer, layer the strawberry mixture on top of the yogurt. Top with sliced strawberries and serve immediately.", "tags": ["breakfast", "strawberry", "berries", "fruit", "15 mins", "easy"], "cook_time_min": 10, "servings": null, "cuisine": ["All"], "rating_avg": null, "rating_count": 0, "popularity_score": null, "nutrition_calories": 288.7, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/52/93/96/EOEJo2quQUK31lUy3Wbe_DSC03146-2.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["breakfast", "strawberry", "berries", "fruit", "15 mins", "easy"], "ingredients": []}, {"recipe_id": "rec_168", "props": {"title": "Old-Fashioned Blueberry Muffins", "instructions": "[Instructions] 1) Preheat oven to 400F; line twelve muffin cups with paper liners. | 2) Combine first 4 ingredients in small saucepan; stir over medium heat until butter melts; cool until mixture is warm to touch; beat in eggs. | 3) Sift flour, sugar, baking powder and salt into large bowl; add milk mixture and stir just until blended; fold in blueberries (or raspberries). | 4) Divide batter equally among prepared muffin cups; Bake until golden and tester comes out clean, about 15-20 minutes. | 5) Variation: You can use raspberries instead of blueberries.", "tags": ["breads", "breakfast", "berries", "fruit", "kid friendly", "sweet", "brunch", "60 mins", "oven"], "cook_time_min": 20, "servings": null, "cuisine": ["All"], "rating_avg": 4.71, "rating_count": 135, "popularity_score": 4.708896551724138, "nutrition_calories": 229.7, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/94/53/2/Bagak57QGIpjJ4KjI4ig_quick-blueberry-muffins-05800.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["breads", "breakfast", "berries", "fruit", "kid friendly", "sweet", "brunch", "60 mins", "oven"], "ingredients": []}, {"recipe_id": "rec_169", "props": {"title": "Old Fashioned English Breakfast Sausage (Or Sausage Patties)", "instructions": "[Instructions] 1) Place all ingredients in a large bowl,mixing well to assure spices are evenly distributed. | 2) Form into patties, refrigerate several hours to allow spices to blend. | 3) Fry over medium heat until well browned and cooked through, with no pink showing. | 4) NOTE this mixture may be stuffed into small casings, making 3-4 inch links, your guests will be so impressed!", "tags": ["high protein", "high in", "brunch", "60 mins"], "cook_time_min": 20, "servings": null, "cuisine": ["All"], "rating_avg": 4.8, "rating_count": 22, "popularity_score": 4.766875, "nutrition_calories": 225.7, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/10/40/52/XZ0f1Ig0RDq7nEDlHKXG_english-breakfast-sausage_0512.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["high protein", "high in", "brunch", "60 mins"], "ingredients": []}, {"recipe_id": "rec_170", "props": {"title": "On-The-Go Breakfast Egg Rolls", "instructions": "[Instructions] 1) Preheat oven to 425 degrees. | 2) On the stove, heat a large skillet greased with cooking spray to medium high. | 3) Whisk together egg, milk and peppers in a bowl, and add to skillet; scramble until nearly done. Add spinach and cooked meat and stir together until well-mixed, then remove from burner. | 4) Assemble the egg rolls: on each wrapper, place one-eighth of the egg mixture (almost half a cup), two tablespoons shredded jack cheese (if using) and sprinkle with half a tablespoon of asiago cheese. Moisten the edges of each egg roll wrap; fold in sides and then roll tightly the long way like an egg roll in a Chinese restaurant; place in a baking dish greased with cooking spray. | 5) Spray the top of the egg rolls with cooking spray and bake for eight minutes, then flip on the other side and cook an additional eight minutes or just until starting to crisp and turn golden. Allow a minute to cool and then ENJOY!", "tags": ["spinach", "poultry", "cheese", "greens", "vegetable", "meat", "60 mins"], "cook_time_min": 16, "servings": null, "cuisine": ["All"], "rating_avg": 4.8, "rating_count": 5, "popularity_score": 4.729333333333333, "nutrition_calories": 155.0, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/28/30/51/rODavtKLQlmaxX31flwU_DSC05590-2.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["spinach", "poultry", "cheese", "greens", "vegetable", "meat", "60 mins"], "ingredients": []}, {"recipe_id": "rec_171", "props": {"title": "Open-Face Salmon and Egg Scandinavian Sandwich", "instructions": "[Instructions] 1) Butter the bread and set aside. | 2) Flake fish. | 3) Scramble eggs with salt and pepper into large curds until just done. The eggs should still be creamy, not dry. | 4) Place eggs on bread slices. Top with salmon and sprinkle with dill to serve.", "tags": ["brunch", "15 mins", "beginner cook", "easy"], "cook_time_min": 3, "servings": null, "cuisine": ["All"], "rating_avg": 5.0, "rating_count": 2, "popularity_score": 4.745, "nutrition_calories": 118.7, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/50/48/35/MYBxgZqTLaMkIIHpcFB4_OFS%206%20-%20final_4.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["brunch", "15 mins", "beginner cook", "easy"], "ingredients": []}, {"recipe_id": "rec_172", "props": {"title": "Opposite of a Smoothie: Breakfast Crunchy", "instructions": "[Instructions] 1) In a tumbler or parfait glass, artfully layer 2-tablespoon portions of yogurt, cereal and fruit into the glass, continuing until ingredients are used up, or glass looks properly full and beautiful. | 2) End with the fruit (for prettiness sake), sprinkle with sweetener OR leave it out, according to your tastebuds. | 3) Enjoy! | 4) VARIATION #1: use other-flavored yogurts to compliment OR contrast the fruit flavors; use your imagination. | 5) VARIATION #2: other cereals work well too (Grapenuts, Muesli, flakes). | 6) VARIATION #3: how about peaches or mangoes? Halved grapes, orange bits, canned fruit cocktail (drained); let your imagination go! | 7) VARIATION #4: sprinkle in a few mini-chocolate chips, raisins, dried cranberries. Ymmm!", "tags": ["dessert", "berries", "melons", "fruit", "canadian", "kid friendly", "15 mins", "beginner cook", "easy", "inexpensive"], "cook_time_min": 2, "servings": null, "cuisine": ["All"], "rating_avg": 4.8, "rating_count": 10, "popularity_score": 4.747, "nutrition_calories": 364.2, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/29/00/90/jxdMnofTMq3FDfTFnYsA_breakfast-crunchy_2785.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["dessert", "berries", "melons", "fruit", "canadian", "kid friendly", "15 mins", "beginner cook", "easy", "inexpensive"], "ingredients": []}, {"recipe_id": "rec_173", "props": {"title": "Overnight Blueberry Coffee Cake", "instructions": "[Instructions] 1) In a bowl, beat egg, and 1/2 cup sugar. | 2) Combine flour, baking powder, and salt in medium sized bowl. | 3) Alternate adding egg mixture and then the milk to flour mixture; beating well after each addition. | 4) Stir in melted butter. | 5) Fold in blueberries. | 6) Pour into a greased 8 inch square pan, sprinkle with 2 tablespoons of remaining sugar. | 7) Cover and refrigerate overnight. | 8) Next morning, remove from refrigerator and put on counter for 30 minutes. | 9) Preheat oven to 350 degrees. | 10) Bake for 30-35 minutes or until toothpick comes out clean.", "tags": ["breakfast", "berries", "fruit", "healthy", "brunch", "60 mins", "oven", "refrigerator", "beginner cook", "easy"], "cook_time_min": 35, "servings": null, "cuisine": ["All"], "rating_avg": 4.69, "rating_count": 13, "popularity_score": 4.691739130434783, "nutrition_calories": 174.6, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/38/09/17/f2U2m5jRNyAVTuQS6v9V_overnight-blueberry-coffee-cake_3885.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["breakfast", "berries", "fruit", "healthy", "brunch", "60 mins", "oven", "refrigerator", "beginner cook", "easy"], "ingredients": []}, {"recipe_id": "rec_174", "props": {"title": "Pasteles De Guayaba (Guava and Cream Cheese Pastries)", "instructions": "[Instructions] 1) Blend the cream cheese, butter and flour until well mixed; Wrap in plastic wrap and refrigerate for at least 30 minutes. | 2) Preheat oven to 375 degrees F. | 3) Roll out the dough into a 1/4-inch thick square; Cut the rolled dough into 16 to 20 squares. | 4) A little off center of each square, place 1 tablespoon guava paste. | 5) Fold the dough over the guava paste, forming a triangle; Press the edges shut. | 6) Place the pasteles onto a cookie sheet and sprinkle them with a thin layer of sugar. | 7) Bake until the pasteles are evenly browned, about 25 minutes.", "tags": ["dessert", "tropical fruits", "fruit", "cuban", "caribbean", "kid friendly", "brunch", "60 mins", "for large groups", "easy"], "cook_time_min": 25, "servings": null, "cuisine": ["All"], "rating_avg": 4.88, "rating_count": 12, "popularity_score": 4.795454545454545, "nutrition_calories": 403.9, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/13/16/62/IvI5FWmxTAaMUmkTYuu5_0S9A7139.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["dessert", "tropical fruits", "fruit", "cuban", "caribbean", "kid friendly", "brunch", "60 mins", "for large groups", "easy"], "ingredients": []}, {"recipe_id": "rec_175", "props": {"title": "Peach Pancakes", "instructions": "[Instructions] 1) Mix egg, yogurt, milk, oil, and sugar. | 2) In a separate small bowl, combine the flour, baking powder, baking soda, and cinnamon with a wire whisk. | 3) Add the flour mixture to the liquid | 4) mixture and stir just enough to combine (batter may be lumpy). | 5) Fold in the chopped peaches. | 6) Spray a hot griddle lightly with cooking oil and preheat to 325 degrees. | 7) Pour approximately 1/4 cup of batter on. | 8) the griddle for each pancake. | 9) Cook until light brown on the bottom. | 10) Flip the pancakes over and finish cooking.", "tags": ["fruit", "60 mins", "easy"], "cook_time_min": 20, "servings": null, "cuisine": ["All"], "rating_avg": 4.0, "rating_count": 1, "popularity_score": 4.63090909090909, "nutrition_calories": 258.2, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/24/80/93/d2F5mrwmRtKKKZYuhs7Y_0S9A5178.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["fruit", "60 mins", "easy"], "ingredients": []}, {"recipe_id": "rec_176", "props": {"title": "Perfect Soft Boiled Eggs", "instructions": "[Instructions] 1) Bring the water to a rapid boil. | 2) add saltand keep it at a rapid boil. | 3) Prick the bottom (wider end) of the egg with an egg pricker | 4) Immerse in the boiling water and boil for exactly 5 minutes. | 5) Dash in cold water, crack & enjoy.", "tags": ["very low carbs", "low protein", "brunch", "15 mins", "easy"], "cook_time_min": 5, "servings": null, "cuisine": ["All"], "rating_avg": 4.71, "rating_count": 52, "popularity_score": 4.70741935483871, "nutrition_calories": 143.0, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/16/37/24/PuuGpkuvRBqeNyABzxCG_PSBE%205%20-%20final_3.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["very low carbs", "low protein", "brunch", "15 mins", "easy"], "ingredients": []}, {"recipe_id": "rec_177", "props": {"title": "Pina Colada Smoothie", "instructions": "[Instructions] 1) Blend all items together in a food processor or blender. Serve immediately.", "tags": ["beverages", "breakfast", "pineapple", "tropical fruits", "fruit", "low protein", "low cholesterol", "healthy", "kid friendly", "15 mins", "no cook", "beginner cook", "easy", "inexpensive"], "cook_time_min": 5, "servings": null, "cuisine": ["All"], "rating_avg": 5.0, "rating_count": 3, "popularity_score": 4.764615384615385, "nutrition_calories": 332.1, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/45/09/76/aeWrbwFTeu2SXJVowt9H_IMG_9423.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["beverages", "breakfast", "pineapple", "tropical fruits", "fruit", "low protein", "low cholesterol", "healthy", "kid friendly", "15 mins", "no cook", "beginner cook", "easy", "inexpensive"], "ingredients": []}, {"recipe_id": "rec_178", "props": {"title": "Pineapple Upside Down Biscuits", "instructions": "[Instructions] 1) Preheat the oven to temperature as stated on biscuits. | 2) Using a cupcake or muffin tin grease 10 cups. | 3) Drain the can of crushed pineapple, saving the juice. | 4) Stir together the pineapple, sugar and butter until well mixed. | 5) Divide the pineapple mixture amongst the muffin cups. | 6) Place a cherry in the center of each tin, pressing to make sure cherry touches the bottom of the cup. | 7) Place 1 biscuit in each cup on top of the pineapple mixture. | 8) Spoon 1 teaspoon of the reserved pineapple juice over each biscuit. | 9) Bake for 12 to 15 minutes, or until golden brown. | 10) Cool for 2 minutes. | 11) Invert the pan onto a plate to relase the biscuits. | 12) Serve warm sprinkled with powdered sugar or plain.", "tags": ["breakfast", "low protein", "30 mins", "easy"], "cook_time_min": 15, "servings": null, "cuisine": ["All"], "rating_avg": 4.61, "rating_count": 42, "popularity_score": 4.626153846153846, "nutrition_calories": 435.1, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/10/18/93/QgZpDBJfTWyhSzUTavVe_pineapple%20upside%20down%20biscuits%20101893-6.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["breakfast", "low protein", "30 mins", "easy"], "ingredients": []}, {"recipe_id": "rec_179", "props": {"title": "Pioneer Woman's Monkey Bread", "instructions": "[Instructions] 1) preheat that oven to 350. | 2) open up all three cans of biscuits and cut each biscuit into quarters. | 3) At this time you\u2019ll want to combine the 1 cup of regular sugar with 2-3 teaspoons of cinnamon. I use 3 teaspoons of cinnamon and this gives it a fairly strong cinnamon flavor. If you\u2019re not so hot on cinnamon, cut it back to 2 teaspoons. Dump these into a 1 gallon zip bag and shake to mix evenly. | 4) drop all of the biscuit quarters into the cinnamon-sugar mix. Go ahead\u2026all of them. Yes, they\u2019re sticking together right now, but just trust me. | 5) Once all the biscuit quarters are in the bag, seal it and give it a vigorous shake. You might have some excess sugar left over and that\u2019s okay. | 6) Spread these nuggets out evenly in your bundt pan. I suppose you might want to grease this pan before doing this, but I\u2019m pretty sure the gallon of butter we are about to add will keep it safe. Un-greased always works for me. | 7) melt those two sticks of butter together with 1/2cup of brown sugar. This can be light or dark brown sugar. | 8) Stir together over a medium-high heat until the two become one. | 9) Once the brown sugar butter has become one color, you can pour it over the biscuits.At first\u2026it\u2019s going to look like too much. It\u2019s okay though. | 10) Bake this @ 350 degrees for about 30-40 minutes until the crust is a deep brown on top. | 11) If you have the willpower, allow this to cool for about 15-30 minutes before turning it over onto a plate. If it doesn\u2019t slide right down onto the plate, give it a few love-taps until it plops. It\u2019ll hold.", "tags": ["dessert", "kid friendly", "sweet", "weeknight", "brunch", "60 mins", "beginner cook", "easy", "inexpensive"], "cook_time_min": 30, "servings": null, "cuisine": ["All"], "rating_avg": 4.8, "rating_count": 7, "popularity_score": 4.737647058823529, "nutrition_calories": 460.7, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/47/85/20/npPc9B4Tf9O7gABeaHgO_Pioneer%20womans%20monkey%20bread%20478520-8.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["dessert", "kid friendly", "sweet", "weeknight", "brunch", "60 mins", "beginner cook", "easy", "inexpensive"], "ingredients": []}, {"recipe_id": "rec_180", "props": {"title": "Poached Eggs Florentine", "instructions": "[Instructions] 1) CHEESE SAUCE: Mix the cornstarch to a paste with about a 1/4 cup of the milk. Pour the remaining milk and butter into a nonstick saucepan and bring to a boil. Reduce to simmer. | 2) Stir the boiling milk into the cornstarch mixture, then pour back into the pan. Bring to a boil, stirring. Once it has thickened, simmer for 2 minutes. | 3) Remove from the heat, stir in the Gruy\u00e8re cheese, salt, pepper, and optional nutmeg. Cover the surface of the sauce with parchment paper to prevent a skin from forming and set aside in a warm place. | 4) SPINACH: Heat the oil in a large saucepan. Add the green onion (or leeks) and saute' for about 3 minutes, until they begin to soften. | 5) Add the spinach and stir over medium heat for 2\u20133 minutes until the spinach has wilted and the leeks are tender. | 6) Drain the vegetables in a sieve or fine mesh strainer, pressing down with the back of a spoon to remove any excess moisture. Return to the pan and season with dill, salt, and pepper. Cover and keep warm. | 7) EGGS: half-fill a medium sized frying pan with water and bring to a simmer. Add the vinegar. Break in the eggs, and cook gently for 3\u20134 minutes, spooning the hot water over the yolks. Lift out the eggs with a slotted spoon and drain on paper towel. | 8) Preheat the broiler. Place the whole wheat toast slices onto a parchment lined baking sheet. Spread the leek and spinach mixture evenly over each toast. Make a hollow in each spinach mixture using the back of a spoon and place a poached egg in each hollow. | 9) Spoon the cheese sauce over the eggs. Lightly dust with paprika, then place the dish under the broiler. Broil until just lightly browned.", "tags": ["spinach", "greens", "vegetable", "brunch", "30 mins", "inexpensive"], "cook_time_min": 20, "servings": null, "cuisine": ["All"], "rating_avg": 4.67, "rating_count": 3, "popularity_score": 4.688461538461539, "nutrition_calories": 363.4, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/32/82/01/iRJ1ohPlQVqSJfXI9baZ_FLORENTINE1.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["spinach", "greens", "vegetable", "brunch", "30 mins", "inexpensive"], "ingredients": []}, {"recipe_id": "rec_181", "props": {"title": "Beautiful Quiche Lorraine", "instructions": "[Instructions] 1) Combine the cheese and flour and sprinkle into the pie shell. | 2) Spread the ham evenly over this. | 3) Combine the eggs, milk, salt and mustard. | 4) Beat until smooth and pour evenly over the cheese and ham. | 5) Bake at 375 degrees for 45 minutes, or until the custard is set. | 6) Serve warm, garnished with chopped parsley. | 7) To freeze: Prepare recipe through step 4. Wrap well with saran wrap and then foil. Freeze. | 8) To serve: Thaw in fridge overnight. Bake as directed.", "tags": ["lunch snacks", "ham", "pork", "cheese", "meat", "brunch", "60 mins", "oven", "beginner cook", "easy", "inexpensive"], "cook_time_min": 45, "servings": null, "cuisine": ["All"], "rating_avg": 4.82, "rating_count": 28, "popularity_score": 4.786842105263158, "nutrition_calories": 366.1, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/65/75/8/msgH6Qh6fKeBsmuOOww4_QUICHE_LORRAINE_056.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["lunch snacks", "ham", "pork", "cheese", "meat", "brunch", "60 mins", "oven", "beginner cook", "easy", "inexpensive"], "ingredients": []}, {"recipe_id": "rec_182", "props": {"title": "Quiche Lorraine Cups", "instructions": "[Instructions] 1) Lightly grease a 12 muffin pan or 12 custard cups. | 2) Line each with a crepe, fluting them. | 3) Sprinkle bacon into the crepes. | 4) Divide the cheese between the crepes. | 5) Mix together the flour, salt. | 6) Mix the beaten eggs and milk, add to the flour. | 7) Blend well and pour into the crepes on top of the cheese. | 8) Bake in 350F oven for 15-20 minutes or until firm. | 9) Cool 5 minutes before removing from pan.", "tags": ["breakfast", "lunch snacks", "pork", "cheese", "meat", "canadian", "60 mins", "oven", "easy"], "cook_time_min": 25, "servings": null, "cuisine": ["All"], "rating_avg": 5.0, "rating_count": 4, "popularity_score": 4.781428571428571, "nutrition_calories": 152.2, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/19/17/0/U4luIVT7QGyCun9REDLV_DSC04899-2.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["breakfast", "lunch snacks", "pork", "cheese", "meat", "canadian", "60 mins", "oven", "easy"], "ingredients": []}, {"recipe_id": "rec_183", "props": {"title": "Raspberry-Mint Agua Fresca", "instructions": "[Instructions] 1) Select 4 tumblers. | 2) In a saucepan, combine the sugar and \u00bd cup water. | 3) Bring to a simmer over med-low heat, stirring to dissolve the sugar. | 4) Remove the sugar syrup form the heat and let cool. | 5) In a blender, combine 18 of the raspberries, the mint leaves, and the sugar syrup and process until a smooth puree forms. | 6) Strain the puree through a fine-mesh sieve into a pitcher. | 7) You should have about 2/3 cup. | 8) Add 1 1/3 cups water. | 9) Fill the glasses with ice and divide the raspberry mixture among the glasses. | 10) Garnish with mint sprigs and remaining raspberries speared on a cocktail pick. | 11) Serve at once.", "tags": ["raspberries", "berries", "fruit", "30 mins", "stove top", "easy"], "cook_time_min": 5, "servings": null, "cuisine": ["All"], "rating_avg": null, "rating_count": 0, "popularity_score": null, "nutrition_calories": 102.4, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/gk-static/fdc-new/img/fdc-shareGraphic.png"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["raspberries", "berries", "fruit", "30 mins", "stove top", "easy"], "ingredients": []}, {"recipe_id": "rec_184", "props": {"title": "Real, \"down Home\" Southern Country Biscuits and Gravy:", "instructions": "[Instructions] 1) FOR THE BISCUITS:. | 2) Wash Hands. | 3) Sift flour into a medium or large mixing bowl. Shake the bowl side-to-side lightly to even out the flour. | 4) Beat the eggs slightly to blend yolks and whites. | 5) Combine oil and egg with half the buttermilk and pour into the flour. Mix thoroughly with a large spoon or fork, or use your hand to squeeze the dough through your fingers, until the dough is well blended. | 6) Add the remaining buttermilk, a little at a time, blending into the dough after each addition, until the right consistency is achieved. | 7) The dough should be just firm enough to form into balls but light enough to slump slightly when placed onto the baking sheet. Experience will enable you to tell from the feel of the dough. If dough is too light, add flour, 1 tablespoon at a time, mixing thoroughly each time, until the dough is the right consistency. If dough is too dense (stiff), add buttermilk, 1 tablespoon at a time, blending well into the dough after each addition, until the dough is the right consistency. | 8) Clean the dough off your hands, then rinse and dry them. Flour the palms and fingers of both hands to prevent the dough from sticking to them. | 9) Pinch off a handful of dough roughly 2/3 the size you want your biscuits to be and roll it between your hands in a circular motion, using just enough pressure to form a ball. Shaping the dough will flour the outside of the biscuit. | 10) Place the ball of dough onto an ungreased baking sheet and press down with fingers just enough to flatten the dough slightly and form the biscuit shape. Repeat, flouring hands after each dough ball is formed and placing biscuits about 1/2-inch to 3/4-inch apart, until all the dough is used up. | 11) Cathead Biscuits. | 12) For cathead biscuits, use about half again as much dough for each biscuit as you would use for regular size biscuits, leaving them thicker than for regular biscuits. Place cat-head biscuits about 3/4-inch apart on the baking sheet. | 13) Place the pan of biscuits as close to the vertical center of the preheated 350-degree oven as your rack guides will allow and bake for 20-30 minutes. Check biscuits after 20 minutes and periodically thereafter until done. Biscuits will be done when the tops are golden brown. Cathead biscuits will take longer to bake. The lower edges of the biscuits may be slightly lighter than the center. | 14) Remove biscuits from oven when done. Serve hot. | 15) Makes 8 to 10 biscuits, or 4 to 5 cathead biscuits. | 16) FOR THE GRAVY. | 17) Mix evaporated milk and water and set aside within reach. | 18) In a large, cast iron skillet, combine oil (or meat fat), flour, salt, and pepper. | 19) Over medium-high heat, stir in flour until blended with oil. With a fork, tines flat against the skillet's bottom, stir the mixture constantly, using a back-and-forth motion, until it begins to brown very slightly. Do not allow the flour to scorch or burn. | 20) When flour has browned slightly, pour in milk, all at once, stirring constantly. | 21) Continue to stir, scraping the bottom of the skillet as you stir, in the manner previously described, to keep flour and milk from scorching and to keep lumps from forming. Bring to a boil, stirring constantly. | 22) As soon as the mixture boils, marked by a sudden foaming up of the mixture, reduce heat to medium so that mixture simmers but does not boil over. Briefly lift pan from heat if necessary to keep contents from boiling over. Don't forget to use a pot holder to avoid being burned. | 23) Continue to stir vigorously, as described above, until gravy achieves desired thickness, usually within a minute or two after boiling. When the gravy is the desired thickness, immediately remove from heat. Serve from the skillet or pour into a serving bowl. | 24) Add additional salt and pepper if needed. | 25) Serves 4.", "tags": ["breakfast", "weeknight", "4 hours", "easy"], "cook_time_min": 30, "servings": null, "cuisine": ["All"], "rating_avg": 5.0, "rating_count": 6, "popularity_score": 4.80875, "nutrition_calories": 609.9, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/38/65/70/USRIKmeSdyZQigo1FpL5_biscuits%20and%20gravy%20SITE-2.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["breakfast", "weeknight", "4 hours", "easy"], "ingredients": []}, {"recipe_id": "rec_185", "props": {"title": "Remarkable Rhubarb Bites", "instructions": "[Instructions] 1) Preheat oven to 350\u00b0F. | 2) Mix together rhubarb and 1/2 cup sugar. | 3) Set aside. Cream shortening, remaining 1/2 cup sugar and brown sugar. | 4) Add egg and then stir in baking soda, salt, cinnamon and flour. | 5) Stir in vanilla, then rhubarb mixture. Place batter in a greased and floured 13x9\" baking pan and bake for 40-45 minutes. | 6) Let cool, sprinkle with confectioners' sugar and cut into 2\" squares. | 7) Nancy {:-).", "tags": ["dessert", "lunch snacks", "cookie and brownie", "fruit", "summer", "weeknight", "for large groups", "oven", "4 hours", "easy"], "cook_time_min": 45, "servings": null, "cuisine": ["All"], "rating_avg": 4.71, "rating_count": 35, "popularity_score": 4.706444444444445, "nutrition_calories": 148.4, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/44/5/OQS3z1T4eIxJX5UeEtJg_0S9A5287.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["dessert", "lunch snacks", "cookie and brownie", "fruit", "summer", "weeknight", "for large groups", "oven", "4 hours", "easy"], "ingredients": []}, {"recipe_id": "rec_186", "props": {"title": "Ricotta, Tomato and Basil Torte", "instructions": "[Instructions] 1) Preheat your oven to 180\u00b0C (360\u00b0F ) Oil side and line with baking paper the base of 20cm springform tin. | 2) Beat ricotta, feta, eggs and garlic until smooth. Stir in basil. | 3) Put into prepared tin and smooth top. Arrange tomatoes on top cut-side up. | 4) Bake in preheated oven for 1 hour or until set and golden. | 5) Cool completely before putting in fridge for at least1 hour to firm.", "tags": ["free of", "4 hours"], "cook_time_min": 1, "servings": null, "cuisine": ["All"], "rating_avg": 4.62, "rating_count": 8, "popularity_score": 4.661111111111111, "nutrition_calories": 178.2, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/40/22/17/JbN3OmrdSdmk0bd56hwk_Ricotta%20Tomato%20and%20Basil%20Torte%20402217%20-%20final%203.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["free of", "4 hours"], "ingredients": []}, {"recipe_id": "rec_187", "props": {"title": "Roti Canai (Authentic Malaysian Recipe)", "instructions": "[Instructions] 1) Mix the salt in the water. | 2) Put the flour in a mixing bowl. Add the salted water gradually. | 3) Mix the flour into a dough. kneed until smooth. Make sure the texture of the dough is not too sticky and gooey. | 4) Oil your hands with cooking oil and then make the dough into palm sized balls. | 5) In a bowl pour some oil so that the dough doesn\u2019t stick to the bowl. Put in the balls, coating it with oil as you put one on top of each other. After it is all in a bowl, totally immerse it in oil. Leave over night. | 6) Oil your kneading space. Take out one dough ball, flatten it out into with you palms until the size of a dinner plate. | 7) Flip it like a pizza (I put a link below to show you how to flip it). | 8) Flip the dough a couple of times and spread it out until paper thin. | 9) Take the one edge and fold it to the middle. Do this another three times so that it will turn into a square. | 10) Grease a flat pan or skillet with cooking oil and cook until golden brown. | 11) http://youtube.com/watch?v=3EucCu1zafk&feature=related.", "tags": ["breakfast", "asian", "30 mins", "easy"], "cook_time_min": 10, "servings": null, "cuisine": ["All"], "rating_avg": 4.4, "rating_count": 11, "popularity_score": 4.54, "nutrition_calories": 709.3, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/27/07/23/9iEMVgMhQxWMEDP3fydW_roti1%20(1%20of%201).jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["breakfast", "asian", "30 mins", "easy"], "ingredients": []}, {"recipe_id": "rec_188", "props": {"title": "Savory Breakfast Tart", "instructions": "[Instructions] 1) Crust:. | 2) Preheat oven to 400 degrees fahrenheit. | 3) Chopped chilled butter into 1/4 inch pieces and mix in flour and salt. Add water until dough holds together loosely. | 4) Shape into a 5\"x5\" disc and wrap in cling wrap; chill in refrigerator for 15 minutes. | 5) Press dough into tart pan using \"lift and pinch\" method. Poke 3-4 times with fork. Line with parchment paper or tin foil, and fill with baking beads or rice. | 6) Bake for 15 minutes, remove parchment and baking beads, then bake for an additional 5 minutes. | 7) Set aside to cool. | 8) Filling:. | 9) Dice yellow onion and saute in olive oil until carmelized. Remove from heat. | 10) Line bottom of tart crust with grated Gruyere cheese. | 11) Layer bacon bits on top. | 12) Once cooled, gently lay sauteed onions on top of bacon layer. | 13) Whisk together egg yolks, egg, salt, pepper, and heavy cream. | 14) Pour egg mixture into tart crust until filling approaches top edge of tart crust. | 15) Sprinkle grated parmesan on top. | 16) Cook tart in oven for 20-25 minutes. | 17) Allow to cool before serving. | 18) Tomato Balsamic Jam:. | 19) Dice onions and garlic. Use box grater to coarsley grate apple. | 20) Saute onions and garlic in large sauce pan until onions are translucent (about 5 minutes). | 21) Add in apple, vinegar, salt, pepper, and tomatoes. | 22) Keep on low simmer stirring occasionally, for about 45 minutes until jam has paste consistency. | 23) Remove from heat. Once jam has cooled, spread a thin layer in a ring on top of tart. Garnish with arugala (optional).", "tags": ["brunch", "4 hours"], "cook_time_min": 40, "servings": null, "cuisine": ["All"], "rating_avg": 5.0, "rating_count": 3, "popularity_score": 4.764615384615385, "nutrition_calories": 629.5, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/53/63/46/wvvIUhCSQVSbRJwiL1uQ_0S9A9346.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["brunch", "4 hours"], "ingredients": []}, {"recipe_id": "rec_189", "props": {"title": "Scotch Eggs", "instructions": "[Instructions] 1) Peel eggs. | 2) Divide sausage into 12 equal portions. | 3) Roll each egg in flour then wrap the sausage around each egg. | 4) Dip sausage-wrapped eggs into beaten egg and roll in Panko bread crumbs. | 5) Heat oil to 350F and cook each egg for 4-5 minutes or until sausage is cooked and browned. | 6) Drain on paper towels and serve warm or cool.", "tags": ["pork", "meat", "lactose free", "free of", "brunch", "15 mins", "beginner cook", "easy"], "cook_time_min": 5, "servings": null, "cuisine": ["All"], "rating_avg": 4.4, "rating_count": 8, "popularity_score": 4.5633333333333335, "nutrition_calories": 403.4, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/21/40/97/LEBWRM7WQkGI6IPPY4BS_scotcheggs2%20(1%20of%201).jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["pork", "meat", "lactose free", "free of", "brunch", "15 mins", "beginner cook", "easy"], "ingredients": []}, {"recipe_id": "rec_190", "props": {"title": "Scrambled Egg Breakfast Panini", "instructions": "[Instructions] 1) Scramble eggs in frying pan. | 2) Melt butter. Brush onto each slice of bread. | 3) Sprinkle cheese onto one side of bread. | 4) Place turkey and/or bacon. | 5) Place eggs on top of meat. | 6) Place in panini maker or George Foreman Grill.", "tags": ["lunch snacks", "poultry", "meat", "15 mins", "inexpensive"], "cook_time_min": 5, "servings": null, "cuisine": ["All"], "rating_avg": 4.83, "rating_count": 6, "popularity_score": 4.745, "nutrition_calories": 238.1, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/31/20/58/MF4VdlT4SLmVGafRdKGA_0S9A8955.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["lunch snacks", "poultry", "meat", "15 mins", "inexpensive"], "ingredients": []}, {"recipe_id": "rec_191", "props": {"title": "Simple Savory Breakfast Casserole", "instructions": "[Instructions] 1) Preheat oven to 325 degrees. | 2) Cook the breakfast sausage as directed on the package. Crumble and drain. | 3) In a large bowl combine the eggs, milk, dry mustard, pepper, and salt. Mix thoroughly. | 4) Lay half the bread cubes in the bottom of a greased 9 x 13 casserole dish. | 5) Add half the cheese and sausage to the casserole dish along with half of any of the optional ingredients if desired. | 6) Repeat layer of bread, cheese, sausage, and optional ingredients if used. | 7) Pour egg mixture over the top of the casserole. | 8) Bake for about an hour or until eggs are set. Cover with foil if top browns too quickly.", "tags": ["pork", "cheese", "meat", "savory", "4 hours"], "cook_time_min": 1, "servings": null, "cuisine": ["All"], "rating_avg": 5.0, "rating_count": 2, "popularity_score": 4.745, "nutrition_calories": 547.1, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/31/62/77/TgNFa4MPTNqeo4USC6sV_simple-savory-breakfast-casserole_0011.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["pork", "cheese", "meat", "savory", "4 hours"], "ingredients": []}, {"recipe_id": "rec_192", "props": {"title": "Socca (Provencal Savory Chickpea Pancake) - Gluten-Free", "instructions": "[Instructions] 1) Place heavy (preferably cast-iron) skillet in oven and preheat to 450. | 2) In a large bowl, sift chickpea flour, pepper and salt together. After sifting, add rosemary leaves. | 3) Whisk in warm water and 2 tbsp olive oil. | 4) Cover the bowl and allow the batter set for at least 30 minutes, which should have the consistency of thick cream. Stir sliced onion into the batter. | 5) Remove skillet from oven. Add 1 tbsp olive oil to the hot pan, pour batter into pan and bake for 12-15 minutes or until the pancake is firm and the edges are set (top may not be browned). | 6) Set socca a few inches below your broiler for 1-2 minutes, just long enough to brown it in spots. Cut into wedges and serve hot, with toppings of your choice.", "tags": ["european", "vegan", "low cholesterol", "kosher", "free of", "savory", "30 mins"], "cook_time_min": 15, "servings": null, "cuisine": ["All"], "rating_avg": 4.9, "rating_count": 21, "popularity_score": 4.833548387096775, "nutrition_calories": 370.0, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/18/95/71/vvxKebUzTz2lhQxPcucT_untitled-3085.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["european", "vegan", "low cholesterol", "kosher", "free of", "savory", "30 mins"], "ingredients": []}, {"recipe_id": "rec_193", "props": {"title": "Southwest Breakfast Casserole", "instructions": "[Instructions] 1) Lightly butter both side of bread slices and place in 9x13-inch baking dish. | 2) In nonstick skillet, over medium-high heat, brown beef sausage; drain well and pat with paper towels. Sprinkle sausage over bread slices. | 3) Sprinkle cheese over sausage. Follow with a layer of chopped green chilies. | 4) In medium bowl, beat eggs lightly. Add salt, dry mustard and half-and-half. Mix thoroughly. Pour over casserole. | 5) Cover with foil and refrigerate overnight. | 6) To bake, preheat oven to 350\u00b0F and bake casserole 45 minutes, or until bubbly and lightly browned. Allow to stand 15 minutes to set. Cut into squares and serve with picante sauce on the side.", "tags": ["cheese", "meat", "mexican", "potluck", "brunch", "60 mins", "oven", "beginner cook", "easy", "inexpensive"], "cook_time_min": 45, "servings": null, "cuisine": ["All"], "rating_avg": 4.8, "rating_count": 5, "popularity_score": 4.729333333333333, "nutrition_calories": 584.5, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/14/21/84/GSOGQm2xTwGynAEgcZe1_southwest%20bfast%20casserole%20SITE-3.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["cheese", "meat", "mexican", "potluck", "brunch", "60 mins", "oven", "beginner cook", "easy", "inexpensive"], "ingredients": []}, {"recipe_id": "rec_194", "props": {"title": "Special Steak and Eggs", "instructions": "[Instructions] 1) Butter a pan and let it heat. | 2) After hot, add oil and let steaks cook about three minutes on each side, turn only once and then take out and reserve for later. | 3) In the grease left in the pan, add the worcestershire sauce, the thyme, the salt and peper,let the onions cook at medium heat for 5 minutes add the tomatos, put heat in low, cover and let it cook for 3 minutes. | 4) Open up the pan, include the steaks, cover with the sauce from the ingredients and let them heat up again. | 5) Serve in the dish with all sauce and fried eggs on top.", "tags": ["south american", "free of", "30 mins", "easy"], "cook_time_min": 30, "servings": null, "cuisine": ["All"], "rating_avg": 5.0, "rating_count": 4, "popularity_score": 4.781428571428571, "nutrition_calories": 282.3, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/42/72/6/n0ApBlj6T1iRLjbhKo3T_0S9A5193.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["south american", "free of", "30 mins", "easy"], "ingredients": []}, {"recipe_id": "rec_195", "props": {"title": "Spinach Feta Frittata", "instructions": "[Instructions] 1) Preheat oven to 350F degrees. | 2) Cook onion in olive oil until opaque in a medium skillet. | 3) Add mushrooms and cook for about 1 minute. | 4) Add the spinach and cook until warmed through. | 5) Grease a 9\" casserole dish with cooking spray. | 6) Put the vegie mixture in the bottom of the casserole dish. | 7) Add crumbled feta to the eggs and pour over. | 8) Top with mozzarella cheese. | 9) Bake at 350F for approx 30 minutes, or until the eggs are solid. | 10) Cool for about 5 minutes then cut into serving size squares.", "tags": ["lunch snacks", "pork", "cheese", "vegetable", "meat", "brunch", "60 mins", "oven"], "cook_time_min": 35, "servings": null, "cuisine": ["All"], "rating_avg": 4.84, "rating_count": 19, "popularity_score": 4.789655172413793, "nutrition_calories": 279.6, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/19/31/0/lqy0LRreTJCLTHriCEVQ_spinach-feta-frittata-2964.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["lunch snacks", "pork", "cheese", "vegetable", "meat", "brunch", "60 mins", "oven"], "ingredients": []}, {"recipe_id": "rec_196", "props": {"title": "Stuffed French Toast", "instructions": "[Instructions] 1) FRENCH TOAST:. | 2) In a small bowl, combine cream cheese and strawberry jam. Stir in sliced strawberries. | 3) Cut a slit through the side of each slice of bread, without cutting all the way through, to create a pocket. Scoop strawberry filling into the pocket and press gently shut. | 4) In a shallow bowl, whisk together egg, heavy cream, vanilla extract, brown sugar and cinnamon. Dunk each slice of bread into egg mixture, soaking each side. Shake off any excess liquid. Cook bread slices on a lightly greased nonstick griddle or skillet on medium heat until browned on both sides, about 2 minutes per side. Remove from heat. | 5) FOR ASSEMBLY:. | 6) Frame the French toast with the split banana. Sprinkle powdered sugar. Use all other ingredients to top like a sundae.", "tags": ["15 mins", "easy"], "cook_time_min": 10, "servings": null, "cuisine": ["All"], "rating_avg": null, "rating_count": 0, "popularity_score": null, "nutrition_calories": 610.0, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/53/56/17/XpfpCASGQgSPW4PQMdJU_0S9A5532.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["15 mins", "easy"], "ingredients": []}, {"recipe_id": "rec_197", "props": {"title": "Sun-Dried Tomato, Basil and Black Pepper Scones", "instructions": "[Instructions] 1) Preheat oven 400 degrees. | 2) Stir together dry ingredients and herbs; first 7 ingredients. | 3) Blend in butter to look like coarse cornmeal. | 4) Stir in tomatoes. | 5) Mix milk with egg; stir into flour mixture until moist. | 6) Gentily knead 8 to 10 turns; then pat into 6\" circle on ungreased baking sheet. | 7) Cut 8 wedges and separate slightly. | 8) Bake until golden 15 - 20 minutes. | 9) Brush with seasoned olive oil or melted butter.", "tags": ["quick breads", "breads", "breakfast", "vegetable", "european", "high in", "savory", "brunch", "60 mins", "easy"], "cook_time_min": 20, "servings": null, "cuisine": ["All"], "rating_avg": 5.0, "rating_count": 11, "popularity_score": 4.854285714285714, "nutrition_calories": 297.1, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/37/24/43/x583YvHEQmWWRctQeTQJ_0S9A8942.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["quick breads", "breads", "breakfast", "vegetable", "european", "high in", "savory", "brunch", "60 mins", "easy"], "ingredients": []}, {"recipe_id": "rec_198", "props": {"title": "Tasty Oatmeal the Microwave Way!", "instructions": "[Instructions] 1) Combine ingredients in microwave safe dish/pot. Nuke 2 mins 20 sec. Stir. If still \"water-y,\" nuke 10-15 seconds. | 2) ***Note #1: I often use whatever fresh fruit I have on hand -- chopped apples, cut up bananas, fresh peaches, etc. | 3) ***Note #2: I also like to use dried fruit such as raisins, cherries, blueberries, etc. When using dried fruit, I like to nuke the fruit in enough water to cover for appx 2 mins, depending on the size of the fruit and it's estimated moisture content. | 4) ***Note #3: After nuking dried fruit, do not drain if there is any water left. Add the other ingredients to the pot and go from there. | 5) ***Note #4: Other than the water and oats, I don't actually measure the other stuff, just adding a handful of this and some of that.", "tags": ["microwave", "15 mins", "easy"], "cook_time_min": 5, "servings": null, "cuisine": ["All"], "rating_avg": 4.92, "rating_count": 13, "popularity_score": 4.821739130434782, "nutrition_calories": 352.6, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/18/41/41/AIMpyGjbRzCAsRDgNGC0_microwave-oatmeal-cherries-3868.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["microwave", "15 mins", "easy"], "ingredients": []}, {"recipe_id": "rec_199", "props": {"title": "Tater Tot Ranch Sausage Cups", "instructions": "[Instructions] 1) Preheat oven to 400 degrees F. Spray a 12-well muffin tin with nonstick cooking spray. Place 5 tater tots in each well and bake for 20 minutes until tater tots are soft. | 2) Remove from oven and use the bottom of a shot glass or your fingers to press the tater tots flat on the bottom and up the sides of each well. Bake until golden and crisp, about 15 minutes. | 3) In a large bowl, stir to combine the sausage, Colby cheese, cheddar cheese, parmesan cheese, roasted red bell peppers, mayonnaise, sour cream, ranch seasoning and chopped scallion whites. Spoon the mixture into the tater tot cups, then return to the oven and bake until cheese is melted, about 6-8 minutes. | 4) Remove the cups from the muffin tin and top each with a sprinkle of scallion greens and pinch chili flakes.", "tags": ["potato", "vegetable", "meat", "60 mins"], "cook_time_min": 45, "servings": null, "cuisine": ["All"], "rating_avg": null, "rating_count": 0, "popularity_score": null, "nutrition_calories": 273.8, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/53/86/57/EatLHA5OQTW48h1dB58I_0S9A1952.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["potato", "vegetable", "meat", "60 mins"], "ingredients": []}, {"recipe_id": "rec_200", "props": {"title": "The Best Tofu Scramble", "instructions": "[Instructions] 1) In a large saucepan on medium-high heat, saute the onions in oil until translucent. | 2) In a medium bowl, stir together the crumbled tofu, garlic,nutritional yeast, tamari, mustard, turmeric, sage, basil, salt and pepper until well-mixed. | 3) Add tofu mixture to onions and scramble until tofu is browned and all the liquid has evaporated. | 4) Toss with tomatoes and serve immediately.", "tags": ["30 mins"], "cook_time_min": 15, "servings": null, "cuisine": ["All"], "rating_avg": 5.0, "rating_count": 14, "popularity_score": 4.8725000000000005, "nutrition_calories": 179.7, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/36/24/58/An9NX7AZQ5m5x9wXOXJn_DSC_4035.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["30 mins"], "ingredients": []}, {"recipe_id": "rec_201", "props": {"title": "Trail Mix Granola Muffins", "instructions": "[Instructions] 1) In mixing bowl combine milk, granola, sugar, butter, molasses, egg and apple blend well. | 2) In large bowl combine remaining ingredients. | 3) Add milk mixture and stir just until dry ingredients are moistened. | 4) Spoon into 18 lined or greased muffin cups. | 5) Bake at 400 for 20 minutes.", "tags": ["breads", "breakfast", "60 mins", "for large groups"], "cook_time_min": 20, "servings": null, "cuisine": ["All"], "rating_avg": 5.0, "rating_count": 9, "popularity_score": 4.838947368421053, "nutrition_calories": 272.6, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/16/22/10/YtpqiJOfTCXhOSpdLg4r_DSC05572-2.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["breads", "breakfast", "60 mins", "for large groups"], "ingredients": []}, {"recipe_id": "rec_202", "props": {"title": "' Utah ' Scones (Deep-Fried)", "instructions": "[Instructions] 1) Dissolve yeast in the 1/2 cup of warm water. | 2) Add the tablespoon of sugar to the yeast-water mixture and set aside. | 3) Beat the 3 eggs in a small bowl and set aside. | 4) Put honey, brown sugar, smart balance, and salt in a large bowl (preferably the bowl for your Kitchen-Aid mixer, if you have one). | 5) Add 1 cup boiling water to the large bowl (with the sugar, salt, etc.). | 6) Add the 3 beaten eggs to the large bowl and mix. | 7) Add the yeast mixture to the large bowl. | 8) Slowly add the flour to the large bowl while mixing. | 9) Continue beating the mixture with a mixer until smooth. | 10) Cover the bowl with a dish towel, and let the dough rise for 1 hour. | 11) Refrigerate the dough until cold. (Sometimes it's nice to make the dough the night before, and finish them in the morning). | 12) Roll the dough out on a floured surface to about 1/4\" thin (careful not to get any water on it, as water and deep-frying DO NOT MIX!). | 13) Heat oil with a high smoke point (peanut oil, sunflower oil, safflower oil, canola oil in a pinch) in a deep-fryer or electric skillet to around 350 degrees F. Make sure not to use olive oil, as it has a low smoke point and is not suited for deep-frying. Use a deep-frying thermometer to check the temperature of the oil, if at all possible. (Make sure to have at least 2 inches of clearance between the top of the skillet and the top of the oil to allow room for bubbling). If your oil starts to smoke (and you'll know it if this happens! Oil smoke smells really nasty), turn off the heat, let the oil cool, then throw out the oil; it's no good. | 14) While oil is heating, cut the dough into pieces, 4 inch squares seem best to me, but you can make them smaller or larger. | 15) Fry the pieces of dough in the heated oil, preferably one at a time, until puffy and golden brown. Remove from oil using an all-metal utensil. | 16) Place on paper towels to cool, but serve warm with the topping of your choice.", "tags": ["yeast breads", "quick breads", "breads", "grains", "healthy", "sweet", "brunch", "mixer", "for large groups", "deep fried", "small appliance", "4 hours", "inexpensive"], "cook_time_min": 1, "servings": null, "cuisine": ["All"], "rating_avg": 5.0, "rating_count": 3, "popularity_score": 4.764615384615385, "nutrition_calories": 183.2, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/35/04/00/bCm0tYohSSGyTpxJDf0p_untitled-8688.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["yeast breads", "quick breads", "breads", "grains", "healthy", "sweet", "brunch", "mixer", "for large groups", "deep fried", "small appliance", "4 hours", "inexpensive"], "ingredients": []}, {"recipe_id": "rec_203", "props": {"title": "Vegan Breakfast Sausage", "instructions": "[Instructions] 1) Stir together flax and water in a small bowl or cup, set aside. | 2) In a food processor, add dry oats and pulse on high six or seven times, add the rice and pulse a few more times. | 3) Add remaining ingredients including 1 T canola oil and flax/water mixture and blend till just mixed. (do not over process, you can finish mixing together with your hands). | 4) With dampened hands, form balls the size of a ping pong ball and then flatten into little patties about 1/4\" thick (thicker if you like). | 5) coat the bottom of a non-stick frying pan with the remaining 1 T canola oil and heat over medium high. | 6) When the oil is hot, cook the patties on each side until they are browned. | 7) transfer to a paper towel to blot off any excess oil before serving.", "tags": ["lunch snacks", "brown rice", "medium grain rice", "rice", "vegan", "low cholesterol", "30 mins", "inexpensive", "from scratch"], "cook_time_min": 10, "servings": null, "cuisine": ["All"], "rating_avg": 4.75, "rating_count": 12, "popularity_score": 4.724545454545455, "nutrition_calories": 228.3, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/43/71/26/xVDv0JwmQNabJWz0VR5Z_untitled-0962.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["lunch snacks", "brown rice", "medium grain rice", "rice", "vegan", "low cholesterol", "30 mins", "inexpensive", "from scratch"], "ingredients": []}, {"recipe_id": "rec_204", "props": {"title": "Vegetable Quiche Cups -SBD-", "instructions": "[Instructions] 1) Heat oven to 350F. | 2) Line a 12 cup muffin pan with foil baking cups, spray the cups with cooking spray. | 3) Thaw and drain spinach, wring it out well by hand. | 4) Mix the spinach, egg whites or substitute, cheese, peppers, onions, hot pepper sauce and salt in a bowl. | 5) Fill the foil cups with the mixture. | 6) Bake at 350F or 20 minutes, testing so that a knife inserted in the middle comes out clean. | 7) Remove from cups to serve.", "tags": ["breakfast", "lunch snacks", "cheese", "vegetable", "savory", "brunch", "60 mins", "oven", "easy"], "cook_time_min": 20, "servings": null, "cuisine": ["All"], "rating_avg": 4.28, "rating_count": 44, "popularity_score": 4.3566666666666665, "nutrition_calories": 9.2, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/81/31/9/ziXyA4PFS8aUqT50HjzE_0S9A3491.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["breakfast", "lunch snacks", "cheese", "vegetable", "savory", "brunch", "60 mins", "oven", "easy"], "ingredients": []}, {"recipe_id": "rec_205", "props": {"title": "Veggie Breakfast Casserole", "instructions": "[Instructions] 1) Mix together the potatoes, tofu, and soy sauce. | 2) Saute the onion and garlic in the oil until translucent. | 3) Preheat the oven to 325 degrees F. | 4) Mix the onion and garlic into the potato mixture, and add the parsley, basil, and black pepper. | 5) Spread into an oiled 8 x 8 x 2-inch baking dish. | 6) Sprinkle with paprika and bake for 35 minutes.", "tags": ["potato", "soy tofu", "beans", "vegetable", "vegan", "low cholesterol", "kosher", "potluck", "60 mins", "oven", "easy"], "cook_time_min": 35, "servings": null, "cuisine": ["All"], "rating_avg": 4.29, "rating_count": 7, "popularity_score": 4.527647058823529, "nutrition_calories": 142.8, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/20/00/2/EMTZKGukQ9SXPVf0oodQ_untitled-8531.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["potato", "soy tofu", "beans", "vegetable", "vegan", "low cholesterol", "kosher", "potluck", "60 mins", "oven", "easy"], "ingredients": []}, {"recipe_id": "rec_206", "props": {"title": "Whole Wheat Pancakes", "instructions": "[Instructions] 1) Stir honey& oil together in a bowl. | 2) Add milk& eggs& beat well. | 3) Mix dry ingredients into the liquids until flour is moistened.", "tags": ["high in", "15 mins", "stove top", "easy", "inexpensive"], "cook_time_min": 5, "servings": null, "cuisine": ["All"], "rating_avg": 4.8, "rating_count": 152, "popularity_score": 4.793456790123456, "nutrition_calories": 269.6, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/47/66/9/3QHYVNrZTCY6cnyonM3w_WWW%202%20final%20-%20whole%20wheat%20waffles%20(1%20of%201).jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["high in", "15 mins", "stove top", "easy", "inexpensive"], "ingredients": []}, {"recipe_id": "rec_207", "props": {"title": "All-In-One Egg Casserole", "instructions": "[Instructions] 1) In a large skillet, cook bacon until crisp. Remove bacon and set aside; discard all but 2 tablespoons of drippings. Saute mushrooms and onions in drippings until tender; set aside. | 2) In a large saucepan, melt butter. Stir in the flour, salt and pepper until smooth; cook until bubbly. Gradually stir in milk and cheese; cook and stir until thickened. Stir in the bacon, mushrooms and onions; remove from the heat and set aside. | 3) For scrambled eggs, beat the eggs, milk, pepper and salt; pour into a greased skillet. Cook and stir gently until eggs are set. Remove from the heat and set aside. | 4) Cut English muffin halves in half again. Place in a greased 11-in. x 7-in. baking dish. Cover with half of cheese sauce. Spoon eggs over all; top with remaining sauce. Sprinkle with parsley. | 5) Bake, uncovered, at 325\u00b0 for 20-25 minutes or until bubbly.", "tags": ["cheese", "brunch", "60 mins"], "cook_time_min": 20, "servings": null, "cuisine": ["All"], "rating_avg": 4.5, "rating_count": 2, "popularity_score": 4.661666666666667, "nutrition_calories": 772.1, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/48/03/68/ztf0u7W3Rza8oPvAm0YN_eggs-1242.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["cheese", "brunch", "60 mins"], "ingredients": []}, {"recipe_id": "rec_208", "props": {"title": "Amish Pickled Eggs and Beets", "instructions": "[Instructions] 1) Boil first four ingredients gently for 5 minutes. | 2) Cool the liquid then pour over eggs and beets, cover and let stand overnight (or up to three days) in the refrigerator. | 3) To serve, cut eggs in half or quarters.", "tags": ["brunch", "15 mins", "easy", "inexpensive"], "cook_time_min": 15, "servings": null, "cuisine": ["All"], "rating_avg": 4.73, "rating_count": 18, "popularity_score": 4.717142857142858, "nutrition_calories": 187.0, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/11/96/85/6gy5jUQ8Qgqq463a8hfK_pickled%20egg-4.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["brunch", "15 mins", "easy", "inexpensive"], "ingredients": []}, {"recipe_id": "rec_209", "props": {"title": "Bacon and Egg Sandwich", "instructions": "[Instructions] 1) Spread 1 slice of bread with Miracle Whip. | 2) Add the fried egg. | 3) (While the egg is cooking, I flatten it with a metal spatula to break the yolk-it fits the bread better.) Spread the egg thinly with Miracle Whip. | 4) Add crisp bacon in a single layer. | 5) Next, a layer of tomato slices. | 6) Cover with other slice of bread spread with Miracle Whip.", "tags": ["lunch snacks", "pork", "vegetable", "meat", "canadian", "high protein", "high in", "30 mins", "beginner cook", "stove top", "easy", "inexpensive"], "cook_time_min": 15, "servings": null, "cuisine": ["All"], "rating_avg": 5.0, "rating_count": 26, "popularity_score": 4.915, "nutrition_calories": 334.3, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/56/19/1/WDzxa2JqShW56WpWX9a2_0S9A9647.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["lunch snacks", "pork", "vegetable", "meat", "canadian", "high protein", "high in", "30 mins", "beginner cook", "stove top", "easy", "inexpensive"], "ingredients": []}, {"recipe_id": "rec_210", "props": {"title": "Bacon 'n' Egg Salad Sandwiches", "instructions": "[Instructions] 1) In a large bowl, combine the first seven ingredients. | 2) Add the eggs and mix well. | 3) Cover and refrigerate for at least 2 hours. | 4) Serve on lettuce-lined croissants.", "tags": ["cheese", "meat", "potluck", "camping", "30 mins"], "cook_time_min": 25, "servings": null, "cuisine": ["All"], "rating_avg": 5.0, "rating_count": 3, "popularity_score": 4.764615384615385, "nutrition_calories": 445.0, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/45/98/64/picoKwPU5.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["cheese", "meat", "potluck", "camping", "30 mins"], "ingredients": []}, {"recipe_id": "rec_211", "props": {"title": "Baked Eggs in Bread (Weight Watchers)", "instructions": "[Instructions] 1) Slice off top of each dinner roll and gently remove some bread until there is a hole large enough to accommodate an egg. Arrange rolls on a baking sheet. Reserve tops. Crack an egg into each roll. Top each egg with some herbs and a bit of cream. Season with salt and pepper. Sprinkle with Parmesan. Bake in a 350 degree oven until eggs are set and bread is toasted 20 to 25 minutes. After eggs have cooked for 20 minutes, place bread tops on baking sheet and bake until golden brown. Let sit 5 minutes. Place tops on rolls and serve warm.", "tags": ["30 mins", "easy"], "cook_time_min": 25, "servings": null, "cuisine": ["All"], "rating_avg": 5.0, "rating_count": 4, "popularity_score": 4.781428571428571, "nutrition_calories": 173.3, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/41/05/13/YDfFISSQT82EazAGpjKc_ww-bread-bowls-4.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["30 mins", "easy"], "ingredients": []}, {"recipe_id": "rec_212", "props": {"title": "Baked Eggs in Tomato Cups", "instructions": "[Instructions] 1) Note the tomatoes should be fresh picked and should be at the point where you can still hollow them out but headed for buttery soft in the next day or so. | 2) Herbs: oregano,chervil, basil, sage, Mrs. Dash. | 3) Preheat oven to 425\u00b0F while slicing tomatoes. Remove tops the scoop out seeds and pulp. | 4) Place in a shallow baking dish, sprinkle with a bit of salt or Mrs Dash [I used Italian], fresh ground pepper and put in a pinch of the parmesan cheese. | 5) Crack the egg into the tomato. Sprinkle with pepper, salt or Mrs. Dash, other herbs and a tiny bit of parmesan. | 6) Bake for 20 minutes for soft yolks and 30 to 35 for hard. During the last 4 minutes place two slices of the cheddar cheese in a cross pattern on top. Melt and let brown. When I removed I put a small amount of fresh chives on top of the cheese. | 7) Serves 8.", "tags": ["vegetable", "30 mins"], "cook_time_min": 25, "servings": null, "cuisine": ["All"], "rating_avg": 5.0, "rating_count": 3, "popularity_score": 4.764615384615385, "nutrition_calories": 170.0, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/18/86/96/XPzkLyMaQGS5qg2Mhqje_0S9A3387.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["vegetable", "30 mins"], "ingredients": []}, {"recipe_id": "rec_213", "props": {"title": "Bakinbaby's Egg and Mushroom Breakfast", "instructions": "[Instructions] 1) Cook bacon till crisp in a 8-10\" skillet; drain and cut bacon into 1/2\" slices. | 2) Pour off grease and return 1-2 Tbsp (some folks suggest less) bacon grease back into pan and saute' onions & peppers about 5 minutes, stir in mushrooms; continue to cook over low heat until veggies are crisp tender ( not mushy);Place veggie mix in a small dish, set aside. | 3) Wipe skillet clean, add some olive oil to the skillet and scramble eggs. | 4) While the eggs are still soft, stir in cheese, continue cooking until eggs are just beginning to set not runny, but before they are setting up, add veggies, and immediately fold in bacon pieces right before serving. | 5) Serve on individual plates.", "tags": ["pork", "vegetable", "meat", "15 mins"], "cook_time_min": 10, "servings": null, "cuisine": ["All"], "rating_avg": 4.57, "rating_count": 7, "popularity_score": 4.642941176470588, "nutrition_calories": 287.5, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/37/47/25/KVwNMCzGTjOUCLc3gqwG_scrambled-egg-2.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["pork", "vegetable", "meat", "15 mins"], "ingredients": []}, {"recipe_id": "rec_214", "props": {"title": "Breakfast Club Sandwich", "instructions": "[Instructions] 1) Put the rack in the center of the oven. Preheat the oven to 425\u00baF (220\u00baC). | 2) Line a 15x10 inch (38x25 cm) dish with a sheet of parchment paper and let the sheet of paper go beyond each of the edges. | 3) Oil the sheet and the sides of the dish. | 4) Spread the slices of bacon on the cooking plate. | 5) Bake in the oven for 12 to 14 minutes or until they are a golden color and crisp. | 6) Drain excess fat on a paper towel. Set aside. | 7) In a bowl, mix the eggs and 1/4 cup (60 ml) of mayonnaise. Add salt and pepper. | 8) Pour the mixture into the cooking dish and bake from 10 to 12 minutes or until lightly moist. | 9) Cut the omelette in 6 portions. Set aside. | 10) Turn off the oven and return the bacon to the oven to reheat it. | 11) Assembly : Toast 3 slices of bread and spread mayonnaise on the surfaces. | 12) On one slice of bread, put the egg and three slices of bacon. | 13) Cover with a second slice of bread. Put 3 slices of tomato and 2 leaves of lettuce. | 14) Complete the assembly with a third slice of bread. | 15) Put a toothpick in each of the 4 corners of the sandwich and cut into triangles. | 16) Repeat the operation with the rest of the ingredients.", "tags": ["lunch snacks", "pork", "vegetable", "meat", "60 mins", "easy"], "cook_time_min": 20, "servings": null, "cuisine": ["All"], "rating_avg": 4.89, "rating_count": 20, "popularity_score": 4.824666666666666, "nutrition_calories": 398.7, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/26/76/10/R6nK6YNjRvuvJTGpeQQ9_BCS%203%20-%20final_1.png"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["lunch snacks", "pork", "vegetable", "meat", "60 mins", "easy"], "ingredients": []}, {"recipe_id": "rec_215", "props": {"title": "Breakfast Pita Pizza", "instructions": "[Instructions] 1) In a medium nonstick frying pan, heat the olive oil. | 2) Add the onion and saute for 2 to 3 minutes. | 3) Add the red pepper and continue to cook for another 3 minutes or until the pepper begins to soften. | 4) Add eggs and gently scramble until just cooked. | 5) Season with salt and pepper and remove from heat. | 6) Preheat the broiler or toaster oven. | 7) Divide the egg mixture between the pita halves. | 8) Top each pita with half the cheese and half the pancetta or bacon. | 9) Toast in toaster oven or under a broiler until the cheese just begins to melt. | 10) Serve immediately.", "tags": ["30 mins", "easy"], "cook_time_min": 12, "servings": null, "cuisine": ["All"], "rating_avg": 5.0, "rating_count": 5, "popularity_score": 4.795999999999999, "nutrition_calories": 271.4, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/32/38/46/DAp6e0RTCqL4UAb2Unls_pita2.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["30 mins", "easy"], "ingredients": []}, {"recipe_id": "rec_216", "props": {"title": "Cheese And Sausage Breakfast Casserole", "instructions": "[Instructions] 1) Grease 9x13 inch glass baking dish. | 2) Place bread cubes in prepared dish. | 3) Top with sausage and cheese. | 4) Beat together eggs, milk, mustard and salt. | 5) Season with pepper. | 6) Pour egg mixture over sausage mixture. | 7) Preheat oven to 350 degrees. | 8) Bake casserole until puffed and center is set, about 50 minutes. | 9) Cut into squares and serve.", "tags": ["pork", "cheese", "meat", "savory", "brunch", "oven", "4 hours"], "cook_time_min": 50, "servings": null, "cuisine": ["All"], "rating_avg": 4.71, "rating_count": 65, "popularity_score": 4.707866666666667, "nutrition_calories": 455.4, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/84/05/2/Kv3WH7CkRAyzmviXRjEG_sausage-egg-breakfast-casserole-3615.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["pork", "cheese", "meat", "savory", "brunch", "oven", "4 hours"], "ingredients": []}, {"recipe_id": "rec_217", "props": {"title": "Chorizo-Potato Frittata", "instructions": "[Instructions] 1) Preheat oven to 400\u00b0F. | 2) Heat a 12-inch, nonstick, oven-safe skillet over medium-high heat. | 3) Add EVOO and chorizo, and cook until the chorizo is crispy, about 3 minutes. | 4) Add the sliced potatoes and onions, and continue to cook, stirring frequently for about 5 minutes (until the potatoes are tender). | 5) Add the garlic and continue to cook for 1 minute. | 6) Beat eggs together with half-and-half then whisk in the salt and pepper. | 7) Pour the eggs over the filling and let the eggs set. | 8) Using a spatula, raise eggs off the bottom of the skillet, allowing more of the liquid egg to settle. | 9) When the frittata has set, sprinkle with the cheese and transfer to the oven. | 10) Cook for 10-12 minutes until top is deep golden brown. | 11) Remove and let stand 5 minutes. | 12) Garnish with parsley, if desired,then cut into wedges and serve. | 13) Enjoy! ;).", "tags": ["breakfast", "potato", "cheese", "vegetable", "meat", "spicy", "savory", "brunch", "30 mins", "beginner cook", "easy"], "cook_time_min": 20, "servings": null, "cuisine": ["All"], "rating_avg": 4.63, "rating_count": 19, "popularity_score": 4.652068965517241, "nutrition_calories": 380.2, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/21/79/63/95bkHYnuRzixQFAE4ORK_potato SITE-2.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["breakfast", "potato", "cheese", "vegetable", "meat", "spicy", "savory", "brunch", "30 mins", "beginner cook", "easy"], "ingredients": []}, {"recipe_id": "rec_218", "props": {"title": "Cream Cheese Scrambled Eggs in Toast Cups", "instructions": "[Instructions] 1) Beat cream cheese until smooth. | 2) Gradually add milk. | 3) Add eggs, chives and salt. | 4) Beat with a fork or whisk until foamy. | 5) Melt butter in a frying pan. | 6) When sizzling, pour in egg mixture. | 7) Cook over medium heat, stirring and moving eggs from center and from sides until eggs are thick and creamy. | 8) Serve in toast cups and sprinkle with more chives. | 9) Toast Cups: | 10) Butter both sides of bread. | 11) Push bread into lightly greased muffin cups so that corners form points. | 12) Bake at 350 degrees until golden brown. | 13) Toast cups can be made ahead and reheated just before serving.", "tags": ["kid friendly", "15 mins", "easy"], "cook_time_min": 10, "servings": null, "cuisine": ["All"], "rating_avg": 4.6, "rating_count": 5, "popularity_score": 4.6626666666666665, "nutrition_calories": 271.6, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/37/90/12/OCEEiqRER6Cra1T9Dc48_eggs-1233.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["kid friendly", "15 mins", "easy"], "ingredients": []}, {"recipe_id": "rec_219", "props": {"title": "Creamy Baked Eggs for Two", "instructions": "[Instructions] 1) Preheat the oven to 325 degrees. | 2) Butter two 8 oz ramekins, and then crack 2 eggs inside each. Be careful not to break the yolks. | 3) Sprinkle parmesan cheese on top, and then salt and pepper. | 4) Pour two tablespoons of cream over the egg mixture in each ramekin. | 5) Place the ramekins on a cookie sheet and bake for 10 to 20 minutes, or when they are done to your liking.", "tags": ["very low carbs", "30 mins"], "cook_time_min": 20, "servings": null, "cuisine": ["All"], "rating_avg": 4.8, "rating_count": 11, "popularity_score": 4.74952380952381, "nutrition_calories": 318.1, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/27/85/75/bWl9Ji4oSAV4SeeQPx0u_DSC_0156.JPG"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["very low carbs", "30 mins"], "ingredients": []}, {"recipe_id": "rec_220", "props": {"title": "Easy Breakfast Egg Casserole", "instructions": "[Instructions] 1) Heat oven to 350\u00b0F. | 2) Grease a 13x9-inch baking pan; place bread in the bottom and sprinkle with sausage and cheese. | 3) Beat eggs, milk, salt and pepper with a whisk; pour over the bread mixture. | 4) Bake 40-45 minutes or until eggs are set in the center and lightly browned.", "tags": ["pork", "cheese", "meat", "potluck", "savory", "brunch", "60 mins", "oven", "beginner cook", "easy"], "cook_time_min": 45, "servings": null, "cuisine": ["All"], "rating_avg": 4.74, "rating_count": 20, "popularity_score": 4.724666666666667, "nutrition_calories": 367.9, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/10/05/42/tBAXhA07R72F84IKWDSQ_sausage-egg-cheddar-bread-breakfast-casserole-3760.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["pork", "cheese", "meat", "potluck", "savory", "brunch", "60 mins", "oven", "beginner cook", "easy"], "ingredients": []}, {"recipe_id": "rec_221", "props": {"title": "Egg in the Basket", "instructions": "[Instructions] 1) Cut a circle in the middle of a piece of bread. | 2) If you don't have a round cookie cutter, the top of a glass will work. | 3) Heat a skillet or griddle sprayed with Pam or Mazola. | 4) Place the bread in the pan. | 5) Put about 1/2 t butter in the hole in the bread. | 6) Heat the butter until very hot. | 7) Crack an egg in the hole. | 8) Use a spatula to move the white around so it gets done. | 9) When the egg is fairly well set, turn the bread and egg over to cook the other side, being careful not to break the yolk. | 10) In the meantime, toast the holes from the bread for dipping in the yolk. | 11) Oh, and salt and pepper as desired. | 12) I guess you could toast the bread before you put it in the pan, but I've never tried it that way.", "tags": ["very low carbs", "low protein", "low cholesterol", "15 mins", "easy"], "cook_time_min": 3, "servings": null, "cuisine": ["All"], "rating_avg": 4.88, "rating_count": 26, "popularity_score": 4.828333333333333, "nutrition_calories": 0.0, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/23/10/6/picCe2Njt.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["very low carbs", "low protein", "low cholesterol", "15 mins", "easy"], "ingredients": []}, {"recipe_id": "rec_222", "props": {"title": "Eggs Benedict Casserole", "instructions": "[Instructions] 1) Cut asparagus into 1/2 inch pieces, and cook until crisp tender in a small amount of water. | 2) Melt butter in saucepan, stir in flour until smooth, then add milk and chicken broth. | 3) Bring to a boil and cook for 2 minutes while stirring continuously. | 4) Add ham and cheese, stir until cheese melts, then add drained asparagus, eggs, salt, and pepper and heat through. | 5) Serve over biscuit halves.", "tags": ["potluck", "brunch", "30 mins", "oven"], "cook_time_min": 15, "servings": null, "cuisine": ["All"], "rating_avg": 5.0, "rating_count": 2, "popularity_score": 4.745, "nutrition_calories": 553.0, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/gk-static/fdc-new/img/fdc-shareGraphic.png"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["potluck", "brunch", "30 mins", "oven"], "ingredients": []}, {"recipe_id": "rec_223", "props": {"title": "Eggs and Rice", "instructions": "[Instructions] 1) Melt butter in a skillet. | 2) Add left over rice. | 3) Make sure rice is well heated and coated with butter. | 4) Whisk eggs in a bowl then pour into the skillet. | 5) Scramble the mixture until you feel it's done.", "tags": ["rice", "very low carbs", "low protein", "kid friendly", "15 mins", "easy", "inexpensive"], "cook_time_min": 5, "servings": null, "cuisine": ["All"], "rating_avg": 4.64, "rating_count": 36, "popularity_score": 4.651739130434782, "nutrition_calories": 158.2, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/42/97/8/3mK6Zzy4TueY8P9kWRux_egg rice SITE-2.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["rice", "very low carbs", "low protein", "kid friendly", "15 mins", "easy", "inexpensive"], "ingredients": []}, {"recipe_id": "rec_224", "props": {"title": "Fried Eggs With Dill", "instructions": "[Instructions] 1) Fry your eggs sunny-side-uo or scrambled. | 2) Season with salt and pepper. | 3) Sprinkle generously with dried dill, according to your taste.", "tags": ["asian", "very low carbs", "weeknight", "15 mins", "easy"], "cook_time_min": 5, "servings": null, "cuisine": ["All"], "rating_avg": 4.77, "rating_count": 27, "popularity_score": 4.749459459459459, "nutrition_calories": 222.3, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/40/01/37/picg1sj8X.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["asian", "very low carbs", "weeknight", "15 mins", "easy"], "ingredients": []}, {"recipe_id": "rec_225", "props": {"title": "Frittata With Ham and Roasted Pepper", "instructions": "[Instructions] 1) In a bowl, with a whisk, whisk eggs, milk and Dijon mustard. Add croutons, ham and half the cheese, half bell peppers and half green onions. Pour the mixture of eggs in a greased pie plate of 9 inches or an 8 inches greased square pan. Sprinkle with remaining cheese, bell pepper and green onion. | 2) Cook in a preheated oven of 350 F for about 20 minutes or until the frittata is golden and the eggs are set. Keep cooking under the preheated grill for about 2 minutes or until frittata is golden and is lightly puffed. Put the pan on a rack and let cool for 5 minutes. Use a spatula to loosen the edges from the pan and cut in wedges.", "tags": ["pork", "cheese", "meat", "european", "broil grill", "60 mins", "oven", "easy"], "cook_time_min": 22, "servings": null, "cuisine": ["All"], "rating_avg": 4.85, "rating_count": 14, "popularity_score": 4.785, "nutrition_calories": 225.0, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/30/54/96/picXlQRpl.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["pork", "cheese", "meat", "european", "broil grill", "60 mins", "oven", "easy"], "ingredients": []}, {"recipe_id": "rec_226", "props": {"title": "Green Chile and Zucchini Quiche", "instructions": "[Instructions] 1) Preheat the oven to 375 degrees F. Stir 2 tablespoons of the melted butter into the cracker crumbs. Press the crumb mixture into the bottom and 1-inch up the side of a 9-inch glass pie plate. Bake the crust in the center of the preheated oven until it begins to brown, about 7 minutes. Remove the crust from the oven and reduce the oven temperature to 350 degrees F. | 2) Meanwhile, grate the zucchini, preferably using the grating attachment of a food processor. Toss the zucchini with 1/2 teaspoon salt and let drain in a colander for 10 minutes. Heat the oil in a medium skillet over high heat until hot. Reduce the heat to medium; add the onion and cook, stirring occasionally, until softened, about 5 minutes. Squeeze the zucchini well with your hands to remove excess moisture. Add the zucchini to the onion and cook over high heat for 3 minutes. | 3) Stir together the flour, the baking powder, and 1/4 teaspoon salt in a small bowl until combined. In a large bowl with an electric mixer, beat the eggs until thick and fluffy, about 3 minutes. Add the Monterey jack and cottage cheeses, the flour mixture, and remaining melted butter to the eggs and beat well. Stir in the zucchini mixture and chiles and pour the mixture into the crust. Bake the quiche in the center of the oven until the top is puffed and golden brown and a cake tester inserted in the center comes out clean, 35 to 40 minutes. Set aside at room temperature 5 minutes, cut into wedges, and serve with salsa, if desired.", "tags": ["cheese", "vegetable", "4 hours", "easy"], "cook_time_min": 55, "servings": null, "cuisine": ["All"], "rating_avg": null, "rating_count": 0, "popularity_score": null, "nutrition_calories": 337.6, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/52/75/51/P84qO5hNQuWe4switJ7c_0S9A3900.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["cheese", "vegetable", "4 hours", "easy"], "ingredients": []}, {"recipe_id": "rec_227", "props": {"title": "Hidden Eggs", "instructions": "[Instructions] 1) Preheat oven to 350 degrees F. | 2) In a 9-inch square pan, break up enough bread to cover bottom of pan and drizzle with 2 tablespoons melted butter. Break eggs over bread and sprinkle with salt and pepper. Break up more bread and spread on top of eggs. Drizzle with remaining 2 tablespoons butter and top with shredded cheese. | 3) Bake for 15 to 20 minutes or until eggs are done.", "tags": ["cheese", "brunch", "30 mins", "beginner cook", "easy"], "cook_time_min": 20, "servings": null, "cuisine": ["All"], "rating_avg": 4.56, "rating_count": 9, "popularity_score": 4.630526315789473, "nutrition_calories": 563.5, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/26/53/14/5XJgSIpOSlWmC3yz7u9V_DSC_0414.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["cheese", "brunch", "30 mins", "beginner cook", "easy"], "ingredients": []}, {"recipe_id": "rec_228", "props": {"title": "Kittencal's Fluffy Omelet", "instructions": "[Instructions] 1) In a small bowl whisk together eggs, baking powder, cream, green onions, salt and pepper until frothy. | 2) Heat an 8-inch skillet over medium heat until your hands feel warm when held about 2-inches above the surface; add in butter and swirl to coat the bottom of the pan evenly. | 3) Pour the whisked eggs into the skillet; let set slightly. | 4) Using a heat-proof spatula, push eggs from edge towards the center; tilt pan to let egg fill the spaces. | 5) Repeat until omelet if JUST set (about 1-2 minutes). | 6) Sprinkle the grated cheese down the center of the omelet. | 7) Using the same spatula, gently fold the omelet over the cheese. | 8) Tilt skillet and slide the filled omelet onto a serving plate (don't worry if you tear the eggs slightly!).", "tags": ["cheese", "very low carbs", "kid friendly", "brunch", "15 mins", "beginner cook", "stove top", "easy", "inexpensive"], "cook_time_min": 5, "servings": null, "cuisine": ["All"], "rating_avg": 4.9, "rating_count": 33, "popularity_score": 4.852093023255814, "nutrition_calories": 313.6, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/16/14/57/5sFowLRgOdRVvxVlRWgA_omelet SITE-2.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["cheese", "very low carbs", "kid friendly", "brunch", "15 mins", "beginner cook", "stove top", "easy", "inexpensive"], "ingredients": []}, {"recipe_id": "rec_229", "props": {"title": "Leo - Lox, Eggs and Onions (My Version With Red Bell Peppers)", "instructions": "[Instructions] 1) Saute the chopped onion and peppers in the olive oil and saute' until onion are transparent and peppers are al dente. | 2) Add the lox pieces and cook an additional 3-5 minutes until the lox is opaque. | 3) Add the eggs and toss to scramble. | 4) Keep moving eggs around until done to your liking. | 5) Note: I have also used egg beaters (6) and 2 eggs with the same delicious results.", "tags": ["very low carbs", "30 mins", "easy"], "cook_time_min": 10, "servings": null, "cuisine": ["All"], "rating_avg": 5.0, "rating_count": 2, "popularity_score": 4.745, "nutrition_calories": 207.9, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/10/91/65/xm0deGcwT8qgfHmzy498_jaja2.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["very low carbs", "30 mins", "easy"], "ingredients": []}, {"recipe_id": "rec_230", "props": {"title": "Mexican Huevos Rancheros", "instructions": "[Instructions] 1) In large skillet, heat olive oil. | 2) Add onion and green pepper, cook until tender. | 3) Add tomato, garlic, jalapeno, if using, oregano, salt, hot pepper sauce, tomato sauce and water. | 4) Simmer, covered for 20 minutes. | 5) Uncover. | 6) Break eggs, one at a time, into cup and slip into sauce. | 7) Cover and simmer over low heat until eggs are set, about 5 minutes. | 8) Serve over tortillas or toasted English muffins, topped with some of the sauce. | 9) Enjoy!", "tags": ["mexican", "60 mins"], "cook_time_min": 35, "servings": null, "cuisine": ["All"], "rating_avg": 4.88, "rating_count": 49, "popularity_score": 4.848474576271186, "nutrition_calories": 135.0, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/53/04/1/e6P4aAzGSHC8OqiPKnUZ_HR%207%20-%20final_5.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["mexican", "60 mins"], "ingredients": []}, {"recipe_id": "rec_231", "props": {"title": "Simple Microwave Poached Eggs", "instructions": "[Instructions] 1) Heat the water or butter in a custard cup. | 2) Add the egg, poke it to prevent it from exploding, and sprinkle with salt, pepper and optional Parmesan. | 3) Cover and microwave on medium for 45 to 75 seconds. | 4) Let stand, with cover on, for 1 minute.", "tags": ["canadian", "very low carbs", "microwave", "15 mins", "beginner cook", "easy", "inexpensive"], "cook_time_min": 2, "servings": null, "cuisine": ["All"], "rating_avg": 4.73, "rating_count": 13, "popularity_score": 4.714347826086957, "nutrition_calories": 71.5, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/33/64/23/NWatyL9iS4ez92m6dncr_202505870569572.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["canadian", "very low carbs", "microwave", "15 mins", "beginner cook", "easy", "inexpensive"], "ingredients": []}, {"recipe_id": "rec_232", "props": {"title": "Migas Lite for 2", "instructions": "[Instructions] 1) Warm oil in skillet. | 2) Add tortilla strips and fry until lightly golden but not crisp. | 3) Add the onion and jalapeno and cook for 2 minutes, additional oil may be needed. | 4) Add tomato and cook and additional 2 minutes. | 5) Add egg substitute and shredded meat; cook until almost set, stirring occasionally, season with salt and pepper to taste. | 6) Sprinkle cheese on top of the egg mixture, cover, turn off heat and allow to sit until cheese melts. | 7) Serve topped with your favoriate salsa, avocado slices and additional corn tortillas if desired.", "tags": ["cheese", "tex mex", "southwestern u s", "low cholesterol", "brunch", "30 mins"], "cook_time_min": 10, "servings": null, "cuisine": ["All"], "rating_avg": 5.0, "rating_count": 9, "popularity_score": 4.838947368421053, "nutrition_calories": 311.6, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/91/66/0/DXET8ggPRdmYCjRucJOx_29.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["cheese", "tex mex", "southwestern u s", "low cholesterol", "brunch", "30 mins"], "ingredients": []}, {"recipe_id": "rec_233", "props": {"title": "No Brainer Cheese and Egg Souffle", "instructions": "[Instructions] 1) In a medium bowl, mix eggs, milk, garlic salt, and pepper. Set aside. | 2) Spray 3 ramekins with non-stick cooking spray and fill 1/2 full with cheese. Pour egg mixture into ramekins and fill to top. Place ramekins on cookie sheet and bake at 375 degrees for 30 minutes until high and fluffy. Serve immediately. Enjoy!", "tags": ["cheese", "european", "very low carbs", "brunch", "60 mins", "easy"], "cook_time_min": 30, "servings": null, "cuisine": ["All"], "rating_avg": 4.76, "rating_count": 26, "popularity_score": 4.741666666666666, "nutrition_calories": 160.3, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/23/29/28/Xry11vrRaOeoJwp05S13_egg-souffle-3.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["cheese", "european", "very low carbs", "brunch", "60 mins", "easy"], "ingredients": []}, {"recipe_id": "rec_234", "props": {"title": "Nuevos Huevos Rancheritos", "instructions": "[Instructions] 1) In a large medium skillet over medium-high heat, add the butter. Once melted, add the 2 eggs and scramble with Oaxaca cheese. | 2) Once the tortillas, tomatillos and beans are cooked, place them on plate next to the guacamole. | 3) Then place the scrambled eggs on the plate and pour the tomato sauce with chipolte on top of the eggs. | 4) Now pour the cream of cilantro on top of the sauce and you are ready for your Nuevo Huevos Rancheritos!", "tags": ["brunch", "60 mins"], "cook_time_min": 10, "servings": null, "cuisine": ["All"], "rating_avg": 4.0, "rating_count": 1, "popularity_score": 4.63090909090909, "nutrition_calories": 924.0, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/submissions/recipe/33186/gKJaH4qSSBPA0M7O4KaA_Devour-31.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["brunch", "60 mins"], "ingredients": []}, {"recipe_id": "rec_235", "props": {"title": "Nyte's Deviled Eggs", "instructions": "[Instructions] 1) Cut eggs in half lengthwise, remove yolks, and reserve whites. | 2) Mash yolks until about the texture of cornmeal. | 3) Combine yolks, mayo, Worcestershire sauce, mustard, and 1 teaspoon of the vinegar mix until smooth. | 4) Slowly add more vinegar until tart and moist enough (about 1 to 2 teaspoons). If it gets tart enough but is not moist enough add a bit more mayonnaise. | 5) Add a dash of salt and mix in . | 6) Spoon mixture into center of egg whites. | 7) Sprinkle tops with paprika. Chill and serve cold.", "tags": ["60 mins"], "cook_time_min": 20, "servings": null, "cuisine": ["All"], "rating_avg": 4.5, "rating_count": 6, "popularity_score": 4.62125, "nutrition_calories": 73.8, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/22/04/18/pic1jQOhC.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["60 mins"], "ingredients": []}, {"recipe_id": "rec_236", "props": {"title": "Persian Eggs Poached in Tomato Sauce", "instructions": "[Instructions] 1) Put the oil in a non-stick skillet over medium high heat. Add onions and garlic. Stir-fry for a minute, then reduce heat to medium. Continue cooking vegetables for 3 or 4 minutes so that the onion becomes translucent with a little color around the edges. | 2) Add the tomatoes and simmer. Cook uncovered for 10 minutes. Season with salt and pepper to taste. | 3) Once the sauce has cooked, use the back of a spoon to create 4 rounded wells, one in each quarter of the pan. Carefully break each egg and place into each of the hollows. | 4) Cover pan with a lid leaving it partially open to allow some heat and moisture to escape. Cook until eggs reach your preferred level of doneness. | 5) Carefully scoop egg with some sauce onto serving plates. Garnish with chives. | 6) Serve with warmed pita or other flatbread of choice. | 7) \u2022Variation: You can make this a little spicier, add a small chili to the onions. If you do so, you may want to omit the chives and instead garnish with finely chopped parsley.", "tags": ["vegetable", "southwest asia middle east", "asian", "savory", "brunch", "30 mins", "stove top", "inexpensive"], "cook_time_min": 20, "servings": null, "cuisine": ["All"], "rating_avg": 4.9, "rating_count": 45, "popularity_score": 4.862545454545455, "nutrition_calories": 293.5, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/14/09/36/uWQCgQPS16ar9pFQvu0g_DSC_0613.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["vegetable", "southwest asia middle east", "asian", "savory", "brunch", "30 mins", "stove top", "inexpensive"], "ingredients": []}, {"recipe_id": "rec_237", "props": {"title": "Pickled Cluckerberries (Eggs)", "instructions": "[Instructions] 1) Put cold eggs in enough cold water to cover by a few inches. Bring to a boil and let cook for about five minutes -- then remove from heat for about 15 or 20 minutes. Put eggs into the coldest ice water you know how to make and chill them til they are thoroughly cold. Probably 20 minutes or so. Your eggs should peel easily without the shells sticking. | 2) While eggs are cooking- put onion slices into the pickle juice jar. | 3) Peel and smash the garlic cloves by simply pressing them with the palm of your hand on a cutting board til they split open and throw them into the jar as well. | 4) If you want a spicier egg -- then add red pepper flakes and/or hot sauce like Tobasco to the mix. | 5) Add the eggs. | 6) Let them sit in the fridge as long as you can stand it before eating. Try for at least a few days. The longer they soak the more pickled they will be. | 7) If you like really hot and spicy throw a small can of pickled jalapenos and their juice in with the brined eggs.", "tags": ["60 mins", "beginner cook", "easy", "inexpensive"], "cook_time_min": 20, "servings": null, "cuisine": ["All"], "rating_avg": 5.0, "rating_count": 8, "popularity_score": 4.83, "nutrition_calories": 80.6, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/17/86/49/pice1qLf7.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["60 mins", "beginner cook", "easy", "inexpensive"], "ingredients": []}, {"recipe_id": "rec_238", "props": {"title": "Potatoes O'brien-Breakfast", "instructions": "[Instructions] 1) Fry the sausage, and add to the potatoes, the 5 beaten eggs, milk, cheese, and salt. Stir together. | 2) Put in a greased 2-quart casserole dish. | 3) Bake at 350 degrees for 50 minutes.", "tags": ["60 mins", "easy"], "cook_time_min": 50, "servings": null, "cuisine": ["All"], "rating_avg": 4.8, "rating_count": 5, "popularity_score": 4.729333333333333, "nutrition_calories": 809.4, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/12/00/70/picgWiFKX.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["60 mins", "easy"], "ingredients": []}, {"recipe_id": "rec_239", "props": {"title": "Quick California-Style Ham and Eggs Benedict", "instructions": "[Instructions] 1) Bake biscuits according to package. | 2) Combine melted butter, 1 tablespoons chives; split biscuits, and brush with mixture. | 3) Place biscuits, buttered side up on a baking sheet and bake at 375\u00b0F for 5 minutes or until toasted. | 4) Meanwhile, prepare Hollandaise according to package, using milk and lemon juice but omit the butter. | 5) Saut\u00e9 ham in skillet over med- heat 3 minutes or until lightly browned. | 6) Stir ham and red pepper, if using, into Hollandaise sauce; keep warm. | 7) Add water to a depth of 2 inches in a large sauce pan. | 8) Bring to a boil; reduce heat, and maintain at a light simmer. | 9) Add \u00bd teas white vinegar. Break eggs one at a time into a large serving spoon, and slip carefully into the water. | 10) Simmer 3-5 minutes or to desired doneness. | 11) Remove with slotted spoon. Trim edges with sharp knife. | 12) To Serve:. | 13) Place bottom biscuit halves, buttered side up on 4 warmed plates. | 14) Top with arugula, slices of avocado (if using), and then poached eggs. | 15) Pour the Hollandaise mixture evenly over eggs. | 16) Sprinkle with remain chives and black pepper to taste. | 17) Serve remaining biscuit halves on side.", "tags": ["vegetable", "brunch", "30 mins"], "cook_time_min": 10, "servings": null, "cuisine": ["All"], "rating_avg": 5.0, "rating_count": 2, "popularity_score": 4.745, "nutrition_calories": 444.0, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/39/96/16/28H9Q0z0QyG9Md3IuQE6_Quick%20California%20Style%20Ham%20and%20Eggs%20Benedict%20399616%20-%20final%204.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["vegetable", "brunch", "30 mins"], "ingredients": []}, {"recipe_id": "rec_240", "props": {"title": "Scalloped Eggs and Bacon", "instructions": "[Instructions] 1) Preheat oven to 350 deg. F. | 2) Melt butter in medium skillet over medium heat. Add chopped onion; saute until tender. Whisk in flour until thoroughly combined. Add milk; continue stirring until thick. Add cheeses; stir until melted. | 3) Place 1/2 of eggs in bottom of small baking dish; pour 1/2 of cheese mixture over eggs. | 4) Sprinkle with 1/2 of bacon and 1/2 of fried onions. Repeat layers. | 5) Bake uncovered 15 to 20 minutes or until heated through.", "tags": ["brunch", "60 mins", "easy", "inexpensive"], "cook_time_min": 20, "servings": null, "cuisine": ["All"], "rating_avg": 4.8, "rating_count": 6, "popularity_score": 4.73375, "nutrition_calories": 283.0, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/15/47/90/CofAfATIR3GmcAfCPk5D_jajka4.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["brunch", "60 mins", "easy", "inexpensive"], "ingredients": []}, {"recipe_id": "rec_241", "props": {"title": "Scrambled Egg Muffins", "instructions": "[Instructions] 1) Brown sausage; drain well. | 2) Preheat oven to 350\u00b0. | 3) In a bowl, beat eggs, then add onion, green peppers, salt, pepper and garlic powder. | 4) Stir in sausage and cheese. | 5) Spoon 1/3 cupfuls into greased muffin cups. | 6) Bake at 350\u00b0 for 20-25 minutes or until a knife inserted comes out clean.", "tags": ["pork", "cheese", "meat", "very low carbs", "kid friendly", "weeknight", "60 mins", "oven", "easy"], "cook_time_min": 20, "servings": null, "cuisine": ["All"], "rating_avg": 4.53, "rating_count": 70, "popularity_score": 4.5505, "nutrition_calories": 152.2, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/12/97/5/nSONEriNQdG6qVw96WMH_SEM%205%20-%20final_2.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["pork", "cheese", "meat", "very low carbs", "kid friendly", "weeknight", "60 mins", "oven", "easy"], "ingredients": []}, {"recipe_id": "rec_242", "props": {"title": "Shakshuka Yemani Basted Eggs", "instructions": "[Instructions] 1) Must have covered pan. | 2) Heat oil. | 3) Add onion. | 4) Add peppers. | 5) Cook 1 minute. | 6) Add tomatoes. | 7) Cover; simmer 10 minutes. | 8) Salt and pepper. | 9) Crack eggs into sauce on the top. | 10) Cover and cook until eggs are desired doneness. | 11) Serve.", "tags": ["peppers", "vegetable", "southwest asia middle east", "60 mins"], "cook_time_min": 25, "servings": null, "cuisine": ["All"], "rating_avg": 4.63, "rating_count": 8, "popularity_score": 4.665555555555555, "nutrition_calories": 171.9, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/46/58/81/picVtw1rO.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["peppers", "vegetable", "southwest asia middle east", "60 mins"], "ingredients": []}, {"recipe_id": "rec_243", "props": {"title": "Simple Homemade Egg Salad Sandwich", "instructions": "[Instructions] 1) Finely chop boiled eggs. | 2) Mix in mayo 1 tablespoon at a time, so not to add too much. | 3) Mix in mustard, relish and pepper. | 4) Put egg salad mixture on bread (toasted is good as well), also good on rolls for finger foods. | 5) Top sandwich with lettuce. | 6) Enjoy!", "tags": ["lunch snacks", "toddler friendly", "kid friendly", "brunch", "15 mins", "stove top", "easy", "inexpensive"], "cook_time_min": 10, "servings": null, "cuisine": ["All"], "rating_avg": 4.77, "rating_count": 54, "popularity_score": 4.758125, "nutrition_calories": 303.2, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/16/63/09/sK3Sf8WRuWvlGrbkrdN0_0S9A5348.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["lunch snacks", "toddler friendly", "kid friendly", "brunch", "15 mins", "stove top", "easy", "inexpensive"], "ingredients": []}, {"recipe_id": "rec_244", "props": {"title": "Smoked Paprika Egg Salad Sandwich on Whole Grain", "instructions": "[Instructions] 1) Whisk together the mayonnaise, dijon mustard, white wine viengar, and smoked Spanish paprika in a large bowl. Reserve 1/4 cup of the mayonnaise mixture for brushing the bread slices. | 2) Add the green onion, parsley, celery and eggs to the remaining mayonnaise mixture and gently fold to combine; season with salt and pepper to taste. | 3) Brush the bread on both sides with some of the oil and grill on a grill or grill pan until lightly golden brown or place on a baking sheet and place under the broiler for 45 seconds per side. Brush the top of the bread slices with the reserved mayonnaise mixture lightly. | 4) Divide the egg salad among the 8 slices of bread, top with slices of onion and a few parsley leaves. Serve open-faced.", "tags": ["15 mins", "easy"], "cook_time_min": 15, "servings": null, "cuisine": ["All"], "rating_avg": 4.62, "rating_count": 8, "popularity_score": 4.661111111111111, "nutrition_calories": 265.3, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/37/65/69/56mdMNKGSk2a01InLcqx_smoked-paprika-egg-sandwich-1.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["15 mins", "easy"], "ingredients": []}, {"recipe_id": "rec_245", "props": {"title": "Smoky Hard Boiled Eggs", "instructions": "[Instructions] 1) Hard boil the eggs. | 2) Let cool or run under water to cool then peel. | 3) Add eggs and soy sauce and liquid smoke together in shallow container. Cover and refrigerate. | 4) Rotate eggs occasionally till all sides brown. | 5) Enjoy.", "tags": ["easy"], "cook_time_min": 13, "servings": null, "cuisine": ["All"], "rating_avg": 4.88, "rating_count": 8, "popularity_score": 4.776666666666666, "nutrition_calories": 77.3, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/74/52/4/9u3wSvuvS2LKjoR4ppF4_DSC05181-2.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["easy"], "ingredients": []}, {"recipe_id": "rec_246", "props": {"title": "Southwest Scotch Egg Rellenos", "instructions": "[Instructions] 1) Boil 6 eggs for 12 minutes, remove from heat for 5 minutes, drain and cool before peeling. | 2) While eggs are boiling, drain and pat green chiles dry with paper towel-set aside. Combine cream cheese with \u00bd cup cheddar cheese, set aside. Set 3 medium bowls in order-1 bowl-flour,chile powder, salt, pepper, 1 bowl-1 egg beaten, 1 bowl-panko bread crumbs. In large bowl combine sausage, 1 egg beaten, and 1/4 cup panko bread crumbs. Use a rolling pin to roll out sausage in between a folded over parchment paper until 1/8\u201d thin, gently peel back top parchment. Use sharp knife to cut into 6 pieces. | 3) Stuff green chiles with 1/6 of cream cheese mixture-about 2 tablespoons-set aside. Peel eggs and pat dry, or pat dry packaged eggs. Roll eggs in flour; insert 1 into each green chile. Wrap each green chile in sausage, pressing firmly. Roll stuffed green chile in flour, dip into egg, then roll in panko bread crumbs, pressing firmly. Roll each green chile in remaining grated cheddar, pressing cheese to stick. Lightly coat with cooking spray on all sides. | 4) Suggested Cooking method-air fryer oven 350 degrees for 25 minutes-turning gently after 15 minutes. Can be baked in oven at 400 degrees for 25 minutes, turning gently after 15 minutes. | 5) Gently cut in half lengthwise with serrated knife, sprinkle with mild red chile powder, and serve with guacamole, salsa, and sour cream for a delicious and nutritious egg fiesta! | 6) Can be reheated in air fryer at 350 degrees for 15 minutes or oven at 400 degrees for 15 minutes-microwave reheating not recommended. | 7) The Southwest region of the United States is best known for the spicy influence from south of the border. A regional favorite is Hatch green chiles from Hatch, NM, which most of us use in every meal-including in eggs any time of day you need a nutritional boost. The annual Hatch Chile Festival is the time for Tucson foodies to stock up on fresh Hatch green chiles-they add a mild kick to any egg dish from their bright and spicy flavor profile. Every year in Tucson there are giant industrial chile roasters filling the air with a spicy, pungent aroma unique to the char-roasted green chile. With all of this careful attention to detail, I use the highest quality ingredients to really showcase my favorite regional delight has resulted-a highly nutritious spicy, creamy, hearty, and crunchy Southwest Scotch Egg Rellenos-Enjoy This Unique Egg Creation!", "tags": ["brunch", "4 hours"], "cook_time_min": 40, "servings": null, "cuisine": ["All"], "rating_avg": null, "rating_count": 0, "popularity_score": null, "nutrition_calories": 695.9, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/53/65/61/6WP6WG9SRp6zi7h4Xbca_0S9A2112.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["brunch", "4 hours"], "ingredients": []}, {"recipe_id": "rec_247", "props": {"title": "Spanish Potato Omelet", "instructions": "[Instructions] 1) In a large frying pan or skillet, heat olive oil over medium-high heat. Sprinkle potatoes lightly with salt and pepper. Cook until golden brown and crisp. | 2) Once the potatoes are golden, stir in the onions. Cook, stirring occasionally, until onions soften and begin to brown. | 3) Meanwhile, beat eggs together with salt and pepper. Pour eggs into pan and stir gently to combine. Reduce heat to low and cook until eggs begin to brown on the bottom. | 4) Loosen bottom of omelet with a spatula, invert a large plate over the pan, and carefully turn the omelet out onto it. Slide the omelet back into the pan with the uncooked side down. Cook until eggs are set. | 5) Garnish omelet with tomato and green onion and serve warm.", "tags": ["vegetable", "spanish", "european", "60 mins"], "cook_time_min": 45, "servings": null, "cuisine": ["All"], "rating_avg": 4.5, "rating_count": 4, "popularity_score": 4.638571428571428, "nutrition_calories": 254.9, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/23/31/71/picjDsXSl.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["vegetable", "spanish", "european", "60 mins"], "ingredients": []}, {"recipe_id": "rec_248", "props": {"title": "Spinach Mushroom Quiche", "instructions": "[Instructions] 1) Combine all ingredients. Be sure that all moisture is out of spinach. | 2) Pour into pie crust. | 3) Bake at 350 for 40-45 minutes until set. Cover with foil after 30 if crust is getting too dark.", "tags": ["lunch snacks", "european", "brunch", "60 mins", "easy"], "cook_time_min": 40, "servings": null, "cuisine": ["All"], "rating_avg": 5.0, "rating_count": 5, "popularity_score": 4.795999999999999, "nutrition_calories": 231.3, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/28/54/09/pic16Lahm.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["lunch snacks", "european", "brunch", "60 mins", "easy"], "ingredients": []}, {"recipe_id": "rec_249", "props": {"title": "Steak Hache Avec Oeufs a Cheval (Hamburgers W/ Eggs on Horseback", "instructions": "[Instructions] 1) Sprinkle the patties with salt and pepper and grill the hamburgers; Transfer the patties to a warmed platter and start the eggs. | 2) Heat 4 teaspoons of butter in a skillet and carefully break the eggs and cook them sunny side up until the whites are firm. Remove from the skillet and place one egg on each pattie. | 3) Sprinkle the eggs with salt and pepper;. | 4) Arrange the anchovies (if desired) on top of the eggs. | 5) Heat 4 tablespoons in a skillet; When it gets foamy, add the capers and parsley. | 6) When the butter just starts to brown, pour equal amounts of the sauce over each egg/pattie and serve hot.", "tags": ["meat", "european", "very low carbs", "high protein", "high in", "brunch", "30 mins"], "cook_time_min": 15, "servings": null, "cuisine": ["All"], "rating_avg": 5.0, "rating_count": 5, "popularity_score": 4.795999999999999, "nutrition_calories": 579.4, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/13/18/33/picVZzjyQ.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["meat", "european", "very low carbs", "high protein", "high in", "brunch", "30 mins"], "ingredients": []}, {"recipe_id": "rec_250", "props": {"title": "Sunny Side up Special", "instructions": "[Instructions] 1) Spray a non-stick skillet with Pam. | 2) Pre-heat pan over medium heat until beads of water sizzles. | 3) Add eggs, being careful not to break the yolk (see note below), cover and cook over medium heat for 3-5 minutes or to your liking (we like the yolk runny). | 4) Toast bread and immediately add the slice of cheese, add the eggs, salt and pepper and the crumbled bacon. | 5) Enjoy. | 6) NOTE:At times I will break the eggs into a bowl and then pour them into the skillet. Haven't had a yolk break yet.", "tags": ["15 mins"], "cook_time_min": 10, "servings": null, "cuisine": ["All"], "rating_avg": 4.9, "rating_count": 31, "popularity_score": 4.849756097560976, "nutrition_calories": 329.8, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/19/38/51/BLjvTGmQRmejFMX0kEWx_sunny-side-up-3.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["15 mins"], "ingredients": []}, {"recipe_id": "rec_251", "props": {"title": "Tahini Egg Salad (Mutabbalat Taheena)", "instructions": "[Instructions] 1) Place tahini and lemon juice in a blender and blend for a few moments, then transfer to a bowl. (I would use an immersion blender here.). | 2) Add garlic, parsley, salt, pepper, eggs, and water and stir gently until well mixed. | 3) Place on a platter, sprinkle with paprika and serve.", "tags": ["african", "asian", "15 mins", "easy"], "cook_time_min": 10, "servings": null, "cuisine": ["All"], "rating_avg": 4.5, "rating_count": 9, "popularity_score": 4.602105263157895, "nutrition_calories": 211.6, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/25/74/83/pictMTe7L.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["african", "asian", "15 mins", "easy"], "ingredients": []}, {"recipe_id": "rec_252", "props": {"title": "Tamale Hash", "instructions": "[Instructions] 1) Heat oil over medium heat in a large skillet, add onion, jalapeno, garlic, 3/4 to 1 cup of Recipe, and cut up tamales; gently stir, warm for about three minutes. Being careful not to scorch or over stir. | 2) As the hash is warming, prepare the eggs either sunny side up or over easy. | 3) To serve, dived the hash between two serving plates. Place an egg on top of each serving, top immediately with a finely grated cheese and cilantro. Serve sour cream on side if desired.", "tags": ["mexican", "15 mins", "easy"], "cook_time_min": 3, "servings": null, "cuisine": ["All"], "rating_avg": 5.0, "rating_count": 2, "popularity_score": 4.745, "nutrition_calories": 225.1, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/49/27/18/Xo4nDOSrivpMDDrGWwrw_TAMALE3.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["mexican", "15 mins", "easy"], "ingredients": []}, {"recipe_id": "rec_253", "props": {"title": "Toasted Sunny-Side up Egg and Cheese Sandwiches", "instructions": "[Instructions] 1) Toast the 2 slices of bread. | 2) Butter one side of one piece of toast, then on the other slice spread with mayonnaise (use any amount of butter and mayo desired). | 3) Place 1 slice of cheese over either the buttererd side or the mayo side. | 4) Heat about 1-2 tablespoon butter into a skillet over medium heat. | 5) Break eggs into the skillet, then season with salt and black pepper to taste. | 6) Cover the skillet and cook eggs until cooked but leave the yolk semi-soft. | 7) Place the cooked egg/s over the cheese on the bread and top with the remaining slice of toast.", "tags": ["lunch snacks", "cheese", "brunch", "15 mins", "stove top", "easy", "inexpensive"], "cook_time_min": 5, "servings": null, "cuisine": ["All"], "rating_avg": 4.95, "rating_count": 19, "popularity_score": 4.861724137931034, "nutrition_calories": 542.6, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/24/51/65/picfxVffT.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["lunch snacks", "cheese", "brunch", "15 mins", "stove top", "easy", "inexpensive"], "ingredients": []}, {"recipe_id": "rec_254", "props": {"title": "African Banana Coconut Bake", "instructions": "[Instructions] 1) Heat oven to 375\u00b0F. | 2) Cut bananas crosswise into halves. | 3) Cut each half lengthwise into halves and arrange in greased 9-inch pie plate. | 4) Dot with margarine or butter and drizzle with orange and lemon juices. | 5) Sprinkle with brown sugar and coconut. | 6) Bake until coconut is golden, 8 to 10 minutes.", "tags": ["dessert", "coconut", "tropical fruits", "fruit", "nuts", "african", "low protein", "vegan", "healthy", "kid friendly", "sweet", "brunch", "15 mins", "oven", "beginner cook", "easy", "inexpensive"], "cook_time_min": 10, "servings": null, "cuisine": ["All"], "rating_avg": 4.66, "rating_count": 39, "popularity_score": 4.6669387755102045, "nutrition_calories": 189.2, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/13/63/81/BB0cZES4SSCshPfNp51a_0S9A1336.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["dessert", "coconut", "tropical fruits", "fruit", "nuts", "african", "low protein", "vegan", "healthy", "kid friendly", "sweet", "brunch", "15 mins", "oven", "beginner cook", "easy", "inexpensive"], "ingredients": []}, {"recipe_id": "rec_255", "props": {"title": "An Arabic Breakfast", "instructions": "[Instructions] 1) In a small frypan, put enough olive oil to nearly cover the bottom. | 2) Fry chunks of white cheese until golden on each side (but don't overdo it). | 3) Put along with oil onto small serving plate. | 4) Clean the frypan (or use another one) and use it to make Arabic style scrambled eggs. | 5) Place two tablespoons of olive oil in the pan along with 3 eggs and salt to taste (about 3 pinches). | 6) Lightly turn it with a fork (Arabic scrambled eggs aren't as scrambled as the 'normal' version) until there is no longer any egg liquid (it should only just be cooked no more). | 7) Put olives in a serving bowl. | 8) Put about 1/2 cup of zaatar in a serving bowl. | 9) Put 1/4 cup olive oil in a serving bowl and serve alongside zaatar. | 10) Cut tomatoes into wedges. | 11) Sprinkle small amount of salt over wedges (optional). | 12) Cut the ends off the cucumbers and slice each into 4 long strips. | 13) Put tomato wedges and cucumbers onto serving plate. | 14) Serve labaneh with olive oil drizzled on top. | 15) Serve mortadella sliced. | 16) Heat the Arabic bread either by using the stove top (gas ovens) and turning frequently or heating each piece in the microwave for 30 seconds (not the authentic way of doing it!) Make tea in pot as per usual but with the dried sage or mint added. | 17) Serve in Arabic teacups (usually small glass ones) with between 1-2 teaspoons sugar in each. | 18) Serve all of the above. | 19) The traditional way is to place a large tablecloth on the floor and eat seated on the ground. | 20) Eat with Arabic bread.", "tags": ["cheese", "palestinian", "southwest asia middle east", "asian", "15 mins", "stove top", "easy"], "cook_time_min": 5, "servings": null, "cuisine": ["All"], "rating_avg": 5.0, "rating_count": 15, "popularity_score": 4.8776, "nutrition_calories": 120.4, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/90/31/6/pichowim7.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["cheese", "palestinian", "southwest asia middle east", "asian", "15 mins", "stove top", "easy"], "ingredients": []}, {"recipe_id": "rec_256", "props": {"title": "Arepas", "instructions": "[Instructions] 1) Put the cornmeal in a food processor and grind until fine. | 2) Put the cornmeal in a large bowl with the salt and cheese. | 3) In a small saucepan heat the milk over medium heat until it comes to a steady simmer. | 4) Add the butter to the pan and stir until melted. | 5) Take pan off the heat and add to the cornmeal mixture to form a thick batter. | 6) Fold in the corn kernels. | 7) Let the batter rest about 15 minutes to thicken into a soft dough. | 8) Form 1 inch balls from the dough and flatten with the palm of your hand into 1/4 inch thick disks. | 9) Heat the oil in a large skillet and cook the arepas until golden brown, about 5 minutes on the first side and 3 minutes on the other, working in batches until done. | 10) Serve hot with butter.", "tags": ["breakfast", "south american", "30 mins"], "cook_time_min": 20, "servings": null, "cuisine": ["All"], "rating_avg": 5.0, "rating_count": 6, "popularity_score": 4.80875, "nutrition_calories": 323.4, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/45/59/80/picnPz2a4.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["breakfast", "south american", "30 mins"], "ingredients": []}, {"recipe_id": "rec_257", "props": {"title": "Bodacious British Bangers and Baked Beans Brunch!", "instructions": "[Instructions] 1) Take a large griddle, skillet or frying pan and spray with cooking oil. | 2) Cut each slice of bread into 3 fingers. | 3) Heat the griddle/skillet/frying pan over a high heat and then as soon as it is hot, turn the heat down to low to medium. (Check by putting a teaspoon of water on the griddle, if it spits and dances over the surface, the griddle is hot.). | 4) Place your sausages at one end and then your tomatoes at the other end. Keep turning your sausages regularly until they are evenly browned, then leave them to cook for 3 to 5 minutes on each side, depending on the thickness of them. | 5) After 5 minutes, carefully turn your tomatoes over to cook on the other side and then add your fingers of bread to gently fry, spraying with more oil if needed. Turn then after a few minutes. | 6) Heat your beans in a small saucepan over a low heat. | 7) Push your tomatoes, bread and sausages to one side to keep warm, and spray the griddle with more cooking oil if needed. Gently break your eggs on to the griddle and cook to personal requirements. | 8) Arrange the bread fingers on a warm plate and then top with three halves of tomatoes. Then add three sausages to the plate and the beans - place the fried egg/s on to the plate and season with salt and pepper to taste. | 9) Serve hot with a pot of tea, orange juice and toast if required. | 10) Worcestershire sauce or HP sauce is also great with this!", "tags": ["lunch snacks", "pork", "meat", "scottish", "european", "kid friendly", "weeknight", "brunch", "30 mins"], "cook_time_min": 15, "servings": null, "cuisine": ["All"], "rating_avg": 5.0, "rating_count": 3, "popularity_score": 4.764615384615385, "nutrition_calories": 187.1, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/41/56/95/picszx0pr.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["lunch snacks", "pork", "meat", "scottish", "european", "kid friendly", "weeknight", "brunch", "30 mins"], "ingredients": []}, {"recipe_id": "rec_258", "props": {"title": "Br\u00f6tchen (German Breakfast Rolls)", "instructions": "[Instructions] 1) In a large mixing bowl, dissolve yeast and sugar in warm water. Let sit until creamy; about 10 minutes. | 2) Mix in shortening, salt and 3 cups of the flour. Beat with dough whisk or heavy spoon for 2 minutes. Fold in egg whites. Gradually add flour 1/4 cup at a time, until dough forms a mass and begins to pull away from bowl. Turn onto a floured surface. Knead, adding more flour as necessary, for 8 to 10 minutes, until smooth and elastic with bubbles. | 3) Lightly oil a large mixing bowl, place the dough in the bowl and turn to coat with oil. Cover with a damp cloth and let rise in a warm place until doubled in volume, about 1 hour. Deflate the dough, form into a round and let rise again until doubled, about 45 minutes. | 4) Preheat oven to 425 degrees F (220 degrees C). Deflate the dough and turn it out onto a lightly floured surface. Divide the dough into 24 equal pieces and form into oval rolls about 3 1/2 inches long. Place on lightly greased baking sheets, cover and let rise until doubled in volume, about 40 minutes. | 5) Place an empty baking sheet on the bottom rack of the oven. In a small bowl, lightly beat the egg white with the 2 tablespoons of milk to make the egg wash. Lightly brush the risen rolls with the egg wash. Place 1 cup of ice cubes on the hot baking sheet in the oven and immediately place the rolls in the oven. | 6) Bake at 425 degrees F (220 degrees C) for about 20 minutes or until the tops are golden brown. | 7) Remove to a wire rack and cool.", "tags": ["german", "european", "low cholesterol", "healthy", "brunch", "for large groups", "4 hours"], "cook_time_min": 3, "servings": null, "cuisine": ["All"], "rating_avg": 5.0, "rating_count": 9, "popularity_score": 4.838947368421053, "nutrition_calories": 151.1, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/17/09/76/yGJgRCRDROmYPijjXTZ5_food.com-22.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["german", "european", "low cholesterol", "healthy", "brunch", "for large groups", "4 hours"], "ingredients": []}, {"recipe_id": "rec_259", "props": {"title": "British Breakfast in Bed - Boiled Eggs and Marmite Soldiers", "instructions": "[Instructions] 1) Bring a small pan of water to the boil. Carefully lower in the eggs and simmer for 4 minutes. Turn off the heat and leave the eggs in the water for another 15 seconds before removing with a slotted spoon. | 2) Meanwhile, toast the bread, butter generously and spread thinly with marmite and slice into fat fingers. | 3) Place your eggs in an egg cup and provide a teaspoon and a knife. | 4) Cut the tops off the eggs and eat with the buttery marmite toast soldiers and a little salt. | 5) Cook's note: if you use eggs at room temperature rather than straight from the fridge, they are less likely to crack in the boiling water.", "tags": ["lunch snacks", "scottish", "welsh", "european", "toddler friendly", "kid friendly", "brunch", "15 mins", "easy"], "cook_time_min": 5, "servings": null, "cuisine": ["All"], "rating_avg": 4.8, "rating_count": 10, "popularity_score": 4.747, "nutrition_calories": 258.8, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/29/12/34/picDj7UaL.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["lunch snacks", "scottish", "welsh", "european", "toddler friendly", "kid friendly", "brunch", "15 mins", "easy"], "ingredients": []}, {"recipe_id": "rec_260", "props": {"title": "Cheese Omelette (Omelette Au Fromage)", "instructions": "[Instructions] 1) Break the eggs into a bowl. | 2) Season to taste with salt, pepper, and nutmeg. | 3) Add Parmesan cheese. | 4) Beat the eggs with a fork until just mixed. | 5) Heat a large frying pan over medium heat. | 6) Add the butter and allow it to melt and color slightly. | 7) Add the beaten eggs. | 8) Use the flat side of the fork to stir the eggs until they start to set. | 9) Smooth the top and leave the eggs to cook. | 10) Add the Gruyere cheese over the surface. | 11) Fold the omelette into thirds and flip it onto a heated serving plate.", "tags": ["cheese", "swiss", "european", "very low carbs", "high protein", "high in", "brunch", "15 mins", "beginner cook", "easy"], "cook_time_min": 3, "servings": null, "cuisine": ["All"], "rating_avg": 4.78, "rating_count": 9, "popularity_score": 4.734736842105264, "nutrition_calories": 450.5, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/27/17/39/picAzbDzl.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["cheese", "swiss", "european", "very low carbs", "high protein", "high in", "brunch", "15 mins", "beginner cook", "easy"], "ingredients": []}, {"recipe_id": "rec_261", "props": {"title": "East Indian Farina Hot Cereal (Payasam)", "instructions": "[Instructions] 1) In saucepan bring milk to almost boil and stir in the cereal using a fork to break up the clumps. Stir in the salt. | 2) Reduce heat, cover and simmer for 5 minutes for farina, 10 minutes for rice meal. | 3) In a small saute pan, melt the butter on medium heat and add the cardamon, cane sugar and raw nuts. Toast for about 2 minutes, being careful not to burn. | 4) Add the raisins to the butter mixture and heat through. | 5) Once the hot cereal is cooked, stir the cardamom/nut mixture into the cereal. | 6) Serve piping hot. Mmmm!", "tags": ["grains", "asian", "indian", "winter", "15 mins", "easy", "inexpensive"], "cook_time_min": 10, "servings": null, "cuisine": ["All"], "rating_avg": 4.83, "rating_count": 7, "popularity_score": 4.75, "nutrition_calories": 689.4, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/15/97/47/piczaQQpZ.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["grains", "asian", "indian", "winter", "15 mins", "easy", "inexpensive"], "ingredients": []}, {"recipe_id": "rec_262", "props": {"title": "Fluffy Artoulakia With Chocolate Chips (Greek Breakfast Recipe)", "instructions": "[Instructions] 1) Make kanelozoumo by bringing 1 cup of water and a dash of cinnamon to a boil. Allow to cool until it is warm, but not hot. | 2) Place kanelozoumo, 1/2 cup flour, tsp or sugar, and yeast in a bowl and mix well. Allow yeast to proof for 5-10 minutes until frothy. | 3) Add brown sugar, mahlepi, masticha, vanilla, bacon grease, and mix well. | 4) Add the flour slowly and knead until you have a soft, pliable dough. | 5) Cover dough and allow to rise in a warm place until doubled in size - about an hour. | 6) Punch dough down and lightly knead. Divide into 12 pieces. | 7) Roll one piece of dough out into about a 3\" x 12\" rectangle. lightly sprinkle with chocolate chips, and roll the bottom up to form a long tube of dough filled with chocolate chips. Roll the tube into a spiral so it looks like a snail. Place on a parchment lined baking sheet, and repeat with remaining dough pieces. | 8) Cover, and allow artoulakia to rise until doubled in size, about 45 minutes. | 9) Bake in a preheated 350*F oven for 15-20 minutes until golden.", "tags": ["dessert", "greek", "european", "60 mins"], "cook_time_min": 20, "servings": null, "cuisine": ["All"], "rating_avg": 5.0, "rating_count": 1, "popularity_score": 4.721818181818181, "nutrition_calories": 279.0, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/50/37/57/picmzI9VN.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["dessert", "greek", "european", "60 mins"], "ingredients": []}, {"recipe_id": "rec_263", "props": {"title": "German Farmer Breakfast", "instructions": "[Instructions] 1) Boil unpeeled potatoes until tender, drain and let cool. | 2) Slice or dice potatoes. | 3) In large frying pan cook bacon until translucent. | 4) Add the potato slices, cook until lightly browned. | 5) Meanwhile, blend eggs with milk and salt. | 6) Stir in cubed ham. | 7) Add tomatoes to egg mixture. | 8) Pour the egg mixture over the potatoes in the skillet. | 9) Cook until eggs are set. | 10) Sprinkle with chopped chives and serve at once.", "tags": ["healthy", "60 mins"], "cook_time_min": 10, "servings": null, "cuisine": ["All"], "rating_avg": 4.92, "rating_count": 12, "popularity_score": 4.817272727272727, "nutrition_calories": 324.3, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/17/02/58/picP6iPIv.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["healthy", "60 mins"], "ingredients": []}, {"recipe_id": "rec_264", "props": {"title": "Greek Kourabiedes Cookies", "instructions": "[Instructions] 1) Preheat the oven to 350 degrees F. | 2) Toast the walnuts until golden brown and fragrant, about 6 minutes. Let cool, then chop about half of the nuts (you should have about 1/2 cup chopped). Pulse the remaining nuts in the food processor until finely ground (about 1/4 cup ground). | 3) Stir the flour, baking powder, salt and nuts together in a medium bowl. Set aside. | 4) In another medium bowl, beat the butter, sugar, egg yolk, brandy and vanilla extract together with an electric mixer on medium-high speed until the mixture gets light and fluffy, about 10 minutes. | 5) At low speed, stir in the nut mixture to make a crumbly dough. Cover the bowl and set dough aside at room temperature for 1 hour. | 6) Preheat oven to 350 degrees F. Line two baking sheets with parchment or coat with nonstick spray. | 7) With a tablespoon, scoop out 1-inch pieces of dough and roll into balls between the palms of your hands. Pinch the ends of the balls to make a football shape. Place the cookies on the prepared baking sheets. Bake until the cookies set and start to brown, about 18 minutes. | 8) Remove cookies from the oven and immediately sprinkle them lightly with the orange water. (If you don't have a brush, simply dip your fingers into the water and flick it over the cookies a few times.) Take care not to douse them, just enough for them to carry the scent of flowers. | 9) Put the confectioners' sugar in a bag, and add 5 to 6 of the warm cookies to it. Very gently toss the cookies to coat with sugar. Remove them from the bag and cool cookies on a rack. Repeat with remaining cookies. Serve.", "tags": ["cookie and brownie", "christmas", "60 mins"], "cook_time_min": 20, "servings": null, "cuisine": ["All"], "rating_avg": null, "rating_count": 0, "popularity_score": null, "nutrition_calories": 230.2, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/40/33/62/picrk8HRd.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["cookie and brownie", "christmas", "60 mins"], "ingredients": []}, {"recipe_id": "rec_265", "props": {"title": "Healthy Italian Breakfast Wraps", "instructions": "[Instructions] 1) Heat a non-stick skillet over medium heat. Add olive oil, garlic, bacon, and shallots. Saute for 2 minutes. | 2) Add all other vegetables, salt and pepper, and saute for 6-8 minutes, until vegetables are softened to your liking. | 3) In a small bowl, beat egg substitute, water, and Italian seasoning. | 4) Add egg mixture to skillet, and let it set for 3-5 minutes, almost like you are making a frittata. | 5) When the mixture is starting to solidify through the middle, begin to scramble gently, and continue until eggs are cooked through. | 6) Add tomatoes and mozzarella cheese, and cook until cheese is melted. Serve in tortillas, and top with parmesan if desired.", "tags": ["vegetable", "european", "30 mins"], "cook_time_min": 20, "servings": null, "cuisine": ["All"], "rating_avg": 5.0, "rating_count": 2, "popularity_score": 4.745, "nutrition_calories": 520.9, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/27/43/62/zGW7UX2wRkCDrDoX8qKm_The%20Food%20Gays%20-%20Healthy%20Italian%20Breakfast%20Wrap-2.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["vegetable", "european", "30 mins"], "ingredients": []}, {"recipe_id": "rec_266", "props": {"title": "Honey and Cream - Iranian Breakfast", "instructions": "[Instructions] 1) Put the cream in a small bowl to one side and the honey on the other side of the bowl. | 2) Lightly warm your bread. | 3) Mix the cream and honey together and spread on your bread.", "tags": ["southwest asia middle east", "asian", "15 mins", "easy"], "cook_time_min": 5, "servings": null, "cuisine": ["All"], "rating_avg": 5.0, "rating_count": 6, "popularity_score": 4.80875, "nutrition_calories": 255.4, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/27/75/56/pic8TapwW.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["southwest asia middle east", "asian", "15 mins", "easy"], "ingredients": []}, {"recipe_id": "rec_267", "props": {"title": "Hopple Popple German Breakfast Casserole", "instructions": "[Instructions] 1) In a large electric skillet on medium high, combine potatoes (enough to cover the bottom of the pan about 1/2-inch deep), onion and butter; saute until slightly browned. Spread evenly in pan. | 2) In a mixing bowl, combine eggs, milk and seasonings. Pour over potato mixture in pan. | 3) Layer pepperoni over the top. Cover pan and cook on medium low for 10-15 minutes (eggs will be 'set'). {While that's cooking, prepare a simple fruit tray or salad.}. | 4) Remove lid and sprinkle cheeses over; put lid back on, but turn off the heat. Let stand 2-3 minutes. [If you're having toast with this, make it now.]. | 5) Cut into wedges or squares and serve immediately. | 6) Option: Fry Italian bulk pork (or turkey) sausage, drain fat, add to potatoes. Toss in a can of Ro-Tel tomatoes. OR try other cheeses!", "tags": ["breakfast", "cheese", "german", "european", "savory", "brunch", "30 mins", "oven", "inexpensive"], "cook_time_min": 20, "servings": null, "cuisine": ["All"], "rating_avg": 4.0, "rating_count": 9, "popularity_score": 4.365263157894737, "nutrition_calories": 446.8, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/18/28/10/uansU9grSf6cFDPP8zNx_hopple.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["breakfast", "cheese", "german", "european", "savory", "brunch", "30 mins", "oven", "inexpensive"], "ingredients": []}, {"recipe_id": "rec_268", "props": {"title": "Irish Breakfast Smoothie", "instructions": "[Instructions] 1) Combine everything in a food processor or blender. | 2) Blend until smooth and serve!", "tags": ["beverages", "breakfast", "raspberries", "strawberry", "berries", "fruit", "european", "low protein", "low cholesterol", "healthy", "st patrick s day", "15 mins", "beginner cook", "easy", "inexpensive"], "cook_time_min": 5, "servings": null, "cuisine": ["All"], "rating_avg": 4.83, "rating_count": 6, "popularity_score": 4.745, "nutrition_calories": 197.8, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/28/84/81/MeJIwTrwRKShBpdP80Q3-IMG_6900.JPG"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["beverages", "breakfast", "raspberries", "strawberry", "berries", "fruit", "european", "low protein", "low cholesterol", "healthy", "st patrick s day", "15 mins", "beginner cook", "easy", "inexpensive"], "ingredients": []}, {"recipe_id": "rec_269", "props": {"title": "Jamaican Fried Dumplings", "instructions": "[Instructions] 1) Mix dry ingredients together. | 2) Add water a little at a time and knead dough. | 3) Dough should be soft but not sticky. | 4) Pinch off pieces (golf ball size), roll into a ball and flatten slightly. | 5) Heat oil in pan. | 6) Put each dumpling in pan and fry on each side. | 7) Remove from pan when each side is golden brown.", "tags": ["grains", "caribbean", "low cholesterol", "healthy", "kid friendly", "30 mins", "for large groups", "easy", "inexpensive"], "cook_time_min": 20, "servings": null, "cuisine": ["All"], "rating_avg": 5.0, "rating_count": 12, "popularity_score": 4.86090909090909, "nutrition_calories": 91.5, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/17/64/20/nNnUB06RuS2y2zHLhjD5_frieddumplings-2.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["grains", "caribbean", "low cholesterol", "healthy", "kid friendly", "30 mins", "for large groups", "easy", "inexpensive"], "ingredients": []}, {"recipe_id": "rec_270", "props": {"title": "Khabeesa (Omani Breakfast Item)", "instructions": "[Instructions] 1) Combine all of the ingredients in a sauce pan. Bring to a boil. Reduce heat to the lowest level and simmer for 10 minutes, stirring occasionally. | 2) Serve warm in individual bowls or on small desert plates. Drizzle with butter, if desired.", "tags": ["southwest asia middle east", "asian", "15 mins", "easy"], "cook_time_min": 10, "servings": null, "cuisine": ["All"], "rating_avg": 4.5, "rating_count": 4, "popularity_score": 4.638571428571428, "nutrition_calories": 291.5, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/34/67/61/picyw8hsm.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["southwest asia middle east", "asian", "15 mins", "easy"], "ingredients": []}, {"recipe_id": "rec_271", "props": {"title": "Mexican Breakfast", "instructions": "[Instructions] 1) Drain beans, saving liquid. Saute garlic, jalapeno and onion until onion is translucent. Add beans and mash with potato masher or fork. Add small amount of bean liquid if needed. Keep warm. | 2) Fry the eggs over medium. | 3) Steam tortillas. | 4) On a plate, lay down two tortillas, top with bean mixture, crumbled bacon and two eggs. Garnish plates with two slices of avocado and a few sprigs cilantro. Serve with hot sauce and extra tortillas.", "tags": ["pork", "beans", "meat", "mexican", "spicy", "brunch", "30 mins", "beginner cook", "stove top", "easy", "inexpensive"], "cook_time_min": 15, "servings": null, "cuisine": ["All"], "rating_avg": 5.0, "rating_count": 1, "popularity_score": 4.721818181818181, "nutrition_calories": 803.6, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/16/88/22/picZMXxWE.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["pork", "beans", "meat", "mexican", "spicy", "brunch", "30 mins", "beginner cook", "stove top", "easy", "inexpensive"], "ingredients": []}, {"recipe_id": "rec_272", "props": {"title": "Mezze Breakfast Plate", "instructions": "[Instructions] 1) Preheat a chargrill pan or bbq plate to medium-high heat. | 2) Cut eggplant lenghways into 8 think slices, then lightly brush each side with olive oil. | 3) Grill eggplant for 2 minutes each side or until charred. Set aside to cool slightly. | 4) Stir the chopped mint into the ricotta and season with salt and pepper. | 5) Spread a heaped tablespoon of the ricotta mix at the end of each slice of grilled eggplant and roll up to enclose. Repeat with remaining eggplant slices. Set aside. | 6) Place the eggs in a pan, cover with hot water and bring to the boil. Reduce heat to medium simmer for 5-6 minutes for soft boiled. Remove the eggs from the hot water and plunge them into iced water. Peel then halve the eggs. | 7) To serve - 4 plates will each have two eggplant rolls, an egg, olives and a salad of cucumber, tomatoes and feta cheese. Drizzle the plate with honey and olive oil. Sprinkle the eggs with sumac or zaatar. . Garnish with a sprig of mint.", "tags": ["cheese", "vegetable", "moroccan", "african", "free of", "brunch", "30 mins", "from scratch"], "cook_time_min": 20, "servings": null, "cuisine": ["All"], "rating_avg": 5.0, "rating_count": 2, "popularity_score": 4.745, "nutrition_calories": 294.3, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/50/43/40/picrfEUET.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["cheese", "vegetable", "moroccan", "african", "free of", "brunch", "30 mins", "from scratch"], "ingredients": []}, {"recipe_id": "rec_273", "props": {"title": "Midori June Bug", "instructions": "[Instructions] 1) Shake ingredients together and pour into a glass. | 2) (Shaking the ingredients creates a delicious fusion of flavors, but the drink can also be enjoyed by layering the ingredients and enjoying each one in its own right.).", "tags": ["asian", "weeknight", "brunch", "15 mins", "easy"], "cook_time_min": 2, "servings": null, "cuisine": ["All"], "rating_avg": 4.78, "rating_count": 9, "popularity_score": 4.734736842105264, "nutrition_calories": 376.8, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/42/51/99/picnaPgRS.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["asian", "weeknight", "brunch", "15 mins", "easy"], "ingredients": []}, {"recipe_id": "rec_274", "props": {"title": "Moroccan Fried Eggs With Cumin and Salt", "instructions": "[Instructions] 1) Heat the oil in a frying pan over medium heat. | 2) Add the eggs, break the yolks with a spatula, and allow the eggs to set. Occasionally lift the edges of the eggs to let the uncooked egg run underneath. | 3) This allows more egg to make contact with the pan for faster cooking. | 4) When the eggs have cooked, sprinkle with salt and cumin, and serve.", "tags": ["lunch snacks", "moroccan", "african", "very low carbs", "lactose free", "free of", "weeknight", "15 mins", "easy", "inexpensive"], "cook_time_min": 6, "servings": null, "cuisine": ["All"], "rating_avg": 4.83, "rating_count": 12, "popularity_score": 4.768181818181818, "nutrition_calories": 182.8, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/41/48/08/picjBwgz8.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["lunch snacks", "moroccan", "african", "very low carbs", "lactose free", "free of", "weeknight", "15 mins", "easy", "inexpensive"], "ingredients": []}, {"recipe_id": "rec_275", "props": {"title": "M'shewsha - Algerian Egg Dish for Breakfast or Coffee", "instructions": "[Instructions] 1) Pour all the ingredients into a blender / liquidizer & mix well. | 2) Pour into a large (25cm-30cm) non stick frying pan / skillet. If you don't have a non stick pan, just wipe or spray with a littlle cooking oil first. | 3) Cook on a low- only just medium heat with the lid on until it is puffed up, the sides come away from the pan & the top is almost totally firm & no longer sticky - this should take about 15 minutes. | 4) Carefully, slide the M'shewsah onto a dinner plate (you mustn't knock it or it will deflate!) Then return to the pan, with the cooked side up - hold the pan over the plate & flip carefully. | 5) Cook for a further 10 - 15 minutes & turn out onto a plate. | 6) Warm honey in the microwave until just warm enough to pour. | 7) Cut the M'shewsha into 8 slices - but do not separate the slices. Pour the honey all over & allow to soak for a minute or two before serving. | 8) You can eat M'shewsha warm or cold.", "tags": ["african", "toddler friendly", "kid friendly", "kosher", "ramadan", "sweet", "30 mins", "stove top", "small appliance", "easy", "inexpensive"], "cook_time_min": 20, "servings": null, "cuisine": ["All"], "rating_avg": 5.0, "rating_count": 2, "popularity_score": 4.745, "nutrition_calories": 437.3, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/32/45/72/pictgSgW8.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["african", "toddler friendly", "kid friendly", "kosher", "ramadan", "sweet", "30 mins", "stove top", "small appliance", "easy", "inexpensive"], "ingredients": []}, {"recipe_id": "rec_276", "props": {"title": "Munavoi- Finnish Egg Butter", "instructions": "[Instructions] 1) Gently mix the eggs and butter together until spreading consistency. | 2) Add salt if desired. | 3) Spread on bread or toast.", "tags": ["finnish", "scandinavian", "european", "very low carbs", "15 mins", "beginner cook", "easy"], "cook_time_min": 5, "servings": null, "cuisine": ["All"], "rating_avg": 4.55, "rating_count": 12, "popularity_score": 4.615454545454545, "nutrition_calories": 124.4, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/18/06/24/picuqMGb8.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["finnish", "scandinavian", "european", "very low carbs", "15 mins", "beginner cook", "easy"], "ingredients": []}, {"recipe_id": "rec_277", "props": {"title": "Norwegian Blueberry Breakfast Crepes", "instructions": "[Instructions] 1) Beat eggs well. | 2) Beat in milk and butter. | 3) Sift flour, measure, and sift again with sugar and salt into egg mixture. | 4) Beat until smooth. | 5) Heat a shallow 8-inch frying pan and butter well. | 6) Pour in about 3 tbsp batter then turn and tilt pan so batter covers entire surface. | 7) Cook until golden brown on both sides. | 8) Sweeten blueberries to taste with sugar. | 9) Spoon 3 tbsp of sweetened blueberries in centre of crepe; fold in half and lift to a heated plate; keep warm. | 10) Repeat, buttering pan before cooking each crepe. | 11) Serve about two filled crepes to each person. | 12) Pass powdered sugar and lemon wedges and melted butter, if desired.", "tags": ["dessert", "berries", "fruit", "norwegian", "scandinavian", "european", "kid friendly", "sweet", "weeknight", "brunch", "60 mins", "stove top"], "cook_time_min": 30, "servings": null, "cuisine": ["All"], "rating_avg": 5.0, "rating_count": 11, "popularity_score": 4.854285714285714, "nutrition_calories": 336.3, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/42/49/56/picLcrESu.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["dessert", "berries", "fruit", "norwegian", "scandinavian", "european", "kid friendly", "sweet", "weeknight", "brunch", "60 mins", "stove top"], "ingredients": []}, {"recipe_id": "rec_278", "props": {"title": "Old World Pancake", "instructions": "[Instructions] 1) Turn oven on to 425'. | 2) Put butter in large (10 inch) ovenproof fry pan (I use a 4 litre saut\u00e9 pan) and put the pan in the preheating oven. | 3) In medium mixing bowl, whisk together the eggs and milk. | 4) Sprinkle in the sugar, nutmeg and flour. This means, just dump in the dry stuff. | 5) Whisk it all together until it is smooth. | 6) Remove hot pan from the oven, swirl the butter around and then dump in all the batter. | 7) No need to spread it or mess about, just pop it back into the hot oven uncovered, close the door and sit back with a cuppa and wait. | 8) Set that timer for 16-18 minutes. | 9) Remove from oven and slice into wedges, in my house that means half for me and half for my husband! | 10) This is great served with warm maple syrup, from annieCANada of course. | 11) Now enjoy. If you are having a big breakfast and you actually have leftovers, rest assured that this pancake tastes great at room temperature, cold or reheated. | 12) Gotta love that! | 13) B'Shalom everyone, Anne.", "tags": ["european", "kid friendly", "kosher", "brunch", "30 mins", "beginner cook", "easy", "inexpensive"], "cook_time_min": 16, "servings": null, "cuisine": ["All"], "rating_avg": 4.6, "rating_count": 6, "popularity_score": 4.65875, "nutrition_calories": 447.4, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/13/53/42/picJgqggl.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["european", "kid friendly", "kosher", "brunch", "30 mins", "beginner cook", "easy", "inexpensive"], "ingredients": []}, {"recipe_id": "rec_279", "props": {"title": "Patacones (fried Plantain)", "instructions": "[Instructions] 1) Peel Plantain, and cut it width wise into 3 or 4 pieces. | 2) I have found that the easiest way to peel the plantain is to cut roughly 1/4\" off of each end of the plantain (the very tips), and then carefully, without cutting into the plantain itself, slicing the skin down one side. | 3) Once you have slit the skin on one side, you can gently pry the peel off with your fingers. | 4) Heat 1\" of vegetable oil on medium heat until hot. | 5) Fry plantain pieces on both sides for about 3 minutes, or until the pieces are golden. | 6) When they are golden, remove from pan and place onto a plate covered with a paper towel. | 7) Flatten the fried plantain. | 8) I do this by placing the pieces one at a time between 2 pieces of waxed paper, and flattening with my hands. | 9) Be careful not to put too much pressure, or the plantain will stick to the waxed paper. | 10) Just gently flatten them till they are about 1/4\" thick. | 11) Place in the hot oil again and fry until both sides are golden brown. | 12) Drain on paper towel covered plate (be sure to change paper towels in between the 2 fryings) and sprinkle with salt. | 13) Serve immediately. | 14) For an extra special treat, eat the patacones with a thin slice of queso blanco (salty white cheese) on top.", "tags": ["tropical fruits", "fruit", "colombian", "south american", "lactose free", "low protein", "vegan", "low cholesterol", "egg free", "healthy", "free of", "brunch", "30 mins", "beginner cook", "stove top", "easy", "inexpensive"], "cook_time_min": 15, "servings": null, "cuisine": ["All"], "rating_avg": 4.62, "rating_count": 11, "popularity_score": 4.655238095238095, "nutrition_calories": 54.6, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/92/19/1/dtUKByRt2dnyKgaIUifg_IMG_9300.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["tropical fruits", "fruit", "colombian", "south american", "lactose free", "low protein", "vegan", "low cholesterol", "egg free", "healthy", "free of", "brunch", "30 mins", "beginner cook", "stove top", "easy", "inexpensive"], "ingredients": []}, {"recipe_id": "rec_280", "props": {"title": "Peruvian Home Fries", "instructions": "[Instructions] 1) Place a 10\" skillet or saute pan over medium heat. When hot, add 1 tbls. oil, wait about 10 seconds, then swirl to coat pan. Turn heat up to medium high and add half the cooked potatoes, spreading them into a single layer in the hot oil. Let them cook without stirring 5 minutes. | 2) Sprinkle in 1/8 teaspoons salt and turn potatoes over, using a metal spatula. Spread them into a single layer again. Let them cook 5-8 more minutes, or until golden. Scrape from the bottom to loosen potatoes and toss them around in the pan. Cook for another few minutes, then move to a plate, scraping out and saving all the tasty brown tidbits from the bottom of the pan. Repeat this procedure with the remaining potatoes, using another tbls. of the oil and anohter 1/8 teaspoons salt. | 3) After cooking the potatoes, scrape out the pan, saving the scrapings, and wipe it out with a damp paper towel. Return the pan to the heat and when it is hot, add remaining tbsl. of oil You may also melt in a little butter. Wait 10 seconds, then swirl the pan. add the onion and saute over medium heat 5-8 minutes, or until it becomes very soft. Add the chiles and bell peppers, along with the remaining 1/2 teaspoons salt. Continue to cook, stirring often, for another 5-8 minutes. | 4) Return the potatoes to the pan and stir them into the onion mixutre, along with the garlic. Saute over medium heat for another 10-20 minutes, or until everything is done to your liking. Sprinkle in the cheese and lemon juice during the last few minutes of cooking, and if needed, adjust the salt. | 5) Serve hot or warm, with peanuts and minced cilantro or parsley, and with lemon wedges on the side. Enjoy! | 6) Note:. | 7) If prepping the potatoes in advance, store them in fresh water in a tightly covered container in the fridge. Drain and dry completely before using.", "tags": ["potato", "onions", "peppers", "vegetable", "peruvian", "south american", "vegan", "low cholesterol", "brunch", "60 mins"], "cook_time_min": 40, "servings": null, "cuisine": ["All"], "rating_avg": 4.6, "rating_count": 5, "popularity_score": 4.6626666666666665, "nutrition_calories": 614.8, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/40/49/81/XTDhTVTha3tEs4KIJMCA_Peruvian%20Home%20Fries%20SITE-3.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["potato", "onions", "peppers", "vegetable", "peruvian", "south american", "vegan", "low cholesterol", "brunch", "60 mins"], "ingredients": []}, {"recipe_id": "rec_281", "props": {"title": "Portuguese Healthy Breakfast", "instructions": "[Instructions] 1) Peel fruit and cut it into pieces. In a bowl place the fruit, yogurt, and cereals. Sprinkle with seeds and drizzle with honey. | 2) Mix everything and enjoy.", "tags": ["portuguese", "european", "15 mins", "easy"], "cook_time_min": 5, "servings": null, "cuisine": ["All"], "rating_avg": 5.0, "rating_count": 6, "popularity_score": 4.80875, "nutrition_calories": 195.3, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/48/27/01/picnVbzRW.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["portuguese", "european", "15 mins", "easy"], "ingredients": []}, {"recipe_id": "rec_282", "props": {"title": "Real Gambas Pil Pil", "instructions": "[Instructions] 1) Heat the earthenware dish over moderate heat and add the oil and fry the garlic till just starting to brown. | 2) Add the garlic, and prawns, season with salt and cook, stirring, till the prawns change colour (pink). | 3) Carefully add the wine, if using. | 4) Serve.", "tags": ["european", "very low carbs", "15 mins"], "cook_time_min": 6, "servings": null, "cuisine": ["All"], "rating_avg": 4.5, "rating_count": 2, "popularity_score": 4.661666666666667, "nutrition_calories": 343.1, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/39/16/85/picsRDW6X.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["european", "very low carbs", "15 mins"], "ingredients": []}, {"recipe_id": "rec_283", "props": {"title": "Roast Goose With Apples", "instructions": "[Instructions] 1) If your goose is frozen, place in the refrigerator 24-48 hours before roasting to thoroughly defrost. Remove the goose from the refrigerator and leave at room temperature for 30 minutes. Preheat oven to 400 degrees. Remove the neck and giblets, rinse goose thoroughly with cold running water, and pat dry with paper towels. Trim as much of the access fat as possible from the opening of the cavity. | 2) With the point of a sharp knife, prick the skin all over the goose, making sure not to pierce the flesh at all. Fold the neck flap under the body of the goose, and pin the flap down with a wooden toothpick. Generously sprinkle the cavity with salt and pepper, and insert the garlic, apple, onion, shallots, thyme, sage and bay leaf. Tie the legs together with a piece of kitchen twine. Sprinkle the outside of the goose with salt and pepper, and place in a shallow roasting pan (breast side up). Carefully pour the water into the pan (this will prevent the grease that drips into the pan from burning). | 3) Roast the goose in the oven until it turns a golden brown, about one hour. Every 30 minutes or so, use a baster to remove the grease from the pan. After 1 hour of roasting, reduce the heat to 325 degrees . Roast until the goose is very well browned all over and an instant read thermometer inserted into a breast (not touching the bone) reads 180 degrees (about 1 hour after reducing the heat). | 4) Remove the goose from the oven and place on a platter. Allow it to rest for 15-20 minutes before serving. Dress with apples and herbs, if desired.", "tags": ["poultry", "meat", "russian", "european", "4 hours"], "cook_time_min": 2, "servings": null, "cuisine": ["All"], "rating_avg": null, "rating_count": 0, "popularity_score": null, "nutrition_calories": 447.6, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/44/03/75/picZsS2Bz.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["poultry", "meat", "russian", "european", "4 hours"], "ingredients": []}, {"recipe_id": "rec_284", "props": {"title": "Sopapilla Breakfast Delight", "instructions": "[Instructions] 1) Preheat oven to 350 degrees. | 2) In the microwave or saucepan, melt 1/4 cup of butter. Place in the bottom of a 13 x 9 inch baking pan. Place one tube of crescent rolls over the butter and press together to close the seams. | 3) Blend both packages of cream cheese with one cup sugar and spread over crescent rolls. | 4) Layer the other package of cresent rolls over the cream cheese, closing the seams. | 5) Melt the remaining 1/2 cup of butter and stir in the remaining 1/2 cup sugar. Spread over the the top of the crescent rolls. Sprinkle generously with cinnamon. | 6) Bake for 45 minutes and let cool slightly and serve warm.", "tags": ["dessert", "brunch", "60 mins", "easy"], "cook_time_min": 45, "servings": null, "cuisine": ["All"], "rating_avg": 3.67, "rating_count": 3, "popularity_score": 4.457692307692308, "nutrition_calories": 166.9, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/31/38/42/bVq1wL4jRfG5btsibGUs_0S9A9483.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["dessert", "brunch", "60 mins", "easy"], "ingredients": []}, {"recipe_id": "rec_285", "props": {"title": "Super Easy, Super Delicious Breakfast Crepes", "instructions": "[Instructions] 1) In a blender, combine milk and eggs, blend until foamy, approx 20 seconds or so. Turn off. | 2) Add sugar and salt, blend for a few seconds turn off. | 3) Add melted butter and vanilla, blend a few seconds turn off. | 4) Add flour, blend until all mixed. | 5) Okay now for cooking them, this is what I did -- | 6) I had a small tefal frying pan, (measured 6-1/2 on bottom, 9-1/2 or so across top) I sprayed it with non-stick Butter Flavor cooking spray. Heat it on medium-high heat. | 7) Use a 1/3 cup measuring cup and dump crepe mixture into pan, swirl around real quick to coat bottom of pan. | 8) I used a silicon spatula to lift edges of crepe and to form round if any stray edges -- it will start to bubble, not much, but its safe to flip when you see edges on underside becoming brown. Just flip with plastic spatula. | 9) So once first side cooked, flip and cook about 2 minutes or so, transfer to plate and continue with rest of batter. | 10) *** Each crepe I made, I sprayed pan with butter cooking spray. So when I took crepe out, i sprayed bottom of pan before putting next cup of batter, do each time. | 11) Serve with powdered sugar, jam, fruits any filling of your choice! | 12) *** For chocolate crepes, add two tablespoons of chocolate syrup to blender when adding in vanilla. | 13) *** For saltier crepes to make with meat or veggies, omit sugar and vanilla.", "tags": ["dessert", "brunch", "30 mins", "inexpensive"], "cook_time_min": 15, "servings": null, "cuisine": ["All"], "rating_avg": 5.0, "rating_count": 3, "popularity_score": 4.764615384615385, "nutrition_calories": 121.7, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/19/91/08/picNY2zC4.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["dessert", "brunch", "30 mins", "inexpensive"], "ingredients": []}, {"recipe_id": "rec_286", "props": {"title": "Swedish Pancakes", "instructions": "[Instructions] 1) Sift dry ingredients together. | 2) Warm the milk and butter just until the butter has melted. . | 3) Add the eggs, then the dry ingredients. | 4) Lightly coat a crepe pan or nonstick frying pan with butter. This batter is thin, so I don't recommend a griddle, it will run all over! | 5) Pour a third of a cup into the hot pan, medium -high wait a minute or two until the edges curl, flip over, another minute and remove to a warm plate. Continue until the batter is gone. | 6) Serve with real maple syrup, Lingonberries, powdered sugar, whatever you like really! Enjoy! | 7) By the way, my amount of finished pancakes is only guesswork.", "tags": ["european", "brunch", "60 mins", "for large groups", "easy"], "cook_time_min": 35, "servings": null, "cuisine": ["All"], "rating_avg": 4.92, "rating_count": 12, "popularity_score": 4.817272727272727, "nutrition_calories": 53.4, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/47/93/24/piccT545w.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["european", "brunch", "60 mins", "for large groups", "easy"], "ingredients": []}, {"recipe_id": "rec_287", "props": {"title": "Swedish Scrambled Eggs", "instructions": "[Instructions] 1) Whisk together the eggs until they are light yellow and frothy. | 2) Add the chunks of cream cheese, the dill and the garlic powder to the eggs and stir to combine. Season with salt and pepper as desired. | 3) Spray a medium-sized skillet with non-stick cooking spray, and heat over high heat until the fat begins to sizzle. | 4) Pour the egg mixture into the pan and reduce heat slightly. Stir eggs gently to scramble until they reach the desired consistency. | 5) Serve immediately.", "tags": ["scandinavian", "european", "very low carbs", "15 mins", "easy"], "cook_time_min": 5, "servings": null, "cuisine": ["All"], "rating_avg": 4.71, "rating_count": 31, "popularity_score": 4.70609756097561, "nutrition_calories": 338.7, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/42/81/16/p1KDBassT8GOhn0s1V1t_swedish eggs SITE-1.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["scandinavian", "european", "very low carbs", "15 mins", "easy"], "ingredients": []}, {"recipe_id": "rec_288", "props": {"title": "The Great British Bacon Butty - Bacon Sandwich", "instructions": "[Instructions] 1) Cook the bacon under a preheated oven grill for seven minutes at about 240C/475F - turning half way through the cooking time. | 2) Cook until crispy, but not burnt or too dry. | 3) (You can also fry the bacon in a pan if you wish). | 4) Butter the two slices of bread and place the grilled or fried bacon inside the two slices of bread to make a sandwich. | 5) Add sauces to taste. | 6) Enjoy! | 7) The bread can also be toasted if you wish! And, you can make this sandwich with a crusty bread roll. | 8) The Scientist's Formula:. | 9) Four researchers at the Department of Food Science at Leeds University in the UK spent more than 1,000 hours testing 700 variations on the traditional bacon sandwich. | 10) They tried different types and cuts of bacon, cooking techniques, types of oil and a range of cooking times at different temperatures. | 11) A shortlist was then tested with computers to measure the texture of each sandwich. | 12) Fifty volunteers also judged each sandwich according to its taste, texture and flavour. | 13) The formula is: N = C + {fb (cm) . fb (tc)} + fb (Ts) + fc . ta, where N=force in Newtons required to break the cooked bacon, fb=function of the bacon type, fc=function of the condiment/filling effect, Ts=serving temperature, tc=cooking time, ta=time or duration of application of condiment/filling, cm=cooking method, C=Newtons required to break uncooked bacon.", "tags": ["lunch snacks", "pork", "meat", "scottish", "welsh", "european", "toddler friendly", "kid friendly", "savory", "brunch", "15 mins", "easy"], "cook_time_min": 7, "servings": null, "cuisine": ["All"], "rating_avg": 4.47, "rating_count": 20, "popularity_score": 4.544666666666666, "nutrition_calories": 300.0, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/24/74/95/pic13RzZa.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["lunch snacks", "pork", "meat", "scottish", "welsh", "european", "toddler friendly", "kid friendly", "savory", "brunch", "15 mins", "easy"], "ingredients": []}, {"recipe_id": "rec_289", "props": {"title": "The Real Deal Irish Breakfast", "instructions": "[Instructions] 1) Heat a frying pan with a little oil. Fry the sausages slowly over a medium heat - keep turning. | 2) Add the pudding to the pan and continue to cook. Put sausages and pudding on a plate and keep warm in the oven. | 3) Place rashers on frying pan and cook until colour has darkened and they crisp - transfer to oven. Add more oil to the frying pan and saut\u00e9 the mushrooms. | 4) Add as many eggs are you want per person and fry however you prefer them. | 5) Add the salt and pepper to the mushrooms. | 6) Serve all ingredients on a plate and serve with crusty french bread (aka breakfast roll - popular hangover cures sold in petrol stations in Ireland ) or with Irish brown bread . Add ketchup to taste. Loads of Kerrygold Irish butter for the bread is yum as it is slightly salty and has a gorgeous flavour. Round it all of with a glass of cold orange juice and a strong cup of tea!", "tags": ["pork", "meat", "european", "30 mins", "beginner cook", "easy"], "cook_time_min": 20, "servings": null, "cuisine": ["All"], "rating_avg": 5.0, "rating_count": 3, "popularity_score": 4.764615384615385, "nutrition_calories": 245.9, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/31/52/27/iPXEAlSOTAuLAqIHXBPl_irish%20br4.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["pork", "meat", "european", "30 mins", "beginner cook", "easy"], "ingredients": []}, {"recipe_id": "rec_290", "props": {"title": "Torta - a Spanish Influenced Breakfast", "instructions": "[Instructions] 1) Slice potatoes thinly. | 2) Add olive oil to a deep 10\" frying pan, add potatoes, chopped garlic, and red or white chopped onions. | 3) Make sure there is enough oil to cover potatoes. | 4) Saute uncovered until the potatoes are soft, but not brown. | 5) Drain oil. | 6) Save a couple tablespoons, discard the rest. | 7) A little before the potatoes are cooked, mix the eggs and milk. | 8) When potatoes are cooked and drained, add them to the eggs and milk mixture. | 9) Let sit for 10-15 minutes. | 10) Season mixture with a bit of salt and lots of black pepper. | 11) Heat a 10\" non-stick frying and add the two tablespoons of olive oil. | 12) Add the potato and egg mixture and cook on low heat until the egg is set (fork will come out clean if inserted). | 13) Flip the tortilla using the lid of a large pan: Place lid over the frying pan; turn pan over; slide the tortilla cooked side up back onto the frying pan to finish cooking, just a couple of minutes longer. | 14) Remove from heat and let tortilla rest for 15 minutes before serving. | 15) May be served warm or at room temperature. | 16) Serve in pie like slices or cut into cubes if serving it to a larger crowd. | 17) Note: rather than flipping the tortilla you can cook on top of the stove until the egg is set on the bottom and then transfer the pan to a 400 degree oven to finish.", "tags": ["breakfast", "potato", "vegetable", "spanish", "european", "healthy", "60 mins"], "cook_time_min": 20, "servings": null, "cuisine": ["All"], "rating_avg": 4.82, "rating_count": 11, "popularity_score": 4.76, "nutrition_calories": 181.8, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/48/58/9/n4M0dDwmRPeo0i9pFYFQ_spanishtortilla-2.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["breakfast", "potato", "vegetable", "spanish", "european", "healthy", "60 mins"], "ingredients": []}, {"recipe_id": "rec_291", "props": {"title": "Tortilla Espanola", "instructions": "[Instructions] 1) In a large, heavy-bottomed (preferably non-stick) pot, heat the olive oil and vegetable oil until hot but not smoking. Add the potato slices, onion and about \u00bd teaspoon salt. Lift and turn the mixture frequently. The potatoes will soften as they boil in the oil but should not brown. Cook until the potatoes are soft (not mushy) and are easily cut with a knife. | 2) While the potatoes cook, crack the eggs into a large bowl and beat with \u00bd teaspoon salt until frothy. | 3) When potatoes are soft, remove the mixture with a slotted spoon to drain the oil and add to the beaten egg. Gently push down the mixture until it is submerged and let rest 15 minutes. | 4) Before cooking the tortilla in the skillet, make sure that you have a plate that is larger than the skillet! It may be easier to make 2 smaller tortillas than one large one. You will also need a lid for the skillet. | 5) In a non-stick (very important to use non-stick!) skillet, heat 1Tablespoon oil (you can use the leftover oil from the pot) until quite hot. Slide in the egg/potato mixture and push down to fill the skillet. Shake the pan, lower the heat to medium high and cover with a lid. Shake the pan to prevent sticking. When it starts to brown on the bottom (lift gently with fork to check), cover the skillet with a plate and flip the tortilla onto the plate (first flip is best done over the sink). Slide tortilla back into skillet and cook on the other side in the same manner. Lower heat to medium and continue to flip 4-5 more times until tortilla is cooked through \u2013 15-20 minutes. | 6) Before serving, I press a paper towel onto both sides to absorb excess oil. Serve with sliced baguette.", "tags": ["european", "60 mins"], "cook_time_min": 30, "servings": null, "cuisine": ["All"], "rating_avg": null, "rating_count": 0, "popularity_score": null, "nutrition_calories": 298.6, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/45/64/26/picNxXVbx.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["european", "60 mins"], "ingredients": []}, {"recipe_id": "rec_292", "props": {"title": "Vegemite on Toast", "instructions": "[Instructions] 1) Toast your favourite variety of bread, butter it generously and spread a thin layer of Vegemite on it. (Reminder, this is very flavoursdome stuff so you don't need to use much at all). | 2) Other variations include:. | 3) - vegemite on toast with cheese, then grill to melt. | 4) - vegemite with cheese and tomato, then grill.", "tags": ["lunch snacks", "australian", "toddler friendly", "healthy", "kid friendly", "savory", "brunch", "15 mins", "beginner cook", "easy", "inexpensive"], "cook_time_min": 4, "servings": null, "cuisine": ["All"], "rating_avg": 5.0, "rating_count": 43, "popularity_score": 4.942264150943396, "nutrition_calories": 151.0, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/20/45/70/picsstht9.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["lunch snacks", "australian", "toddler friendly", "healthy", "kid friendly", "savory", "brunch", "15 mins", "beginner cook", "easy", "inexpensive"], "ingredients": []}, {"recipe_id": "rec_293", "props": {"title": "Xi-Fan - Easy Breakfast Fried Rice", "instructions": "[Instructions] 1) Spray skillet with non-fat cooking spray and heat on high; add rice, bacon and veggies and mix together. | 2) Once heated through, add egg white and turn heat down to medium. After it starts to cook, stir through rice mixture. | 3) Sprinkle with spices to taste and serve.", "tags": ["brown rice", "rice", "chinese", "asian", "low cholesterol", "healthy", "15 mins", "beginner cook", "stove top", "easy", "inexpensive"], "cook_time_min": 10, "servings": null, "cuisine": ["All"], "rating_avg": 5.0, "rating_count": 2, "popularity_score": 4.745, "nutrition_calories": 405.4, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/25/11/66/PtHb5ID1SJy3aH74asLp_friedrice2%20(1%20of%201).jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["brown rice", "rice", "chinese", "asian", "low cholesterol", "healthy", "15 mins", "beginner cook", "stove top", "easy", "inexpensive"], "ingredients": []}, {"recipe_id": "rec_294", "props": {"title": "Apple Pie Smoothie", "instructions": "[Instructions] 1) Put all ingredients into blender. | 2) Blend until smooth. | 3) Pour into glass and enjoy.", "tags": ["beverages", "breakfast", "apple", "tropical fruits", "fruit", "15 mins", "beginner cook", "easy"], "cook_time_min": 10, "servings": null, "cuisine": ["All"], "rating_avg": 4.74, "rating_count": 38, "popularity_score": 4.730416666666667, "nutrition_calories": 284.0, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/22/83/86/QVRFE6zWTgyP7bQK25BA_0S9A3771.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["beverages", "breakfast", "apple", "tropical fruits", "fruit", "15 mins", "beginner cook", "easy"], "ingredients": []}, {"recipe_id": "rec_295", "props": {"title": "Avocado Toast With Za'atar", "instructions": "[Instructions] 1) Toast your bread. | 2) Mash your half avocado and spread on bread, it will be a thick layer. | 3) Drizzle your avocado toast with olive oil, about 2 teaspooons worth. | 4) Sprinkle a pinch or three on za'atar on the avocado, how much you use is up to your taste\u2014start small you can always add more. | 5) Sprinkle toast with a pinch of fleur de sel, crushing it between your fingers as your sprinkle it over your toast. | 6) Eat!", "tags": ["breakfast", "avocado", "vegetable", "15 mins"], "cook_time_min": 10, "servings": null, "cuisine": ["All"], "rating_avg": 5.0, "rating_count": 3, "popularity_score": 4.764615384615385, "nutrition_calories": 321.6, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/submissions/recipe/2001051242/7pd9ptXgTFygNcQolDWt_FullSizeRender.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["breakfast", "avocado", "vegetable", "15 mins"], "ingredients": []}, {"recipe_id": "rec_296", "props": {"title": "Bacon Hash Brown Casserole", "instructions": "[Instructions] 1) Thaw hash browns for 30 minutes. | 2) While hash browns are thawing, prepare the bacon: Using clean scissors, cut the bacon into thin strips horizontally. Fry until crispy or desired doneness. (The scissor method saves the hassle of trying to crumble the bacon after it is cooked.). | 3) In a large bowl, mix together soup & sour cream & salt and pepper. | 4) Add melted margarine & mix well. | 5) Add the cheese & bacon and then the hash browns. Continue mixing until well combined. | 6) Spread mixture into 9 X 13 pan, lightly coated with cooking spray. | 7) Bake for 1 hour at 375 degrees.", "tags": ["vegetable", "4 hours"], "cook_time_min": 1, "servings": null, "cuisine": ["All"], "rating_avg": 4.88, "rating_count": 8, "popularity_score": 4.776666666666666, "nutrition_calories": 672.5, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/34/54/44/EoWCeJCoSemmkRB6A2BV_hashbrown-casserole-02352.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["vegetable", "4 hours"], "ingredients": []}, {"recipe_id": "rec_297", "props": {"title": "Banana Pancake Sandwich", "instructions": "[Instructions] 1) Divide almond butter between two pancakes. | 2) Slice banana thinly and arrange on pancakes with almond butter; drizzle some maple syrup over banana slices. | 3) Top with remaining pancakes and more maple syrup.", "tags": ["tropical fruits", "fruit", "15 mins", "easy"], "cook_time_min": 5, "servings": null, "cuisine": ["All"], "rating_avg": 4.5, "rating_count": 4, "popularity_score": 4.638571428571428, "nutrition_calories": 696.8, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/11/08/71/I2ai7G2VQ9mPsFepiYvy_pancakespastry2-2.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["tropical fruits", "fruit", "15 mins", "easy"], "ingredients": []}, {"recipe_id": "rec_298", "props": {"title": "Basic Pasta Dough (No Egg)", "instructions": "[Instructions] 1) Put flour in large mixing bowl, making a well in the center. | 2) Add wet ingredients to well and very slowly mix together with a fork, incorporating only a little flour at a time so it mixes smoothly and evenly. Trust me, the more patient you are with this the better it will turn out. | 3) Continue kneading by hand for about 10 minutes, let rest for a half hour covered with a towel. Repeat a couple times until dough is smooth and silky, and just slightly sticky. | 4) Shape by hand or with a machine. | 5) Note: Boiling fresh pasta takes significantly less time than dry pasta. Depending on the shape, cook for 30 seconds to 2 minutes.", "tags": ["egg free", "healthy", "free of", "4 hours", "easy"], "cook_time_min": 2, "servings": null, "cuisine": ["All"], "rating_avg": 4.92, "rating_count": 18, "popularity_score": 4.839285714285714, "nutrition_calories": 400.9, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/36/02/34/XjMHSoWSqKbO19dMDAwc-DSC_7960.JPG"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["egg free", "healthy", "free of", "4 hours", "easy"], "ingredients": []}, {"recipe_id": "rec_299", "props": {"title": "Best Ever Eggless Banana Oatmeal Muffins", "instructions": "[Instructions] 1) Preheat oven to 400 degrees F (205 degrees C). | 2) In a bowl, combine flour, oats, sugar, baking powder, soda, and salt. | 3) In another large bowl, mix together milk, applesauce, and vanilla. | 4) Add the mashed bananas, and combine thoroughly. | 5) Stir the flour mixture into the banana mixture until just combined. | 6) Lightly grease and dust 6 muffin cups (or line with paper bake cups), and divide the batter among them. | 7) Bake at 400 degrees F (205 degrees C) for 20 minutes.", "tags": ["breads", "breakfast", "fruit", "low cholesterol", "healthy", "kid friendly", "30 mins", "oven", "beginner cook", "easy"], "cook_time_min": 20, "servings": null, "cuisine": ["All"], "rating_avg": 4.28, "rating_count": 44, "popularity_score": 4.3566666666666665, "nutrition_calories": 141.2, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/22/60/0/picKwhX2L.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["breads", "breakfast", "fruit", "low cholesterol", "healthy", "kid friendly", "30 mins", "oven", "beginner cook", "easy"], "ingredients": []}, {"recipe_id": "rec_300", "props": {"title": "Breakfast Banana Split", "instructions": "[Instructions] 1) Select smaller, ripe bananas. Cut off one inch, and then slice the banana in half and place on a salad plate curving away from one another and outward. Slice the small piece and place on either side of the curved pieces. | 2) Spoon whipped yogurt across the top of bananas. Dribble slightly diluted jam on top of yogurt. Sprinkle nuts on top, if desired. Offer chocolate or fudge sauce. Enjoy!", "tags": ["lunch snacks", "tropical fruits", "fruit", "low protein", "low cholesterol", "healthy", "kid friendly", "15 mins", "easy"], "cook_time_min": 10, "servings": null, "cuisine": ["All"], "rating_avg": 4.8, "rating_count": 16, "popularity_score": 4.759230769230769, "nutrition_calories": 253.6, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/12/76/84/uD8v7zFPSbulXHL1dpYI_banana.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["lunch snacks", "tropical fruits", "fruit", "low protein", "low cholesterol", "healthy", "kid friendly", "15 mins", "easy"], "ingredients": []}, {"recipe_id": "rec_301", "props": {"title": "Breakfast Cereal Popsicles", "instructions": "[Instructions] 1) Pour the cereal into a large bowl and add the milk. Let this mixture sit for 10-15 minutes. | 2) Melt two scoops of vanilla ice cream in a bowl until liquid. | 3) Combine the cereal/milk mixture and the melted vanilla ice cream. | 4) Pour the mixture into popsicle molds and put them in the freezer for 45 minutes. Then remove, add popsicle sticks and freeze for another four hours.", "tags": ["30 mins", "easy"], "cook_time_min": 20, "servings": null, "cuisine": ["All"], "rating_avg": 2.0, "rating_count": 1, "popularity_score": 4.449090909090908, "nutrition_calories": 51.9, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/53/02/87/SKEf0oHpRlC5aFjs4Jai_milk-cereal-popsicles-trix-3938.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["30 mins", "easy"], "ingredients": []}, {"recipe_id": "rec_302", "props": {"title": "Breakfast Smoothie", "instructions": "[Instructions] 1) Combine all the ingredients in a blender & puree until smooth! | 2) Pour into 2 tall glasses & ENJOY!", "tags": ["beverages", "oranges", "citrus", "tropical fruits", "fruit", "15 mins", "easy"], "cook_time_min": 2, "servings": null, "cuisine": ["All"], "rating_avg": 4.5, "rating_count": 5, "popularity_score": 4.629333333333333, "nutrition_calories": 308.9, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/39/15/99/GqTfEvG6SfEQ2PFjgSmK_Smoothie3.JPG"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["beverages", "oranges", "citrus", "tropical fruits", "fruit", "15 mins", "easy"], "ingredients": []}, {"recipe_id": "rec_303", "props": {"title": "Broccoli and Cheese Breakfast Melts", "instructions": "[Instructions] 1) Thaw broccoli in microwave oven or at room temperature, drain well on paper towels. | 2) Place muffins on baking sheet, broil turning once, until lightly toasted. | 3) Remove and turn cut side up. | 4) Top each with slice of ham and tomato, top with broccoli. | 5) Sprinkle with cheese. | 6) Broil for 3 minutes or until cheese is melted and bubbly.", "tags": ["breakfast", "lunch snacks", "cheese", "vegetable", "canadian", "kid friendly", "broil grill", "30 mins", "oven", "beginner cook", "easy", "inexpensive"], "cook_time_min": 10, "servings": null, "cuisine": ["All"], "rating_avg": 4.0, "rating_count": 1, "popularity_score": 4.63090909090909, "nutrition_calories": 187.1, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/18/29/8/uCsszj0RVmEabWsfNKyY_file1.jpeg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["breakfast", "lunch snacks", "cheese", "vegetable", "canadian", "kid friendly", "broil grill", "30 mins", "oven", "beginner cook", "easy", "inexpensive"], "ingredients": []}, {"recipe_id": "rec_304", "props": {"title": "Broiled Cheese Toast", "instructions": "[Instructions] 1) Place bread on cookie sheet. | 2) Spread with your desired amount of butter. | 3) Place cheese on top of butter. | 4) Sprinkle with sugar. | 5) Place under broiler; be sure to watch closely so sugar does not burn). | 6) Broil until tops are bubbly and just beginning to toast. | 7) Enjoy!", "tags": ["cheese", "high in", "broil grill", "15 mins", "oven", "beginner cook", "easy"], "cook_time_min": 5, "servings": null, "cuisine": ["All"], "rating_avg": 4.33, "rating_count": 5, "popularity_score": 4.572666666666667, "nutrition_calories": 113.5, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/24/36/20/zqu4rUmERNCkfbNEuR2B_untitled-2520.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["cheese", "high in", "broil grill", "15 mins", "oven", "beginner cook", "easy"], "ingredients": []}, {"recipe_id": "rec_305", "props": {"title": "Carrot Cake Overnight Oats", "instructions": "[Instructions] 1) In a medium bowl, mix the oats, milk and yoghurt together. Stir in the carrot, cinnamon and ginger. | 2) Divide between two bowls or mason jars and store in the fridge overnight. | 3) In the morning, top with the walnuts, honey and extra yoghurt if desired. Serve.", "tags": ["breakfast", "vegetable", "15 mins", "easy"], "cook_time_min": 5, "servings": null, "cuisine": ["All"], "rating_avg": null, "rating_count": 0, "popularity_score": null, "nutrition_calories": 265.7, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/53/72/06/N1h3ClHSjWcPTZgZCNgw_untitled-6416.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["breakfast", "vegetable", "15 mins", "easy"], "ingredients": []}, {"recipe_id": "rec_306", "props": {"title": "Coconut and Chia-Seed Pudding", "instructions": "[Instructions] 1) Pour the chia seeds into a jar. | 2) Pour the coconut milk over the chia seeds. | 3) Put a lid on the jar and shake to combine. | 4) Add strawberries and almonds on top and serve.", "tags": ["15 mins", "easy"], "cook_time_min": 5, "servings": null, "cuisine": ["All"], "rating_avg": null, "rating_count": 0, "popularity_score": null, "nutrition_calories": 262.5, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/submissions/recipe/33186/A6MmqQnxRcSD7WQbIFnd_Screen%20Shot%202016-09-07%20at%2011.26.00%20AM.png"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["15 mins", "easy"], "ingredients": []}, {"recipe_id": "rec_307", "props": {"title": "Coconut, Raspberry and Lemon Overnight Oats", "instructions": "[Instructions] 1) In a medium bowl, mix the oats, coconut milk, milk and lemon zest. | 2) Mash half of the raspberries and stir into the oats. | 3) Divide between two bowls or mason jars and store in the fridge overnight. | 4) In the morning, top the oats with the remaining raspberries and flaked coconut. Serve with honey/maple syrup if needed.", "tags": ["breakfast", "vegan", "15 mins"], "cook_time_min": 5, "servings": null, "cuisine": ["All"], "rating_avg": null, "rating_count": 0, "popularity_score": null, "nutrition_calories": 288.4, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/submissions/recipe/2001201872/YGiW881QVU3IcrxiOrNA_untitled-6459.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["breakfast", "vegan", "15 mins"], "ingredients": []}, {"recipe_id": "rec_308", "props": {"title": "Cornbread (Egg-Free/Vegan)", "instructions": "[Instructions] 1) Preheat oven to 375 degrees. | 2) Grease an 8\" or 9\" square pan. | 3) Combine the dry ingredients--cornmeal, flour, sugar, baking powder, baking soda, and salt. | 4) Stir in the wet ingredients--milk, oil, vinegar, and corn syrup. | 5) Pour batter into pan. | 6) Bake for 20 minutes or until the sides begin to pull away from the edge of the pan and wooden toothpick inserted in center comes out clean.", "tags": ["breads", "egg free", "free of", "30 mins"], "cook_time_min": 20, "servings": null, "cuisine": ["All"], "rating_avg": 4.33, "rating_count": 21, "popularity_score": 4.4474193548387095, "nutrition_calories": 268.9, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/31/63/04/gwRolVKvRL2Tq2gQyP0Q_20171109_184540.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["breads", "egg free", "free of", "30 mins"], "ingredients": []}, {"recipe_id": "rec_309", "props": {"title": "Egg-Free Peanut Butter Cookies", "instructions": "[Instructions] 1) Preheat oven to 375 degrees farenheit. | 2) mix together peanut butter, sugars, vanilla and margarine until well blended. | 3) add rest of ingredients, and mix well til totally combined. | 4) form dough into balls about 3/4 inch in size, and place on ungreased cookie sheet, mark top of balls with fork. | 5) heat in 375 degree oven for 8-10 minute. | 6) wait a minute, then transfer to wire rack, cool completely. | 7) Store in air tight container.", "tags": ["cookie and brownie", "15 mins"], "cook_time_min": 10, "servings": null, "cuisine": ["All"], "rating_avg": 4.37, "rating_count": 62, "popularity_score": 4.415, "nutrition_calories": 123.3, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/71/84/9/x7Uu6YjrToqWVam73VSE_image.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["cookie and brownie", "15 mins"], "ingredients": []}, {"recipe_id": "rec_310", "props": {"title": "Eggless Chocolate Cookies", "instructions": "[Instructions] 1) Cream margarine, oil, sugar and 1 T water until light and fluffy. | 2) Mix in remaining 2-3 T of water and beat well. | 3) Mix dry ingredients. | 4) Add to margarine mixture and mix until combined. | 5) Refrigerate for 30 minutes to an hour. | 6) Preheat oven 400\u00b0F (200\u00b0C) and grease a cookie sheet well. | 7) Make 24 balls (can also do drop cookies). | 8) Bake for 10 minutes, should be very puffy. | 9) Allow to cool for 5 minutes on baking sheet, they will fall considerably due to the lack of egg.", "tags": ["dessert", "cookie and brownie", "vegan", "egg free", "free of", "60 mins", "for large groups", "inexpensive"], "cook_time_min": 10, "servings": null, "cuisine": ["All"], "rating_avg": 4.49, "rating_count": 53, "popularity_score": 4.522380952380953, "nutrition_calories": 74.5, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/36/00/32/picyAE47M.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["dessert", "cookie and brownie", "vegan", "egg free", "free of", "60 mins", "for large groups", "inexpensive"], "ingredients": []}, {"recipe_id": "rec_311", "props": {"title": "Eggless Egg Free Tapioca Pudding", "instructions": "[Instructions] 1) Combine tapioca, milk & sugar in a medium/large saucepan and let sit for 5 minutes. | 2) Combine cornstarch & water in a small bowl. | 3) Bring to a slow boil over medium high heat, stirring constantly. | 4) Once bubbling, add cornstarch mixture and continue boiling for 1 minute. | 5) Remove from heat and add vanilla. | 6) Stir & allow to cool. | 7) Makes 6 1/2 cup servings.", "tags": ["low protein", "low cholesterol", "egg free", "healthy", "free of", "15 mins"], "cook_time_min": 10, "servings": null, "cuisine": ["All"], "rating_avg": 4.5, "rating_count": 4, "popularity_score": 4.638571428571428, "nutrition_calories": 150.5, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/44/00/01/picnLwbyu.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["low protein", "low cholesterol", "egg free", "healthy", "free of", "15 mins"], "ingredients": []}, {"recipe_id": "rec_312", "props": {"title": "Fruit Cups", "instructions": "[Instructions] 1) Without draining any of the fruit, combine all ingredients in a large bowl. Mix well. | 2) Spoon by the cupful into 9 oz. cups and freeze until firm. (Package in plastic airtight bags or cover with plastic wrap for long-term storage). | 3) Remove from freezer about 15 minutes prior to serving. I like to serve them when they are slushy but still frozen.", "tags": ["lunch snacks", "fruit", "low protein", "low cholesterol", "toddler friendly", "healthy", "kid friendly", "brunch", "beginner cook", "freezer", "4 hours", "easy"], "cook_time_min": 2, "servings": null, "cuisine": ["All"], "rating_avg": 5.0, "rating_count": 3, "popularity_score": 4.764615384615385, "nutrition_calories": 231.6, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/26/67/64/picoeALHE.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["lunch snacks", "fruit", "low protein", "low cholesterol", "toddler friendly", "healthy", "kid friendly", "brunch", "beginner cook", "freezer", "4 hours", "easy"], "ingredients": []}, {"recipe_id": "rec_313", "props": {"title": "Fruity Pebbles Parfait", "instructions": "[Instructions] 1) Place a small layer of the yogurt in the bottom of a glass. | 2) Alternate between layers of yogurt, cereal and sliced fruit. Only layer one fruit at a time so they come out looking color-blocked. | 3) Finish with a final layer of cereal. Drizzle with the chocolate syrup, if desired. Serve cold.", "tags": ["15 mins", "easy"], "cook_time_min": 7, "servings": null, "cuisine": ["All"], "rating_avg": 4.67, "rating_count": 3, "popularity_score": 4.688461538461539, "nutrition_calories": 178.8, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/53/02/85/1e4FoYRhqAGnCiUPRhSQ_fruity-pebbles-yogurt-parfait-3573.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["15 mins", "easy"], "ingredients": []}, {"recipe_id": "rec_314", "props": {"title": "Gourmet Spam Mcmuffin", "instructions": "[Instructions] 1) Slice the Spam into 6 even slices and place in a dry, non-stick skillet; cook until lightly browned, turning once. | 2) Place the tomato slices on a foil-lined cookie sheet, top with grated cheese and place under the broiler until cheese is melted. | 3) To assemble: Place the Spam slices on 6 of the muffin halves, top with a tomato slice, black pepper and a basil leaf. | 4) Spread the remaining half of muffin with Dijon mustard to suit your taste, place on top of all and enjoy.", "tags": ["lunch snacks", "vegetable", "meat", "brunch", "broil grill", "30 mins", "oven", "stove top", "easy"], "cook_time_min": 10, "servings": null, "cuisine": ["All"], "rating_avg": 4.6, "rating_count": 5, "popularity_score": 4.6626666666666665, "nutrition_calories": 329.8, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/24/66/22/picobPovX.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["lunch snacks", "vegetable", "meat", "brunch", "broil grill", "30 mins", "oven", "stove top", "easy"], "ingredients": []}, {"recipe_id": "rec_315", "props": {"title": "Healthy Fruit Free Breaky Cereal", "instructions": "[Instructions] 1) Combine all ingredients in a large bowl and mix well until everything is really well combined. | 2) Spread mixture over 1 or 2 trays and bake at 160\u00b0C for 30 minutes, stirring every 5-10 minutes If the mixture appears to be getting too dark, but doesn't seem dried out, turn the oven down to 140\u00b0C. | 3) Remove from the oven and cool completely before storing in airtight jars or containers.", "tags": ["australian", "kid friendly", "60 mins", "easy"], "cook_time_min": 30, "servings": null, "cuisine": ["All"], "rating_avg": 5.0, "rating_count": 2, "popularity_score": 4.745, "nutrition_calories": 232.3, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/33/15/81/picEVWVCI.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["australian", "kid friendly", "60 mins", "easy"], "ingredients": []}, {"recipe_id": "rec_316", "props": {"title": "Honey and Cheese Sandwich", "instructions": "[Instructions] 1) Butter bread thinly. | 2) Spread honey on bread. | 3) Unwrap slice of processed cheese and place on top of honey. | 4) Enjoy. | 5) If you would like, spread butter and honey on another slice of wholemeal bread and make it a closed sandwich.", "tags": ["lunch snacks", "healthy", "high in", "15 mins", "no cook", "easy"], "cook_time_min": 5, "servings": null, "cuisine": ["All"], "rating_avg": 4.38, "rating_count": 8, "popularity_score": 4.554444444444444, "nutrition_calories": 173.6, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/98/36/9/mfFrVroSimfWfKh9UfgA_cheese-honey-toast-1302.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["lunch snacks", "healthy", "high in", "15 mins", "no cook", "easy"], "ingredients": []}, {"recipe_id": "rec_317", "props": {"title": "Masala Dosa with Coconut Chutney (South Indian Savory Crepes with filling)", "instructions": "[Instructions] 1) For the dosa: Soak the parboiled and uncooked rice together in water. | 2) Separately, soak the dal and fenugreek seeds together in water. | 3) After 3-4 hours, drain and reserve the water and grind both separately in a blender to a fine paste, adding some the reserved water as needed (if the grinder/blender seizes up) until the mixture is of batter consistency. | 4) Add the salt, some water if necessary, and mix both together thoroughly; keep overnight to ferment. | 5) The next day, check the batter; if too thick, add some water and mix so that it is of a pouring consistency. | 6) Heat a skillet and grease with some oil. | 7) Pour a ladleful of batter and spread as quickly as possible into a thin circle. | 8) Pour a little oil (about 1/2 teaspoon) all around the crepe and on the centre as well. | 9) Cook until the dosa is done, then turn over and cook the other side until crisp. | 10) Set the dosas aside. | 11) Note: If parboiled rice is not available, soak 2 1/4 cups of uncooked rice. | 12) For the potato curry: Heat the 3 tablespoons of oil. | 13) Season with the mustard and gram dals. | 14) When done, add the chopped onions, green chilies, ginger, curry leaves, chili powder, and turmeric powder. | 15) When the onions are browned, add the potatoes and salt, and mix thoroughly. | 16) Add the coriander leaves and lemon juice, if desired, and mix well. | 17) For the chutney: Heat the oil, add the asafoetida, red chilies, and then the dal. | 18) Fry until the dal turns brownish. | 19) Remove from flame. | 20) Grind this mixture with the grated coconut, salt and tamarind to a slightly rough paste. | 21) Add a little water to make the chutney of a spreadable consistency. | 22) To make the masala dosas (the final product!): When required, reverse the prepared dosa and place on a skillet. | 23) Spread approximately 1 tablespoon of chutney evenly all over the dosa. | 24) Carefully place 2 tablespoons of potato curry in the centre, fold the the left a third over the centre, and then the right side over the left (or, just fold it any way you like!). | 25) Sprinkle a little ghee or butter. | 26) Roast for a minute or two. | 27) Remove from flame and serve immediately. | 28) Alternatively, stuff the dosa with the potato curry only, and serve the chutney as a dip.", "tags": ["lunch snacks", "potato", "rice", "coconut", "fruit", "vegetable", "nuts", "asian", "indian", "potluck", "spicy", "savory", "weeknight", "refrigerator", "stove top"], "cook_time_min": 30, "servings": null, "cuisine": ["All"], "rating_avg": 4.86, "rating_count": 8, "popularity_score": 4.767777777777778, "nutrition_calories": 497.4, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/27/02/8/OOAT4eIST9aBZ5yKtuUS_DSC_4264.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["lunch snacks", "potato", "rice", "coconut", "fruit", "vegetable", "nuts", "asian", "indian", "potluck", "spicy", "savory", "weeknight", "refrigerator", "stove top"], "ingredients": []}, {"recipe_id": "rec_318", "props": {"title": "Milk and Cereal Smoothies", "instructions": "[Instructions] 1) Put all ingredients in a blender and blend until smooth. | 2) Garnish with extra cereal on top and enjoy!", "tags": ["15 mins", "easy"], "cook_time_min": 2, "servings": null, "cuisine": ["All"], "rating_avg": 2.0, "rating_count": 1, "popularity_score": 4.449090909090908, "nutrition_calories": 216.7, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/53/02/84/OO3FKItQRSNT6l1DXQvs_cereal-milk-smoothies-3496.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["15 mins", "easy"], "ingredients": []}, {"recipe_id": "rec_319", "props": {"title": "Milk-Free, Egg-Free Pancakes", "instructions": "[Instructions] 1) Sift flour, sugar, baking powder, and salt together into medium mixing bowl. | 2) Melt 2 1/2 Tbsp margarine in frying pan until melted. | 3) Be sure to tip the pan side to side to coat/grease all over. | 4) Pour melted margarine in a small bowl, add water and egg (if you want to add egg); Mix well. | 5) Stir liquid mixture into the dry ingredients until it is thoroughly moistened. | 6) It is OK if this batter is lumpy. | 7) Cook the pancakes over medium-high heat on the stove-top (or 375F on electric frying pans). | 8) Cook pancakes until the tops are bubbly and the bottoms browned. | 9) Turn the pancakes over to cook other side (approximately four minutes per side). | 10) Serve hot with margarine, honey, brown sugar or maple syrup. | 11) Actual cooking time will depend on the size of the pan you are using; I have a small frying pan, so I have to do these individually. My mom has a griddle large enough to cook them all at once.", "tags": ["lactose free", "kid friendly", "free of", "30 mins", "beginner cook", "easy", "inexpensive"], "cook_time_min": 15, "servings": null, "cuisine": ["All"], "rating_avg": 4.69, "rating_count": 140, "popularity_score": 4.690266666666667, "nutrition_calories": 155.2, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/92/64/7/KefiQG6QRMGF2RaVL567_milk-free-egg-free-pancakes_0476.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["lactose free", "kid friendly", "free of", "30 mins", "beginner cook", "easy", "inexpensive"], "ingredients": []}, {"recipe_id": "rec_320", "props": {"title": "Mocha Latte Smoothie", "instructions": "[Instructions] 1) Place all ingredients in blender and blend on high until smooth.", "tags": ["beverages", "low protein", "low cholesterol", "healthy", "kid friendly", "summer", "15 mins", "no cook", "small appliance", "easy", "inexpensive"], "cook_time_min": 1, "servings": null, "cuisine": ["All"], "rating_avg": 4.93, "rating_count": 41, "popularity_score": 4.883725490196079, "nutrition_calories": 179.4, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/65/34/7/ArEAsjkeSO2xh72IR14A_DSC_3978.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["beverages", "low protein", "low cholesterol", "healthy", "kid friendly", "summer", "15 mins", "no cook", "small appliance", "easy", "inexpensive"], "ingredients": []}, {"recipe_id": "rec_321", "props": {"title": "Nat's Cucumber Cream Cheese Bagel", "instructions": "[Instructions] 1) Slice and toast bagel. | 2) Spread both sides with cream cheese. | 3) Top on side with cucumber slices. | 4) Sprinkle with salt and pepper. | 5) Note:. | 6) My favorite bagel is the \"everything bagel\", the onion or the sesame, but use whatever bagel you fancy. | 7) I keep the skin on the cucumber, but peel it if you like.", "tags": ["lunch snacks", "cheese", "15 mins", "easy"], "cook_time_min": 1, "servings": null, "cuisine": ["All"], "rating_avg": 5.0, "rating_count": 13, "popularity_score": 4.86695652173913, "nutrition_calories": 387.9, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/11/38/53/pEhG9hQPQFqxq9uNyvkJ_cucumber-cream-cheese-bagels_9894.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["lunch snacks", "cheese", "15 mins", "easy"], "ingredients": []}, {"recipe_id": "rec_322", "props": {"title": "Quick and Easy Eggless Banana Bread", "instructions": "[Instructions] 1) 1. Preheat oven to 350\u00baF/180\u00baC. | 2) 2. In a mixing bowl, combine mashed bananas with butter. | 3) 3. Add in milk, vanilla, and mix. | 4) 4. Add in sugar, baking soda, salt, and mix. | 5) 5. Add flour last and mix until just combined. | 6) 6. Pour mixture into a greased and floured bread loaf pan. | 7) 7. Bake for 1 hour or until a wooden pick comes out clean. | 8) 8. Allow to cool before removing from pan.", "tags": ["breads", "dessert", "tropical fruits", "fruit", "australian", "european", "low protein", "toddler friendly", "kid friendly", "potluck", "weeknight", "brunch", "beginner cook", "4 hours", "easy", "inexpensive"], "cook_time_min": 1, "servings": null, "cuisine": ["All"], "rating_avg": 4.16, "rating_count": 46, "popularity_score": 4.255357142857143, "nutrition_calories": 658.4, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/44/74/87/01503176987.jpeg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["breads", "dessert", "tropical fruits", "fruit", "australian", "european", "low protein", "toddler friendly", "kid friendly", "potluck", "weeknight", "brunch", "beginner cook", "4 hours", "easy", "inexpensive"], "ingredients": []}, {"recipe_id": "rec_323", "props": {"title": "Quick Japanese Breakfast Roll", "instructions": "[Instructions] 1) Place the nori on your cutting board and place the salmon across the bottom half of the sheet. | 2) Thinly slice the avocado and add it on top of the salmon. | 3) Drizzle the soy sauce on top and roll the nori up. Slice in half and serve.", "tags": ["15 mins", "easy"], "cook_time_min": 5, "servings": null, "cuisine": ["All"], "rating_avg": null, "rating_count": 0, "popularity_score": null, "nutrition_calories": 84.0, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/submissions/recipe/33186/AVmdbv4MScWlzPF1JbfR_Screen%20Shot%202016-09-07%20at%201.47.33%20PM.png"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["15 mins", "easy"], "ingredients": []}, {"recipe_id": "rec_324", "props": {"title": "Sausage Biscuits", "instructions": "[Instructions] 1) MIX TOGETHER USING HANDS. | 2) FORM INTO 1 TO 1/2 INCH BALLS. | 3) BAKE AT 350 FOR 20 TO 25 MINUTES TILL GOLDEN BROWN. | 4) EAT AND ENJOY.", "tags": ["pork", "meat", "30 mins", "easy"], "cook_time_min": 20, "servings": null, "cuisine": ["All"], "rating_avg": 4.0, "rating_count": 2, "popularity_score": 4.578333333333333, "nutrition_calories": 409.2, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/15/21/60/picyCRgaS.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["pork", "meat", "30 mins", "easy"], "ingredients": []}, {"recipe_id": "rec_325", "props": {"title": "Sausage Gravy and Biscuits", "instructions": "[Instructions] 1) Cook sausage and onions in a skillet until sausage is done. | 2) Meanwhile, in a separate bowl, combine milk, Worcestershire sauce, and salt/pepper (to taste); set aside. | 3) When sausage/onion mixture is done,remove and drain excess grease. | 4) Return sausage/onion mixture back to skillet. | 5) Over medium/low heat, gradually add flour. | 6) Turn to coat sausage and cook until golden (approx). | 7) Return heat to medium. | 8) Slowly stir in milk/seasoning mixture. | 9) Cook until gravy reaches desired thickness (stirring frequently). | 10) Cook biscuits according to package directions. | 11) Serve gravy over biscuits split in half.", "tags": ["breakfast", "pork", "meat", "60 mins", "oven", "stove top", "easy"], "cook_time_min": 30, "servings": null, "cuisine": ["All"], "rating_avg": 4.91, "rating_count": 97, "popularity_score": 4.889813084112149, "nutrition_calories": 954.6, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/86/02/S5SJBxdkTiS2WlkHWOsl_sausage-gravy-and-biscuits_0137.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["breakfast", "pork", "meat", "60 mins", "oven", "stove top", "easy"], "ingredients": []}, {"recipe_id": "rec_326", "props": {"title": "Scrambled Tofu", "instructions": "[Instructions] 1) Crumble tofu with your fingers. | 2) Combine with nutritional yeast. | 3) Mix together soy sauce, turmeric, onion powder and garlic powder; add to tofu mixture. | 4) Spray a nonstick skillet with cooking spray. | 5) Add tofu mixture to skillet. | 6) Cook over medium to high heat, turning with an egg turner or spatula, for several minutes. | 7) Add salt and pepper. | 8) VARIATION: If desired, you can make Vegetable Scrambled Tofu. | 9) Before adding tofu to the skillet, saute 2 sliced mushrooms, 1 T chopped onion and 1 T chopped green pepper. | 10) Add tofu and continue as above. | 11) To add additional color use a bit more tumeric. It is what supplies the color.", "tags": ["soy tofu", "beans", "vegan", "low cholesterol", "healthy", "brunch", "15 mins", "stove top"], "cook_time_min": 5, "servings": null, "cuisine": ["All"], "rating_avg": 4.2, "rating_count": 11, "popularity_score": 4.435238095238095, "nutrition_calories": 103.9, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/71/41/9/picJQU5Ic.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["soy tofu", "beans", "vegan", "low cholesterol", "healthy", "brunch", "15 mins", "stove top"], "ingredients": []}, {"recipe_id": "rec_327", "props": {"title": "Smoked Salmon and Herb Butter", "instructions": "[Instructions] 1) For the herb butter, combine the butter, garlic, scallions, dill, parsley, juice juice, salt and pepper in the bowl of an electric mixer fitted with a paddle attachment. Beat until mixed, but do not whip. | 2) To serve, spread some herb butter on a slice of bread and top it with a slice of smoked salmon.", "tags": ["scandinavian", "european", "mixer", "15 mins", "small appliance", "easy"], "cook_time_min": 10, "servings": null, "cuisine": ["All"], "rating_avg": 5.0, "rating_count": 7, "popularity_score": 4.82, "nutrition_calories": 313.6, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/42/56/71/A5zt5avQqq4iVX0rTiwQ_smoked-salmon-herb-butter-toasts-02700.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["scandinavian", "european", "mixer", "15 mins", "small appliance", "easy"], "ingredients": []}, {"recipe_id": "rec_328", "props": {"title": "Throw Away the Bread Machine Instructions!.... White Bread", "instructions": "[Instructions] 1) Place the water into the bread pan. | 2) Sprinkle the sugar then the yeast over the water; allow the yeast to foam for 10 minutes. | 3) Add in the melted butter, oil, flour and salt. | 4) Select the BASIC or WHITE BREAD setting and press start.", "tags": ["breads", "healthy", "kid friendly", "brunch", "bread machine", "15 mins", "beginner cook", "small appliance", "easy"], "cook_time_min": 5, "servings": null, "cuisine": ["All"], "rating_avg": 4.74, "rating_count": 177, "popularity_score": 4.737540106951871, "nutrition_calories": 160.8, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/33/99/05/3RDltEbqSZCOOfoR10yY_bread%20machine%20white%20SITE-3.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["breads", "healthy", "kid friendly", "brunch", "bread machine", "15 mins", "beginner cook", "small appliance", "easy"], "ingredients": []}, {"recipe_id": "rec_329", "props": {"title": "Toasted Peach Sandwich", "instructions": "[Instructions] 1) Slather 1 side of each bread slice with cream cheese. | 2) On 2 bread slices, arrange peaches accordion style; sprinkle peaches with sugar and nutmeg. | 3) Close up the sandwiches. | 4) Spread butter on 1 side of the bread. | 5) Put butter side down in medium-hot frying pan. | 6) Carefully butter top bread slices. | 7) Toast on each side until bread is golden brown, 3-4 minutes per side. | 8) Serve sprinkled with powdered sugar if desired.", "tags": ["lunch snacks", "cheese", "fruit", "sweet", "15 mins", "easy"], "cook_time_min": 8, "servings": null, "cuisine": ["All"], "rating_avg": 4.67, "rating_count": 3, "popularity_score": 4.688461538461539, "nutrition_calories": 295.3, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/24/27/36/XvYOgOMKQGqQIru3UFax_peach-sandwich-2.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["lunch snacks", "cheese", "fruit", "sweet", "15 mins", "easy"], "ingredients": []}, {"recipe_id": "rec_330", "props": {"title": "Vegan French Toast With Coconut Milk and Banana", "instructions": "[Instructions] 1) Place all ingredients (except bread!) into a blender and blend until smooth. Pour into a large, shallow bowl, and set aside. | 2) Slice bread into 8 thick slices. Heat a griddle or pan and brush with oil. Submerge bread slices into the batter, lift out with a pair of tongs, and place onto hot pan. Cook until golden brown, flip and cook on the reverse side. Serve immediately with your favourite toppings.", "tags": ["coconut", "tropical fruits", "fruit", "nuts", "vegan", "brunch", "60 mins", "small appliance", "easy"], "cook_time_min": 30, "servings": null, "cuisine": ["All"], "rating_avg": 4.71, "rating_count": 7, "popularity_score": 4.700588235294117, "nutrition_calories": 145.4, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/42/31/16/5hLzLmvIQs29qg0bjyKE_vegan-coconut-french-toast-05820.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["coconut", "tropical fruits", "fruit", "nuts", "vegan", "brunch", "60 mins", "small appliance", "easy"], "ingredients": []}, {"recipe_id": "rec_331", "props": {"title": "Vegan Waffles", "instructions": "[Instructions] 1) Mix banana and water. | 2) Add dry ingredients and mix leaving lumps in batter to prevent waffles from become rubbery when cooked. | 3) Cook on/in waffle iron.", "tags": ["grains", "vegan", "low cholesterol", "healthy", "15 mins", "beginner cook", "easy"], "cook_time_min": 10, "servings": null, "cuisine": ["All"], "rating_avg": 3.33, "rating_count": 4, "popularity_score": 4.304285714285714, "nutrition_calories": 256.3, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/25/88/58/SrVvuQoqSeGQVrFeyLWT_VP%205%20-%20final_3.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["grains", "vegan", "low cholesterol", "healthy", "15 mins", "beginner cook", "easy"], "ingredients": []}, {"recipe_id": "rec_332", "props": {"title": "Wake-Up Stuffed French Breakfast Panini", "instructions": "[Instructions] 1) Cut two slices French bread diagonally, each slice about an inch thick, OR. | 2) Cut just one slice French bread diagonally, about 2 inches thick, and carefully open one end and remove some of the bread, making a pocket. | 3) Mix cream cheese and preserves. | 4) Spread cream cheese/preserve mixture on one side of sliced bread, and top with remaining slice, making a sandwich OR. | 5) Stuff pocket in the 2 inch slice of bread with cream cheese/preserve mixture. | 6) Spread the outside of bread with melted butter. | 7) Place on grill. | 8) When browned to your likeness, dust with powdered sugar. | 9) NOTE: You may add cinnamon, raisins, nuts, cranberries, etc. Or you may make it with cream cheese only, and drizzle with syrup.", "tags": ["low cholesterol", "healthy", "brunch", "15 mins", "easy"], "cook_time_min": 4, "servings": null, "cuisine": ["All"], "rating_avg": 5.0, "rating_count": 11, "popularity_score": 4.854285714285714, "nutrition_calories": 2959.4, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/27/46/31/s76xnQaRRqidSebC6DwL_THE%20FOOD%20GAYS%20-%20WAKE%20UP%20STUFFED%20FRENCH%20TOAST%20PANINI.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["low cholesterol", "healthy", "brunch", "15 mins", "easy"], "ingredients": []}, {"recipe_id": "rec_333", "props": {"title": "Apple Butter", "instructions": "[Instructions] 1) Mix apple puree, sugars, cinnamon, nutmeg, cloves, pumpkin pie spice and lemon juice in a large, heavy saucepan. Cook, uncovered, over medium heat and when it begins to boil, turn down heat to low and simmer, stirring occasionally. | 2) Place a couple of small saucers in the refrigerator. As mixture gets thicker, stir more often so it does not scorch. Total cooking time can take 1 to 2 hours. | 3) Cook until a spoonful dropped onto a cold plate does not weep. Let the mixture sit on plate about 5 minutes to check the consistency. | 4) Meanwhile, wash 6 half-pint jars. Keep hot until needed. Prepare lids as manufacturer directs. | 5) Ladle the hot apple butter into 1 hot jar at a time, leaving 1/4 inch head space. | 6) Wipe jar rim with a clean, damp cloth. Attach lid. | 7) Fill and close remaining jars. | 8) Process in a boiling water canner for 10 minutes. | 9) Note: To make the puree, wash, peel, core and quarter apples. Place in saucepan with just enough water to cover the bottom of the pan. Cover and cook on medium heat until apples are soft. Put cooked apples through a sieve or food mill.", "tags": ["fruit", "low protein", "low cholesterol", "healthy", "4 hours"], "cook_time_min": 2, "servings": null, "cuisine": ["All"], "rating_avg": null, "rating_count": 0, "popularity_score": null, "nutrition_calories": 473.0, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/26/52/53/picrwHyTC.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["fruit", "low protein", "low cholesterol", "healthy", "4 hours"], "ingredients": []}, {"recipe_id": "rec_334", "props": {"title": "Baked Denver Omelet", "instructions": "[Instructions] 1) Preheat oven to 400 degrees. | 2) In a medium bowl, whisk together the eggs, milk, salt and pepper. | 3) Place a nonstick or lightly greased baking sheet on an oven rack place at 2/3 of the oven's height. Pour egg mixture into pan. Bake 10 or 15 minutes or until the eggs are set but glossy. | 4) While the eggs are baking, saute the mushrooms, onion, and pepper together. | 5) Remove the baked omelet from the oven. Cut omelet into four squares. Place a square on each of four plates. | 6) Spoon 1/4 of the vegetable filling over each square. Sprinkle each with 1/4 cup of the shredded cheese. | 7) Fold each omelet square in half to form either a rectangle or a triangle. If desired, garnish with a bit more cheese and some parsley. | 8) NOTE: For vegetarians, omit ham or replace with veggie ham or sausage.", "tags": ["lunch snacks", "cheese", "very low carbs", "60 mins", "easy"], "cook_time_min": 30, "servings": null, "cuisine": ["All"], "rating_avg": 4.67, "rating_count": 3, "popularity_score": 4.688461538461539, "nutrition_calories": 398.2, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/22/93/04/KPLYDHWmTsaKm2GvYcv8_baked%20denver%20omelet%20SITE-1.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["lunch snacks", "cheese", "very low carbs", "60 mins", "easy"], "ingredients": []}, {"recipe_id": "rec_335", "props": {"title": "Baked French Toast Casserole With Maple Syrup", "instructions": "[Instructions] 1) Slice French bread into 20 slices, 1 inch thick. | 2) Arrange slices in a generously buttered 9x13-inch baking dish in 2 rows, overlapping slices. | 3) In a large bowl, combine the eggs, half and half, milk, sugar, vanilla, cinnamon, nutmeg and salt and beat with wire whisk until well blended. | 4) Pour mixture over bread slices, making sure all are covered evenly with egg mixture. | 5) Spoon some of the mixture in between the slices. | 6) Cover with foil and refrigerate overnight. | 7) The next morning, preheat oven to 350\u00b0F. | 8) Spread praline topping evenly over bread and bake for 40 minutes, until puffed up and lightly golden brown. | 9) Serve with maple syrup.", "tags": ["toddler friendly", "kid friendly", "potluck", "sweet", "brunch", "60 mins", "oven", "refrigerator"], "cook_time_min": 40, "servings": null, "cuisine": ["All"], "rating_avg": 4.56, "rating_count": 51, "popularity_score": 4.581967213114754, "nutrition_calories": 1297.0, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/90/24/6/S5rEG42MQICa66NLQYWE_DSC00487.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["toddler friendly", "kid friendly", "potluck", "sweet", "brunch", "60 mins", "oven", "refrigerator"], "ingredients": []}, {"recipe_id": "rec_336", "props": {"title": "Cinnamon-Raisin Baked Oatmeal", "instructions": "[Instructions] 1) Preheat oven to 350\u00b0F. | 2) Mix everything together in a greased 1 quart casserole. | 3) Bake, uncovered, for 30 minutes or until milk is absorbed. | 4) Serve with milk or cream. Add more sugar or other toppings to your heart's desire.", "tags": ["raspberries", "grains", "apple", "berries", "fruit", "native american", "low cholesterol", "healthy", "kid friendly", "sweet", "brunch", "60 mins", "oven", "easy", "inexpensive"], "cook_time_min": 30, "servings": null, "cuisine": ["All"], "rating_avg": 4.95, "rating_count": 19, "popularity_score": 4.861724137931034, "nutrition_calories": 543.5, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/22/33/92/picZmSvdo.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["raspberries", "grains", "apple", "berries", "fruit", "native american", "low cholesterol", "healthy", "kid friendly", "sweet", "brunch", "60 mins", "oven", "easy", "inexpensive"], "ingredients": []}, {"recipe_id": "rec_337", "props": {"title": "Beautiful Bagels - (using bread machine to make the dough)", "instructions": "[Instructions] 1) Place all the above ingredients into bread machine, and select'dough' cycle. | 2) Stop the bread machine 40 minutes after the mixing starts (1 hour and 10 minutes from beginning of dough cycle). | 3) Tip bagel dough out onto a lightly floured surface and gently knead by hand for about 1 minute. | 4) Cut dough into 8 pieces. | 5) Roll and'gently massage' each piece into a snake. | 6) Dampen and overlap the ends pressing firmly to form a ring. | 7) Place each ring on an individual piece of baking paper already lightly sprayed with oil. | 8) Cover all rings with a sheet of baking paper and allow to rest. | 9) Meanwhile, bring a large pan of water to the boil. | 10) Carefully lowering each bagel one by one (about 4 at a time) into the pan of boiling water, slide the paper from each bagel ring away. | 11) Gently turn bagels allowing about 40 seconds on each side. | 12) Lift each bagel out and drain on absorbent paper towels. | 13) Place drained bagels on baking baking tray already lined with baking paper. | 14) Brush each bagel with lightly beaten egg mixed with 1 tablespoon water and 1/2 teaspoon of salt and sprinkle with lots of poppy seeds or toasted sesame seeds. | 15) Bake in hot oven (220'C, Gas mark 7) for about 15 minutes- or until a nice deep golden brown colour. | 16) Remove bagels from oven and place on wire rack.", "tags": ["breads", "bread machine", "15 mins", "small appliance"], "cook_time_min": 5, "servings": null, "cuisine": ["All"], "rating_avg": 4.83, "rating_count": 22, "popularity_score": 4.7875, "nutrition_calories": 185.6, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/20/47/6/picqnRzPy.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["breads", "bread machine", "15 mins", "small appliance"], "ingredients": []}, {"recipe_id": "rec_338", "props": {"title": "Benedictine Sandwiches", "instructions": "[Instructions] 1) Peel the cucumber, and remove the seeds. | 2) Place in a food processor and pulse about 5-6 times until minced. (I use my Pampered Chef handy chopper, chopping a few pieces at a time - about 15 chops). | 3) Transfer cucumber to a small mixing bowl. | 4) Chop onion in chopper or food processor, until finely minced. Add to cucumber. | 5) Add cream cheese, salt, food coloring and Tabasco, combining well. | 6) With a biscuit cutter, cut rounds out of bread slices. | 7) Spread a small amount of mayonnaise on bread rounds. Top with cucumber mixture, spreading to edges. Top with additional bread round. | 8) Garnish with parsley or other herbs as desired.", "tags": ["cheese", "onions", "vegetable", "very low carbs", "low protein", "potluck", "savory", "15 mins", "inexpensive"], "cook_time_min": 15, "servings": null, "cuisine": ["All"], "rating_avg": 5.0, "rating_count": 1, "popularity_score": 4.721818181818181, "nutrition_calories": 47.1, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/16/84/13/picTspw9u.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["cheese", "onions", "vegetable", "very low carbs", "low protein", "potluck", "savory", "15 mins", "inexpensive"], "ingredients": []}, {"recipe_id": "rec_339", "props": {"title": "Big Breakfast Biscuit Sandwich", "instructions": "[Instructions] 1) Mix together egg,SPAM( or other meat )cheese,and pepper. | 2) Set aside. | 3) In a non-stick skillet melt margarine over medium heat. | 4) Spray canning ring with cooking spray. | 5) Place ring in skillet,pour egg/mixture into ring ( there will be a little leakage ). | 6) Let cook for about 3 minutes,pour water around ring. | 7) Cover with lid and let cook for about 5 minutes. | 8) Remove lid and turn egg and ring over. | 9) Cover with lid and finish cooking (about 3 minutes). | 10) Place in biscuit and eat.", "tags": ["very low carbs", "15 mins"], "cook_time_min": 8, "servings": null, "cuisine": ["All"], "rating_avg": 4.5, "rating_count": 2, "popularity_score": 4.661666666666667, "nutrition_calories": 320.4, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/29/76/48/picVoWy3a.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["very low carbs", "15 mins"], "ingredients": []}, {"recipe_id": "rec_340", "props": {"title": "Blueberry Blueberry Sour Cream Pancakes", "instructions": "[Instructions] 1) Mix dry ingredients. | 2) Beat together wet ingredients. | 3) Add butter to egg and sour cream. | 4) Add milk to sour cream mixture. | 5) Mix wet ingredients into dry ingredients until just incorporated. | 6) Add blueberries last and fold in carefully. | 7) Preheat lightly coated griddle or skillet over medium heat. | 8) If you are using an electric griddle, set temperature to 360\u00b0F. | 9) Test by adding a few drops of water on hot pan. When the drops start to \"dance\" on the griddle it is time to cook. | 10) For each pancake, pour about a 1/4 cup of batter onto a hot griddle. | 11) Cook on first side until bubbles that form begin to pop and edges look dry. | 12) With a spatula, turn and cook until the second side is rich and golden-brown. | 13) Serve with Maine Blueberry Syrup or honey.", "tags": ["berries", "fruit", "kid friendly", "high in", "30 mins"], "cook_time_min": 15, "servings": null, "cuisine": ["All"], "rating_avg": 4.73, "rating_count": 92, "popularity_score": 4.726470588235294, "nutrition_calories": 301.6, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/22/27/4/0M8IhW9yT9uECobrzcMf_blueberry-pancakes-2.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["berries", "fruit", "kid friendly", "high in", "30 mins"], "ingredients": []}, {"recipe_id": "rec_341", "props": {"title": "Brown Oatmeal Soda Bread", "instructions": "[Instructions] 1) If using sour milk, prepare and set aside. | 2) In a large bowl mix 2 1/4 cup of the flour with the rest of the dry ingredients. | 3) Form a well in the center. | 4) In another bowl (or large measuring cup) whisk together the egg and milk. | 5) Pour milk mixture into the dry ingredients and fold until JUST combined. | 6) Turn out onto floured surface and knead the other 1/4 cup of flour into the bread being careful not to overwork the dough. | 7) Cut dough in half. | 8) Form into 2 round loaves. | 9) Cut a cross into the top of each loaf. | 10) Dust with flour and sprinkle with additional oats. | 11) Sprinkle baking sheets (I prefer to use baking stones) with oats to prevent sticking and bake loaves at 350 for 30-35 minutes.", "tags": ["breads", "grains", "european", "healthy", "60 mins", "oven"], "cook_time_min": 30, "servings": null, "cuisine": ["All"], "rating_avg": 4.9, "rating_count": 11, "popularity_score": 4.801904761904762, "nutrition_calories": 1358.2, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/44/43/7/picBHB6Wf.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["breads", "grains", "european", "healthy", "60 mins", "oven"], "ingredients": []}, {"recipe_id": "rec_342", "props": {"title": "Buckwheat Spice Pancakes", "instructions": "[Instructions] 1) Combine first 7 ingredients in a large bowl, stir to blend. | 2) Combine milk, oil, and egg stir into flour. | 3) Spoon about 1/3 cup batter for each pancake onto a hot greased nonstick griddle or nonstick skillet. | 4) Turn pancakes when the tops are covered with bubbles and the edges are dry.", "tags": ["healthy", "high in", "15 mins", "easy"], "cook_time_min": 10, "servings": null, "cuisine": ["All"], "rating_avg": 5.0, "rating_count": 1, "popularity_score": 4.721818181818181, "nutrition_calories": 262.4, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/19/17/68/pic9TqluR.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["healthy", "high in", "15 mins", "easy"], "ingredients": []}, {"recipe_id": "rec_343", "props": {"title": "Caramel Pecan Sticky Bun Cookies", "instructions": "[Instructions] 1) In large bowl, beat 1 cup margarine and sugar until light and fluffy. | 2) Add 1/2 cup corn syrup and egg yolks; blend well. | 3) Stir in flour; mix well. | 4) Cover with plastic wrap; refrigerate 1 hour for easier handling. | 5) In small saucepan, combine powdered sugar, 1/4 cup margarine and 3 Tbsp corn syrup; bring to a boil. | 6) Remove from heat. Stir in pecans. | 7) Refrigerate at least 10 minutes. | 8) Heat oven to 375\u00b0. | 9) Lightly grease cookie sheets. | 10) Shape dough into 1 1/2-inch balls. | 11) Place 2-inches apart on greased cookie sheets. | 12) Bake at 375\u00b0 for 5 minutes. | 13) Remove from oven. | 14) Brush dough lightly with egg white. | 15) With spoon, carefully make deep indentation in center of each cookie; fill each with 1/2 teaspoon. | 16) FILLING. | 17) Return to oven and bake an additional 6 to 9 minutes or until light golden brown. | 18) Cool 1-2 minutes; remove from cookie sheets. | 19) Cool completely. | 20) Yield: 3 dozen cookies.", "tags": ["cookie and brownie", "fruit", "nuts", "weeknight", "4 hours"], "cook_time_min": 12, "servings": null, "cuisine": ["All"], "rating_avg": 4.76, "rating_count": 21, "popularity_score": 4.738709677419354, "nutrition_calories": 1643.1, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/47/51/6/HyAoLQzTTuSFdUrheAyC_caramel pecan cookies SITE-2.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["cookie and brownie", "fruit", "nuts", "weeknight", "4 hours"], "ingredients": []}, {"recipe_id": "rec_344", "props": {"title": "Cherry Cream Scones", "instructions": "[Instructions] 1) Cut two 10-inch circles of parchment or waxed paper; Use one to line a 10-inch round cake pan; Reserve the second piece. | 2) Sift the flour, sugar, baking powder, and salt together into a mixing bowl; Make a well in the center of the flour mixture; Add one cup of dried cherries to the dry ingredients just before blending in the cream. | 3) Add the cream to the flour mixture and stir by hand just until the batter is evenly moistened. | 4) Place the dough into the lined cake pan and press into an even layer; Cover the dough with the second parchment paper circle; Freeze the dough until very firm, at least 12 hours. | 5) Preheat the oven to 350\u00b0F; Prepare a baking sheet by spraying it lightly with cooking spray or lining with parchment paper. | 6) Thaw the dough for 5 minutes at room temperature; turn it out of the cake pan onto a cutting board; Cut the dough into 10 equal wedges and place them on the baking sheet about 2-inches apart; | 7) Mix the milk and confectioners\u2019 sugar together to make a glaze and set aside. | 8) Bake the scones until golden brown, 30-40 minutes; Cool them on the baking sheet for a few minutes then transfer to cooling racks; spoon glaze over the scones while they are still warm. | 9) Serve the scones warm or at room temperature; Serve baked scones the same day they are made or freeze for up to 4 weeks.", "tags": ["quick breads", "breads", "breakfast", "cherries", "fruit", "european", "kid friendly", "brunch", "60 mins"], "cook_time_min": 30, "servings": null, "cuisine": ["All"], "rating_avg": 5.0, "rating_count": 3, "popularity_score": 4.764615384615385, "nutrition_calories": 355.2, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/12/91/95/picbUV8xm.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["quick breads", "breads", "breakfast", "cherries", "fruit", "european", "kid friendly", "brunch", "60 mins"], "ingredients": []}, {"recipe_id": "rec_345", "props": {"title": "Cinnamon Biscuits", "instructions": "[Instructions] 1) Combine flour, baking powder and salt; cut in shortening. | 2) Add milk and 1 tsp. vanilla; stir with fork just until dough leaves sides of bowl. | 3) Roll dough out, on lightly floured surface, into a 1/4 inch thick rectangle. | 4) Brush top with butter (I prefer to use soft butter rather than melted). | 5) Combine cinnamon and sugar; sprinkle evenly over dough. | 6) Sprinkle with chopped pecans (or other nuts or raisins) if desired. | 7) Roll up, starting on long side. | 8) Cut into 1/2 inch thick rounds. | 9) Place rounds, with sides just touching, in greased 9\" round pan. | 10) Bake at 425\u00b0F for 18-20 minutes or until golden brown. | 11) Remove from oven and drizzle with glaze, serve warm. | 12) For glaze: Combine all ingredients and beat until smooth.", "tags": ["brunch", "60 mins", "oven"], "cook_time_min": 18, "servings": null, "cuisine": ["All"], "rating_avg": 4.8, "rating_count": 70, "popularity_score": 4.7867500000000005, "nutrition_calories": 694.8, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/91/79/1/u7llaWwlSyO5jSfvYe9m_DSC01731.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["brunch", "60 mins", "oven"], "ingredients": []}, {"recipe_id": "rec_346", "props": {"title": "Sunny Side Up Corned Beef Hash", "instructions": "[Instructions] 1) Heat the oil in a large cast iron skillet over medium heat. | 2) Add the onion and cook until softened. | 3) Add corned beef, hash browns, seasoning, pepper, green onions, (beef broth and Worcestershire). | 4) Cook stirring occasionally, until potatoes are golden and crisp. About 15 minutes. | 5) To add eggs : When the potatoes are crisp and golden make indention's in the hash to hold eggs and place skillet in oven - preheat, with the hash in the oven, to 350. | 6) When oven is preheated, remove skillet and crack an egg into each indention and lightly cover with foil and place back in oven until eggs are cooked as you desire - runny yellow or set. | 7) Serve the Hash with slices of toast.", "tags": ["brunch", "60 mins"], "cook_time_min": 20, "servings": null, "cuisine": ["All"], "rating_avg": null, "rating_count": 0, "popularity_score": null, "nutrition_calories": 671.1, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/45/35/15/picnvm0Kn.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["brunch", "60 mins"], "ingredients": []}, {"recipe_id": "rec_347", "props": {"title": "Country Ham Biscuits", "instructions": "[Instructions] 1) Bake biscuits in a 400 degree oven for 8 to 10 minutes until golden brown. | 2) Cut ham into pieces to fit size of biscuits. | 3) Place ham pieces in a skillet and boil in a small amount of water for one minute to allow salt to escape. Pour off water to drain. | 4) Split biscuit and insert ham pieces. | 5) Dijon mustard may be spread inside of biscuits - optional feature. | 6) Enjoy!", "tags": ["ham", "pork", "meat", "30 mins", "easy"], "cook_time_min": 10, "servings": null, "cuisine": ["All"], "rating_avg": 4.5, "rating_count": 2, "popularity_score": 4.661666666666667, "nutrition_calories": 164.3, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/37/16/46/picLGWjaH.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["ham", "pork", "meat", "30 mins", "easy"], "ingredients": []}, {"recipe_id": "rec_348", "props": {"title": "Crabby Baby (Crab Dutch Baby)", "instructions": "[Instructions] 1) Preheat oven to 425\u00b0F. | 2) Saute mushrooms, green onions, and garlic in 1 TB of butter. | 3) In a bowl, mushroom mix, crab, and spinach with a pinch of salt and pepper to taste. | 4) Place the rest of the butter in a 8\" cast iron pan. Place pan in oven to preheat. | 5) In a blender or food processor, blend eggs for 30 seconds. | 6) Add milk, flour, pinch of salt. Blend for 60 seconds. | 7) Remove pan from the oven, butter should be melted, pour in batter. | 8) Add crab mixture to pan, keeping a 3/4\" away from the edge, sprinkle with parmesan cheese. | 9) Bake for 20 minute.", "tags": ["60 mins"], "cook_time_min": 20, "servings": null, "cuisine": ["All"], "rating_avg": null, "rating_count": 0, "popularity_score": null, "nutrition_calories": 260.1, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/submissions/recipe/292764/IVYirnLuROKF6K7ssDCO_20161204_202850.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["60 mins"], "ingredients": []}, {"recipe_id": "rec_349", "props": {"title": "Cuban Coffee (Cafecito)", "instructions": "[Instructions] 1) Fill a 6-cup stovetop espresso maker with water and coffee according to the manufacturer's instructions, making sure to pack down the coffee. Place the espresso maker over moderate heat. | 2) While the coffee is brewing, place the sugar in a tall container with a spout, such as a liquid measuring cup. As soon as the coffee starts to fill the reservoir, pour about 1/2 tablespoon of coffee over the sugar and return the espresso maker to the heat. | 3) Using a spoon, beat the sugar and espresso until the mixture turns a pale beige color and most of the sugar granules begin to dissolve, about 1 minute. The mixture may seem a bit dry at first, but keep beating, and it will come together. | 4) Once all the coffee has been brewed, slowly pour the coffee over the creamed sugar, stirring to make sure all the sugar dissolves. A thin layer of sugar foam (crema) should float on top of the coffee. Pour the coffee into espresso cups and serve immediately. | 5) SPECIAL EQUIPMENT:. | 6) Stovetop espresso makers come in several sizes. This recipe is written for the 6-cup version, yet you can substitute any other size simply by adjusting the amount of coffee and sugar used. Ultimately, the coffee's sweetness is up to you. | 7) TECHNIQUES:. | 8) Making the sugar crema is the technique that defines Cuban coffee. You cannot overbeat the sugar, so err on the side of beating too much. If you accidentally pour too much coffee into the sugar, continue with the beating process, as you will still achieve sugar foam.", "tags": ["cuban", "caribbean", "low protein", "vegan", "low cholesterol", "healthy", "brunch", "15 mins", "easy"], "cook_time_min": 5, "servings": null, "cuisine": ["All"], "rating_avg": 5.0, "rating_count": 5, "popularity_score": 4.795999999999999, "nutrition_calories": 32.2, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/50/32/92/w032OAIjRHOpPalk9WdZ_cuban%20cafecito%20SITE-3.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["cuban", "caribbean", "low protein", "vegan", "low cholesterol", "healthy", "brunch", "15 mins", "easy"], "ingredients": []}, {"recipe_id": "rec_350", "props": {"title": "Easy Caramel Sticky Rolls", "instructions": "[Instructions] 1) Heat oven to 350\u00b0F In an ungreased 8-inch round pan, mix brown sugar and whipping cream. Sprinkle with pecans. | 2) In small bowl, mix sugar and cinnamon. Unroll breadstick dough, but do not separate into breadsticks. Sprinkle cinnamon-sugar mixture over dough. Roll up dough from short end; separate at perforations. Place coiled dough in pan. | 3) Bake 20-25 minutes or until golden brown. Cool 1 minute. Place serving plate upside down onto pan; turn plate and pan over. Let pan remain there 1 minute so caramel can drizzle over rolls.", "tags": ["lunch snacks", "60 mins", "easy"], "cook_time_min": 25, "servings": null, "cuisine": ["All"], "rating_avg": 5.0, "rating_count": 17, "popularity_score": 4.886666666666667, "nutrition_calories": 186.8, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/28/62/67/picZqVNDY.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["lunch snacks", "60 mins", "easy"], "ingredients": []}, {"recipe_id": "rec_351", "props": {"title": "Egg Muffin sandwich", "instructions": "[Instructions] 1) Toast the english muffin. | 2) In a microwaveable cup roughly the same diameter of the muffin, add the egg, a tablespoon of water. | 3) Beat the egg, add the bacon (or sandwich meat, or nothing). | 4) Microwave on high for 1 to 2 minutes (until egg is cooked) while muffin is toasting. | 5) Assemble the muffin and let stand for a few minutes to melt the cheese.", "tags": ["lunch snacks", "microwave", "15 mins", "easy"], "cook_time_min": 3, "servings": null, "cuisine": ["All"], "rating_avg": 4.78, "rating_count": 24, "popularity_score": 4.754705882352941, "nutrition_calories": 200.9, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/32/54/4/L6TZCuhzTFGPU3K5Q8Sg_Unknown-18.jpeg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["lunch snacks", "microwave", "15 mins", "easy"], "ingredients": []}, {"recipe_id": "rec_352", "props": {"title": "Fantastic Pecan Sticky Buns", "instructions": "[Instructions] 1) PREP PAN: Take a 9\" square baking pan and encase it entirely with heavy duty or quick-release aluminum foil (to make cleanup easy). Grease only the sides of the inside of the pan with non-stick cooking spray or use butter. Line a baking sheet with aluminum foil (to catch overflow). | 2) Stir the yeast, water, and sugar, in a small bowl. Allow it to stand for about 5-8 minutes to dissolve the yeast. | 3) Mix flour and salt together in a large bowl or stand mixer. Add the yeast mixture and stir to moisten the flour, scraping the sides of the bowl and folding the dough over itself until it gathers into a shaggy mass. | 4) Move the dough to a lightly floured surface and knead it by hand for 5 minutes. Gently shape the dough into a loose ball, cover it with plastic, and let it rest on the table for 20 minutes. NOTE: This is a soft, moist dough. If the dough seems too stiff and hard to knead, add extra warm water 1 tablespoon at a time until you get a nice malleable dough. | 5) Gently knead the dough on the lightly floured surface for 1-2 more minutes, or until it becomes smooth, supple, and elastic but not too firm (The texture of the dough should be soft but springy). Shape the dough into a loose ball, place it in a lightly oiled bowl, and turn to coat the top with oil. Cover it tightly with plastic wrap and let it rise at room temperature about 1 1/2 to 2 hours (until doubled). | 6) Meanwhile make the caramel: in a small saucepan, melt the butter and then add the dark brown sugar over low heat, stirring occasionally, until the butter has melted and the sugar is completely moistened (it won't be dissolved). Whisk until the mixture looks silky and a little lighter in color. | 7) Pour the caramel into the square pan, tilting the pan slightly so the mixture spreads evenly over the bottom of the pan. Set aside. | 8) When the dough has doubled, gently pour it onto the floured work surface. Roll dough out to form a 9x9\" square. | 9) Spray dough evenly with non-stick cooking spray, leaving a 1/2-inch strip unsprayed along the top edge. Sprinkle the cinnamon sugar generously and evenly, then sprinkle with chopped pecans, again leaving the top 1/2-inch of the rectangle bare. | 10) Starting with the bottom edge, roll up the dough jelly-roll fashion into log. (If the dough sticks to the table as you're rolling, use a dough scraper to loosen it gently). Pinch gently but firmly along the seam to seal. | 11) Cut the log of dough into 4 equal pieces. Lay the pieces cut side down on top of the caramel. Don't worry if it's a tight fit. Let rise, uncovered, at room temperature for 1 hour or until the dough has almost doubled, (The rolls should fill the pan and extend 1/2 to 3/4-inch above it). | 12) Meanwhile, position a rack in the center of the oven and preheat the oven to 350\u00b0F Bake for 30-35 minutes, until the tops of the buns are golden brown and crusty (It's important to bake the buns long enough so the dough is cooked all the way through and the caramel topping develops properly). | 13) Set the pan of buns on a rack to cool for 5 minutes. Then quickly but carefully transfer the buns onto a heatproof plate. Immediately drizzle any remaining caramel from the bottom of the pan and spread it on the tops of the buns, filling in any bare spots (or drizzle with honey). Let the buns cool until just warm before serving.", "tags": ["breads", "kid friendly", "brunch", "4 hours"], "cook_time_min": 45, "servings": null, "cuisine": ["All"], "rating_avg": 5.0, "rating_count": 5, "popularity_score": 4.795999999999999, "nutrition_calories": 757.5, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/32/87/51/picfqpynd.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["breads", "kid friendly", "brunch", "4 hours"], "ingredients": []}, {"recipe_id": "rec_353", "props": {"title": "French Market Beignets", "instructions": "[Instructions] 1) Put 1 1/2 cups warm water in a large bowl, sprinkle yeast over the water then stir well to dissolve the yeast When the yeast is dissolved and frothing add sugar, salt& milk. | 2) Beat the two eggs and add to the bowl. | 3) Add crisco. | 4) Stir well and slowly add the 7 cups of flour. | 5) Stir until the flour is well mixed in and the dough is in a big ball, cover with plastic and place in the fridge overnight Next day rollsmall pieces of dough on a floured board. | 6) Roll as thin as you can and cut into 2\" squares.Make a double slash through the center of each square. This helps the center cook through. | 7) Fry in 360F oil for about 3 minutes until light brown. | 8) Shake the beignets in a bag in confectioner's sugar C'est Bon.", "tags": ["breads", "lunch snacks", "cajun", "healthy", "weeknight", "refrigerator", "deep fried"], "cook_time_min": 3, "servings": null, "cuisine": ["All"], "rating_avg": 5.0, "rating_count": 7, "popularity_score": 4.82, "nutrition_calories": 1509.6, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/31/85/4/vYJaaDGQietCrlXjAw9m_beignets SITE-3.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["breads", "lunch snacks", "cajun", "healthy", "weeknight", "refrigerator", "deep fried"], "ingredients": []}, {"recipe_id": "rec_354", "props": {"title": "Fried Grit Cakes With Eggs and Tomato Gravy", "instructions": "[Instructions] 1) Take the grits after they have cooled and mix in the Parmesan Cheese and garlic powder. Add some cayenne pepper if you like things hot! Spread the mixture on a large baking sheet. Place in the refrigerator to cool for 30 minutes. | 2) Take a large biscuit or cookie cutter (you can use shaped ones for the holidays!) and cut out the grit mix. | 3) Place 1 tbsp salt, 1 tbsp pepper, and 1/2 cup all purpose flour in a small bowl and mix well. Pour onto a plate and press the grit cakes into the flour to coat both sides. | 4) In a skillet over medium heat add the oil to cover the bottom. When the oil is hot but not smoking, drop in the grit cakes, browning both sides. Remove and reserve. | 5) Cook the country ham or Canadian bacon in another skillet, just until browned. Remove and place on a paper towel to absorb the grease. | 6) Leave 1/2 cup grease in the skillet for the tomato gravy. (You can use bacon grease instead). Heat the ham or bacon grease over medium high heat. Add 2 tbsp all purpose flour and stir until well mixed, about 1 minute. Add 1 cup milk and stir until it boils. Add the tomatoes and return to a boil. Add the salt and pepper to taste. If it is too thick, add some water and stir. | 7) Meanwhile, fry your eggs in the skillet you cooked the grit cakes inches | 8) To assemble, place two cooked grit cakes on a plate. Place a slice of ham or canadian bacon on top of each grit cake. Place a gried egg on top of the ham or canadian bacon. Ladle the tomato gravy over the top and enjoy.", "tags": ["ham", "pork", "meat", "brunch", "60 mins"], "cook_time_min": 15, "servings": null, "cuisine": ["All"], "rating_avg": 5.0, "rating_count": 4, "popularity_score": 4.781428571428571, "nutrition_calories": 1700.6, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/38/29/97/xpFNvItYRPgVM3AlblYg_image.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["ham", "pork", "meat", "brunch", "60 mins"], "ingredients": []}, {"recipe_id": "rec_355", "props": {"title": "Goetta", "instructions": "[Instructions] 1) In a large pot bring water to a boil and add oats, salt and pepper-reduce to a simmer, cover and cook for 2 hours. | 2) Add meat, onion, spices and cover, cooking for 1 hour more. | 3) Pour into pan/s-cool and then refrigerate. | 4) Turn out, slice and fry until brown in a bit of butter or oil.", "tags": ["grains", "meat", "weeknight", "refrigerator", "stove top", "4 hours"], "cook_time_min": 3, "servings": null, "cuisine": ["All"], "rating_avg": 4.18, "rating_count": 13, "popularity_score": 4.403478260869565, "nutrition_calories": 390.4, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/17/35/7/kRzqHIM1RdC7yxJPpfxE-homemade-goetta.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["grains", "meat", "weeknight", "refrigerator", "stove top", "4 hours"], "ingredients": []}, {"recipe_id": "rec_356", "props": {"title": "Hash Browns Casserole", "instructions": "[Instructions] 1) Preheat oven to 350\u00b0. | 2) Spray 9x13-inch baking pan with Pam. | 3) Combine soup, margarine, salt, pepper, onion and cheese. | 4) Gently mix in the potatoes and pour into prepared pan. | 5) Bake in 350\u00b0F oven for 35-40 minutes.", "tags": ["vegetable", "60 mins", "oven"], "cook_time_min": 45, "servings": null, "cuisine": ["All"], "rating_avg": 4.61, "rating_count": 34, "popularity_score": 4.629090909090909, "nutrition_calories": 3978.8, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/45/55/7/iG3aC3TDRSCDgVkfOwjy_DSC00875.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["vegetable", "60 mins", "oven"], "ingredients": []}, {"recipe_id": "rec_357", "props": {"title": "Hawaiian Holiday Smoothie", "instructions": "[Instructions] 1) Pour all liquid ingredients into the blender. Add all frozen ingredients. blend at MIX setting for 30 seconds then blend at SMOOTH setting until smooth. While the machine is running, move the stir stick around counter-clockwise to aid mixing. Serve immediately. Each recipe serves 3-5.", "tags": ["beverages", "polynesian", "15 mins", "easy"], "cook_time_min": 5, "servings": null, "cuisine": ["All"], "rating_avg": 5.0, "rating_count": 2, "popularity_score": 4.745, "nutrition_calories": 255.5, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/45/81/35/picETSoMG.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["beverages", "polynesian", "15 mins", "easy"], "ingredients": []}, {"recipe_id": "rec_358", "props": {"title": "Huckleberry ( or Blueberry) Coffee Cake", "instructions": "[Instructions] 1) Beat margarine and cream cheese at medium speed of an electric mixer until creamy; gradually 1 cup sugar, beating well. Add egg, and beat well. | 2) Combine flour, baking powder, and salt; stir into margarine mixture. Stir in vanilla, then fold in berries. | 3) Pour batter into a 9-inch round cake pan coated with cooking spray (I also lined bottom with parchment). | 4) Combine 2 tablespoons sugar and cinnamon; sprinkle over batter. | 5) Bake at 350F for 1 hour; cool on a wire rack.", "tags": ["breakfast", "berries", "fruit", "brunch", "oven", "4 hours", "easy"], "cook_time_min": 1, "servings": null, "cuisine": ["All"], "rating_avg": 4.89, "rating_count": 28, "popularity_score": 4.8384210526315785, "nutrition_calories": 194.3, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/12/48/10/XnHT7vLgS6K00LfwWeOE_0S9A5248.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["breakfast", "berries", "fruit", "brunch", "oven", "4 hours", "easy"], "ingredients": []}, {"recipe_id": "rec_359", "props": {"title": "Jiffy Cinnamon Sticky Rolls", "instructions": "[Instructions] 1) Preheat oven to 375\u00baF. | 2) In a 9-inch square baking dish, in the oven, melt butter. Add corn syrup, brown sugar and pecans. Stir to combine and set aside. | 3) For dough, combine cake mix and pizza crust mix; add water, mixing well. Cover with a towel and let rise for 10 minutes. | 4) On a floured surface, pat dough into a 14-inch by 6-inch rectangle. Spread with butter and sprinkle with sugar and cinnamon. Drizzle on corn syrup. | 5) Roll up jelly-roll fashion (from the long side) and cut into 12 slices. | 6) Arrange cut side down over topping in prepared pan. | 7) Bake for 20-25 minutes. Remove from oven and invert onto a plate immediately.", "tags": ["dessert", "fruit", "nuts", "brunch", "60 mins"], "cook_time_min": 30, "servings": null, "cuisine": ["All"], "rating_avg": null, "rating_count": 0, "popularity_score": null, "nutrition_calories": 305.1, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/gk-static/fdc-new/img/fdc-shareGraphic.png"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["dessert", "fruit", "nuts", "brunch", "60 mins"], "ingredients": []}, {"recipe_id": "rec_360", "props": {"title": "Jumbo Chocolate Pecan Christmas Fudge Pie", "instructions": "[Instructions] 1) Combine chocolate wafer crumbs and 1/3 cup melted butter; firmly press on. | 2) bottom and sides of a 9-inch tart pan or pie plate. | 3) Bake at 350*F. for 6-8 minutes. | 4) Cream 1/2 cup softened butter; gradually add brown sugar with the electric mixer at medium speed until blended. Add the eggs, one at a time, beating after each addition. Stir in the melted chocolate, instant coffee granules, vanilla, flour and chopped pecans. Pour into prepared. | 5) crust. | 6) Bake at 375*F. for 25 minutes. Remove from the oven and cool completely on a wire. | 7) rack. | 8) Before serving, pipe sweetened whipped cream on each piece and drizzle. | 9) with chocolate syrup. Garnish with cherries and/or mint if desired. Enjoy!", "tags": ["dessert", "fruit", "nuts", "christmas", "sweet", "60 mins"], "cook_time_min": 35, "servings": null, "cuisine": ["All"], "rating_avg": 5.0, "rating_count": 2, "popularity_score": 4.745, "nutrition_calories": 694.0, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/19/83/65/picYHwG3D.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["dessert", "fruit", "nuts", "christmas", "sweet", "60 mins"], "ingredients": []}, {"recipe_id": "rec_361", "props": {"title": "Michigan German Baked Oatmeal", "instructions": "[Instructions] 1) Preheat oven to 400 degrees. | 2) Coat 3-quart casserole or baking pan with cooking spray. | 3) In mixing bowl, combine all ingredients. | 4) Transfer to baking dish. Sprinkle top with additional almonds. | 5) Bake uncovered for 45 minutes. Serve hot.", "tags": [], "cook_time_min": 45, "servings": null, "cuisine": ["All"], "rating_avg": 4.86, "rating_count": 7, "popularity_score": 4.76235294117647, "nutrition_calories": 305.5, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/42/45/73/picv74b8E.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": [], "ingredients": []}, {"recipe_id": "rec_362", "props": {"title": "Traditional Migas", "instructions": "[Instructions] 1) Melt butter in large skillet. | 2) Add Tabasco into eggs and pour into skillet. | 3) Add onion and green pepper. | 4) Stir. | 5) When eggs are almost set, add cheese. | 6) Turn heat to lowest setting, add tostados and finish cooking.", "tags": ["tex mex", "southwestern u s", "very low carbs", "60 mins", "easy"], "cook_time_min": 20, "servings": null, "cuisine": ["All"], "rating_avg": 4.43, "rating_count": 7, "popularity_score": 4.5852941176470585, "nutrition_calories": 292.4, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/16/35/2/SGs9RNR6QaWGmrnzIxGA_migas%20SITE-3.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["tex mex", "southwestern u s", "very low carbs", "60 mins", "easy"], "ingredients": []}, {"recipe_id": "rec_363", "props": {"title": "Molasses Pecan Sticky Rolls", "instructions": "[Instructions] 1) Combine 2 c flour and yeast in large mixing bowl. In saucepan, combine water, milk, sugar, salt and butter or margarine. Heat and stir over low heat till butter or margarine is almost melted. Let cool till lukewarm. | 2) Add warm milk mixture to flour and yeast. Beat till smooth. Add remaining flour to make a sticky dough. Turn out onto floured surface and knead 7-8 minutes till smooth and elastic. Place dough into greased bowl turning to grease top. Cover and let rise in warm place 45-60 minutes till doubled. | 3) For topping, in saucepan, melt butter. Add brown sugar, molasses and pecans. Stir to combine. Spread in bottom of 13x9\" pan that has been sprayed with cooking spray. | 4) Turn dough out onto lightly floured surface. Roll to 12x17\" rectangle. Spread softened butter or margarine to within 1/2\" of edges and sprinkle with cinnamon. Roll up starting with a long side and pinch edges to seal. Cut into 12 rolls and place cut side down in pan. | 5) Cover pan and let rise till doubled, approximately 30 minutes. Bake at 375 degrees till brown on top. Remove from oven and let sit for a couple of minutes. Turn out onto serving platter.", "tags": ["breads", "breakfast", "4 hours"], "cook_time_min": 25, "servings": null, "cuisine": ["All"], "rating_avg": null, "rating_count": 0, "popularity_score": null, "nutrition_calories": 462.9, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/46/57/85/piclRW7zZ.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["breads", "breakfast", "4 hours"], "ingredients": []}, {"recipe_id": "rec_364", "props": {"title": "Mom's Chocolate Gravy", "instructions": "[Instructions] 1) Mix all the dry ingredients in a heavy saucepan with a whisk. Using a whisk blends everything better than a spoon. Stir in the milk. | 2) Cook over medium heat stirring constantly. Remove the pot when the mixture is thick like pudding. | 3) Add the butter. Stir in until completely melted. Serve over biscuits with a teaspoon of butter dolloped on top.", "tags": ["dessert", "low protein", "egg free", "healthy", "free of", "60 mins", "beginner cook", "easy", "inexpensive"], "cook_time_min": 30, "servings": null, "cuisine": ["All"], "rating_avg": 4.94, "rating_count": 60, "popularity_score": 4.904857142857143, "nutrition_calories": 200.6, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/14/25/24/picOkYveg.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["dessert", "low protein", "egg free", "healthy", "free of", "60 mins", "beginner cook", "easy", "inexpensive"], "ingredients": []}, {"recipe_id": "rec_365", "props": {"title": "My Sausage Breakfast Burritos", "instructions": "[Instructions] 1) Cook sausage in a medium hot skillet until no longer pink, add salsa and cook until most of the liquid is gone. (Not completely dry),. | 2) In another skillet scrample eggs lightly, before completely done, add to sausage/salsa mixture, set aside. | 3) Heat flour tortillas in a large skillet over high heat, turning twice, heating till tortilla is nice and soft. (If you overheat and tortilla is dry and hard; discard, you only want to use warm and flexable tortillas)). | 4) Place warm, flexable tortilla on serving plate, add 1/4 portion of egg/sausge mix on tortilla, top with 1/8 cup cheddar cheese, then roll burro style. | 5) If you like more spice, serve with more salsa, as well as sour cream and cilantro.", "tags": ["cheese", "mexican", "15 mins", "easy"], "cook_time_min": 6, "servings": null, "cuisine": ["All"], "rating_avg": 4.75, "rating_count": 6, "popularity_score": 4.715, "nutrition_calories": 696.5, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/34/96/29/picacJk3L.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["cheese", "mexican", "15 mins", "easy"], "ingredients": []}, {"recipe_id": "rec_366", "props": {"title": "Norwegian Potato and Rye Pancake Flatbreads - Lefse", "instructions": "[Instructions] 1) Put the mashed potatoes into a large bowl and add the flour, sugar and salt - mix well. | 2) Add some water - bit by bit, kneading well so it makes a pliable dough. | 3) Take little balls from the dough - the size of a small egg and roll them out thinly on a well floured surface. | 4) Heat up a flat griddle, hotplate or skillet and cook the Lefse with a little fat until the dough bubbles. | 5) Turn them over and cook the other side. | 6) When the Lefse have been cooked - they should be smooth and soft. | 7) Eat them as I have suggested in the Introduction! | 8) For Vegetarian make sure the Fat is from a Vegetable product such as vegetable oil not from an animal product such as lard.", "tags": ["lunch snacks", "potato", "vegetable", "norwegian", "scandinavian", "european", "low protein", "low cholesterol", "healthy", "savory", "sweet", "brunch", "60 mins", "easy"], "cook_time_min": 20, "servings": null, "cuisine": ["All"], "rating_avg": 5.0, "rating_count": 1, "popularity_score": 4.721818181818181, "nutrition_calories": 133.4, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/23/51/52/pics6xGwm.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["lunch snacks", "potato", "vegetable", "norwegian", "scandinavian", "european", "low protein", "low cholesterol", "healthy", "savory", "sweet", "brunch", "60 mins", "easy"], "ingredients": []}, {"recipe_id": "rec_367", "props": {"title": "Pecan Sticky Buns", "instructions": "[Instructions] 1) Preheat oven to 425 degrees F. | 2) Grease a 9-inch round metal cake pan. | 3) Prepare filling: in small bowl, combine 1/4 cup brown sugar with cinnamon; set aside. | 4) Prepare topping: In 1-quart saucepan, heat honey, remaining 1/3 cup brown sugar and 2 T butter on medium until mixture is blended and smooth, stirring occasionally. | 5) Pour topping into prepared pan, and sprinkle evenly with pecans; set aside. | 6) Prepare dough: In large bowl, combine flour, granulated sugar, baking powder, baking soda and salt. | 7) In small bowl, mix buttermilk and 5 T butter. | 8) With spoon, stir buttermilk mixture into flour mixture just until liquid is absorbed. | 9) Turn dough onto lightly floured surface, and knead 8-10 minutes or just until smooth, about 30 seconds. | 10) Pat dough into a 12-inch by 9-inch rectangle. | 11) Brush dough with 1 T butter, then sprinkle with filling. | 12) Starting at one short end, roll up dough jellyroll fashion. | 13) With seam side down, cut dough crosswise into 8 slices. | 14) Place each slice, cut side down, on pecan mixture in cake pan; brush with remaining melted butter. | 15) Bake buns 28-30 minutes or until golden. | 16) Remove pan from oven. | 17) Immediately place serving plate over top of pan and invert buns onto plate, allowing topping to run down sides. | 18) Remove baking pan. | 19) Cool buns slightly, about 10 minutes, to serve warm, or cool completely to serve later. | 20) Wrap any leftovers in foil, and store at room temperature up to 3 days.", "tags": ["dessert", "fruit", "nuts", "kid friendly", "christmas", "thanksgiving", "sweet", "brunch", "oven", "4 hours"], "cook_time_min": 1, "servings": null, "cuisine": ["All"], "rating_avg": 5.0, "rating_count": 1, "popularity_score": 4.721818181818181, "nutrition_calories": 459.0, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/33/77/09/picfshytI.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["dessert", "fruit", "nuts", "kid friendly", "christmas", "thanksgiving", "sweet", "brunch", "oven", "4 hours"], "ingredients": []}, {"recipe_id": "rec_368", "props": {"title": "Pecan Sticky Rolls", "instructions": "[Instructions] 1) Spray a 6 muffin tin with non-stick cooking spray and set aside; preheat oven to 350 degrees. | 2) In a small bowl, combine 2 tablespoons of the melted butter, brown sugar and water and stir until smooth; evenly spoon the mixture in the prepared pan. | 3) Sprinkle the chopped pecans over the sugar mixture. | 4) Unroll the crescent rolls, lightly press seams to seal, spread lightly with remaining 1 tablespoon butter and sprinkle with the cinnamon sugar. | 5) Roll up the dough and slice into 6 even slices, place cut side down into muffin tins; place muffin tin on cookie sheet and bake in preheated oven for 2o to 25 minutes or until cooked through and browned. | 6) Turn onto serving plate and serve immediately.", "tags": ["breakfast", "brunch", "60 mins", "oven", "easy"], "cook_time_min": 25, "servings": null, "cuisine": ["All"], "rating_avg": 5.0, "rating_count": 2, "popularity_score": 4.745, "nutrition_calories": 246.5, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/29/52/44/8p39NRFhSKae3kxvaZ5y_pecan%20sticky%20rolls%20SITE-3.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["breakfast", "brunch", "60 mins", "oven", "easy"], "ingredients": []}, {"recipe_id": "rec_369", "props": {"title": "Polish Jam Kolaches", "instructions": "[Instructions] 1) Beat butter or margarine and cream cheese in mixer bowl until light and fluffy. | 2) Add flour gradually, beating well after each addition. | 3) Roll dough to 1/8 inch thickness on lightly floured surface. | 4) Cut into 2-inch circles. | 5) Spoon 1/4 teaspoon jam into center of each circle. | 6) Fold opposite edges together, slightly overlapping edges. | 7) Place 2 inches apart on greased cookie sheet. | 8) Bake at 375 degrees Fahrenheit (190 degrees Celsius) for 15 minutes. | 9) Remove to wire rack to cool. | 10) Sprinkle with confectioners' sugar.", "tags": ["cookie and brownie", "polish", "european", "60 mins", "easy"], "cook_time_min": 15, "servings": null, "cuisine": ["All"], "rating_avg": 4.91, "rating_count": 23, "popularity_score": 4.844545454545455, "nutrition_calories": 1048.2, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/13/50/70/5J6rDefnTF6r6VUNvzuD_DSC00472.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["cookie and brownie", "polish", "european", "60 mins", "easy"], "ingredients": []}, {"recipe_id": "rec_370", "props": {"title": "Potato Apple Cinnamon Fritters #5FIX", "instructions": "[Instructions] 1) 1. Preheat Oil to 350. | 2) 2. In a large bowl, combine cinnamon biscuit mix, potatoes and apples. Toss to coat well with dry biscuit mix. Add buttermilk, stirring to mix well. Drop by teaspoonful into hot oil. Fy until golden brown. | 3) 3. Remove, drain on paper towels. | 4) 4. Serve tossed with powdered sugar, with caramel sauce or apple butter.", "tags": ["dessert", "potato", "vegetable", "kid friendly", "brunch", "15 mins", "easy"], "cook_time_min": 3, "servings": null, "cuisine": ["All"], "rating_avg": 5.0, "rating_count": 8, "popularity_score": 4.83, "nutrition_calories": 91.4, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/49/73/75/RyICyYAERGSdAYnAQdLd_0S9A0630.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["dessert", "potato", "vegetable", "kid friendly", "brunch", "15 mins", "easy"], "ingredients": []}, {"recipe_id": "rec_371", "props": {"title": "Pretty Grits and Eggs", "instructions": "[Instructions] 1) Heat oven to 350 degrees. | 2) Spray muffin pan with cooking spray. | 3) Lay 2 slices ham per muffin cup (should only fill 4). | 4) Crack an egg in each cup with ham, making sure egg stays inside of ham cup. | 5) Bake for 13 minutes or longer for desired doneness. | 6) While eggs are baking, bring water, buttermilk, texas pete, rotel, salt and pepper to boil on stove. | 7) Add grits, parmesean, and cheddar cheese. | 8) Stir until thickened. Remove from heat. | 9) Spoon grits on 2 plates. | 10) Put 2 ham and egg cups in center of grits on each plate. | 11) Garnish with fresh or dried parsley. | 12) ENJOY!", "tags": ["brunch", "30 mins", "inexpensive"], "cook_time_min": 15, "servings": null, "cuisine": ["All"], "rating_avg": null, "rating_count": 0, "popularity_score": null, "nutrition_calories": 669.8, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/35/73/15/picVo8HMP.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["brunch", "30 mins", "inexpensive"], "ingredients": []}, {"recipe_id": "rec_372", "props": {"title": "Rhode Island Coffee Milk", "instructions": "[Instructions] 1) In a large glass, add coffee syrup and milk. | 2) Stir well. | 3) Taste and add more syrup if you want a stronger coffee taste.", "tags": ["15 mins", "beginner cook", "easy"], "cook_time_min": 1, "servings": null, "cuisine": ["All"], "rating_avg": 4.17, "rating_count": 6, "popularity_score": 4.4975, "nutrition_calories": 156.2, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/21/45/64/pice6aWl5.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["15 mins", "beginner cook", "easy"], "ingredients": []}, {"recipe_id": "rec_373", "props": {"title": "Scrambled Eggs With Portuguese Fernandes Linguica", "instructions": "[Instructions] 1) In a large non-stick skillet add olive oil, sausage, potatoes, Serrano pepper, Maui onion, 1/2 teaspoon sea salt and 1/2 teaspoon white pepper. | 2) Saute sausage, potatoes, pepper, onions until they are golden brown; about 4-5 minutes. Remove from heat and hold warm for service. | 3) In a bowl whisk eggs, heavy cream, sea salt and white pepper. | 4) In a clean skillet melt butter and add eggs. Scramble 2-3 minutes or until done. | 5) Place Fernandes Linguica, potatoes, scrambled eggs on warm serving plates. | 6) Garnish with sliced Blood Oranges and serve. | 7) *Note: Saloio XV Premium or any Extra Virgin Olive Oil.", "tags": ["portuguese", "european", "15 mins"], "cook_time_min": 5, "servings": null, "cuisine": ["All"], "rating_avg": null, "rating_count": 0, "popularity_score": null, "nutrition_calories": 823.7, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/submissions/recipe/0/MnFs63RSiilajbBkfefr_BLOOD%20ORANGES%20and%20PORTUGUESEE.JPG"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["portuguese", "european", "15 mins"], "ingredients": []}, {"recipe_id": "rec_374", "props": {"title": "Simple Popovers", "instructions": "[Instructions] 1) Do NOT preheat oven. | 2) Mix flour and salt together. | 3) Using a seperate bowl, combine the eggs, milk and melted butter. | 4) Beat lightly and stir into the flour mixture. | 5) Stir lightly until well blended. | 6) Grease a 12 count muffin pan. | 7) Fill the cups a little more than half full. | 8) Place pan in a cold oven. | 9) Turn oven to 400 degrees and bake for 20 to 30 minutes. | 10) THey will be crisp on the outside, chewy and soft on the inside.", "tags": ["breakfast", "healthy", "kid friendly", "brunch", "30 mins", "easy"], "cook_time_min": 20, "servings": null, "cuisine": ["All"], "rating_avg": 4.81, "rating_count": 16, "popularity_score": 4.765384615384615, "nutrition_calories": 65.7, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/10/30/73/aeaOeuB3SFWg7dpX5Lhh_0S9A0156.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["breakfast", "healthy", "kid friendly", "brunch", "30 mins", "easy"], "ingredients": []}, {"recipe_id": "rec_375", "props": {"title": "Smoked Salmon and Cream Cheese Frittata", "instructions": "[Instructions] 1) In a bowl whisk together eggs, milk, onions, basil, salt and pepper. | 2) Preheat broiler. | 3) Heat butter or oil in a 12-inch oven-proof skillet over medium heat until hot. | 4) Pour egg mixture into skillet and scatter cream cheese cubes over top. | 5) Cook, lifting up cooked eggs around edges using a spatula to let the raw egg flow underneath until the frittata is set on bottom, and egg is almost set but still moist on top (about 3 minutes). | 6) Remove from heat. | 7) Sprinkle salmon all over frittata, then press lightly, the shake skillet to allow salmon to settle into the top. | 8) Broil about 6 inches from heat for 1 - 1-1/2 minutes, or until set, slightly puffed and golden in spots. | 9) Cool 5 minutes, then loosen edge with spatula, and slide onto a large plate. | 10) Cut into wedges and serve warm or at room temperature.", "tags": ["very low carbs", "savory", "brunch", "broil grill", "30 mins", "oven", "beginner cook", "stove top", "easy"], "cook_time_min": 6, "servings": null, "cuisine": ["All"], "rating_avg": 4.5, "rating_count": 4, "popularity_score": 4.638571428571428, "nutrition_calories": 426.0, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/14/16/44/picnunLfl.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["very low carbs", "savory", "brunch", "broil grill", "30 mins", "oven", "beginner cook", "stove top", "easy"], "ingredients": []}, {"recipe_id": "rec_376", "props": {"title": "Smoked Salmon Pancakes", "instructions": "[Instructions] 1) Combine sifted flour with baking soda and baking powder. In a separate bowl, lightly beat egg and add milk. Make a well in the centre of the flour mixture and pour in egg and milk. Stir with a whisk until smooth and thick. | 2) Spoon a tablespoon of mixture into a lightly greased, non-stick frying pan. Cook over a medium heat for 3 minutes, until bubbles appear on the surface. Turn and cook for 1 minute. Repeat with remaining batter and set aside to cool completely. | 3) Combine sour cream, mustard and horseradish. Stir in chives and season with pepper. Spoon onto cooled pancakes and top with slices of smoked salmon. Garnish with extra chives and serve.", "tags": ["healthy", "brunch", "60 mins", "easy"], "cook_time_min": 30, "servings": null, "cuisine": ["All"], "rating_avg": 4.67, "rating_count": 4, "popularity_score": 4.687142857142857, "nutrition_calories": 42.1, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/44/76/07/BONG6hZSgW9mAw6fKAw2_smoked-salmon-horesradish-cream-pancakes-2705.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["healthy", "brunch", "60 mins", "easy"], "ingredients": []}, {"recipe_id": "rec_377", "props": {"title": "Smoked Salmon Scramble", "instructions": "[Instructions] 1) Heat oil in a nonstick skillet over medium-high heat for 1 to 2 minutes. | 2) Add eggs and allow to set, 10 seconds. | 3) Sprinkle salmon, cream cheese, and chives over eggs. | 4) Scramble until just cooked, about 1 minute, being careful not to overcook. Season to taste with pepper, if desired. | 5) Serve hot.", "tags": ["very low carbs", "brunch", "15 mins"], "cook_time_min": 5, "servings": null, "cuisine": ["All"], "rating_avg": 5.0, "rating_count": 3, "popularity_score": 4.764615384615385, "nutrition_calories": 202.3, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/42/15/95/picq7emFB.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["very low carbs", "brunch", "15 mins"], "ingredients": []}, {"recipe_id": "rec_378", "props": {"title": "Titanic Spiked Pecan Sticky Buns", "instructions": "[Instructions] 1) Butter a 13\u201d x 9\u201d baking pan. | 2) Combine sugar, butter and honey in a small saucepan. Bring to a boil over medium heat, stirring to melt sugar well. Add whiskey. Boil for one minute, stirring constantly. | 3) Remove from heat and stir in pecans. Pour into baking pan and set aside. | 4) Roll dough into a 12\u201d x 16\u201d rectangle and brush with melted butter. | 5) Combine sugar and spices in small bowl and sprinkle over dough. | 6) Roll dough from long side, pressing to seal edges. | 7) Cut into 8 slices and place cut side down in baking pan. Cover with plastic wrap and place in unheated oven with pan/bowl of hot water below (or other warm place) and allow to rise until doubled, about 1 hour. | 8) Remove plastic wrap. | 9) Preheat oven to 350 degrees and bake for about 25-30 minutes until buns are golden and syrup is bubbly. | 10) Cool in pan for 5 minutes and invert onto foil covered baking sheet or serving platter. | 11) Serve warm.", "tags": ["breakfast", "fruit", "nuts", "brunch", "beginner cook", "4 hours", "easy"], "cook_time_min": 1, "servings": null, "cuisine": ["All"], "rating_avg": null, "rating_count": 0, "popularity_score": null, "nutrition_calories": 502.6, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/gk-static/fdc-new/img/fdc-shareGraphic.png"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["breakfast", "fruit", "nuts", "brunch", "beginner cook", "4 hours", "easy"], "ingredients": []}, {"recipe_id": "rec_379", "props": {"title": "Western Skillet Omelet", "instructions": "[Instructions] 1) Place potatoes in large saucepan; cover with water. | 2) Bring to boil; continue boiling 5 minutes. | 3) Drain well and set aside. | 4) Cook bacon in large skillet on medium-high heat until crisp, turning occasionally. | 5) Remove bacon from skillet; drain on paper towels. | 6) Discard bacon drippings. | 7) Add peppers, tomatoes and onions to skillet. | 8) Reduce heat to medium; cook and stir 3 minutes. | 9) Add potatoes, cook an additional 15 minutes, stirring occasionally. | 10) Make 6 small wells in potato mixture. | 11) Add 1 egg to each well. | 12) Top potato mixture with bacon; sprinkle with cheese. | 13) Cover skillet with lid. | 14) Cook 5-8 minutes or until eggs are set.", "tags": ["cheese", "60 mins", "stove top", "easy"], "cook_time_min": 45, "servings": null, "cuisine": ["All"], "rating_avg": 4.5, "rating_count": 5, "popularity_score": 4.629333333333333, "nutrition_calories": 320.1, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/25/27/07/pic2B0Qub.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["cheese", "60 mins", "stove top", "easy"], "ingredients": []}, {"recipe_id": "rec_380", "props": {"title": "World's Best Cinnamon Raisin Bread (Not Bread Machine)", "instructions": "[Instructions] 1) Warm the milk in a small sauce pan on the stove until it just starts to bubble, stirring occasionally. | 2) Remove from heat. | 3) Let cool until lukewarm, about 120-125 degrees. | 4) Dissolve yeast in warm water and set aside until yeast is frothy, about 10 minutes or so (make sure your water is at the correct temperature or the yeast won't activate.) Then mix in eggs, sugar, butter salt and raisins (stir in the cooled milk slowly so you don't cook the eggs.) Add the flour gradually to make a stiff dough. | 5) Knead the dough on a lightly floured surface for a few minutes until smooth. | 6) Place in a large, buttered, mixing bowl and turn to grease the surface of the dough. | 7) Cover with a warm, damp cloth and let rise (I like to let my bread rise in the oven with the light on. It has just the right amount of heat and keeps the bread out of drafts.) Allow to rise until doubled, usually about 1 1/2 hours. | 8) Roll out on a lightly floured surface into a large rectangle 1/2 inch thick. | 9) Moisten the dough with 2 tablespoons milk and rub all over the dough with your hands. | 10) Mix together 1 cup of sugar and 3 tablespoons cinnamon and sprinkle mixture evenly on top of the moistened dough. | 11) Roll up tightly (the long way). | 12) The roll should be about 3 inches in diameter. | 13) Cut into thirds, and tuck under ends and pinch bottom together. | 14) Place loaves into well greased (you can use Crisco or butter for this) 9 x 5 inch pans and lightly grease tops of loaves. | 15) Let rise in warm place, uncovered, again for about an hour. | 16) Bake at 350 degrees for 45 minutes or until loaves are lightly browned and sound hollow when tapped. | 17) Remove from oven and let cool on rack. | 18) Take melted butter and spread over tops of loaves. | 19) After about 20 minutes, lay loaves on their sides and remove from pans. | 20) Allow to cool before slicing.", "tags": ["breads", "breakfast", "grains", "toddler friendly", "healthy", "kid friendly", "winter", "brunch", "for large groups", "oven", "4 hours"], "cook_time_min": 45, "servings": null, "cuisine": ["All"], "rating_avg": 4.65, "rating_count": 264, "popularity_score": 4.651605839416058, "nutrition_calories": 189.6, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/98/86/7/S7z0H6qFSbKHdPa0El8s_Best%20cinnamon%20raisin%20bread%20SITE-2.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["breads", "breakfast", "grains", "toddler friendly", "healthy", "kid friendly", "winter", "brunch", "for large groups", "oven", "4 hours"], "ingredients": []}, {"recipe_id": "rec_381", "props": {"title": "Almond/Walnut-Coconut Granola", "instructions": "[Instructions] 1) Preheat oven to 325 degrees F. | 2) In a large bowl, stir together oats, nuts, coconut, sunflower seeds and salt. | 3) In a small saucepan melt butter with honey over low heat, stirring constantly. | 4) Pour butter mixture over oat mixture and stir until well combined. | 5) In a large jelly-roll pan that has been sprayed with Pam, spread granola evenly. | 6) Bake in middle of oven, stirring halfway through backing- approximately. | 7) 20 minutes. | 8) Cool granola in pan on a rack and stir in dried fruit. | 9) Can be kept in an airtight container at cool room temperature up to 2 weeks.", "tags": ["grains", "coconut", "tropical fruits", "fruit", "nuts", "camping", "30 mins", "oven", "beginner cook", "easy"], "cook_time_min": 20, "servings": null, "cuisine": ["All"], "rating_avg": 4.5, "rating_count": 2, "popularity_score": 4.661666666666667, "nutrition_calories": 321.9, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/63/94/7/picYudkYn.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["grains", "coconut", "tropical fruits", "fruit", "nuts", "camping", "30 mins", "oven", "beginner cook", "easy"], "ingredients": []}, {"recipe_id": "rec_382", "props": {"title": "Chewy Granola Bars", "instructions": "[Instructions] 1) Preheat oven to 350\u00b0 and lightly grease or spray 9 x 13 pan. | 2) In large bowl, beat brown sugar, sugar, and butter until light and fluffy. | 3) Blend in honey, vanilla and egg. | 4) In separate bowl, combine flour, cinnamon, baking soda, and salt. | 5) Add flour mixture gradually to sugar mixture and beat until combined. | 6) By hand, stir in almonds, chocolate chips and oats until well mixed. | 7) Press mixture firmly in bottom of greased pan, and bake at 350\u00b0 for 20-25 minutes, or until light golden brown. | 8) Cool and cut into squares.", "tags": ["breakfast", "dessert", "cookie and brownie", "kid friendly", "60 mins", "oven", "beginner cook", "easy", "inexpensive"], "cook_time_min": 25, "servings": null, "cuisine": ["All"], "rating_avg": 4.78, "rating_count": 119, "popularity_score": 4.773333333333333, "nutrition_calories": 269.9, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/20/18/4/YqSpyRZgRnqaa7qHs4vf_0S9A7651.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["breakfast", "dessert", "cookie and brownie", "kid friendly", "60 mins", "oven", "beginner cook", "easy", "inexpensive"], "ingredients": []}, {"recipe_id": "rec_383", "props": {"title": "Chocolate and Cherries Granola", "instructions": "[Instructions] 1) Preheat oven to 325 degrees. | 2) In a large mixing bowl, stir together the oats, pecans, coconut, wheat germ, brown sugar and salt. | 3) Combine the the oil, honey, water and vanilla. Add to oat mixture and toss until well combined. | 4) Spread the mixture evenly on a cookie sheet. | 5) Bake for 30-40 minutes or until lightly browned, stirring every 10 minutes to keep the mixture from sticking. | 6) Allow to cool. | 7) Stir in the cherries and chocolate chips. | 8) Store in an air tight container.", "tags": ["cherries", "grains", "fruit", "kid friendly", "brunch", "60 mins", "for large groups", "oven", "easy"], "cook_time_min": 40, "servings": null, "cuisine": ["All"], "rating_avg": 5.0, "rating_count": 4, "popularity_score": 4.781428571428571, "nutrition_calories": 236.8, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/21/77/58/picR1IojP.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["cherries", "grains", "fruit", "kid friendly", "brunch", "60 mins", "for large groups", "oven", "easy"], "ingredients": []}, {"recipe_id": "rec_384", "props": {"title": "Chocolate Crunch (Cooking Light)", "instructions": "[Instructions] 1) Preheat oven to 3oo degrees. | 2) Cover a jelly roll pan with parchment paper. Coat parchment paper with cooking spray. | 3) Combine oats, rice cereal, brown sugar, chopped pecans, salt and ground cinnamon in a large bowl. | 4) Combine honey and canola oil in a small saucepan over low heat; cook 2 minutes or until warm. Remove from heat. Add vanilla and chocolate; stir with a whisk until smooth. Pour chocolate mixture over oat mixture. Lightly coat hands with cooking spray. Gently mix chocolate mixture and oat mixture until combined. Spread oat mixture onto prepared jelly-roll pan. Bake at 300 degrees for 20 minutes, stirring after 10 minutes. Cool completely on pan; stir in cranberries.", "tags": ["lunch snacks", "low cholesterol", "healthy", "60 mins", "for large groups", "easy"], "cook_time_min": 30, "servings": null, "cuisine": ["All"], "rating_avg": 5.0, "rating_count": 4, "popularity_score": 4.781428571428571, "nutrition_calories": 195.8, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/28/76/88/picwjRlSh.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["lunch snacks", "low cholesterol", "healthy", "60 mins", "for large groups", "easy"], "ingredients": []}, {"recipe_id": "rec_385", "props": {"title": "Chocolate-Granola Apple Wedges", "instructions": "[Instructions] 1) Place chocolate in a medium microwave-safe bowl, and microwave for 1 minute, stirring every 15 seconds, or until chocolate melts. | 2) Place granola in a shallow dish. | 3) Dip apple wedges skin side up, in chocolate to drip back in bowl. | 4) Dredge wedges in granola. | 5) Place wedges chocolate side up on a large plate, and refridgerate for 5 minutes, or until set.", "tags": ["fruit", "weeknight", "30 mins", "easy", "inexpensive"], "cook_time_min": 6, "servings": null, "cuisine": ["All"], "rating_avg": 5.0, "rating_count": 1, "popularity_score": 4.721818181818181, "nutrition_calories": 101.6, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/46/26/57/pic0n0Eeh.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["fruit", "weeknight", "30 mins", "easy", "inexpensive"], "ingredients": []}, {"recipe_id": "rec_386", "props": {"title": "Costco Clone Granola", "instructions": "[Instructions] 1) Preheat oven to 325\u00b0F. | 2) Mix granola ingredients in a large bowl. | 3) For coating, heat oil, honey, and maple syrup to a rolling boil. Turn off heat and add vanilla. Pour over granola mixture and blend well. Spread on a baking sheet. | 4) Bake for about 15-20 minutes, stirring the granola every 5 minutes while baking to ensure even browning. Watch it closely as it can burn fast. For softer granola do not bake as long.", "tags": ["lunch snacks", "grains", "fruit", "nuts", "30 mins"], "cook_time_min": 20, "servings": null, "cuisine": ["All"], "rating_avg": 5.0, "rating_count": 6, "popularity_score": 4.80875, "nutrition_calories": 424.0, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/39/09/08/picScQSdN.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["lunch snacks", "grains", "fruit", "nuts", "30 mins"], "ingredients": []}, {"recipe_id": "rec_387", "props": {"title": "Crunchy Granola", "instructions": "[Instructions] 1) Preheat oven to 325 degrees F. In a large bowl, mix together the ingredients for Oat Mixture. | 2) In a small to medium bowl, separately mix together the first 4 ingredients for Oil Mixture. | 3) Add Oil Mixture (not the honey yet) to the Oat Mixture; blend well. | 4) Then add in the honey. Mix well. | 5) Spread thinly and evenly on cookie sheets (for ease of preparation, use rimmed cookie sheets). | 6) Bake at 325 d F for 30 minutes, stirring occasionally until golden (stir @ every 12-15 minutes). | 7) After baking, remove from oven and let granola cool on cookie sheets. | 8) Remove granola from cooled pans and it's ready to eat, or store covered for about 2 weeks. | 9) Makes a nice food gift. | 10) Yield is approximate & depends on amounts used.", "tags": ["4 hours"], "cook_time_min": 30, "servings": null, "cuisine": ["All"], "rating_avg": 4.5, "rating_count": 2, "popularity_score": 4.661666666666667, "nutrition_calories": 555.5, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/11/77/90/picaDj06y.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["4 hours"], "ingredients": []}, {"recipe_id": "rec_388", "props": {"title": "Crunchy Granola (Muesli)", "instructions": "[Instructions] 1) Preheat oven to 350 degrees. | 2) Combine all the dry ingredients in the baking pan (first six items). Add raisins (or other dried fruits) after cooking. | 3) Heat the butter, honey, milk and salt in a small saucepan until all the butter melts. | 4) Dribble honey\u2013butter mixture over dry ingredients, and mix well to moisten all the dry ingredients. | 5) Bake for 20-30 minutes (depending on how hot your oven runs), stirring frequently. | 6) This can easily over-brown (burn), so keep an eye on it. | 7) Remove from oven and stir in the raisins or other dried fruit. | 8) When cool, store in an airtight container. It keeps very well.", "tags": ["grains", "30 mins", "for large groups", "beginner cook", "easy"], "cook_time_min": 20, "servings": null, "cuisine": ["All"], "rating_avg": 4.76, "rating_count": 17, "popularity_score": 4.735555555555555, "nutrition_calories": 257.0, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/20/23/55/picktTERS.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["grains", "30 mins", "for large groups", "beginner cook", "easy"], "ingredients": []}, {"recipe_id": "rec_389", "props": {"title": "Crunchy Yogurt With Berries", "instructions": "[Instructions] 1) Place berries in 4 see-through bowls. | 2) Add yogurt and sprinkle with granola. | 3) Top with maple syrup.", "tags": ["fruit", "15 mins", "easy"], "cook_time_min": 5, "servings": null, "cuisine": ["All"], "rating_avg": 5.0, "rating_count": 2, "popularity_score": 4.745, "nutrition_calories": 237.1, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/25/44/30/pic2FS2wV.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["fruit", "15 mins", "easy"], "ingredients": []}, {"recipe_id": "rec_390", "props": {"title": "Down to Earth Granola Weight Watchers", "instructions": "[Instructions] 1) In a bowl, mix oats, almonds, brown sugar, salt and cinnamon. In a sauce pan, warm the oil and honey. Whisk or stir in the vanilla. Carefully pour liquid over the oat mixture. Stir gently with wooden spoon, finish mixing by hand. | 2) Preheat oven to 300\u00b0F Spread granola in a 15x10x1\u201d pan. Bake 40 minutes, stirring carefully every 10 minutes. | 3) Transfer granola-filled pan to a cooling rack. Cool completely. | 4) Stir in raisins or dried cranberries. Seal granola in an air-tight container or self sealing plastic bags. | 5) Store at room temperature for 1 week or the freezer for 3 months.", "tags": ["low cholesterol", "healthy", "60 mins"], "cook_time_min": 40, "servings": null, "cuisine": ["All"], "rating_avg": 4.42, "rating_count": 22, "popularity_score": 4.505625, "nutrition_calories": 276.3, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/27/26/50/picSH2t4u.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["low cholesterol", "healthy", "60 mins"], "ingredients": []}, {"recipe_id": "rec_391", "props": {"title": "Fantastic Granola Bars", "instructions": "[Instructions] 1) Set oven to 350 degrees. | 2) Grease BOTTOM ONLY of a 13 x 9-in baking pan. | 3) In a large bowl, combine the first 5 ingredients. | 4) Stir well. | 5) Stir in the remaining ingredients. | 6) You may add what ever you want, as long as the mixture is sticking together in several large clumps. | 7) Press the mixture into the baking pan, using your fingers. | 8) Bake at 350 degrees for 15-20 mins, or until golden. | 9) Cool completely, and cut into bars.", "tags": ["breakfast", "dessert", "cookie and brownie", "camping", "30 mins", "for large groups"], "cook_time_min": 15, "servings": null, "cuisine": ["All"], "rating_avg": 4.77, "rating_count": 13, "popularity_score": 4.736956521739129, "nutrition_calories": 401.7, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/77/20/0/picEgVfms.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["breakfast", "dessert", "cookie and brownie", "camping", "30 mins", "for large groups"], "ingredients": []}, {"recipe_id": "rec_392", "props": {"title": "Fruited Granola", "instructions": "[Instructions] 1) Preheat oven to 325 degrees F. | 2) Spread oats & almonds in single layer in 13\"x9\" baking pan. | 3) Stirring frequently, bake 15 minutes or until lightly toasted. | 4) Remove from oven & set aside. | 5) In large bowl, combine honey, butter, wheat germ & cinnamon until well blended. | 6) Add oats & almonds, tossing to coat completely. | 7) Spread mixture in single layer in baking pan. | 8) Bake 20 minutes or until golden brown. | 9) Remove from oven & cool completely in pan on wire rack. | 10) Break mixture into small chunks. | 11) In large bowl, combine oat chunks, wheat cereal, raisins, cranberries & dates. | 12) Serve with yogurt or milk, if desired. | 13) Store in airtight container at room temperature up to 2 weeks.", "tags": ["fruit", "nuts", "healthy", "60 mins", "for large groups"], "cook_time_min": 35, "servings": null, "cuisine": ["All"], "rating_avg": 4.2, "rating_count": 5, "popularity_score": 4.529333333333334, "nutrition_calories": 201.9, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/21/94/01/picgkDVue.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["fruit", "nuts", "healthy", "60 mins", "for large groups"], "ingredients": []}, {"recipe_id": "rec_393", "props": {"title": "Fruity Granola Energy Bars", "instructions": "[Instructions] 1) Preheat oven to 350 degrees F. | 2) Spray a 9-inch square baking pan with non-stick cooking spray or brush with oil. | 3) Combine oats,wheat germ, apricots, raisins, sunflower seeds, cinnamon and salt in a large bowl. | 4) Combine melted butter and brown sugar in a small bowl until sugar is dissolved. | 5) Stir in honey, egg and vanilla until smooth. | 6) Stir liquid mixture into dry mixture until dry ingredients are evenly moistened. | 7) Press mixture firmly and evenly in prepared pan. | 8) Bake for 20 minutes, or until golden and firm. | 9) Cool on wire rack before cutting into squares or bars. | 10) Wrap individually for easy grab and go breakfasts and snacks.", "tags": ["breakfast", "dessert", "lunch snacks", "cookie and brownie", "fruit", "healthy", "60 mins"], "cook_time_min": 20, "servings": null, "cuisine": ["All"], "rating_avg": 4.25, "rating_count": 12, "popularity_score": 4.451818181818181, "nutrition_calories": 119.6, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/62/42/7/picHako2c.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["breakfast", "dessert", "lunch snacks", "cookie and brownie", "fruit", "healthy", "60 mins"], "ingredients": []}, {"recipe_id": "rec_394", "props": {"title": "Granola Cookies", "instructions": "[Instructions] 1) Preheat oven to 350 degrees F. | 2) Cream butter and sugar in a stand mixer. Add egg. | 3) In a separate bowl, combine flour, baking soda, salt and spices. Gradually add to wet ingredients. Combine thoroughly. Stir in granola and chocolate chips until well incorporated. | 4) Drop by spoonful onto parchment-lined baking sheet. | 5) Bake for 8-10 minutes. Remove from oven and let cool on sheet 2 minutes. Remove to rack and let cool completely.", "tags": ["lunch snacks", "cookie and brownie", "30 mins", "beginner cook", "easy"], "cook_time_min": 10, "servings": null, "cuisine": ["All"], "rating_avg": 4.0, "rating_count": 1, "popularity_score": 4.63090909090909, "nutrition_calories": 163.7, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/35/36/33/picqtIMz9.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["lunch snacks", "cookie and brownie", "30 mins", "beginner cook", "easy"], "ingredients": []}, {"recipe_id": "rec_395", "props": {"title": "Granola Fudge Clusters (Small Batch)", "instructions": "[Instructions] 1) In a microwave safe bowl combine chocolate chips and butterscotch chips. Melt them and stir until smooth (in my microwave it took 1 1/2 minutes on high). | 2) Stir in granola, almonds and cinnamon until everything is well coated. | 3) Drop by tabelspoonfuls onto a paper-lined baking sheet. Allow to dry for about 1 1/2 hours or until set.", "tags": ["dessert", "high protein", "high in", "sweet", "weeknight", "15 mins", "easy"], "cook_time_min": 5, "servings": null, "cuisine": ["All"], "rating_avg": 4.75, "rating_count": 4, "popularity_score": 4.71, "nutrition_calories": 141.3, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/45/93/46/picVV90xA.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["dessert", "high protein", "high in", "sweet", "weeknight", "15 mins", "easy"], "ingredients": []}, {"recipe_id": "rec_396", "props": {"title": "Green Mountain Granola", "instructions": "[Instructions] 1) Melt the butter in a 9\"x13\" pan. Add the 1/3 cup maple syrup. | 2) Now mix together in a bowl the oats, coconut, walnuts, almonds or pecans, and cinnamon, then add to syrup, mixing all together, then pressing into one layer in pan. | 3) Bake at 325*F. for 15 to 25 mins.(watch carefully during the last 10 minutes so they don't get too brown), remove from oven, cool, break up into chunks, and then add: \u00bd cup to 2/3 cup dried cranberries, apricots, or any dried fruit and 1 cup raisins. Enjoy!", "tags": ["lunch snacks", "grains", "fruit", "nuts", "kid friendly", "brunch", "60 mins", "for large groups", "easy"], "cook_time_min": 25, "servings": null, "cuisine": ["All"], "rating_avg": 5.0, "rating_count": 12, "popularity_score": 4.86090909090909, "nutrition_calories": 374.2, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/22/16/83/picpILi7n.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["lunch snacks", "grains", "fruit", "nuts", "kid friendly", "brunch", "60 mins", "for large groups", "easy"], "ingredients": []}, {"recipe_id": "rec_397", "props": {"title": "Healthy Granola", "instructions": "[Instructions] 1) Preheat oven to 300 degrees. | 2) In a large bowl combine oats, wheat germ, flax seed, coconut, sesame seeds and nuts, mixing well. | 3) In a large saucepan, combine the brown sugar substitute or brown sugar, water, oil, honey, sorghum, salt, cinnamon and vanilla. | 4) Heat until thoroughly mixed; do not boil. | 5) Pour the syrup over dry ingredients and stir until coated well. | 6) Spread into five 13 x 9 inch jelly roll pans. | 7) Bake 20 to 30 minutes, stirring occasionally. | 8) For a crunchier texture, bake an additional 10 to 15 minutes. | 9) Cool mixture and add dried fruit. | 10) Store in airtight container in a cool dry place. | 11) Will keep up to 6 months; but it doens't make it that long in our house.", "tags": ["grains", "lactose free", "free of", "for large groups", "4 hours"], "cook_time_min": 1, "servings": null, "cuisine": ["All"], "rating_avg": 4.72, "rating_count": 41, "popularity_score": 4.714901960784314, "nutrition_calories": 287.2, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/10/04/64/picrs2TRW.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["grains", "lactose free", "free of", "for large groups", "4 hours"], "ingredients": []}, {"recipe_id": "rec_398", "props": {"title": "Homemade Granola", "instructions": "[Instructions] 1) Preheat oven to 360 degrees. | 2) Toast nuts in pan over stove until lightly brown. | 3) Mix the fruit juice, honey, maple syrup, oil, vanilla, and spices in a large bowl. It's okay to add more honey, maple syrup, cinnamon, or spices - just depends how you like your granola to taste. | 4) Add oats and nuts into honey mixture and combine together. | 5) Spread mixture on a baking sheet and bake 30 minutes until golden. Stir occasionally. Use your best judgement when baking. I like mine a little crunchy, so sometimes I bake it 40 minutes. | 6) Leave on pan to cool. | 7) If you are using dried fruit stir in once completely cooled. | 8) Store granola in container with lid (not in refrigerator). It will last about a week or a little longer. Add granola to vanilla yogurt, or with milk, or eat plain.", "tags": ["weeknight", "60 mins"], "cook_time_min": 30, "servings": null, "cuisine": ["All"], "rating_avg": 5.0, "rating_count": 2, "popularity_score": 4.745, "nutrition_calories": 214.5, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/38/91/05/picjuvoDK.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["weeknight", "60 mins"], "ingredients": []}, {"recipe_id": "rec_399", "props": {"title": "Low-Fat Citrus Granola", "instructions": "[Instructions] 1) Preheat oven to 300 degrees F. | 2) Combine oatmeal,almonds, sunflower seeds, wheat germ and cinnamon. | 3) In a saucepan, combine brown sugar and honey. Bring to a boil. | 4) Remove from heat and add lemon and orange rind and juice. | 5) Toss liquid mixture with dry mixture. | 6) Spray large pan, spread with granola and bake at 300 degrees F for 30 minutes. Stir every 10 minutes until golden brown. | 7) Cool. | 8) Add dried fruit. | 9) Store in airtight container.", "tags": ["lunch snacks", "grains", "low cholesterol", "healthy", "camping", "brunch", "60 mins", "easy"], "cook_time_min": 30, "servings": null, "cuisine": ["All"], "rating_avg": 5.0, "rating_count": 2, "popularity_score": 4.745, "nutrition_calories": 717.6, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/29/28/70/picZrQTYx.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["lunch snacks", "grains", "low cholesterol", "healthy", "camping", "brunch", "60 mins", "easy"], "ingredients": []}, {"recipe_id": "rec_400", "props": {"title": "Mango and Pineapple Granola Bars", "instructions": "[Instructions] 1) Preheat oven to 325F and grease and line an 8x8 inch square pan. | 2) Place oats, chopped fruit and light brown sugar into a large bowl and stir until combined. | 3) Place the honey, oil and vanilla extract into a jug and lightly beat with a fork. | 4) Pour liquid measurements into dry and stir until all the oats are coated with the wet mix. | 5) Tip the granola mix into your lined pan and spread until level, either with the back of a spoon or your hand. | 6) Place in the oven for 30-35 minutes until golden and slightly firm to the touch. | 7) Leave to cool in the pan completely. | 8) Once cool, slice into 9-12 bars. Granola bars will keep in an airtight container, at room temperature, for 4 days.", "tags": ["mango", "pineapple", "tropical fruits", "fruit", "60 mins", "from scratch"], "cook_time_min": 30, "servings": null, "cuisine": ["All"], "rating_avg": null, "rating_count": 0, "popularity_score": null, "nutrition_calories": 165.1, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/submissions/recipe/1802849661/gYjMOjPnSSekZiXKYvTK_foodgawker.png"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["mango", "pineapple", "tropical fruits", "fruit", "60 mins", "from scratch"], "ingredients": []}, {"recipe_id": "rec_401", "props": {"title": "Maple Granola", "instructions": "[Instructions] 1) Preheat oven to 225 degrees F. | 2) In a small saucepan, combine the oil and syrup and heat, stirring, over low heat. Remove from the heat and add the vanilla extract. | 3) In a large bowl, toss together the wheat germ, sesame seeds, coconut, oats, pumpkin seeds, cashews, and almonds. | 4) Add the syrup mixture and stir to coat evenly. | 5) Spread the granola mixture out on a baking sheet. | 6) Bake until golden brown, about an 1 hour and 30 minutes. | 7) Stir the mixture occasionally while baking so it toasts evenly. | 8) Transfer the warm toasted granola to a large bowl and stir in the dried fruits and let cool. | 9) Store in a tightly sealed container a room temperature for 2 weeks or freeze for up to 2 months.", "tags": ["lunch snacks", "4 hours"], "cook_time_min": 1, "servings": null, "cuisine": ["All"], "rating_avg": 5.0, "rating_count": 2, "popularity_score": 4.745, "nutrition_calories": 611.0, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/22/30/88/picn2tQ19.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["lunch snacks", "4 hours"], "ingredients": []}, {"recipe_id": "rec_402", "props": {"title": "Molasses-Peanut Granola", "instructions": "[Instructions] 1) Feel free to add whatever you want! | 2) Position rack to center of oven and preheat to 325*. | 3) Spray large roasting pan with nonstick spray. | 4) Mix oats, peanuts, and coconut in prepared roasting pan. | 5) Combine molasses, brown sugar, 1/4 cup water and oil in heavy small saucepan. | 6) Bring to boil, stirring occasionally. | 7) Pour hot molasses mixture over oat mixture; toss to coat well. | 8) Bake granola 20 minutes Stir raisins into granola. | 9) Bake until deep golden, stirring frequently, about 15 minutes longer. | 10) Transfer pan to rack. | 11) Using metal spatula, scrape bottom of pan to loosen granola. | 12) Cool completely in pan, occasionally scraping with spatula to prevent granola from sticking.", "tags": ["30 mins"], "cook_time_min": 20, "servings": null, "cuisine": ["All"], "rating_avg": 3.5, "rating_count": 5, "popularity_score": 4.295999999999999, "nutrition_calories": 672.9, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/28/51/5/picSmYw4D.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["30 mins"], "ingredients": []}, {"recipe_id": "rec_403", "props": {"title": "No-Bake Apple Crisp", "instructions": "[Instructions] 1) Melt butter in a skillet over medium heat. Add apples, sprinkle with cinnamon and stir. Cook until tender 5-8 minutes. | 2) Drizzle apples with agave nectar and stir to evenly coat. Cook an additional 1-2 minutes until nice and gooey! | 3) Remove from heat, transfer to a bowl and top with granola.", "tags": ["apple", "fruit", "vegan", "free of", "15 mins", "easy"], "cook_time_min": 10, "servings": null, "cuisine": ["All"], "rating_avg": 4.0, "rating_count": 1, "popularity_score": 4.63090909090909, "nutrition_calories": 250.2, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/46/76/66/picuJekiv.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["apple", "fruit", "vegan", "free of", "15 mins", "easy"], "ingredients": []}, {"recipe_id": "rec_404", "props": {"title": "No Bake Granola Bars", "instructions": "[Instructions] 1) Line a 9 x 13 inch sheet pan with parchment paper. Set aside. | 2) Mix rolled oats, cereal, craisins, coconut and almonds in a large bowl. Set aside. (I cut the coconut with two knives so it will not be stringy.) | 3) In a saucepan, mix corn syrup and brown sugar. Bring to a boil while stirring. Add peanut butter and vanilla. Stir just to blend well. | 4) Pour over oats and fruit mixture. Stir and mix well. Press mixture firmly onto pan. (I place a piece of wax paper on top while pressing hard.) Let cool and cut into bars. Store in air-tight container. Freezes well, if securely wrapped. | 5) Enjoy!", "tags": ["berries", "coconut", "fruit", "nuts", "30 mins", "easy"], "cook_time_min": 2, "servings": null, "cuisine": ["All"], "rating_avg": 4.8, "rating_count": 15, "popularity_score": 4.7576, "nutrition_calories": 131.6, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/32/69/00/picOA7ctL.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["berries", "coconut", "fruit", "nuts", "30 mins", "easy"], "ingredients": []}, {"recipe_id": "rec_405", "props": {"title": "Oatmeal Cookie Granola", "instructions": "[Instructions] 1) Preheat oven to 300 degrees. | 2) Combine oats, flax, brown sugar, salt, cinnamon, and nutmeg in a large bowl. | 3) In a small saucepan, melt butter and add honey. | 4) Once it starts to simmer, remove from heat and quickly stir in extract. Mix well, and pour over dry mixture. Mix to coat thoroughly, and place on a greased cookie sheet. | 5) Place into the oven and bake for 20-25 minutes, until done. | 6) Allow to cool completely, break into large pieces and store in an airtight container. | 7) *Note - granola nuggets form better if you stir the granola as little as possible while baking, and don't stir it at all while it's cooling.", "tags": ["lunch snacks", "healthy", "60 mins", "easy"], "cook_time_min": 25, "servings": null, "cuisine": ["All"], "rating_avg": 5.0, "rating_count": 10, "popularity_score": 4.847, "nutrition_calories": 455.9, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/17/47/42/pic1tmxw9.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["lunch snacks", "healthy", "60 mins", "easy"], "ingredients": []}, {"recipe_id": "rec_406", "props": {"title": "Peanut-Butter Granola Bars", "instructions": "[Instructions] 1) Preheat oven to 300 degrees. | 2) Line an 8 inch square baking pan with two criss-crossed rectangles of parchment paper, leaving a 2-inch overhang at opposite ends. | 3) In a large bowl, combine oats, almonds and cranberries. | 4) In a small saucepan, whisk together oil, brown sugar, peanut butter, cinnamon, salt and water over low heat until the sugar has dissolved, about 5 minutes. | 5) Let cool slightly; whisk in egg white. | 6) Pour over oat mixture; stir until moistened. | 7) Spread evenly in bottom of pan; smooth top. | 8) Bake until top is firm, about 30 minutes. Note: The firm top is your best indicator that it's ready - if it's too soft the granola will be crumbly, if it's too hard it will be too brittle. | 9) Let cool 10 minutes. | 10) Lift out of pan, using paper as handles. | 11) Let cool completely, cut into bars with a serrated knife.", "tags": ["lunch snacks", "4 hours"], "cook_time_min": 1, "servings": null, "cuisine": ["All"], "rating_avg": 4.67, "rating_count": 9, "popularity_score": 4.682631578947369, "nutrition_calories": 249.8, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/18/46/74/picWdjGec.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["lunch snacks", "4 hours"], "ingredients": []}, {"recipe_id": "rec_407", "props": {"title": "Strawberry and Cream Cheese Parfait", "instructions": "[Instructions] 1) In a bowl, with an electric mixer, mix cream cheese and 3 tablespoon of sugar for 2 minutes or until it's creamy. Add yogurt and mix until the mixture is homogeneous. | 2) Put strawberries in a large bowl. Add remaining sugar and stir delicately to coat well. Let rest for 5 minutes at room temperature (stir one time). | 3) In 6 parfait glasses of a capacity of 1 cup each, distribute half the mixture of cream cheese, half of strawberries and half of almond cookies. Repeat with remaining ingredients. Cover with a plastic wrap and put in the fridge for 2 hours. When ready to serve, garnish with roasted almonds.", "tags": ["strawberry", "cheese", "berries", "fruit", "nuts", "egg free", "kid friendly", "free of", "summer", "mixer", "15 mins", "no cook", "refrigerator", "small appliance", "easy"], "cook_time_min": 15, "servings": null, "cuisine": ["All"], "rating_avg": 5.0, "rating_count": 11, "popularity_score": 4.854285714285714, "nutrition_calories": 136.3, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/28/90/70/picVZ0cs1.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["strawberry", "cheese", "berries", "fruit", "nuts", "egg free", "kid friendly", "free of", "summer", "mixer", "15 mins", "no cook", "refrigerator", "small appliance", "easy"], "ingredients": []}, {"recipe_id": "rec_408", "props": {"title": "Wicked Excellent Granola", "instructions": "[Instructions] 1) Preheat oven to 300\u00b0F. | 2) Combine in a very large roasting pan the oats through nutmeg. Drizzle oil, honey, maple syrup & vanilla over all & stir well to combine. | 3) Bake for 1 - 1.5 hrs, stirring every 20 minutes until it looks dry-ish & toasty. | 4) When cooled, stir in fruit.", "tags": ["grains", "camping", "for large groups", "beginner cook", "4 hours", "easy"], "cook_time_min": 1, "servings": null, "cuisine": ["All"], "rating_avg": 4.33, "rating_count": 3, "popularity_score": 4.61, "nutrition_calories": 323.6, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/25/85/12/picFX2pLD.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["grains", "camping", "for large groups", "beginner cook", "4 hours", "easy"], "ingredients": []}, {"recipe_id": "rec_409", "props": {"title": "Yogurt, Granola and Bananas", "instructions": "[Instructions] 1) Place half the ingredients layering into a wine glass follow with a second layer, drizzle honey on top. | 2) Sit back and enjoy guilt free!", "tags": ["dessert", "tropical fruits", "fruit", "low cholesterol", "healthy", "sweet", "brunch", "15 mins", "no cook", "easy"], "cook_time_min": 5, "servings": null, "cuisine": ["All"], "rating_avg": 5.0, "rating_count": 15, "popularity_score": 4.8776, "nutrition_calories": 574.5, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/10/34/35/pickXcRev.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["dessert", "tropical fruits", "fruit", "low cholesterol", "healthy", "sweet", "brunch", "15 mins", "no cook", "easy"], "ingredients": []}, {"recipe_id": "rec_410", "props": {"title": "Yummy, Healthy Granola", "instructions": "[Instructions] 1) Preheat oven to 350. | 2) Put oats in a microwaveable bowl and cook for two minutes, stirring after one. (This warms the oats helping to melt all the ingredients together). | 3) Add remaining ingredients, except the dried fruit, and stir until very well blended. | 4) Pour mixture into two large oven safe dishes and bake for 20 minutes, stirring every five. | 5) Add dried fruit. | 6) Spread on wax paper to cool.", "tags": ["low cholesterol", "toddler friendly", "healthy", "kid friendly", "30 mins", "for large groups", "easy"], "cook_time_min": 20, "servings": null, "cuisine": ["All"], "rating_avg": 4.8, "rating_count": 5, "popularity_score": 4.729333333333333, "nutrition_calories": 69.0, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/31/15/01/picSs49yU.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["low cholesterol", "toddler friendly", "healthy", "kid friendly", "30 mins", "for large groups", "easy"], "ingredients": []}, {"recipe_id": "rec_411", "props": {"title": "Apricot Honey Syrup", "instructions": "[Instructions] 1) Soak the apricots in water overnight. | 2) Drain off water. Pur\u00e9e apricots. Add honey and simple syrup. Store in refrigerator. | 3) Warm on stove or in microwave. Put into little pitchers and hold each in oven until ready to serve. | 4) To make simple sugar syrup, combine sugar and water in a saucepan and bring to a boil. Boil gently without stirring for 10 minutes. Allow to cool.", "tags": ["kid friendly", "beginner cook", "easy", "inexpensive"], "cook_time_min": 576, "servings": null, "cuisine": ["All"], "rating_avg": 4.0, "rating_count": 1, "popularity_score": 4.63090909090909, "nutrition_calories": 6736.0, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/14/43/67/picwFr4Ib.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["kid friendly", "beginner cook", "easy", "inexpensive"], "ingredients": []}, {"recipe_id": "rec_412", "props": {"title": "Arkansas German-Baked Pancake", "instructions": "[Instructions] 1) Make Apple Filling: melt butter in a large skillet over med-high heat; add in apples; cook, stirring constantly, 12 minutes, until tender. | 2) Gently stir in honey; cook just until thoroughly heated; keep warm. | 3) Make pancake: heat a 12-inch cast-iron skillet in a 450\u00b0 oven for 5 minutes. | 4) Combine the eggs, milk, and vanilla in a bowl; beat at medium speed using an electric mixer, until smooth. | 5) Add in flour and salt; beat 5 minutes. | 6) Melt butter in skillet; pour batter into hot skillet. | 7) Bake at 450\u00b0 for 15 minutes; decrease temperature to 350\u00b0; bake 8 minutes or until puffed and browned. | 8) Remove from oven; spoon Apple Filling over pancake (pancake will deflate). | 9) Sprinkle with powdered sugar and dollop with whipped cream; cut into wedges and serve.", "tags": ["low protein", "60 mins"], "cook_time_min": 30, "servings": null, "cuisine": ["All"], "rating_avg": 3.75, "rating_count": 4, "popularity_score": 4.424285714285714, "nutrition_calories": 490.0, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/22/96/45/H2WdhHWSSMKWhqsC5K8R_german-pancake-apple-filling-8979.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["low protein", "60 mins"], "ingredients": []}, {"recipe_id": "rec_413", "props": {"title": "Banana Berry Pancakes", "instructions": "[Instructions] 1) :Pancakes:. | 2) Place bananas in a medium bowl and mash with a fork. | 3) Add pancake mix and water; stir until blended. | 4) Spray large skillet with nonstick cooking spray and heat over medium heat. | 5) Pour 1/4 cup batter for each pancake into hot skillet. Cook pancakes for about 2 minutes per side untill fully cooked. | 6) :Topping:. | 7) Spray a pan with nonstick cooking spray and heat over medium heat. | 8) Cook berries and orange juice for 3 minutes or until the berries are soft. | 9) Spoon topping over pancakes.", "tags": ["fruit", "low protein", "low cholesterol", "healthy", "30 mins"], "cook_time_min": 10, "servings": null, "cuisine": ["All"], "rating_avg": 4.62, "rating_count": 8, "popularity_score": 4.661111111111111, "nutrition_calories": 163.3, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/43/26/77/OlUA3BiVQuO4YymrrwH4_banana-berry-pancakes-4.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["fruit", "low protein", "low cholesterol", "healthy", "30 mins"], "ingredients": []}, {"recipe_id": "rec_414", "props": {"title": "Banana-Nut Waffles (Gluten-Free and Vegan)", "instructions": "[Instructions] 1) Heat waffle iron. | 2) Beat bananas, milk substitute, oil, and sweetener with a wire whisk or electric mixer. | 3) Stir in flour, baking powder and salt until just mixed. Batter may be lumpy. | 4) Fold in nuts or berries or chocolate chips. | 5) Spray waffle iron with non-stick cooking spray. Pour about 2/3 cup of batter onto the center of the iron. Close lid. | 6) Bake about 5 minutes or until steaming stops. Carefully remove waffle and serve with non-hydrogenated margarine (I like Earth Balance Natural Buttery Spread) and real maple syrup or honey. Other serving suggestions: spread with peanut butter or top with fresh berries and vegan whipped cream or vegan ice cream. | 7) If you have extra batter, either store it in an airtight container in the fridge for a day or two OR go ahead and cook up some more waffles and freeze them in Ziploc bags. Then toast for a weekday morning treat!", "tags": ["kid friendly", "free of", "brunch", "15 mins", "inexpensive"], "cook_time_min": 5, "servings": null, "cuisine": ["All"], "rating_avg": 4.89, "rating_count": 10, "popularity_score": 4.792, "nutrition_calories": 299.7, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/31/28/03/piccE2qvT.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["kid friendly", "free of", "brunch", "15 mins", "inexpensive"], "ingredients": []}, {"recipe_id": "rec_415", "props": {"title": "Banana Pancakes", "instructions": "[Instructions] 1) Combine flour, sugar, baking powder and salt. | 2) In separate bowl, mix together egg, milk, vegetable oil and bananas. | 3) Stir flour mixture into banana mixture; batter will be a little lumpy. | 4) Heat a lightly oiled griddle or frying pan over medium high heat. | 5) Pour or scoop batter onto pan, using about 1/4 cup for each pancake. | 6) Cook until pancakes are golden brown on both sides.", "tags": ["kid friendly", "brunch", "30 mins", "easy"], "cook_time_min": 20, "servings": null, "cuisine": ["All"], "rating_avg": 4.69, "rating_count": 107, "popularity_score": 4.69034188034188, "nutrition_calories": 197.8, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/86/35/3/xebcOwDQoO6YS2rJggLO_0S9A0808.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["kid friendly", "brunch", "30 mins", "easy"], "ingredients": []}, {"recipe_id": "rec_416", "props": {"title": "Basic Batter Waffles", "instructions": "[Instructions] 1) Mix all dry ingredients together using a large whisk. | 2) Mix the wet ingredients together. | 3) Gently combine but don't overmix. | 4) Cook as your waffle maker directs. | 5) Sprinkle with powdered sugar (my daughter). | 6) Cover with toasted nuts, bananas, and real maple syrup (Me!). | 7) Pour on log Cabin (my son) and Michele's Maple Cream Syrup for my husband!", "tags": ["kid friendly", "30 mins", "beginner cook", "easy"], "cook_time_min": 10, "servings": null, "cuisine": ["All"], "rating_avg": 4.74, "rating_count": 200, "popularity_score": 4.737809523809524, "nutrition_calories": 345.3, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/11/06/83/RbXLgEiQHnLAeaD2f3wb_Waffles%20SITE-2.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["kid friendly", "30 mins", "beginner cook", "easy"], "ingredients": []}, {"recipe_id": "rec_417", "props": {"title": "Basic Pancake Mix", "instructions": "[Instructions] 1) In a bowl, mix together all the dry ingredients. | 2) Make a well in the centre and pour in the milk. | 3) Start with 1 1/4 cups milk, adding up to another 1/4 cup if necessary, as you mix it with the flour. | 4) Add the two eggs, vanilla if using and oil, whisking until mixed but still a bit lumpy. | 5) Heat a frying pan (if it is not non-stick, you will need to melt a bit of butter or oil in it) and when hot, pour in some pancake mix. | 6) How much depends on how experienced you are at flipping pancakes and how big you want them. We do about 1/4 cup a time for small, easy-to-flip pancakes but you could make this as much as 1/2 cup of pancake mix. | 7) If you are adding fruit, I like to sprinkle it on top of the pancake now. | 8) When the pancake starts to bubble on top and is golden brown on the cooked side, turn it and continue cooking until both sides are golden brown. | 9) The first pancake is always a bit of a test so adjust the batter by adding more flour if you need to make it thicker or more milk if you want a thinner pancake. In either case, just add a few spoonfuls at a time until you get it right. | 10) Repeat the cooking process with the remaining batter. You may need to adjust the heat as pan tends to get hotter as you keep making pancakes. | 11) Keep the cooked pancakes covered with a tea towel, to keep them warm while you finish cooking the rest.", "tags": ["breakfast", "grains", "30 mins", "stove top", "easy"], "cook_time_min": 15, "servings": null, "cuisine": ["All"], "rating_avg": 4.7, "rating_count": 336, "popularity_score": 4.699826589595376, "nutrition_calories": 454.4, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/48/63/5/hQThWlKpROi0fltE5p1r_0S9A8686.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["breakfast", "grains", "30 mins", "stove top", "easy"], "ingredients": []}, {"recipe_id": "rec_418", "props": {"title": "Bavarian Pancakes", "instructions": "[Instructions] 1) Mix all ingredients; don't over beat. Mix may have some lumps. | 2) Heat skillet and melt butter. | 3) Pour about 1/2 cup mix in circle into skillet and fry until bubbly. | 4) Turn over and fry until light brown. | 5) Top with syrup, powdered sugar, apple sauce, nuts, chocolate chips, whipped cream or any such ingredient and roll up. | 6) Eat in a roll.", "tags": ["german", "european", "brunch", "30 mins", "easy"], "cook_time_min": 15, "servings": null, "cuisine": ["All"], "rating_avg": 4.86, "rating_count": 14, "popularity_score": 4.7908333333333335, "nutrition_calories": 202.3, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/18/99/30/LjuLxLCmQBeNuJA7ytWw_bavarian%20pancakes%20SITE-2.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["german", "european", "brunch", "30 mins", "easy"], "ingredients": []}, {"recipe_id": "rec_419", "props": {"title": "Belgian Waffles", "instructions": "[Instructions] 1) Combine the flour, baking powder, confectioners sugar, oil, milk and egg yolks. | 2) Beat the egg whites and salt until they stand in soft peaks, mix in the vanilla at this time and fold into the batter (do not over mix). | 3) Pour 1/8 of the mixture into a hot waffle iron and bake for about 2 minutes. | 4) Repeat with the remaining batter. | 5) Top with your favorite fruit and whipped cream and serve hot.", "tags": ["fruit", "healthy", "kid friendly", "30 mins", "stove top", "easy"], "cook_time_min": 20, "servings": null, "cuisine": ["All"], "rating_avg": 4.53, "rating_count": 98, "popularity_score": 4.545185185185185, "nutrition_calories": 206.0, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/28/50/1/zZAaHjlSTRiZbSC80nav_0S9A5119.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["fruit", "healthy", "kid friendly", "30 mins", "stove top", "easy"], "ingredients": []}, {"recipe_id": "rec_420", "props": {"title": "Best Ever Pancake/Waffle Batter", "instructions": "[Instructions] 1) Mix wet ingredients into dry, let sit for a minute or two and gently mix again. | 2) Fry on lightly greased griddle or in waffle maker. | 3) Serve with Maple Syrup.", "tags": ["high in", "30 mins", "easy"], "cook_time_min": 20, "servings": null, "cuisine": ["All"], "rating_avg": 4.0, "rating_count": 4, "popularity_score": 4.4957142857142856, "nutrition_calories": 227.4, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/40/66/74/WYvCmaT3CJpOIYAM5YPA-image.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["high in", "30 mins", "easy"], "ingredients": []}, {"recipe_id": "rec_421", "props": {"title": "Buttermilk Pancakes", "instructions": "[Instructions] 1) Place sifter into a medium sized bowl. Sift flour, sugar, baking powder, and salt. | 2) Combine the eggs, buttermilk, and melted butter in another bowl (I use a large liquid measure). | 3) Add wet ingredients into dry ingredients and whisk together until combined. | 4) For each pancake pour 1/3 cup batter (for a pretty large pancake) into a preheated skillet on medium heat that has been melted with butter or sprayed with non-stick spray. Once bubbles start to form and pop in the middle, flip the pancake and brown on the second side. | 5) Serve with your choice of topping. We like homemade syrup, or jam with sour cream and vanilla yogurt.", "tags": ["easy"], "cook_time_min": 10, "servings": null, "cuisine": ["All"], "rating_avg": 5.0, "rating_count": 3, "popularity_score": 4.764615384615385, "nutrition_calories": 191.2, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/41/41/50/picHiS7oz.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["easy"], "ingredients": []}, {"recipe_id": "rec_422", "props": {"title": "Cake Batter Pancakes", "instructions": "[Instructions] 1) In a large bowl, whisk to combine powdered sugar, 3 tablespoons milk, and 1 teaspoon vanilla. Set aside. Add additional milk as necessary to reach a pourable consistency. | 2) In a large bowl, mix to combine cake mix, bisquick, and sprinkles. | 3) Add remaining 1 \u00bd cups milk, eggs, and remaining 1 \u00bd teaspoons vanilla. If desired, add rainbow confetti sprinkles. Mix until smooth. | 4) Preheat a nonstick skillet or griddle over medium heat and spray with nonstick cooking spray. | 5) Make 8 cake \u201clayers\u201d, pouring two each of the following measurements onto the griddle, in batches as necessary: \u00be cup, \u00bd cup, \u00bc cup, and 2 tablespoons. | 6) Cook, flipping once, until pancakes are golden and cooked through, removing pancakes to a baking sheet or plate as they finish cooking. | 7) Stack layers, largest to smallest, on a cake stand or serving platter. Drizzle with reserved glaze and top with sprinkles. | 8) Cut into wedges and serve, passing any additional glaze on the side.", "tags": ["dessert", "birthday", "30 mins"], "cook_time_min": 5, "servings": null, "cuisine": ["All"], "rating_avg": null, "rating_count": 0, "popularity_score": null, "nutrition_calories": 616.9, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/53/03/37/8zYScQGqn9kTe5dx4pg9_Next%20Level%20Birthday%20Cake%20Pancakes%2016x9.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["dessert", "birthday", "30 mins"], "ingredients": []}, {"recipe_id": "rec_423", "props": {"title": "Chicken and Waffles", "instructions": "[Instructions] 1) CHICKEN SCHNITZEL:. | 2) Season the chicken cutlet with salt and pepper. Combine flour, 1/2 tsp salt, 1/2 tsp pepper and paprika in a large, shallow dish. In a second dish, whisk milk and egg together. Place panko in a third dish. Dredge chicken in flour, then egg mixture, and finally panko. Heat oil in a deep saucepan to 350 degrees. Fry chicken schnitzel for about 4 to 6 minutes until cooked through and crispy. Drain excess oil on paper towels. | 3) WAFFLE:. | 4) Whisk together dry ingredients in a large bowl. Combine eggs and buttermilk in a small bowl. Add to dry ingredients. Whisk in melted butter, combining completely. Follow waffle iron instructions to make 3 waffles. | 5) SWEET CRANBERRY APPLE SLAW:. | 6) Add all ingredients to a medium bowl. Toss to combine. | 7) FOR THE ASSEMBLY:. | 8) Brush the waffles with melted butter. Cut chicken schnitzel into 3 pieces. Place one piece of the schnitzel on the waffle, top with sweet cranberry apple slaw. Drizzle with syrup.", "tags": ["30 mins"], "cook_time_min": 15, "servings": null, "cuisine": ["All"], "rating_avg": null, "rating_count": 0, "popularity_score": null, "nutrition_calories": 3056.0, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/53/56/09/BIOPN9PgT9ec5BbZOW7t_0S9A5636.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["30 mins"], "ingredients": []}, {"recipe_id": "rec_424", "props": {"title": "Chicken Parmesan Waffle Sandwich", "instructions": "[Instructions] 1) Waffle Instructions:. | 2) Heat up waffle iron. | 3) Combine all dry ingredients (flour, baking soda and spices) in one bowl and all wet ingredients (eggs, buttermilk and melted butter) in another bowl and mix well. | 4) Slowly add wet ingredients mix to dry bowl and whisk well. | 5) Shred and add the parmesan cheese and mix well. | 6) Pour batter on waffle iron to create your savory waffles. | 7) Fried Chicken Instructions:. | 8) Combine flour with all the spices in one bowl and combine buttermilk (with salt and pepper) and the chicken thigh into a seperate bowl. | 9) Let the buttermilk and chicken marinade for at least 30 minutes. | 10) Once finished marinating, shake the excess buttermilk off the chicken and dredge in seasoned flour. | 11) Add an inch of canola oil in a frying pan and heat to 350 degrees fahrenheit. | 12) Cook the chicken 7-8 minutes per each side (internal temperature 165 degrees farenheit. | 13) Sandwich Assembly Instructions:. | 14) Take fried chicken thigh and spread marinara sauce on top. | 15) Add shredded mozzarella and shredded parmesan. | 16) Turn broiler on and melt the cheeses on top of the chicken. | 17) Assemble the waffle sandwich, placing the chicken on top of one waffle, some fresh basil and the second waffle.", "tags": ["60 mins"], "cook_time_min": 30, "servings": null, "cuisine": ["All"], "rating_avg": null, "rating_count": 0, "popularity_score": null, "nutrition_calories": 5940.6, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/53/65/87/uQWKFurTGmQ8ogaGZyPg_0S9A9588.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["60 mins"], "ingredients": []}, {"recipe_id": "rec_425", "props": {"title": "Copy-Cat Hoito Finnish Pancakes", "instructions": "[Instructions] 1) Combine and whisk all ingredients until smooth. | 2) Let the batter rest for 30 minutes (or sit in fridge overnight). | 3) Heat non-stick or lightly greased pan to medium. | 4) Pour in a thin layer of the batter just so it covers the bottom. | 5) Once it is golden brown on one side, flip and cook the other. | 6) Serve with maple syrup, butter, fruit, or jam.", "tags": ["30 mins", "stove top", "inexpensive"], "cook_time_min": 20, "servings": null, "cuisine": ["All"], "rating_avg": 4.83, "rating_count": 16, "popularity_score": 4.777692307692307, "nutrition_calories": 407.9, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/43/07/77/hAGfVggGSSuKjsqJdcrn_hoito pancakes FULLSIZE-1.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["30 mins", "stove top", "inexpensive"], "ingredients": []}, {"recipe_id": "rec_426", "props": {"title": "Cornmeal Pancakes", "instructions": "[Instructions] 1) In a large bowl, combine the flour, cornmeal, sugar, baking powder and salt. In another bowl, whisk the eggs, milk and oil; stir into dry ingredients just until moistened. | 2) Pour batter by 1/4 cupfuls onto a lightly greased hot griddle. Turn when bubbles form on top; cook until the second side is golden brown. Serve with syrup. Yield: 4 servings.", "tags": ["breads", "breakfast", "30 mins", "easy"], "cook_time_min": 5, "servings": null, "cuisine": ["All"], "rating_avg": 4.86, "rating_count": 15, "popularity_score": 4.7936, "nutrition_calories": 460.2, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/39/52/75/gXt8oaGQOGQbjH1VSa7E_0S9A9661.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["breads", "breakfast", "30 mins", "easy"], "ingredients": []}, {"recipe_id": "rec_427", "props": {"title": "Cranberry Orange Pancakes", "instructions": "[Instructions] 1) In a small bowl, mix cranberries, sugar & zest & set aside. | 2) In large bowl, mix flour, baking powder, baking soda & salt. | 3) In another small bowl, mix egg, buttermilk, OJ & butter, then add this mixture to flour mixture, stirring until just combined [batter should be lumpy]. | 4) Fold cranberry mixture into the other mixed ingredients. | 5) Heat a lightly greastd griddle or heavy skillet over medium heat. | 6) Pour about 1/4 cup batter onto hot griddle for each pancake. | 7) Cook pancakes until golden brown, then turn to cook other side. | 8) Serve hot!", "tags": ["oranges", "berries", "citrus", "fruit", "healthy", "30 mins"], "cook_time_min": 20, "servings": null, "cuisine": ["All"], "rating_avg": 4.92, "rating_count": 25, "popularity_score": 4.855428571428571, "nutrition_calories": 296.9, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/30/43/19/osNizfEaTI6NGhWtjeLr_0S9A9161.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["oranges", "berries", "citrus", "fruit", "healthy", "30 mins"], "ingredients": []}, {"recipe_id": "rec_428", "props": {"title": "Family Favorite Oatmeal Pancakes", "instructions": "[Instructions] 1) Pour milk over oats and let stand 2-5 minutes. | 2) Beat in eggs, oil, then remaining ingredients. | 3) Mixture will be thin. | 4) Fry on hot griddle. | 5) Serve with honey butter (equal parts of honey and butter beaten until smooth), or favorite topping.", "tags": ["15 mins"], "cook_time_min": 2, "servings": null, "cuisine": ["All"], "rating_avg": 4.53, "rating_count": 116, "popularity_score": 4.5430158730158725, "nutrition_calories": 92.1, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/52/99/9/va1xzK2ZQzK2gTDKkmwK_036%20oatmeal%20pancakes.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["15 mins"], "ingredients": []}, {"recipe_id": "rec_429", "props": {"title": "Flourless Banana Bread Pancakes", "instructions": "[Instructions] 1) In a small bowl, peel, break, and then mash the banana until creamy. | 2) In a small bowl, whisk the eggs until combined. Add Vanilla and 1-oz walnuts, whisk to combine. Add egg mixture to banana and whisk to combine. | 3) Spray a non-stick skillet with cooking spray. Set stovetop to medium high. Pour half the mixture and cook for one minute on each side. Repeat for second pancake. | 4) Spread Almond butter on top of each pancake, add remaining walnuts to both, roll up and serve.", "tags": ["15 mins"], "cook_time_min": 5, "servings": null, "cuisine": ["All"], "rating_avg": null, "rating_count": 0, "popularity_score": null, "nutrition_calories": 311.2, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/submissions/recipe/33186/vfnUpPsuTxadz3OlYK1Z_BBP_4x3-1.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["15 mins"], "ingredients": []}, {"recipe_id": "rec_430", "props": {"title": "Fluffy Eggless Pancakes", "instructions": "[Instructions] 1) Combine dry ingredients and mix slightly. | 2) Add milk, oil, water, and vanilla. Whisk together until just combined. Be careful not to over mix - it should still be slightly lumpy. Set aside to rest for a few minutes. | 3) Melt the butter. When fully melted, add the butter to the batter. | 4) Take pan to stove and stir butter into batter. | 5) When pan is hot, with a measuring cup or ladle, pour 1/4 cup of batter into the skillet for each pancake. | 6) Cook until bubbles form on the surface. Carefully flip pancakes with turner/spatula and cook until golden brown. | 7) Note: This recipe also works well with whole wheat flour. Chopped fruit, nuts or chocolate chips can be added to batter before cooking for a unique treat.", "tags": ["grains", "egg free", "free of", "high in", "30 mins", "15 mins", "easy"], "cook_time_min": 10, "servings": null, "cuisine": ["All"], "rating_avg": 4.0, "rating_count": 57, "popularity_score": 4.103582089552239, "nutrition_calories": 120.9, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/25/02/12/BLADdchMQOOtZjpOeCVY_20190226_203136.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["grains", "egg free", "free of", "high in", "30 mins", "15 mins", "easy"], "ingredients": []}, {"recipe_id": "rec_431", "props": {"title": "Fluffy Pumpkin Spice Pancakes from Scratch", "instructions": "[Instructions] 1) In a large bowl add the flour, spices and baking powder. Use a whisk to airate it and get lots of air inches. | 2) In a seperate bowl, beat the eggs with a beater until foamy - about 3 minutes. Add the yoghurt, milk, pumpkin, vanilla, sugar, and brown sugar. Beat to mix well. | 3) Pour the egg mix into the flour mix and gently fold to combine. | 4) Spoon 1/4 of a cup on to a buttered hot pan and cook over a medium heat. | 5) Let each side cook for about 3 minutes.", "tags": ["pumpkin", "vegetable", "healthy", "30 mins", "from scratch"], "cook_time_min": 20, "servings": null, "cuisine": ["All"], "rating_avg": 5.0, "rating_count": 4, "popularity_score": 4.781428571428571, "nutrition_calories": 369.8, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/46/13/58/picYZmN2t.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["pumpkin", "vegetable", "healthy", "30 mins", "from scratch"], "ingredients": []}, {"recipe_id": "rec_432", "props": {"title": "Fresh Sausage Waffles", "instructions": "[Instructions] 1) In skillet,on medium heat brown the sausage. | 2) Drain fat well,on paper towels. | 3) In a medium mixing bowl,mix the milk,eggs and butter. | 4) Mix well. | 5) Combine the dry ingredients,add to egg mixture,combining well. | 6) Pour half of the batter in a hot,light oiled,waffle iror. | 7) Sprinkle half the sausage over batter. | 8) Cook apprx. | 9) 5 minutes,or until done. | 10) Repeat with remaining batter.", "tags": ["pork", "meat", "30 mins"], "cook_time_min": 15, "servings": null, "cuisine": ["All"], "rating_avg": 4.0, "rating_count": 1, "popularity_score": 4.63090909090909, "nutrition_calories": 236.8, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/33/85/7/6vCEVsETRs25QE7OlXBG_SW%203%20-%20final_1.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["pork", "meat", "30 mins"], "ingredients": []}, {"recipe_id": "rec_433", "props": {"title": "German Pancake", "instructions": "[Instructions] 1) Preheat oven to 400 degrees. | 2) Place butter in 9x13 baking dish and place in oven to melt butter,tilt to coat bottom of pan. | 3) Place remaining ingredients in blender jar,blend until smooth. | 4) Pour into buttered baking dish. | 5) Bake for 20 minutes or until golden. | 6) Sprinkle with powdered sugar,cut into squares,serve warm. | 7) Serve with favorite syrup.", "tags": ["german", "european", "30 mins", "easy"], "cook_time_min": 20, "servings": null, "cuisine": ["All"], "rating_avg": 4.61, "rating_count": 48, "popularity_score": 4.62448275862069, "nutrition_calories": 207.3, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/16/65/9/5HRmeWyfSgKojaDqFk9L_0S9A0114.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["german", "european", "30 mins", "easy"], "ingredients": []}, {"recipe_id": "rec_434", "props": {"title": "German-Style Crisp Potato Pancakes", "instructions": "[Instructions] 1) In a large bowl combine the mashed potatoes with the lemon juice and stir well. | 2) In a dry bowl, combine the onion, caraway seeds, fresh parsley, flour, egg and milk. | 3) Stir in potatoes. Season to taste with salt and freshly ground pepper. | 4) Over medium heat, melt 2 to 3 tablespoons of butter in a wide frying pan. | 5) When butter starts to foam add about 2 tablespoons of the potato mixture, spreading into a 4 inch pancake. Repeat to make 2 or 3 more cakes, enough to fill the pan but not overcrowd. | 6) Cook, turn once, until golden brown on both sides about 5 minutes per side. Add more butter as needed to fry pancakes. | 7) Using a wide spatula, lift pancakes from pan and transfer to warming tray in low oven at 200 degrees. Continue cooking remainder of potato mixture. | 8) Keep warm until ready to serve. Garnish with fresh parsley and top with sour cream if desired.", "tags": ["potato", "vegetable", "german", "european", "low protein", "30 mins", "easy", "inexpensive"], "cook_time_min": 15, "servings": null, "cuisine": ["All"], "rating_avg": 4.92, "rating_count": 26, "popularity_score": 4.857222222222222, "nutrition_calories": 425.4, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/12/53/05/01466460896.jpeg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["potato", "vegetable", "german", "european", "low protein", "30 mins", "easy", "inexpensive"], "ingredients": []}, {"recipe_id": "rec_435", "props": {"title": "Gingerbread Waffles", "instructions": "[Instructions] 1) Heat waffle iron and spray with cooking spray. | 2) In a mixing bowl, sift together flour, brown sugar, baking powder, baking soda, ginger, cinnamon, cloves, nutmeg, and salt. | 3) In another mixing bowl, combine eggs, buttermilk, and molasses. Beat in melted butter. | 4) Add dry ingredients with wet ingredients just until moistened and lump free. | 5) Pour enough batter to fill two-thirds of the waffle iron. | 6) Cook until crisp and golden brown. | 7) Set aside. | 8) Repeat with remaining batter, spraying with cooking spray as needed.", "tags": ["healthy", "high in", "christmas", "60 mins"], "cook_time_min": 20, "servings": null, "cuisine": ["All"], "rating_avg": 4.96, "rating_count": 25, "popularity_score": 4.884, "nutrition_calories": 314.1, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/10/60/15/picpzmui0.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["healthy", "high in", "christmas", "60 mins"], "ingredients": []}, {"recipe_id": "rec_436", "props": {"title": "Granny's Pancakes", "instructions": "[Instructions] 1) Sift flour,baking powder, salt and sugar in a large bowl. | 2) Mix in milk, egg, melted butter and vanilla until smooth. | 3) Heat lightly oiled griddle over medium high heat. | 4) Pour about 1/4 cup for each pancake. | 5) Brown on both sides. | 6) (I brush melted butter on each pancake as I add them to the stacks.).", "tags": ["grains", "high in", "30 mins", "stove top", "easy"], "cook_time_min": 15, "servings": null, "cuisine": ["All"], "rating_avg": 4.92, "rating_count": 27, "popularity_score": 4.858918918918919, "nutrition_calories": 337.4, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/51/05/8/qevHbo1aQHuFLKJOQA51_granny pancakes SITE-1.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["grains", "high in", "30 mins", "stove top", "easy"], "ingredients": []}, {"recipe_id": "rec_437", "props": {"title": "Healthy Cocoa Chocolate Chip Banana Pancakes", "instructions": "[Instructions] 1) In a small bowl whisk milk, egg whites, vanilla, and banana. | 2) In large bowl, mix flours, cocoa powder, sugar, flax seed, baking soda and salt. | 3) Add wet mixture to dry, and whisk just until dry ingredients are moistened, folding in chocolate chips. | 4) Pour pancakes onto greased griddle (at about 350-375\u00b0F) and let sit until lightly bubbling and edges have began to firm. Flip and cook until firm and browned. Top with jam or a sweet sauce. | 5) FREEZING INSTRUCTIONS: If you make these to freeze them, don't make the topping. Cool the pancakes on a wire rack, and then when they are completely cool, wrap them in tinfoil (I wrap them in packs of two for 1 serving) and freeze. Microwave until warm, then toast to unfreeze them.", "tags": ["dessert", "tropical fruits", "fruit", "low cholesterol", "egg free", "toddler friendly", "healthy", "kid friendly", "free of", "sweet", "brunch", "60 mins"], "cook_time_min": 15, "servings": null, "cuisine": ["All"], "rating_avg": 4.5, "rating_count": 8, "popularity_score": 4.607777777777778, "nutrition_calories": 190.1, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/36/01/28/3pq0Z6yvRGmvz2io4Cgf_nalesnik.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["dessert", "tropical fruits", "fruit", "low cholesterol", "egg free", "toddler friendly", "healthy", "kid friendly", "free of", "sweet", "brunch", "60 mins"], "ingredients": []}, {"recipe_id": "rec_438", "props": {"title": "Hedgehog Crepe Cake", "instructions": "[Instructions] 1) Before you begin, you will want to gather a few supplies: candy thermometer, pink and blue icing gel, 2 piping bags, large round piping tip, small round piping tip, wax paper, pastry brush, offset spatula, toothpicks, and a sprinkle mix (if using) to decorate the top of the cake. . | 2) In a high speed blender combine the eggs, milk, and vanilla, and blend until foamy. Add the sugar, flour, and salt, and blend just until combined (with no visible lumps). | 3) Transfer to a medium sized bowl, cover and refrigerate for at least 2 hours or overnight. | 4) You can make the marshmallows while the crepe batter rests! Begin by combining the marshmallow coating powder ingredients in an airtight container. Set aside. | 5) Line a baking tray with wax paper and sift the coating powder over the top. Fit 2 piping bags with the round piping tips. Set aside. | 6) In the bowl of a stand mixer, add 1/3 cup cold water, sprinkle the unflavored gelatin on top, and stir to combine. Allow the gelatin to bloom while heating the sugar mixture. | 7) Add the sugar, corn syrup, 1/4 cup cold water, and salt to a medium sized saucepan. Cook on medium heat, stirring until the sugar dissolves then add the candy thermometer, and raise the heat to high. Cook on high (without stirring) until the temperature reaches 240\u00b0F. | 8) With the mixer on low speed, VERY carefully and slowly pour the hot sugar into the softened gelatin. Gradually increase the speed to high, and continue to whip until soft peaks form and hold their shape (about 8-10 minutes). | 9) Add the vanilla extract and mix again just until combined. Transfer the marshmallow to the prepared piping bags. | 10) Use the bag fitted with the large round piping tip to first pipe an oval shape onto the wax paper pulling and releasing into a point for the hedgehog's nose. You can use water to smooth any lumps or peaks. Just dip a clean finger into a bowl with a little water and smooth the marshmallow. Try to work fairly quickly as the marshmallow starts to set fast (I like to make 3 hedgehogs at a time). | 11) Once you have 3 bodies piped you can sprinkle on any color of jimmies, that you'd like, for the spines. Then use the piping bag fitted with the small round tip to pipe an ear onto each side of the face. I like to use a little water to flatten and mold it a bit into the right shape. Allow the marshmallow to set for at least 7 hours or overnight before handling. Once set you can use the coating powder to dust any sticky spots. . | 12) When the crepe batter is ready divide it evenly into 3 bowls. Use toothpicks to color each as vivid or softly as you would like with the icing gels, combining the pink and blue gels to make purple. . | 13) Heat a large nonstick skillet, or crepe press, over medium-low heat. Lightly brush with the melted butter, and scoop about 1/3 cup of the crepe batter onto the middle of the skillet or press. | 14) Swirl the batter around the pan to evenly coat the bottom (or follow the crepe press instructions). Cook until the bottom of the crepe feels set \u2013 about 1-2 minutes. Then use chopsticks or a spatula to very carefully lift and flip the crepe. Cook for 45 seconds to 1 minute more until set. You will want to add a little more butter between every crepe to keep them from sticking. If the crepes are spreading too thin or tearing lower the heat and cook a little longer. Make about 6-7 crepes in each color, working with one color at a time. . | 15) Once all crepes are cooked transfer them to the refrigerator to cool while working on the filling. | 16) Place your mixing bowl and whisk attachment in the freezer for 15 minutes. Once they are fully chilled add all the heavy cream, sugar and vanilla to the mixing bowl, and mix on low slowly working your way up to high speed (so it doesn\u2019t splatter). Then continue to beat for about 5 minutes until the filling is light and fluffy. Crush the Oreos, and fold into the whipped cream (you can reserve some whipped cream without cookies for the top of the cake if you would like). | 17) Time to build the cake! Start with the purple crepes, and place one onto your cake plate or stand. Use an offset spatula to apply a thin layer of the cookies & cream whipped cream on top (leaving a thin border around the edge). Continue to add the crepes, using all of one color at a time, while adding the cream in between each layer working from purple to pink. When you get to the top crepe, cover and refrigerate for at least an hour. | 18) While the cake chills you can finish up those cute hedgehogs :). Melt 1/4 cup chocolate chips and use a toothpick to dot the nose and eyes onto each marshmallow. | 19) When you are ready to serve the cake add the rest of the whipped cream and decorate the top with the hedgehog marshmallows and sprinkles (party hat optional), enjoy!", "tags": ["4 hours"], "cook_time_min": 1, "servings": null, "cuisine": ["All"], "rating_avg": null, "rating_count": 0, "popularity_score": null, "nutrition_calories": 545.2, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/53/91/12/eePChMUqT2mnjzJHdYQe_Hedgehog 16X9 V2.png"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["4 hours"], "ingredients": []}, {"recipe_id": "rec_439", "props": {"title": "Kittencal's German Apple Puff Pancake", "instructions": "[Instructions] 1) Set oven to 400 degrees F. | 2) Spray two 8-inch round cake pans with cooking spray. | 3) Place 2 Tbsp butter in each of the pans. | 4) Place the pans in the oven and bake until the butter has melted; remove from oven. | 5) In a bowl, beat the flour, 1/4 teaspoons baking powder, sugar (if using) salt, milk and eggs until smooth, then allow to stand for 30 minutes. | 6) Arrange the apple slices into the two pans onto the melted butter. | 7) Re-whisk the flour/egg mixture again then divide the batter evenly between pans, over the apple slices. | 8) Mix the sugar and cinnamon; sprinkle over the batter in each pan. | 9) Bake until puffed, and golden brown, about 20-25 minutes.", "tags": ["apple", "fruit", "low protein", "brunch", "60 mins"], "cook_time_min": 20, "servings": null, "cuisine": ["All"], "rating_avg": 4.74, "rating_count": 49, "popularity_score": 4.7322033898305085, "nutrition_calories": 482.2, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/10/52/12/0ovUlhST4Ska8W5wIa4I_0S9A7045.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["apple", "fruit", "low protein", "brunch", "60 mins"], "ingredients": []}, {"recipe_id": "rec_440", "props": {"title": "Lemon Ricotta Pancakes With Warm Blueberry Compote", "instructions": "[Instructions] 1) For the blueberry compote, in a saute pan, combine the blueberries, cornstarch, 1 cup sugar, water, lemon curd, orange juice, and a pinch of salt. Gently cook over medium heat until the blueberries are tender but not broken down, and the mixture simmers and thickens. Remove from the heat; stir in the butter and vanilla. Set aside to cool slightly. | 2) For the pancakes, in a medium bowl, sift the flour, baking powder, salt, and sugar. Stir in lemon zest. Set aside. In a large bowl, mix the egg yolks and the cheese. Fold in the dry ingredients alternately with the milk. In a separate bowl, whip the egg whites until medium-stiff peaks form. Fold into the batter. | 3) To complete the recipe, heat a buttered nonstick skillet or griddle over medium-high heat or to 350\u00baF (water drops on the skillet should skitter or sizzle when hot). For each pancake, pour 1/4 to 1/3 cup batter and cook until bubbles form on top. Turn and cook until the bottom is golden brown and the pancake is cooked through. | 4) To serve, stack three pancakes on each plate with a dollop of the remaining prepared lemon curd between pancakes. Sprinkle with confectioner\u2019s sugar and pour compote over the pancakes.", "tags": ["cheese", "berries", "fruit", "60 mins", "from scratch"], "cook_time_min": 20, "servings": null, "cuisine": ["All"], "rating_avg": 5.0, "rating_count": 8, "popularity_score": 4.83, "nutrition_calories": 510.6, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/49/24/67/x5uRzsSOTcK9M7XpGYAY_lemon-ricotta-pancakes-blueberry-compote-172.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["cheese", "berries", "fruit", "60 mins", "from scratch"], "ingredients": []}, {"recipe_id": "rec_441", "props": {"title": "Low Fat Whole Wheat Banana Pancakes", "instructions": "[Instructions] 1) Combine the sugar, baking powder, cinnamon, cocoa, and salt, sift in the flour (to remove some of the larger pieces particularly in whole wheat flour), and mix. | 2) Mash the bananas. | 3) Add the water, skim milk, vanilla, and egg to the mashed bananas and mix. | 4) Combine the wet and dry ingredients and stir. | 5) Heat the griddle to medium/medium-high, and spray with non-stick cooking spray. | 6) Pour the batter into the griddle. Flip when bubbles appear. Cook until golden brown on both sides.", "tags": ["berries", "tropical fruits", "fruit", "low cholesterol", "healthy", "30 mins"], "cook_time_min": 5, "servings": null, "cuisine": ["All"], "rating_avg": 4.62, "rating_count": 44, "popularity_score": 4.633703703703704, "nutrition_calories": 169.5, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/12/32/43/picQyigcf.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["berries", "tropical fruits", "fruit", "low cholesterol", "healthy", "30 mins"], "ingredients": []}, {"recipe_id": "rec_442", "props": {"title": "Neapolitan Waffles", "instructions": "[Instructions] 1) Preheat waffle iron. | 2) In one bowl, whisk together the flour, sugar, baking powder, baking soda and salt. | 3) In another bowl, whisk together buttermilk, butter and eggs; add flour mixture and mix until just combined. | 4) Divide the batter evenly between three bowls. In one bowl, stir in the vanilla extract. In another bowl, stir in the melted chocolate until thoroughly combined. In the third bowl, stir in the strawberry powder and red food color if using. | 5) Coat the waffle iron with cooking spray. Take a heaping spoonful of the strawberry batter and pour it into a stripe in the waffle iron; use the back of the spoon to spread it into place if needed. Spoon a stripe of the vanilla batter next to the strawberry batter, spreading it into place. Put a stripe of chocolate batter next to the waffle batter. All three lines of batter should be touching each other--also you can pipe in each color using a piping bag. | 6) Close the waffle iron and cook according to manufacturer instructions; epeat the cooking process with the remaining batter. | 7) Serve the waffles with a drizzle of chocolate sauce, a dollop of whipped cream, and fresh strawberries.", "tags": ["60 mins"], "cook_time_min": 25, "servings": null, "cuisine": ["All"], "rating_avg": null, "rating_count": 0, "popularity_score": null, "nutrition_calories": 517.5, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/53/60/16/CLBzCOKrSTJ4GBWpoTwG_5244175_GK_GeniusObsessions_Neapolitan-Waffles_16x9_v1_H.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["60 mins"], "ingredients": []}, {"recipe_id": "rec_443", "props": {"title": "Oatmeal Waffles or Pancakes", "instructions": "[Instructions] 1) Mix well together. | 2) There should be no lumps. | 3) Bake in a waffle iron, or like regular pancakes. | 4) Variation: add 1/2 cup finely chopped apple and 1/2 teaspoon cinnamon.", "tags": ["grains", "healthy", "kid friendly", "15 mins", "easy"], "cook_time_min": 6, "servings": null, "cuisine": ["All"], "rating_avg": 4.48, "rating_count": 61, "popularity_score": 4.510140845070423, "nutrition_calories": 105.8, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/23/22/5/bDrqWavHSnG7MshUgTCT_oatmealwaffles3.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["grains", "healthy", "kid friendly", "15 mins", "easy"], "ingredients": []}, {"recipe_id": "rec_444", "props": {"title": "Pancake Breakfast Tacos", "instructions": "[Instructions] 1) Preheat oven to 200 degrees. | 2) In a medium bowl, whisk to combine Bisquick, milk, and eggs. | 3) Preheat a large nonstick pan or griddle over medium heat. Grease surface with one teaspoon butter. | 4) Add \u2153 cup pancake batter to pan or griddle, and let cook until bubbles form and the underside is golden brown, about 3 minutes. | 5) Flip, and let cook an additional 1-2 minutes. | 6) Remove pancake to a baking sheet, top with a slice of cheese, and transfer to oven to keep warm. | 7) Repeat with remaining batter, replenishing butter as necessary between batches. You should have 6 pancakes. | 8) Wipe out skillet or griddle. Increase heat to medium-high and grease with 1 teaspoon butter. Crack eggs, 1-2 at a time, into skillet, and let cook until whites are set and edges are golden brown, about 3 minutes. | 9) Season with salt and pepper. | 10) Remove to a platter or baking sheet. | 11) Repeat with remaining eggs, replenishing butter as necessary. | 12) Construct breakfast tacos: Divide eggs, chorizo, and sliced scallions among pancakes. Gently fold in half, sprinkle eggs with cayenne pepper, drizzle with maple syrup, and serve immediately.", "tags": ["mexican", "30 mins"], "cook_time_min": 20, "servings": null, "cuisine": ["All"], "rating_avg": null, "rating_count": 0, "popularity_score": null, "nutrition_calories": 582.3, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/53/03/24/e9JjOHngSxOLr0td5JAi_Next%20Level%20Pancake%20Breakfast%20Tacos%2016x9.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["mexican", "30 mins"], "ingredients": []}, {"recipe_id": "rec_445", "props": {"title": "Quick Sourdough Pancakes", "instructions": "[Instructions] 1) mix flour,baking soda, sugar and salt. | 2) add starter,butter.milk and the egg. | 3) Mix well - Some lumps are fine. | 4) let sit for a minute or two while heating your skillet. I use a cast iron skillet lightly oiled. | 5) when pan is hot drop by 1/8 c amounts | 6) cook until bubbles appear and then flip after about 45 seconds they are done. | 7) remove from pan and serve as you like with syrup or fruit.", "tags": ["yeast breads", "breads", "breakfast", "sweet", "15 mins", "easy", "inexpensive"], "cook_time_min": 2, "servings": null, "cuisine": ["All"], "rating_avg": 4.93, "rating_count": 36, "popularity_score": 4.878695652173913, "nutrition_calories": 314.9, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/32/92/55/mWicFuTjQn2fpWqsTeTG_sourdough pancakes SITE-2.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["yeast breads", "breads", "breakfast", "sweet", "15 mins", "easy", "inexpensive"], "ingredients": []}, {"recipe_id": "rec_446", "props": {"title": "Rainbow Pancakes", "instructions": "[Instructions] 1) TO MAKE PANCAKES. | 2) Sift cake flour, salt, and baking powder. | 3) Mix egg, sugar, milk, oil and vanilla extract in a bowl. | 4) Add in sifted flour mixture. | 5) Divide the batter and add food coloring in each, and mix thoroughly. | 6) Lightly oil a non-stick frying pan and set to medium heat. | 7) Scoop or pour in the batter, and cook both sides. | 8) TO MAKE ICING. | 9) Mix store-bought, ready-made icing with milk and water until smooth. | 10) Stack the colored pancakes. | 11) Pour over the icing. | 12) Top with sprinkles.", "tags": ["brunch", "60 mins"], "cook_time_min": 20, "servings": null, "cuisine": ["All"], "rating_avg": null, "rating_count": 0, "popularity_score": null, "nutrition_calories": 923.5, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/52/65/27/GQ15tgR5O1IgyLOkEU4A_Rainbow%20Pancake.JPG"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["brunch", "60 mins"], "ingredients": []}, {"recipe_id": "rec_447", "props": {"title": "Real Swedish Pancakes (Pannkakor)", "instructions": "[Instructions] 1) Mix eggs, flour and salt. | 2) Add the milk, a little at the time, and whisk to a smooth batter. The batter will be very thin (almost like for cr\u00eapes). | 3) In a hot skillet (preferably cast-iron), add one teaspoon butter and just as much batter to cover the bottom (turn the skillet around to spread the batter). Fry the pancakes golden brown on both sides. Add more butter for each new pancake. | 4) Roll or stack them on a serving plate. Keep warm. | 5) Serve hot, preferably with whipped cream and jam. | 6) (Leftovers can be reheated or served cold with the same accessories).", "tags": ["dessert", "swedish", "scandinavian", "european", "30 mins", "easy"], "cook_time_min": 15, "servings": null, "cuisine": ["All"], "rating_avg": 4.7, "rating_count": 52, "popularity_score": 4.699032258064516, "nutrition_calories": 260.9, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/31/04/0/jYY46ZDOTcyLW9aVw8el_Swedish-pancakes-3.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["dessert", "swedish", "scandinavian", "european", "30 mins", "easy"], "ingredients": []}, {"recipe_id": "rec_448", "props": {"title": "Rice Flour Pancakes", "instructions": "[Instructions] 1) Mix rice flour, sugar, baking powder and salt in bowl. Beat in milk until mixture has a smooth consistency. Add the beaten egg and oil and mix until just blended. | 2) Add a little oil to griddle and cook on med heat. Turn only once.", "tags": ["free of", "brunch", "15 mins", "easy"], "cook_time_min": 2, "servings": null, "cuisine": ["All"], "rating_avg": 4.19, "rating_count": 67, "popularity_score": 4.255454545454546, "nutrition_calories": 277.2, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/30/42/33/s8uKej5dSOmUw52a77Nx_IMG_2570.JPG"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["free of", "brunch", "15 mins", "easy"], "ingredients": []}, {"recipe_id": "rec_449", "props": {"title": "Rich Pancakes and Waffles", "instructions": "[Instructions] 1) Seperate eggs and beat whites till fluffy but not dry, set aside. | 2) Mix all dry ingredients together, set aside. | 3) Beat yolks and milk. | 4) Slowly add dry ingredients beat till smooth. | 5) Mix in melted butter. | 6) Do not overbeat. | 7) Fold in egg whites. | 8) Cook over medium heat till golden.", "tags": ["brunch", "30 mins", "beginner cook", "easy", "inexpensive"], "cook_time_min": 10, "servings": null, "cuisine": ["All"], "rating_avg": 5.0, "rating_count": 1, "popularity_score": 4.721818181818181, "nutrition_calories": 367.0, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/gk-static/fdc-new/img/fdc-shareGraphic.png"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["brunch", "30 mins", "beginner cook", "easy", "inexpensive"], "ingredients": []}, {"recipe_id": "rec_450", "props": {"title": "Super Easy Chocolate Pancakes or Waffles", "instructions": "[Instructions] 1) Combine pancake mix, cocoa and sugar in large bowl. Stir in water with wire whisk until large lumps disappear. Add walnuts and chocolate chips, stir until evenly mixed. Let batter rest for five minutes. Cook according to package directions.", "tags": ["30 mins", "for large groups", "easy"], "cook_time_min": 20, "servings": null, "cuisine": ["All"], "rating_avg": 5.0, "rating_count": 2, "popularity_score": 4.745, "nutrition_calories": 42.2, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/gk-static/fdc-new/img/fdc-shareGraphic.png"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["30 mins", "for large groups", "easy"], "ingredients": []}, {"recipe_id": "rec_451", "props": {"title": "Tex-Mex Waffles", "instructions": "[Instructions] 1) Preheat the waffle maker. | 2) In a large bowl, combine the flour, cornmeal, cheese, baking powder, sugar, salt and chili powder. Add the milk, eggs, vegetable oil and chiles, and mix just until moistened. Mixture may be a little lumpy. | 3) Bake in preheated waffle maker according to manufacturer's instructions. Makes 4 to 5 large waffles. | 4) Serve with your favorite salsa, sour cream and additional grated cheese.", "tags": ["high in", "30 mins", "inexpensive"], "cook_time_min": 8, "servings": null, "cuisine": ["All"], "rating_avg": 4.8, "rating_count": 5, "popularity_score": 4.729333333333333, "nutrition_calories": 746.6, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/18/11/02/tGVlsMWaSGavz5y9wikQ_mexican%20waffles.JPG"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["high in", "30 mins", "inexpensive"], "ingredients": []}, {"recipe_id": "rec_452", "props": {"title": "The Perfect Buttermilk Pancakes", "instructions": "[Instructions] 1) Blend the buttermilk, eggs, butter, and vanilla until well combined. | 2) Slowly add the flour, sugar, baking powder, baking soda, and salt. | 3) Continue to blend until the batter is thick and smooth. | 4) Optional: For thinner pancakes - add buttermilk to it out to the consistency you like. For thicker pancakes - add a little more flour to desired thicknessHeat a non-stick frying pan on medium heat and coat it with non-stick spray. | 5) Pour 1/3 cup of the pancake batter onto the pan. Watch for the pancake to form bubbles on the surface and the griddle side of the pancake golden. | 6) Gently but quickly flip the pancake over and cook for 30 seconds or until golden. | 7) Spray non-stick spray between cooking new pancakes. | 8) Serve hot with butter and maple syrup.", "tags": ["30 mins"], "cook_time_min": 10, "servings": null, "cuisine": ["All"], "rating_avg": 5.0, "rating_count": 11, "popularity_score": 4.854285714285714, "nutrition_calories": 260.5, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/49/99/31/jasFNU1YTVuhrfyJULuQ_p.png"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["30 mins"], "ingredients": []}, {"recipe_id": "rec_453", "props": {"title": "Thin Pancakes", "instructions": "[Instructions] 1) Melt the butter and add the eggs and milk. | 2) Mix well. | 3) Add baking powder, flour (and salt). Mix well. | 4) Pour enough out to make a pancake about 3\" across onto a hot, oiled griddle, but the amount you pour out really depends on how big you want the pancakes to be.", "tags": ["15 mins", "for large groups", "stove top"], "cook_time_min": 10, "servings": null, "cuisine": ["All"], "rating_avg": 4.61, "rating_count": 35, "popularity_score": 4.628666666666668, "nutrition_calories": 67.7, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/10/27/3/mp5g35jKQnOsGTDwvOaf_EA2A2E11-6350-44DC-943F-D31E8D8A7FC6.jpeg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["15 mins", "for large groups", "stove top"], "ingredients": []}, {"recipe_id": "rec_454", "props": {"title": "Traditional Swedish Pancakes", "instructions": "[Instructions] 1) In a large mixing bowl, beat the eggs with half the milk. | 2) Beat in flour and salt until smooth. | 3) Stir in melted butter and remaining milk. | 4) Heat a griddle or large skillet with a small amount of vegetable oil. | 5) For each pancake, pour about 1/4 cup batter onto the griddle and cook over medium heat 1 to 2 minutes. | 6) With a spatula, turn the pancakes and cook until golden brown, about 1/2 minute. | 7) Serve immediately or keep warm while making the remaining pancakes.", "tags": ["swedish", "scandinavian", "european", "toddler friendly", "kid friendly", "brunch", "15 mins", "stove top", "easy", "inexpensive"], "cook_time_min": 5, "servings": null, "cuisine": ["All"], "rating_avg": 4.46, "rating_count": 26, "popularity_score": 4.525, "nutrition_calories": 336.2, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/97/29/1/0iYECEfuS8enVHaXUJvb_0S9A0101.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["swedish", "scandinavian", "european", "toddler friendly", "kid friendly", "brunch", "15 mins", "stove top", "easy", "inexpensive"], "ingredients": []}, {"recipe_id": "rec_455", "props": {"title": "Waffles With Fresh Strawberry Syrup - Emeril Lagasse", "instructions": "[Instructions] 1) Preheat a waffle iron according to the manufacturer\u2019s instructions. | 2) Into a medium bowl, sift the flour, baking powder, and salt. | 3) In a separate bowl, beat together the egg yolks and sugar until the sugar is completely dissolved and eggs have turned a pale yellow. Add the milk, melted butter, and vanilla extract and whisk to combine. Add the flour mixture to the egg-milk mixture and whisk just until blended. Do not overmix. | 4) In a third bowl, beat the egg whites with an electric mixer until soft peaks form, about 1 minute. | 5) Using a rubber spatula, gently fold the egg whites into the waffle batter, being careful not to overmix. | 6) Coat the waffle iron with nonstick cooking spray, if required, and pour enough batter in the iron to just cover the waffle grid. Close and cook as per the manufacturer\u2019s instructions until golden brown, 2 to 3 minutes. (Do not open the waffle iron for at least 1 minute.) Repeat with the remaining batter. | 7) Serve immediately with Strawberry Syrup spooned over the top of each waffle. | 8) Fresh Strawberry Syrup: In a medium saucepan, combine all the ingredients and bring to a boil. Lower the heat and simmer until the strawberries are soft and the syrup is thickened and reduced by one-third to one-half in volume, 15 to 18 minutes. | 9) Remove from the heat and let cool to room temperature before serving. (If thinner syrup is desired, strain the hot syrup through a fine mesh strainer into a clean container and let cool.).", "tags": ["strawberry", "berries", "fruit", "healthy", "kid friendly", "brunch", "30 mins"], "cook_time_min": 20, "servings": null, "cuisine": ["All"], "rating_avg": 5.0, "rating_count": 2, "popularity_score": 4.745, "nutrition_calories": 327.7, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/29/99/18/picdfTPft.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["strawberry", "berries", "fruit", "healthy", "kid friendly", "brunch", "30 mins"], "ingredients": []}, {"recipe_id": "rec_456", "props": {"title": "Zucchini Pancakes", "instructions": "[Instructions] 1) Wash and shred zucchini on a fine shredder (DO NOT PEEL). | 2) In a large mixing bowl, beat eggs; add shredded zucchini and mix well using a fork. | 3) Add flour, sugar, salt and olive oil and stir well to blend. | 4) Finally, add baking powder and mix using a spoon (Batter consistency should be like heavy whipping cream). | 5) Preheat griddle to 425- 450\u00b0F. | 6) If using a heavy duty frying pan, heat to medium-high heat; adjust heat if necessary. | 7) Rub grill or frying pan with oil before cooking each batch of pancakes. | 8) Spoon batter onto hot griddle (about 2 tablespoons for each pancake). | 9) Cook until bubbles on the top of the pancake almost stop, about 1 1/2 minutes; turn pancake over and continue to cook for another 1 to 1 1/2 minutes or until pancakes are done. | 10) When done, rub pancakes with melted butter and place in a preheated 250 F oven to keep warm until the remainder are cooked, or serve immediately. | 11) Serve with your choice of jams or syrups. | 12) Also very good with sour cream or yogurt along with your choice of jams or syrups, or you can eat them just plain. | 13) These pancakes are delicious for breakfast, brunch or just as a snack anytime.", "tags": ["grains", "vegetable", "russian", "european", "high in", "brunch", "60 mins", "stove top"], "cook_time_min": 20, "servings": null, "cuisine": ["All"], "rating_avg": 4.84, "rating_count": 63, "popularity_score": 4.819999999999999, "nutrition_calories": 363.0, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/16/70/2/rhsIeILpSPe1VLfj97SS_Zucchini pancakes SITE-3.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["grains", "vegetable", "russian", "european", "high in", "brunch", "60 mins", "stove top"], "ingredients": []}, {"recipe_id": "rec_457", "props": {"title": "3 Ingredient Pumpkin Spice Cupcakes", "instructions": "[Instructions] 1) Preheat oven to 350 degrees. | 2) Combine all ingredients in a large bowl for 2 minutes. Contents will be VERY thick. (Electric mixer may be used.). | 3) Line muffin tin with paper cups. | 4) Fill 2/3 full with batter. | 5) You may add a 1/4 cup of water to make it easier to stir. | 6) Bake 22 to 24 minutes. | 7) Optional: sprinkle tops with cinnamon sugar before placing in oven if you don't use frosting.", "tags": ["low protein", "vegan", "low cholesterol", "healthy", "winter", "thanksgiving", "60 mins", "for large groups", "beginner cook", "easy", "inexpensive"], "cook_time_min": 22, "servings": null, "cuisine": ["All"], "rating_avg": 4.33, "rating_count": 9, "popularity_score": 4.521578947368421, "nutrition_calories": 196.8, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/25/89/70/EcbrqGO9RjaEpQWWoSRd_4%20(1%20of%201).jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["low protein", "vegan", "low cholesterol", "healthy", "winter", "thanksgiving", "60 mins", "for large groups", "beginner cook", "easy", "inexpensive"], "ingredients": []}, {"recipe_id": "rec_458", "props": {"title": "Alessi's Tiramisu", "instructions": "[Instructions] 1) Zabaglione Cream: In the top part of a double boiler, beat eggs and sugar together until the mixture is pale yellow in color. | 2) In the bottom part of the double boiler, bring water to a boil then reduce heat to simmer. | 3) Place egg yolk mixture over water and gradually add Marsala, beating continously. | 4) Scrape bottom and sides of pan occasionally and cook 6 to 10 minutes or until soft mounds can be formed. | 5) Transfer to bowl, cover and refrigerate 30 minutes. | 6) Whip cream with 2 Tbsp. | 7) sugar until soft peaks form. | 8) Fold in Mascarpone and Zabaglione and mix until well blended. | 9) Cover and refrigerate 1 hour. | 10) In a separate bowl, mix espresso, 2 Tbsp. | 11) sugar, Brandy and vanilla. | 12) Arrange cookies on the bottom of a 9\" by 13\" pan. | 13) Carefully spoon about 1 Tbsp. | 14) of the coffee mixture over each cookie so they are well saturated but not falling apart. | 15) Spoon 1/2 cheese mixture over cookies and sprinkle with 1 Tbsp. | 16) cocoa. | 17) Repeat one more time ending with cocoa. | 18) Cover and refrigerate at least 5 hours or overnight so that cookies can soften as they absorb moisture. | 19) Garnish and serve.", "tags": ["european", "60 mins"], "cook_time_min": 30, "servings": null, "cuisine": ["All"], "rating_avg": 4.78, "rating_count": 9, "popularity_score": 4.734736842105264, "nutrition_calories": 197.9, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/72/17/9/N36VSdamRoiaGpi8trDq_0S9A9798.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["european", "60 mins"], "ingredients": []}, {"recipe_id": "rec_459", "props": {"title": "Avocado Nut Bread", "instructions": "[Instructions] 1) Pre-heat oven to 375\u00b0F. | 2) Grease a 9 X 5 inch loaf pan. | 3) Combine dry ingredients. | 4) In a separate bowl, beat together egg and avocado; stir in buttermilk. | 5) Add the wet ingredients to the dry and blend well. | 6) Stir in nuts. | 7) Pour into pan and bake 50 minutes to 1 hour, until an inserted toothpick comes out clean.", "tags": ["breads", "fruit", "vegetable", "nuts", "healthy", "brunch", "60 mins"], "cook_time_min": 50, "servings": null, "cuisine": ["All"], "rating_avg": 4.47, "rating_count": 20, "popularity_score": 4.544666666666666, "nutrition_calories": 231.3, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/12/34/54/TuoWJkBuQyWxDvxZbKON_Avocado%20Nut%20bread%20SITE-1.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["breads", "fruit", "vegetable", "nuts", "healthy", "brunch", "60 mins"], "ingredients": []}, {"recipe_id": "rec_460", "props": {"title": "Awesome Apple Bread", "instructions": "[Instructions] 1) Combine and set aside the oil, eggs, sugar, and vanilla. | 2) Sift flour, cinnamon, soda, and salt. Add dry ingredients to oil mixture gradually. | 3) Add apples and nuts. | 4) Bake in 2 regular loaf pans or 3 foil loaf pans for 1 1/2 hours at 300 degrees. | 5) Cool 10 minutes in the pan. | 6) Sprinkle with sugar, if desired. | 7) Note: I bake it at 325 degrees for about 70 minutes.", "tags": ["breads", "apple", "fruit", "oven", "4 hours"], "cook_time_min": 2, "servings": null, "cuisine": ["All"], "rating_avg": 4.9, "rating_count": 50, "popularity_score": 4.865666666666668, "nutrition_calories": 2634.1, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/64/7/ZsjcWILS468aWD0Ku4uq_DSC_5969.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["breads", "apple", "fruit", "oven", "4 hours"], "ingredients": []}, {"recipe_id": "rec_461", "props": {"title": "Banana Bread Brownies", "instructions": "[Instructions] 1) Heat oven to 375\u00b0F Grease and flour 15x10-inch jelly roll pan. For the bars, in a large bowl, beat together sugar, sour cream, butter, and eggs until creamy. Blend in bananas and vanilla extract. Add flour, baking soda, salt, and blend for 1 minute. Stir in walnuts. | 2) Spread batter evenly into pan. Bake 20 to 25 minutes or until golden brown. | 3) Meanwhile, for frosting, heat butter in a large saucepan over medium heat until boiling. Let the butter turn a delicate brown and remove from heat immediately. | 4) Add powdered sugar, vanilla extract and milk. Whisk together until smooth (it should be thicker than a glaze but thinner than frosting). Using a spatula, spread the brown butter frosting over the warm bars (the frosting will be easier to spread while the bars are still warm).", "tags": ["fruit", "low protein", "60 mins", "for large groups", "from scratch"], "cook_time_min": 20, "servings": null, "cuisine": ["All"], "rating_avg": 4.79, "rating_count": 31, "popularity_score": 4.7665853658536586, "nutrition_calories": 436.0, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/50/71/76/hs2ejdAZTvebR7Q79qoF_Banana%20Bread%20Brownies_final%203.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["fruit", "low protein", "60 mins", "for large groups", "from scratch"], "ingredients": []}, {"recipe_id": "rec_462", "props": {"title": "Barefoot Contessa's Carrot Cake Cupcakes", "instructions": "[Instructions] 1) Preheat the oven to 350\u00b0F | 2) Beat the sugar, oil, and vanilla together in the bowl of an electric mixer fitted with a paddle attachment. | 3) Add the eggs, 1 at a time. | 4) In another bowl, sift together the flour, cinnamon, baking soda, and salt. | 5) With the mixer on low speed, add 1/2 of the dry ingredients to the wet ingredients. | 6) Add the grated carrots, raisins, and walnuts to the remaining flour, mix well, and add to the batter. | 7) Mix until just combined. | 8) Line muffin pans with paper liners. | 9) Scoop the batter into 22 muffin cups until each is 3/4 full. | 10) Bake at 400\u00b0F for 10 minutes then reduce oven temperature to 350\u00b0F and cook for a further 35 minutes (**see note at bottom), until a toothpick comes out clean. | 11) Cool on a rack. | 12) Frosting:. | 13) Cream the cream cheese, butter, and vanilla in the bowl of an electric mixer fitted with a paddle attachment. | 14) Add the sugar and beat until smooth. | 15) When the cupcakes are cool, frost them generously and serve. | 16) **I don't need to cook these for the entire additional 35 minutes. After I lower the temperature to 350\u00b0F; I start checking the muffins at around 15 minutes. Just keep watching them until a toothpick inserted in center comes out clean.", "tags": ["vegetable", "4 hours"], "cook_time_min": 45, "servings": null, "cuisine": ["All"], "rating_avg": 4.23, "rating_count": 25, "popularity_score": 4.362571428571429, "nutrition_calories": 509.9, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/20/84/86/UjR0LoneQJKKH50bz9n7_food.com-55.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["vegetable", "4 hours"], "ingredients": []}, {"recipe_id": "rec_463", "props": {"title": "Best Banana Bread", "instructions": "[Instructions] 1) Remove odd pots and pans from oven. | 2) Preheat oven to 350\u00ba / 180\u00ba. | 3) Cream together butter and sugar. | 4) Add eggs and crushed bananas. | 5) Combine well. | 6) Sift together flour, soda and salt. Add to creamed mixture. Add vanilla. | 7) Mix just until combined. Do not overmix. | 8) Pour into greased and floured loaf pan. | 9) Bake at 350\u00ba / 180\u00ba for 55 minutes. | 10) Keeps well, refrigerated.", "tags": ["breads", "fruit", "oven", "4 hours"], "cook_time_min": 1, "servings": null, "cuisine": ["All"], "rating_avg": 4.81, "rating_count": 2346, "popularity_score": 4.809507640067912, "nutrition_calories": 272.8, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/28/86/wBZxNua1T8yfDwbfo9Fz_0S9A9315.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["breads", "fruit", "oven", "4 hours"], "ingredients": []}, {"recipe_id": "rec_464", "props": {"title": "Best Buckeyes (Peanut Butter and Chocolate Candies)", "instructions": "[Instructions] 1) Cream peanut butter and butter. | 2) Add sugar and vanilla and mix well. | 3) Form into 1 inch balls and refrigerate. | 4) Melt chocolate chips with parafin wax in a double boiler. | 5) Dip balls into chocolate with a toothpick about 3/4 of the way covered. | 6) Place chocolate side down on waxed paper. | 7) Let set at room temperature or refrigerate.", "tags": ["dessert", "fruit", "nuts", "kid friendly", "potluck", "christmas", "60 mins", "no cook", "easy"], "cook_time_min": 45, "servings": null, "cuisine": ["All"], "rating_avg": 4.61, "rating_count": 35, "popularity_score": 4.628666666666668, "nutrition_calories": 94.1, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/26/55/5/OAgt1R3jQQmFZXx0bVbk_GQ4A4483.JPG"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["dessert", "fruit", "nuts", "kid friendly", "potluck", "christmas", "60 mins", "no cook", "easy"], "ingredients": []}, {"recipe_id": "rec_465", "props": {"title": "Big Ol Cowboy Cookies", "instructions": "[Instructions] 1) Heat over to 350\u00b0. | 2) Mix flour, baking soda, cinnamon and salt in bowl. | 3) Beat butter on medium speed until smooth and creamy, gradually beat in sugars, beat to combine. | 4) Add eggs one at a time, add vanilla. | 5) Stir in flour mixture until just combined. | 6) Add chocolate chips, oats, coconut and pecans. | 7) For each cookie drop 1/4 cup dough onto ungreased baking sheet (I use a large ice cream scoop). | 8) Bake at 350\u00b0 for 17-19 minutes or until edges are lightly browned. | 9) Cool cookies on rack.", "tags": ["dessert", "cookie and brownie", "weeknight", "4 hours"], "cook_time_min": 1, "servings": null, "cuisine": ["All"], "rating_avg": 5.0, "rating_count": 32, "popularity_score": 4.927142857142857, "nutrition_calories": 341.1, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/72/75/2/qgZvUeiiSu6kEIGPQg4C_25.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["dessert", "cookie and brownie", "weeknight", "4 hours"], "ingredients": []}, {"recipe_id": "rec_466", "props": {"title": "Blackberry Dump Cake", "instructions": "[Instructions] 1) Preheat oven to 350 degrees. | 2) 2 Mix your berries, sugar and cinnamon together and spread in the bottom of a 9\u00d713 pan. | 3) 3 Sprinkle dry cake mix and rolled oats over the top of berry mixture. | 4) 4 Pour melted butter over the cake/oats mix, make sure you cover evenly. (Melted butter will absorb into the dry cake mix. Do not stir! If you use cold butter shavings, scatter over the top of dry cake mix trying to cover evenly). | 5) 5 Bake 30 minutes or until top is golden and berries are bubbling. You can serve this with ice cream, whipped cream or cool whip.", "tags": ["berries", "fruit", "low protein", "sweet", "60 mins", "easy"], "cook_time_min": 30, "servings": null, "cuisine": ["All"], "rating_avg": 5.0, "rating_count": 2, "popularity_score": 4.745, "nutrition_calories": 2422.2, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/44/35/85/q4uski2Squ7GuIOYB6x6_blackberry-dump-cake_1042.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["berries", "fruit", "low protein", "sweet", "60 mins", "easy"], "ingredients": []}, {"recipe_id": "rec_467", "props": {"title": "Blackberry Wine Cake", "instructions": "[Instructions] 1) Preheat the oven to 325 degrees. | 2) Grease and flour a Bundt pan; sprinkle the nuts in the bottom of the pan. | 3) In a large bowl, combine the cake mix and gelatin. | 4) Add the eggs, oil and wine. | 5) At low speed, beat just until moistened. | 6) Increase the speed to medium and beat for 2 more minutes; scrape the bowl frequently. | 7) Pour in the Bundt pan and bake for 45-50 minutes. | 8) Glaze: Bring the 1 c powdered sugar, wine and butter to a boil; the glaze will be fairly thin. | 9) While the cake is still warm and in the Bundt pan, pour half of the glaze on the cake. | 10) Let the cake sit for 30 minutes to absorb the glaze. | 11) Turn the cake out of the pan and completely cool. | 12) Thicken the remaining half of the glaze with additional powdered sugar and pour over the cake. | 13) .", "tags": ["fruit", "nuts", "brunch", "oven", "beginner cook", "4 hours", "easy"], "cook_time_min": 50, "servings": null, "cuisine": ["All"], "rating_avg": 5.0, "rating_count": 10, "popularity_score": 4.847, "nutrition_calories": 591.9, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/16/30/30/4lceCF4dRUaGaHIu4N2g_Blackberrywinecake4.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["fruit", "nuts", "brunch", "oven", "beginner cook", "4 hours", "easy"], "ingredients": []}, {"recipe_id": "rec_468", "props": {"title": "Blow-Your-Mind Banana Pudding", "instructions": "[Instructions] 1) Combine the condensed milk; water and pudding mix in a bowl. | 2) Mix thoroughly and chill in the refrigerator. | 3) Pour heavy whipping cream in a bowl and beat until stiff. | 4) Combine your whipping cream and the pudding mixture together. | 5) Place a layer of Nilla Wafers on the bottom of your dish and then layer your bananas on top of the wafers and then spoon your creamy pudding mixture on top and continue this process until all of your ingredients are gone. | 6) Refrigerate until ready to serve. | 7) ENJOY! | 8) *Ifyou would like you can always place your banana slices in the creamy pudding mixture if you would like and just spoon on top of the wafers*.", "tags": ["kid friendly", "potluck", "30 mins", "no cook", "refrigerator", "easy"], "cook_time_min": 25, "servings": null, "cuisine": ["All"], "rating_avg": 4.75, "rating_count": 29, "popularity_score": 4.7356410256410255, "nutrition_calories": 560.3, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/46/69/0/bRsniXquTqeIww8hqbmA_0S9A1029.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["kid friendly", "potluck", "30 mins", "no cook", "refrigerator", "easy"], "ingredients": []}, {"recipe_id": "rec_469", "props": {"title": "Boston Cream Pie", "instructions": "[Instructions] 1) Heat oven to 350 degrees. Grease and flour two 9\" round cake pans or make it easy on yourself and trace the bottom of the cake pans on a piece of waxed paper and cut to fit then place on bottom of pans. No need to grease; the cakes will fall right out. | 2) For the cake layers: Separate eggs; place whites in a small, clean bowl free of any grease or oil and set aside. In a large mixing bowl, combine cake flour, 3/4 cup of the sugar, baking powder and salt. Set aside. | 3) In a small bowl with an electric mixer, beat egg whites until soft peaks form. Very gradually beat in the remaining 1/4 cup sugar; beat until stiff peaks form. Set aside. | 4) Add egg yolks, oil and 1/2 cup milk to flour mixture. With electric mixer, beat until smooth, scraping sides of bowl occasionally. Add remaining 1/2 cup milk and vanilla. Beat just until combined. Carefully fold beaten egg whites into batter. Divide batter into prepared pans. | 5) Bake cakes 20 to 25 minutes or until centers spring back when gently pressed. Cool in pans on wire rack for 5 minutes. Loosen cake around edges with a sharp knife then turn cakes out onto racks and remove waxed paper, if used; cool completely. (Tip: I make the cake layers in advance, wrap and freeze. Defrost in wrapper for a couple of hours then proceed with the filling and glaze.). | 6) While cake is baking, make cream filling: In a 1-quart saucepan, heat 1 cup milk to boiling. In cup or small bowl, combine remaining 1/2 cup milk, cornstarch, sugar, pinch salt, egg and vanilla until blended. | 7) When milk comes to boiling, gradually stir in cornstarch mixture with wire whisk. Return to boiling, stirring constantly. Reduce heat and simmer 1 minutes or until thickened to pudding consistancy. Set aside to cool to room temperature. | 8) Make chocolate glaze: In 1 quart saucepan, heat water and sugar to boiling. Add chocolate chips; stir until glaze is smooth; remove from heat. Cool 5 to 10 minutes or until slightly thickened. | 9) To assemble, place one cake layer, upside down, on a serving plate. Spread with cream filling. Top with remaining cake layer, right side up. Spoon glaze over top; spread to edges of cake. Refrigerate.", "tags": ["kid friendly", "sweet", "weeknight", "freezer", "4 hours"], "cook_time_min": 25, "servings": null, "cuisine": ["All"], "rating_avg": 4.38, "rating_count": 14, "popularity_score": 4.510833333333333, "nutrition_calories": 470.3, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/40/62/37/QVIYYHbJSA6q9cjxDoEO_BCP%204%20-%20final_1.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["kid friendly", "sweet", "weeknight", "freezer", "4 hours"], "ingredients": []}, {"recipe_id": "rec_470", "props": {"title": "Brazilian Brigadeiro", "instructions": "[Instructions] 1) PREPARE:. | 2) Cook over medium-low heat, stir vigorously the sweetened condensed milk, margarine and cocoa powder. | 3) Cook the mixture until it thickens enough to show the pan bottom during stirring. | 4) Pour the mixture in a greased dish and let it cool to room temperature. Take small amounts of the mixture with a teaspoon and make 1 \u00bd inch balls. | 5) Roll the balls over chocolate jimmies to decorate. | 6) Hint: Grease your hands with margarine to make the balls easily. | 7) If the balls don't hold the shape and flat down like coins, it means that you did not cook enough. Cook additional five minutes, take a small sample and dip it in a glass with cold water. If you cooked enough, this sample should hold the shape after cooling down in the water. | 8) The cheapest, low grade sweetened condensed milk is the best to make the brigadeiro because they have more starch on them, which helps the candy to hold the shape. | 9) In US, buy the sweet condensed milk from the Walmart brand \"Great Value\", cook this brand for 20 minutes in medium heat stirring continuously and your brigadeiro is with the right consistency.", "tags": ["dessert", "brazilian", "south american", "high in", "60 mins", "for large groups", "easy"], "cook_time_min": 25, "servings": null, "cuisine": ["All"], "rating_avg": 5.0, "rating_count": 8, "popularity_score": 4.83, "nutrition_calories": 70.6, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/34/34/01/I6vC42G8SFumbUoPP1eb_0S9A1342.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["dessert", "brazilian", "south american", "high in", "60 mins", "for large groups", "easy"], "ingredients": []}, {"recipe_id": "rec_471", "props": {"title": "Brandy Bread Pudding", "instructions": "[Instructions] 1) Cover raisins with brandy or water. | 2) Set aside. | 3) Melt butter or margarine. | 4) Break up bread, set aside. | 5) Combine brown sugar, cinnamon, allspice. | 6) Reserve 3 tablespoons of this mixture for topping. | 7) Pour melted margarine on before you toss the bread crumbs. Your sugar mixture will stick better that way. | 8) Toss bread with remaining sugar mixture. | 9) Place 1/2 of bread mixture in a lightly greased 1 1/2 quart baking dish. | 10) Drain raisins, place 1/2 raisins over bread crumbs. | 11) Repeat layers. | 12) Combine egg, salt, and vanilla in a bowl. | 13) Beat for 1 minute. | 14) Add milk slowly. | 15) Pour over mix in dish. | 16) Let stand for 5 minutes. | 17) Sprinkle reserved sugar mix on top. | 18) Bake at 325F for 45 to 50 minutes.", "tags": ["winter", "christmas", "thanksgiving", "weeknight", "oven", "4 hours"], "cook_time_min": 45, "servings": null, "cuisine": ["All"], "rating_avg": 4.85, "rating_count": 100, "popularity_score": 4.835818181818181, "nutrition_calories": 377.8, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/16/13/6/pIhdLrhtTDCK4pcTouw9_0S9A9016.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["winter", "christmas", "thanksgiving", "weeknight", "oven", "4 hours"], "ingredients": []}, {"recipe_id": "rec_472", "props": {"title": "Brennan's Bananas Foster", "instructions": "[Instructions] 1) Combine the butter, sugar and cinnamon in a flamb\u00e9 pan or skillet. | 2) Place the pan over low heat either on an alcohol burner or on top of the stove, and cook, stirring, until the sugar dissolves. | 3) Stir in the banana liqueur, then place the bananas in the pan. When the banana sections soften and begin to brown, carefully add the rum. | 4) Continue to cook the sauce until the rum is hot, then tip the pan slightly to ignite the rum, or ignite with a long match. | 5) When the flames subside, lift the bananas out of the pan and place four pieces over each portion of ice cream. | 6) Generously spoon warm sauce over the top of the ice cream and serve immediately.", "tags": ["tropical fruits", "fruit", "brunch", "15 mins"], "cook_time_min": 5, "servings": null, "cuisine": ["All"], "rating_avg": 5.0, "rating_count": 12, "popularity_score": 4.86090909090909, "nutrition_calories": 585.3, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/23/29/07/JfMRguwVQ7ZRfxKZPwUb_0S9A5080.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["tropical fruits", "fruit", "brunch", "15 mins"], "ingredients": []}, {"recipe_id": "rec_473", "props": {"title": "Buttermilk Pie", "instructions": "[Instructions] 1) Preheat oven to 400\u00b0F. | 2) Beat the butter and sugar together until light. | 3) Add the eggs and beat; then beat in vanilla. | 4) Sift the dry ingredients together and add to the batter alternatively with the buttermilk; beat until smooth. | 5) Pour into a deep dish pie shell and bake at 400F for 10 minutes, reduce heat to 350F and bake for 50-60 additional minutes. | 6) Pie should turn a nice golden brown and a knife inserted should come out clean. | 7) I think it is absolutely best when it is just still warm. (Not too hot, or it will be like napalm.).", "tags": ["dessert", "oven", "4 hours", "easy"], "cook_time_min": 1, "servings": null, "cuisine": ["All"], "rating_avg": 4.75, "rating_count": 174, "popularity_score": 4.74695652173913, "nutrition_calories": 395.9, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/56/nTwHmSmmRqGCr5HAUapC_pie-1194.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["dessert", "oven", "4 hours", "easy"], "ingredients": []}, {"recipe_id": "rec_474", "props": {"title": "Cake Batter Fudge", "instructions": "[Instructions] 1) * Stir cake mix and powdered sugar in microwave safe bowl. | 2) * Cut butter into small pieces and put in bowl. | 3) * Microwave on high for 2 minutes. | 4) * Stir until well mixed. If it is too thick to stir, add 1/2 tsp milk at a time until it is well mixed (should be thick but stirrable). | 5) * Add sprinkles, if desired. But do it quickly as they will melt in the hot batter. | 6) * Spread in a greased 8x8 pan. Refrigerate for an hour to set. Cut and serve.", "tags": ["dessert", "15 mins", "for large groups", "no cook", "easy"], "cook_time_min": 2, "servings": null, "cuisine": ["All"], "rating_avg": 3.6, "rating_count": 11, "popularity_score": 4.120952380952381, "nutrition_calories": 72.8, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/48/82/96/xHW1C7udSQ28XNF5iZDr_cake-batter-fudge-1.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["dessert", "15 mins", "for large groups", "no cook", "easy"], "ingredients": []}, {"recipe_id": "rec_475", "props": {"title": "Cake Mix Cookie Bars", "instructions": "[Instructions] 1) Grease and flour a 9x11 pan. | 2) Mix all together by hand.It will be thick. | 3) Spread in pan. | 4) Cook at 325 for 30 min or untill middle is done.", "tags": ["dessert", "cookie and brownie", "60 mins", "for large groups", "easy"], "cook_time_min": 30, "servings": null, "cuisine": ["All"], "rating_avg": 4.0, "rating_count": 2, "popularity_score": 4.578333333333333, "nutrition_calories": 228.8, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/20/05/14/9ZCuOzQsTYupPlpxJacV_cq2.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["dessert", "cookie and brownie", "60 mins", "for large groups", "easy"], "ingredients": []}, {"recipe_id": "rec_476", "props": {"title": "Cannoli", "instructions": "[Instructions] 1) To make shells, mix flour, sugar and salt in a bowl. | 2) Cut in butter. | 3) Add egg yolks; stir with a fork. | 4) Stir in wine, 1 tablespooon at a time, with a fork until dough clings together. | 5) Form a ball with the dough and let stand for 30 minutes. | 6) Roll dough almost paper thin, on a well-floured surface. | 7) Using the rim of a margarita glass (about 3-4 inches across), make circle imprints into rolled dough. | 8) Using a paring knife, make sure circles are cut all the way through. | 9) Roll each circle of dough around a metal cannoli tube, overlaping the ends and press to seal, flaring out the edges slightly. | 10) Fry one or two at a time in hot melted shortening (about 360\u00b0F) for approximately 1 minute, turning to brown all sides. | 11) Remove from hot grease and drain on paper towels, seam side down. | 12) Let cool a minute or two before trying to remove metal tube. | 13) To remove the tube hold cannoli shell down on the paper towel and carefully slide the tube out one end. | 14) Leave cannoil shells on paper towel, seam side down to cool completely. | 15) ~NOTE~Shells can be stored in airtight containers and made several days prior to filling. | 16) For filling, drain ricotta cheese over cheesecloth if ricotta is watery. | 17) Combine ricotta cheese, powdered sugar, and vanilla extract until combined. | 18) Squeeze Maraschino cherries with paper towels to remove all liquid. | 19) (If you don't squeeze them good, you will have a pink water filling!). | 20) Stir in cherries and chocolate chips into the ricotta mixture, being careful not to over mix. | 21) For a lighter filling, you may whip 1 cup of heavy whipping cream to form stiff peaks, and fold into filling mixture at this step. | 22) Chill filling for about 30 minutes before piping into cooled cannoli shells. | 23) You may garnish the cannoli by sprinkling powdered sugar on top. | 24) Whipped cream, a cherry, and shaved chocolate can also be used to garnish the top. | 25) Keep refrigerated until time of serving.", "tags": ["cheese", "european", "sweet", "for large groups", "4 hours"], "cook_time_min": 45, "servings": null, "cuisine": ["All"], "rating_avg": 4.44, "rating_count": 50, "popularity_score": 4.482333333333334, "nutrition_calories": 247.7, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/95/54/6/DLN9WtsdR9euCddvgrVg_CAN%207%20-%20final_2.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["cheese", "european", "sweet", "for large groups", "4 hours"], "ingredients": []}, {"recipe_id": "rec_477", "props": {"title": "Caramel Apple Dump Cake", "instructions": "[Instructions] 1) In a greased 9 X 13 inch baking dish, mix apple pie filling and caramel sauce. | 2) You may add in the 1/2 teaspoons cinnamon, if desired. | 3) Spread evenly in the pan. | 4) Pour dry cake mix directly on top of the pie filling and spread evenly. | 5) Top with melted butter and pecans. (optional). | 6) Bake at 350 degrees for 50-55 minutes or until top is golden brown and apple filling is bubbly.", "tags": ["low protein", "60 mins"], "cook_time_min": 50, "servings": null, "cuisine": ["All"], "rating_avg": 4.67, "rating_count": 3, "popularity_score": 4.688461538461539, "nutrition_calories": 433.1, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/51/53/57/LmXfZ0TeQlenOHaNvMJm_uploads-2.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["low protein", "60 mins"], "ingredients": []}, {"recipe_id": "rec_478", "props": {"title": "Chocolate Chip Cookie Bars", "instructions": "[Instructions] 1) Set oven to 350 degrees F. | 2) Set oven rack to second-lowest position. | 3) Grease a 13 x 9-inch pan (for thinner bars bake in a larger pan and reduce the baking time slightly). | 4) In a large mixing bowl cream butter with both sugars until fluffy. | 5) Add in eggs and vanilla; beat until well combined. | 6) In another bowl mix together flour with cinnamon, baking soda and salt; gradually add to the creamed mixture until combined. | 7) Mix in chocolate chips and nuts (batter will be very thick). | 8) Transfer the mixture to prepared baking pan then spread out using a spoon. | 9) Bake for about 25-30 minutes or until golden brown.", "tags": ["dessert", "cookie and brownie", "kid friendly", "potluck", "sweet", "60 mins", "for large groups", "oven", "beginner cook", "easy", "inexpensive"], "cook_time_min": 25, "servings": null, "cuisine": ["All"], "rating_avg": 4.64, "rating_count": 31, "popularity_score": 4.653170731707316, "nutrition_calories": 224.2, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/26/58/26/lMOpHMK0ShuF2Bkqbyy2_CCB%204%20-%20final_2.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["dessert", "cookie and brownie", "kid friendly", "potluck", "sweet", "60 mins", "for large groups", "oven", "beginner cook", "easy", "inexpensive"], "ingredients": []}, {"recipe_id": "rec_479", "props": {"title": "Chocolate Chip Panookies", "instructions": "[Instructions] 1) Preheat oven to 375 degrees and grease 8 (4 inch) pie tins. In a medium mixing bowl stir together flour, baking soda, and salt, set aside. | 2) In a large mixing bowl with an electric mixer on medium speed cream butter and sugars until fluffy. Beat in eggs, one at a time, and vanilla. On low speed gradually add flour mixture and mix just until blended. Stir in chocolate chips and walnuts. | 3) Divide dough between prepared pie tins and place onto a baking sheet. Bake for 20 minutes. Serve panookies immediately with a scoop of ice cream.", "tags": ["cookie and brownie", "30 mins", "easy"], "cook_time_min": 20, "servings": null, "cuisine": ["All"], "rating_avg": 5.0, "rating_count": 1, "popularity_score": 4.721818181818181, "nutrition_calories": 748.6, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/40/94/25/KXkk8BfqRsij5WMGwweA_Chocolate%20Chip%20Panookies_final_6.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["cookie and brownie", "30 mins", "easy"], "ingredients": []}, {"recipe_id": "rec_480", "props": {"title": "Chocolate! Chocolate! Chocolate! Bundt Cake With Chocolate Glaze", "instructions": "[Instructions] 1) Cake: Preheat oven to 350\u00b0. | 2) Grease and flour bundt pan, set aside. | 3) In large mixing bowl, combine cake mix, pudding mix and chocolate chips. | 4) In another bowl, combine water, eggs, and vanilla mixing well. | 5) Add egg mixture to dry mixture and mix with spoon until just blended. | 6) Pour into prepared pan. | 7) Bake for 50 to 55 minutes or until cake tests done when wooden pick in center comes out clean. | 8) Cool 15 to 20 minutes before removing cake from pan. | 9) When completely cool, drizzle cake with Chocolate Glaze. | 10) Chocolate Glaze: Combine all ingredients in bowl. | 11) Mix with spoon until smooth.", "tags": ["for large groups", "4 hours", "easy"], "cook_time_min": 50, "servings": null, "cuisine": ["All"], "rating_avg": 4.84, "rating_count": 391, "popularity_score": 4.836359102244389, "nutrition_calories": 321.6, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/27/14/4/YSWmkLQtRpinfqX46cc0_1choccake3.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["for large groups", "4 hours", "easy"], "ingredients": []}, {"recipe_id": "rec_481", "props": {"title": "Chocolate Cookarolis (Fried Ravioli Cookies)", "instructions": "[Instructions] 1) MAKE THE COOKAROLIS: Cut cookie dough in half lengthwise and place onto a long sheet of plastic wrap (about 2 feet). Place one half of the dough into the center, then place another sheet of plastic wrap loosely over top. Roll out cookie dough into a 4\" wide strip 1/4\" thick. Lift off top sheet of plastic wrap and discard. Place 3-4 chocolate morsels in a group onto the bottom of cookie strip 1/2\" apart. | 2) Using the top part of the plastic wrap, fold top half of cookie strip over filling. Using your finger, gently press between and bottom the cookaiolis to seal. Holding the ends of the plastic wrap taut, place the strips onto a cookie sheet and freeze till needed. Repeat with the other half of cookie dough. | 3) MAKE THE PASTRY DOUGH: In the bowl of a food processor, combine the flour, baking powder and salt. Pulse for a few seconds and then pour into a large mixing bowl. | 4) Add the shortening and knead it into the flour with your hands until it is crumbly. Add the milk all at once and mix in with a spatula until it begins to come together. | 5) Lightly flour your hands and the countertop and turn the dough out onto the countertop. Knead the dough ball, folding over about 12 times. Divide dough in half. Roll each half out to 6\" wide strips and about 1/8\" thin. | 6) Remove cookarolis from the freezer and separate them into individual pieces using a knife or pizza pie cutter. Place cookarolis onto the dough 1/4\" apart on the bottom half of the dough. Brush the edges of half of the dough lightly with the egg wash (remember egg wash sticks to dough, but not itself). Fold top part of dough over and separate (using a pizza cutter works well) and then gently seal the edges together with the tines of a fork, dipping the tines into some flour as needed. Repeat with second ball of dough. Place on cookie sheet and refridgerate for a minimum of 30 minutes. NOTE: at this point, they can be frozen on the cookie sheets, then placed into a ziploc bag and frozen for up to a year till needed. | 7) DEEP FRY: Heat oil in a deep fryer to 350\u00b0F Carefully fry in batches for about 3 minutes until just light brown. Drain on paper towels. When cooled (about 5 minutes), dust with powdered sugar. Serve immidiately but be careful, as filling may still be hot.", "tags": ["cookie and brownie", "toddler friendly", "kid friendly", "30 mins", "for large groups", "easy"], "cook_time_min": 5, "servings": null, "cuisine": ["All"], "rating_avg": 5.0, "rating_count": 1, "popularity_score": 4.721818181818181, "nutrition_calories": 204.7, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/25/40/57/2DEzzyYfSKuS07e2JaQX_IMG_9706.png"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["cookie and brownie", "toddler friendly", "kid friendly", "30 mins", "for large groups", "easy"], "ingredients": []}, {"recipe_id": "rec_482", "props": {"title": "Chocolate Eclair Cake", "instructions": "[Instructions] 1) Line buttered 9 x 12 dish with graham crackers. | 2) Combine pudding mix with milk. | 3) Fold in Cool Whip. | 4) Pour half of the mixture over crackers. | 5) Add second layer of crackers. | 6) Add remaining pudding mixture. | 7) Add final layer of graham crackers. | 8) Over medium heat, melt chocolate glaze except for the powdered sugar. | 9) Remove from heat. | 10) Beat in 1-1/2 cups powdered sugar. | 11) Pour over crackers. | 12) Refrigerate overnight.", "tags": ["30 mins"], "cook_time_min": 20, "servings": null, "cuisine": ["All"], "rating_avg": 4.97, "rating_count": 31, "popularity_score": 4.902682926829268, "nutrition_calories": 692.7, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/18/11/6/Aym2f48OQbab4lamnSqc_untitled-7786.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["30 mins"], "ingredients": []}, {"recipe_id": "rec_483", "props": {"title": "Chocolate Molten Lava Cakes", "instructions": "[Instructions] 1) Preheat oven to 425 degrees and grease 4 (6 ounce) ramekins, place on baking sheet. In a large microwavable bowl microwave butter and chocolate for 1 minute or until butter is melted, stir until chocolate is completely melted. | 2) Stir in powdered sugar until well blended. Whisk in eggs and egg yolks, then stir in flour. Divide batter between prepared ramekins. Bake for 13 to 14 minutes or until sides are firm but centers are soft. Let stand for 1 minute. | 3) Run a small knife around the cakes to loosen, invert cakes onto plates. Top with whipped cream and serve immediatley.", "tags": ["30 mins", "easy"], "cook_time_min": 13, "servings": null, "cuisine": ["All"], "rating_avg": 5.0, "rating_count": 4, "popularity_score": 4.781428571428571, "nutrition_calories": 565.1, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/40/07/97/12ArB6DRTRaWHxVBTvda_lavafood.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["30 mins", "easy"], "ingredients": []}, {"recipe_id": "rec_484", "props": {"title": "Chocolate-Peanut Butter Cookie Pie", "instructions": "[Instructions] 1) Heat oven to 350 degrees. | 2) Remove cookie dough from wrapper. | 3) With floured fingers, prss dough in bottom of ungreased 10 or 9 inch springform pan. | 4) Bake cookie dough at 350 degrees for 14 to 18 minutes or until golden brown. | 5) Cool baked cookie for 15 minutes. | 6) In medium bowl, combine powdered sugar, peanut butter, butter and water; mix well. | 7) (If necessary, add additional water 1 t. at a time until mixture is smooth.) Drop spoonfuls of mixture over baked cookie crust; press evenly over crust. | 8) Spread melted chocolate chips over peanut butter mixture. | 9) If desired, swirl chocolate with a fork. | 10) Garnish with pecan halves. | 11) Refrigerate 1 hour or until chocolate is set.", "tags": ["dessert", "cookie and brownie", "sweet", "60 mins", "for large groups", "oven", "refrigerator"], "cook_time_min": 18, "servings": null, "cuisine": ["All"], "rating_avg": 4.75, "rating_count": 8, "popularity_score": 4.718888888888889, "nutrition_calories": 413.4, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/54/21/3/2C5BH2emSpGIuWFSwvPG_DSC03111.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["dessert", "cookie and brownie", "sweet", "60 mins", "for large groups", "oven", "refrigerator"], "ingredients": []}, {"recipe_id": "rec_485", "props": {"title": "Coconut Coffee Cake", "instructions": "[Instructions] 1) In a large mixing bowl combine the cake mix, soup, water, eggs, and lemon rind. Beat until blended. | 2) Stir in 1 cup of coconut, pineapple, and nuts. Spread the batter evenly in a greased and floured 9x13-inch pan. | 3) In another bowl, cut butter into the flour until crumbly. Stir in sugar and the remaining coconut. Sprinkle over the batter. | 4) Bake in a 350 oven for 50 minutes or until done.", "tags": ["breakfast", "coconut", "tropical fruits", "fruit", "nuts", "sweet", "brunch", "for large groups", "beginner cook", "4 hours", "easy"], "cook_time_min": 50, "servings": null, "cuisine": ["All"], "rating_avg": 5.0, "rating_count": 2, "popularity_score": 4.745, "nutrition_calories": 260.3, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/20/39/47/jQmn4ZeXS1yF88naoUmn_untitled-0517.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["breakfast", "coconut", "tropical fruits", "fruit", "nuts", "sweet", "brunch", "for large groups", "beginner cook", "4 hours", "easy"], "ingredients": []}, {"recipe_id": "rec_486", "props": {"title": "Coffee Shop Style Easy Cake Mix Biscotti", "instructions": "[Instructions] 1) Preheat the oven to 350F degrees. | 2) Pour the cake mix into a mixing bowl. Stir in sifted all purpose flour. | 3) Make a well in the centre and add the eggs, margarine and vanilla extract. | 4) With an electric beater mix on medium speed for 2 to 3 minutes until the dough does not stick to the sides of the mixing bowl. It will look and feel like play dough! | 5) On a lightly floured board, divide dough into two halves. | 6) Roll each half into a log about 1\" in diameter. | 7) Roll each log gently to the edge of the board and then continue rolling it onto a lightly sprayed 11\u201d x 15\u201d baking sheet. | 8) Flatten the top of each cookie log until it is about 3\" wide. | 9) Bake for 20 minutes. | 10) Remove baking sheet from the oven and let stand for 10 minutes. | 11) Reduce oven temperature to 325 and do not turn off. | 12) Gently slide one cookie log onto the board that you rolled out the dough on. | 13) Using a serrated knife or better still an electric carving knife, slice each log across the width into 3/4\" slices. | 14) Place cookies cut side down back onto the baking sheet and return them to the oven for another 10 minutes. | 15) Remove cookies to cooling rack to cool completely. | 16) Store cooled cookies in an airtight container or freeze. | 17) Variations include:. | 18) PECAN BISCOTTI: butter pecan cake mix - chopped pecans - maple extract. | 19) APRICOT BISCOTTI: golden cake mix - chopped dried apricots - toasted slivered almonds - almond extract. | 20) CRANBERRY BISCOTTI: vanilla cake mix - chopped dried cranberries - toasted slivered almonds - almond extract. | 21) ORANGE SPICE BISCOTTI: spice cake mix - walnuts - grated orange zest. | 22) GINGER BISCOTTI: spice cake mix - walnuts - chopped crystalized ginger pieces. | 23) CHOCOLATE-CHOCOLATE BISCOTTI: chocolate cake mix - chocolate piece or chips, freeze first so they retain their shape during baking. | 24) LEMON ALMOND BISCOTTI: lemon cake mix - toasted slivered almonds.", "tags": ["cookie and brownie", "european", "christmas", "mixer", "60 mins", "small appliance", "inexpensive"], "cook_time_min": 40, "servings": null, "cuisine": ["All"], "rating_avg": 4.14, "rating_count": 7, "popularity_score": 4.465882352941176, "nutrition_calories": 109.4, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/21/96/23/80MmOUKcRZ6vX0XS87wA_untitled-1694.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["cookie and brownie", "european", "christmas", "mixer", "60 mins", "small appliance", "inexpensive"], "ingredients": []}, {"recipe_id": "rec_487", "props": {"title": "Cookie-Crust Lemon Bars", "instructions": "[Instructions] 1) Heat oven to 350\u00b0F | 2) Slice cookie dough as directed on package. Arrange slices in bottom of ungreased 13x9-inch glass pan. With lightly floured fingers, press dough evenly in pan. (Even though the cookie dough is cold/just out of the fridge, pressing it down is pretty easy. It'll take the whole roll to cover the 13x9 pan). | 3) Bake at 350\u00b0F for 15 to 20 minutes or until light golden brown. | 4) In large bowl, combine eggs, sugar, flour and baking powder; blend well. Blend together lemon juice, lemon extract and lemon zest. Add lemon mixture to egg-sugar mixture, and pour over warm crust. | 5) Bake at 350\u00b0F for an additional 20 to 30 minutes or until top is light golden brown. Cool completely. Sprinkle with powdered sugar; cut into bars.", "tags": ["dessert", "cookie and brownie", "60 mins", "for large groups", "easy"], "cook_time_min": 40, "servings": null, "cuisine": ["All"], "rating_avg": 4.71, "rating_count": 7, "popularity_score": 4.700588235294117, "nutrition_calories": 97.2, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/18/24/13/nSOp21BR0OkTV9fD96yl_11.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["dessert", "cookie and brownie", "60 mins", "for large groups", "easy"], "ingredients": []}, {"recipe_id": "rec_488", "props": {"title": "Cookie Dough Brownies", "instructions": "[Instructions] 1) For brownies, melt shortening and chocolate. | 2) Transfer to large mixing bowl. | 3) Blend in sugar, eggs and vanilla. | 4) Add flour, salt and baking powder. | 5) Bake at 350 degrees for 30 minutes in a 9x13 pan (grease bottom of pan). | 6) Cool completely. | 7) For the cookie dough, cream the butter and sugars till fluffy. | 8) Add remaining ingredients, blending well. | 9) Spread over cooled brownies. | 10) Combine glaze ingredients in a small bowl. | 11) Microwave just until the chocolate is melted (about 1 min.), stir till smooth. | 12) Spoon glaze over cookie dough and spread carefully to cover. | 13) Sprinkle with chopped walnuts, if desired (I don't). | 14) Store in the refrigerator.", "tags": ["dessert", "cookie and brownie", "toddler friendly", "kid friendly", "sweet", "60 mins", "for large groups"], "cook_time_min": 30, "servings": null, "cuisine": ["All"], "rating_avg": 4.67, "rating_count": 16, "popularity_score": 4.679230769230769, "nutrition_calories": 429.3, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/11/02/16/y9CH145OQhSiHq0Sylgl_34%20(1%20of%201).jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["dessert", "cookie and brownie", "toddler friendly", "kid friendly", "sweet", "60 mins", "for large groups"], "ingredients": []}, {"recipe_id": "rec_489", "props": {"title": "Cookie Dough Cheesecake", "instructions": "[Instructions] 1) In a small bowl, combine cookie crumbs and sugar, stir in butter. | 2) Press into the bottom and sides of a greased 9\" springform pan, set aside. | 3) In a mixing bowl, beat cream cheese, sugar until smooth. | 4) Add eggs, beat until combined. | 5) Add sour crem and vanilla, beat until well blended. | 6) Pour over crust, set aside. | 7) Cut up cookie dough into teaspoon sized cubes. | 8) Drop over filling, pushing below the surface. | 9) Dough should be completely covered. | 10) Bake at 350F for 45-55 minutes or until the center is almost set. | 11) Cool on a wire rack for 10 minutes. | 12) Run a knife around the edge of the pan to loosen. | 13) Cool 1 hour longer. | 14) Refrigerate overnight, remove sides of pan. | 15) Sprinkle with mini chocolate chips.", "tags": ["dessert", "cheese", "kid friendly", "potluck", "christmas", "weeknight", "oven", "beginner cook", "4 hours", "easy"], "cook_time_min": 55, "servings": null, "cuisine": ["All"], "rating_avg": 4.76, "rating_count": 30, "popularity_score": 4.7435, "nutrition_calories": 634.9, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/15/53/2/oKRdYYcaRje1B79u37dZ_CookieDoughCheesecake3.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["dessert", "cheese", "kid friendly", "potluck", "christmas", "weeknight", "oven", "beginner cook", "4 hours", "easy"], "ingredients": []}, {"recipe_id": "rec_490", "props": {"title": "Cream Cheese Brownies!", "instructions": "[Instructions] 1) Preheat oven to 350 degrees F. | 2) Stir together flour, salt and baking powder. | 3) Melt butter and remove from heat. | 4) Stir in the cocoa. | 5) Beat in the eggs, sugar and the vanilla. | 6) Fold in the dry ingredients. | 7) Pour in 1/2 the batter in a 9\" greased square casserole dish or baking pan. | 8) Spread Cream Cheese Filling on top CAREFULLY! | 9) Top with remaining chocolate batter. | 10) Pull a knife through all of the layers to create a marbled effect. | 11) Bake covered with tin foil or a glass lid for 40-45 minutes or until a toothpick inserted into the brownies comes out clean. | 12) Cream Cheese Filling: Beat the cream cheese. | 13) Gradually add the 1/3 cup sugar, 1 egg and the 1/2 tsp vanilla until the filling is very smooth.", "tags": ["dessert", "cookie and brownie", "weeknight", "4 hours"], "cook_time_min": 45, "servings": null, "cuisine": ["All"], "rating_avg": 4.5, "rating_count": 46, "popularity_score": 4.534642857142857, "nutrition_calories": 138.9, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/36/62/7/19qbdcEnTIGsTq94IQZO_classic-cream-cheese-brownies%20(4%20of%204).jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["dessert", "cookie and brownie", "weeknight", "4 hours"], "ingredients": []}, {"recipe_id": "rec_491", "props": {"title": "Dark Chocolate Red Wine Truffles", "instructions": "[Instructions] 1) Coarsley chop chocolate and place into a medium sized bowl. | 2) Bring cream to a simmer, add butter and stir until melted. | 3) Pour the cream over the chocolate. Stir with a spatula until the chocolate is melted. | 4) Add the red wine and stir until wine is incorporated. | 5) Pour into an 8x8 baking dish and refridgerate for at least 4 hours | 6) Use a metal cookie scoop to scoop out a truffle. Coat your hands in cocoa powder and gently roll the chocolate until it forms a ball. Roll in cocoa to coat. | 7) Keep refridgerated.", "tags": ["dessert", "very low carbs", "low protein", "easy"], "cook_time_min": 4, "servings": null, "cuisine": ["All"], "rating_avg": 4.0, "rating_count": 7, "popularity_score": 4.408235294117647, "nutrition_calories": 37.4, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/43/12/38/bopww8WKTGxzOhcG3qOg_0S9A1678.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["dessert", "very low carbs", "low protein", "easy"], "ingredients": []}, {"recipe_id": "rec_492", "props": {"title": "Decadent Krispies Bar", "instructions": "[Instructions] 1) This bar comes together rather quickly. Begin by preparing a 9 by 9 inch pan with a good coating of cooking spray and set aside. Also apply a bit of spray to your cooking spoon (preferably wooden). | 2) If your almonds are not already toasted, place them in a dry non-stick skillet over medium heat. Cook for 2 to 3 minutes, routinely tossing the almonds around the pan. The almonds should add just a small amount of color and become slightly aromatic. | 3) To make the bars, begin by adding the butter and brown sugar together in a large sauce pan over medium to low heat. Stir while the both the butter and sugar melt for 2 minutes or so. The result is smooth to the feel with a wooden spoon. In addition, you should be able to move it about the bottom of the pan with the spoon (sort of a blob). | 4) Add in the 1/4 teaspoon of cinnamon and stir. | 5) Add the miniature marshmallows and stir continuously helping the puffs to melt. Continue mixing until you have a pale brown mixture that is still rather loose. | 6) This is where things begin to move fast. Once the marshmallows are fully melted and mixed with the sugar, add in the Rice Krispies, almonds and apricots. Stir quickly to get all of the ingredients incorporated. | 7) Turn the mixture out into the 9 by 9 inch pan, distributing as much as possible using your spoon. | 8) To level the bars in the pan, give your palms a quick shot of cooking spray and pat down. | 9) Place the bars in the refrigerator for 30 minutes to set. | 10) Invert pan and give the pan a good whack to release the Krispies bar. Slice into 12 pieces (4 by 3). | 11) Melt white chocolate chips in a double boiler over very low heat. (If you do not have a double boiler, you can fashion one using a large bowl over a smaller saucepan. Just be certain the fit is tight and no steam is being released). | 12) Add the oil to the chocolate and stir while the the chips continue to melt. If the chocolate begins to harden, this is sign the heat is too high and you should lower the flame or remove the top half of the double boiler from the bottom. | 13) Stir the Grand Marnier into the melted chocolate and use a spoon to stripe the bars on the diagonal allowing the melted chocolate to drip down the side. If you are a big fan of white chocolate, you can skip the drizzling and just dunk the bars into the white chocolate and place on waxed paper to cool. | 14) (Timesaver tip: If you want to speed things up a bit. You can melt the chocolate after placing the bars in the pan and drizzle over the entire pan before cooling and cutting. Not quite as pretty, but just as tasty).", "tags": ["dessert", "lunch snacks", "cookie and brownie", "fruit", "30 mins"], "cook_time_min": 20, "servings": null, "cuisine": ["All"], "rating_avg": 4.56, "rating_count": 9, "popularity_score": 4.630526315789473, "nutrition_calories": 181.5, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/21/15/58/Ii6M6UJIQP2xwRhR14tx_decadent-krispies-bar-16.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["dessert", "lunch snacks", "cookie and brownie", "fruit", "30 mins"], "ingredients": []}, {"recipe_id": "rec_493", "props": {"title": "Delicious Oreo Refrigerator Cake (No-Bake)", "instructions": "[Instructions] 1) Crush Oreo cookies; set 1/4 cup aside for topping. | 2) Mix the remaining crushed cookies with the melted butter. | 3) Press into the bottom of a greased 13 x 9-in baking pan. | 4) In a bowl, beat the cream cheese with the confectioners sugar on medium speed. | 5) Fold in half of the Cool Whip topping. | 6) Spread over cookie crumb layer. | 7) Refrigerate 1/2 hour. | 8) In the meantime, combine milk with instant pudding mix; beat well, until smooth. | 9) Pour over chilled mixture in the pan. | 10) Refrigerate for 1 hour. | 11) Spread remainder of Cool Whip topping on top of pudding layer. | 12) Sprinkle with remaining reserved cookie crumbs. | 13) Store cake in the refrigerator, covered tightly.", "tags": ["low protein", "30 mins", "refrigerator"], "cook_time_min": 30, "servings": null, "cuisine": ["All"], "rating_avg": 4.84, "rating_count": 44, "popularity_score": 4.812962962962962, "nutrition_calories": 717.5, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/77/96/0/tBpHISgIQRG2Ox5QuLVS_0S9A4968.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["low protein", "30 mins", "refrigerator"], "ingredients": []}, {"recipe_id": "rec_494", "props": {"title": "Dump Cake the Loretta Lynn Dump Cake for Ray Charles", "instructions": "[Instructions] 1) Try not to think about it. There's a reason people in this country are addicted to fatty foods that are bad for you, and this cake is going to appeal to all of those urges in you and more. Best cake in the world, remember? It's worth a shot.Preheat oven to 350. Follow the instructions on the cake mix box for baking. | 2) So, make your cake in the usual way, and when it's hot from the oven, use the cylindrical end of a large wooden spoon to poke holes in the cake. | 3) Oh, I should mention that I'd recommend the cake be baked in a 9x12 glass pan. | 4) And, the holes should be poked in neat columns and rows, let's say about an inch and a half apart. Maybe an inch. Maybe two inches. Maybe an inch and a half. | 5) Holes poked? Pour the can of condensed milk all over the cake. | 6) Pour the jar of caramel sauce all over the cake.Spread a liberal layer of Cool Whip all over the cake. | 7) While your cake was baking, you should have pounded the Nestl\u00e9 Crunch bars into half-inch or less (or maybe a bit more) pieces. Now sprinkle those on top. | 8) DON'T EAT THE CAKE! | 9) If you must, if you really must, go ahead and have some, but it's not fair to judge your creation at this stage. It has not become the best cake in the world yet. Here, it's just a recipe for instant diabetic keelover. | 10) Put the cake in the refrigerator. | 11) Now you must leave that cake in there for as long as you can stand. Ideally, this means overnight. At least. But, if you're pressed for a choc fix, at least let it get nice and cold. | 12) But, again, it really is a \"this gets amazing after a day in the fridge\" recipe. | 13) And that's it. That is the very best cake in the world. Like so many precious artifacts, one would not expect to find such a powerful recipe in the hands of a kitchen simpleton such as myself, but I have come forth with the treasure. | 14) Now the world is forever changed. Or, if not the world, then your weekend, if you're smart (and want to be really, really popular with the rest of your household). | 15) Eat! Enjoy!", "tags": ["dessert", "for large groups", "4 hours", "easy"], "cook_time_min": 1, "servings": null, "cuisine": ["All"], "rating_avg": 5.0, "rating_count": 3, "popularity_score": 4.764615384615385, "nutrition_calories": 399.6, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/44/22/91/wQFg9wnMSDyXH8HjrAAO_IMG_1417.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["dessert", "for large groups", "4 hours", "easy"], "ingredients": []}, {"recipe_id": "rec_495", "props": {"title": "Easy Cherry Delight Dessert (No-Bake)", "instructions": "[Instructions] 1) Prepare a 9 x 9\" baking pan. | 2) In a bowl, mix the graham cracker crumbs, melted butter and 1 tbsp sugar; spread on bottom of prepared baking pan to form a crust. | 3) Mix the Dream Whip topping according to directions on the package, then beat in the softened cream cheese into the Dream Whip a little at a time. | 4) Add the remaining sugar and vanilla until well blended. | 5) Smooth on top of the crust. | 6) Top with the cherry pie filling. | 7) Chill at least 3 hours (overnight is even better) if storing in the fridge overnight, cover with plastic wrap.", "tags": ["cherries", "fruit", "low protein", "30 mins", "refrigerator"], "cook_time_min": 25, "servings": null, "cuisine": ["All"], "rating_avg": 4.56, "rating_count": 18, "popularity_score": 4.607857142857143, "nutrition_calories": 274.2, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/82/00/2/HM9BYVRbQMmQ8p8aOGKQ_easy-cherry-delight-3.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["cherries", "fruit", "low protein", "30 mins", "refrigerator"], "ingredients": []}, {"recipe_id": "rec_496", "props": {"title": "Easy Chocolate Mousse", "instructions": "[Instructions] 1) Melt chocolate with hot water. To melt completely, it may be necessary to place the bowl in a pan of hot water. | 2) Cool and then add beaten eggs. | 3) Add Grand Marnier. | 4) Carefully fold in whipped cream. | 5) Chill and serve.", "tags": ["30 mins", "easy"], "cook_time_min": 30, "servings": null, "cuisine": ["All"], "rating_avg": 4.57, "rating_count": 14, "popularity_score": 4.621666666666667, "nutrition_calories": 377.4, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/18/53/25/9Rm9OlrkSO49IJ8ROC5D_Chocolate%20mousse.JPG"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["30 mins", "easy"], "ingredients": []}, {"recipe_id": "rec_497", "props": {"title": "Easy Key Lime Pie", "instructions": "[Instructions] 1) Beat milk and lime juice in large bowl with electric mixer on medium speed until smooth and thickened. | 2) Fold in whipped topping. | 3) Spoon lime mixture into pie crust. | 4) Cover and refrigerate about 1 hour or until set. | 5) Garnish with grated lime peel.", "tags": ["dessert", "lime", "citrus", "fruit", "potluck", "spring", "summer", "weeknight", "no cook", "refrigerator", "beginner cook", "4 hours", "easy", "inexpensive"], "cook_time_min": 1, "servings": null, "cuisine": ["All"], "rating_avg": 4.85, "rating_count": 56, "popularity_score": 4.826363636363636, "nutrition_calories": 253.9, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/43/29/2/cUSe19GQKKWnFFKWOxAt_Key%20Lime%20Pie_final%202.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["dessert", "lime", "citrus", "fruit", "potluck", "spring", "summer", "weeknight", "no cook", "refrigerator", "beginner cook", "4 hours", "easy", "inexpensive"], "ingredients": []}, {"recipe_id": "rec_498", "props": {"title": "Easy Lemon Marble Cheesecake", "instructions": "[Instructions] 1) Make the lemon curd: Combine the lemon zest, juice, and sugar in a small saucepan and bring to a simmer. Meanwhile beat the egg until light in a small bowl. Beat some of the hot lemon mixture into the egg. Scrape the egg mixture back into the saucepan. Cook, stirring constantly and reaching all over the bottom and sides of the pan, until the mixture barely starts to simmer around the edges. Continue to cook and stir for about 15 seconds. Pour through a strainer set over a clean bowl. Stir in the vanilla. Cool to room temperature. | 2) Make the cheesecake batter: Position rack in lower third of oven and preheat to 350 degrees. Place a round of parchment paper in the bottom of the cake pan and spray sides of pan with vegetable oil spray. Put water kettle on to boil for baking procedure. | 3) Process the cottage cheese in a food processor for 2 1/2 to 3 minutes or until silky smooth, scraping the sides and bottom of the bowl once or twice as necessary. Set aside. | 4) In a small microwave safe bowl, soften the Neufchatel cheese in microwave on high for about 30 seconds. Or, warm gently in the top of a double boiler. Stir until smooth. Scrape into the processor. Add the eggs, sugar, vanilla, lemon juice, and salt. Pulse until incorporated and perfectly smooth. Do not over process. | 5) Scrape the batter into the prepared pan. Distribute slightly rounded tablespoons of lemon curd evenly over the cheesecake batter. Using a table knife or teaspoon, use circular strokes to marble the batters until nicely but not to completely mingled. | 6) Slide oven rack part way out. Place cheesecake pan in baking dish or skillet and set on oven rack. Carefully pour boiling water around the pan to a depth of about 1-inch. Slide oven rack in gently to avoid sloshing. Bake until cheesecake has puffed and risen slightly and is just beginning to shrink from the edges of the pan, about 40 to 45 minutes. Remove cheesecake from water bath and cool on a rack. When completely cool, cover and chill for at least 12 hours or up to 2 days before serving. | 7) To unmold and serve: Cover the pan with tightly stretched plastic wrap. Place a flat dish on top of plastic. Invert pan and dish and rap the pan gently until cheesecake is released from pan. Remove pan and peel parchment liner from bottom of cake. Place cake circle or serving plate on the cake and carefully invert so that cake is right side up. Remove plastic wrap. Press crumbs around sides of cake. Cut with a sharp thin knife. Dip the knife in hot water and wipe it dry between cuts. | 8) TIPS:. | 9) The suave texture of this cheesecake relies on ultra smooth cottage cheese. This requires a food processor and at least 2 1/2 to 3 minutes of processing, no cheating. | 10) Once the Neufchatel Cheese has been added, pulse only enough to incorporate. over processing thins the batter. | 11) If you use nonfat cottage instead of low fat, the results will be not be nearly as good and you would save only about .4 grams of fat per serving. It's not worth it.", "tags": ["dessert", "lemon", "cheese", "citrus", "fruit"], "cook_time_min": 45, "servings": null, "cuisine": ["All"], "rating_avg": null, "rating_count": 0, "popularity_score": null, "nutrition_calories": 239.7, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/submissions/recipe/33186/uX0f3bMTn58OskfTGWgv_Devour-23.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["dessert", "lemon", "cheese", "citrus", "fruit"], "ingredients": []}, {"recipe_id": "rec_499", "props": {"title": "French Vanilla Banana Cream Pie", "instructions": "[Instructions] 1) Place banana slices in crust. | 2) Pour milk into bowl. | 3) Add pudding. | 4) Beat with wire whisk 2 minutes. | 5) Gently stir in one cup of Cool Whip; spoon into crust. | 6) Refrigerate 4 hours. | 7) Top pie with remaining Cool Whip.", "tags": ["low protein", "easy"], "cook_time_min": 4, "servings": null, "cuisine": ["All"], "rating_avg": 4.0, "rating_count": 7, "popularity_score": 4.408235294117647, "nutrition_calories": 332.1, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/10/76/41/gGQWJweSsmcQIcew9Dyb_french%20vanilla%20banana%20cream%20pie%20107641-3.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["low protein", "easy"], "ingredients": []}, {"recipe_id": "rec_500", "props": {"title": "Fresh Peach Turnovers", "instructions": "[Instructions] 1) Preheat oven to 400\u00ba. | 2) As you're slicing the peaches, save the juice. | 3) Combine peach juice with sugar and cornstarch in saucepan. Cook until thick and bubbly. | 4) Add peaches, butter, cinnamon and nutmeg. | 5) Cool slightly. | 6) Lightly roll out each pastry sheet on floured surface. | 7) Cut each sheet into 4 squares. | 8) Place some of peach filling on half of each square. Brush edges with beaten egg. Fold over into a triangle (or rectangle) and press to seal edges (or crimp with fork). | 9) Place on baking sheets. | 10) Bake at 400\u00ba for 10-15 minutes until lightly brown and puffy. | 11) Cool on racks. | 12) Sprinkle with powdered sugar. Or frost with a powdered sugar frosting.", "tags": ["fruit", "kid friendly", "spring", "summer", "60 mins"], "cook_time_min": 20, "servings": null, "cuisine": ["All"], "rating_avg": 4.38, "rating_count": 9, "popularity_score": 4.545263157894737, "nutrition_calories": 490.2, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/12/69/65/Z5xw2MESLWGB4fN9V1mg_peach-turnovers-1.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["fruit", "kid friendly", "spring", "summer", "60 mins"], "ingredients": []}]};
UNWIND $rows AS row
MERGE (r:Recipe {recipe_id: row.recipe_id})
SET r.title = row.props.title,
    r.instructions = row.props.instructions,
    r.tags = row.props.tags,
    r.cook_time_min = row.props.cook_time_min,
    r.servings = row.props.servings,
    r.cuisine = row.props.cuisine,
    r.rating_avg = row.props.rating_avg,
    r.rating_count = row.props.rating_count,
    r.image_urls = row.props.image_urls,
    r.source_url = row.props.source_url,
    r.recipe_category = row.props.recipe_category,
    r.popularity_score = coalesce(row.props.popularity_score, 0),
    r.popularity_views = coalesce(row.props.popularity_views,0),
    r.popularity_saves = coalesce(row.props.popularity_saves,0),
    r.popularity_cooks = coalesce(row.props.popularity_cooks,0),
    r.popularity_likes = coalesce(row.props.popularity_likes,0),
    r.nutrition_calories = row.props.nutrition_calories,
    r.cost_estimate = row.props.cost_estimate,
    r.equipment_needed = row.props.equipment_needed,
    r.video_url = row.props.video_url,
    r.alternative_ingredients = row.props.alternative_ingredients,
    r.allergens = row.props.allergens
WITH r, row
UNWIND coalesce(row.tags, []) AS tagName
MERGE (t:Tag {name: tagName})
MERGE (r)-[:TAGGED_AS]->(t)
WITH r, row
CALL { WITH r, row
  UNWIND coalesce(row.ingredients, []) AS ing
  MATCH (i:Ingredient {ingredient_id: ing.ingredient_id})
  MERGE (r)-[rel:HAS_INGREDIENT]->(i)
  SET rel.qty = ing.qty, rel.unit = ing.unit, rel.optional = coalesce(ing.optional_flag,false), rel.prep = ing.prep
  RETURN count(*) AS _
}
WITH r, row
UNWIND coalesce(row.props.cuisine, []) AS cuisineName
MERGE (cu:Cuisine {name: cuisineName})
MERGE (r)-[:OF_CUISINE]->(cu)

:param rows => {"rows": [{"recipe_id": "rec_501", "props": {"title": "Fried Oreos", "instructions": "[Instructions] 1) Preheat deep fryer to 375 degrees F. | 2) Combine pancake mix, milk, eggs and oil. | 3) Mix until there are no lumps. | 4) Dip Oreos into batter, make sure both sides are covered and put the Oreos into the deep fryer. | 5) You will need to watch these as the cookies tend to float- so be sure to turn them. | 6) Also be careful that they don't burn- you just want them golden brown. | 7) Remove the cookies and drain well. | 8) The cookies are best straight out of the deep fryer!", "tags": ["lunch snacks", "sweet", "30 mins", "deep fried"], "cook_time_min": 15, "servings": null, "cuisine": ["All"], "rating_avg": 5.0, "rating_count": 8, "popularity_score": 4.83, "nutrition_calories": 73.0, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/63/35/2/ZA6tKQxxRr29WAPrPEgQ_FO%207%20-%20final_5.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["lunch snacks", "sweet", "30 mins", "deep fried"], "ingredients": []}, {"recipe_id": "rec_502", "props": {"title": "Fudgy Salty Peanut Butter Brownies", "instructions": "[Instructions] 1) Preheat your oven to 325 degrees F. | 2) For your brownie batter: Melt your butter in a medium (or large) heatproof bowl over a pot of simmering water. | 3) While the butter is melting, whisk the cocoa powder, sea salt and sugar in a separate bowl. (The sugar and salt will work as abrasive agents to get any lumps out of the cocoa.) Whisk the cocoa/sugar/salt combo into the melted butter until the sugar has dissolved fully. The mixture should look like fudge and pull away from the bowl into a ball. Take off the stove and set the pan on a dishtowel on your counter. Allow the fudgy mixture to cool down until it's warm, but not hot anymore. | 4) While that is cooling, line the bottom and sides of your 9 by 13-inch baking pan with parchment paper or foil. You want to leave about 4 inches of overhang on the 2 opposite sides. These serve as your handles to remove the brownies from the pan in 1 piece, so make sure that there is enough of the overhang for you to have a solid grip. Grease the parchment or foil well. | 5) Stir in the vanilla into the cooled fudge mixture to loosen it up. Add the eggs into the mixture 1 at a time, adding the second egg after the first egg is fully incorporated. The batter should look shiny and well blended. Add in your flour and stir it until it's fully incorporated. Once it looks fully blended, beat the batter vigorously for at least 45 strokes. This'll not only get out any pent up stress, but it will make the brownies chewy. Fold in your chocolate chips. Spread the very thick and fudgy brownie batter evenly in the lined pan with an offset spatula or your greased hands. | 6) Pop the brownies in the oven and bake until they get a nice crust and your house smells like brownies, 30 to 35 minutes. Let them cool completely on a rack or a dishtowel on your counter. | 7) While the brownies are cooling make the buttercream and ganache. | 8) For the buttercream: Mix your peanut butter and butter together in a stand mixer until they are totally blended. Turn your mixer down and slowly add your powdered sugar and fine sea salt. Stop the mixer and scrape the sides and bottom of the bowl. Turn your mixer back to medium, add your milk and vanilla and keep mixing until it's fully blended. Dollop the peanut butter buttercream in heaping spoonfuls on top of the cooled brownies. Evenly spread it with the back of a butter knife the over the surface. Scatter the peanuts evenly over the buttercream, pressing into the buttercream so that the ganache has something to hold on to and the peanuts are all covered. | 9) For the ganache: Melt the chocolate chips and butter together in a small saucepan over low heat, stirring constantly. Allow the ganache to cool down slightly for 10 minutes or so, then pour it evenly over the peanut butter buttercream layer. Smooth the ganache out with the back of a butter knife, making sure to cover the buttercream and peanuts completely. Chill the brownies in the refrigerator until the toppings are set, 1 1/2 hours or so. | 10) Remove these delicious guys from the refrigerator. Lift up the ends of the foil liner and place the Fudgy Salty Chocolate Peanut Butter Brownies on a cutting board. Cut into squares. Enjoy!", "tags": ["cookie and brownie", "peanut butter", "birthday", "4 hours", "from scratch"], "cook_time_min": 40, "servings": null, "cuisine": ["All"], "rating_avg": 4.0, "rating_count": 4, "popularity_score": 4.4957142857142856, "nutrition_calories": 887.5, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/45/98/88/ob1w63x0TMagiuPXmMFJ_PEANUT%20BUTTER%20BROWNIES.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["cookie and brownie", "peanut butter", "birthday", "4 hours", "from scratch"], "ingredients": []}, {"recipe_id": "rec_503", "props": {"title": "German Chocolate Icing", "instructions": "[Instructions] 1) Put butter in a sauce pan and let it melt. | 2) Add milk, sugar, vanilla and whisk in egg yolks. | 3) Cook and stir over medium heat until mixture starts to bubble and then cook for about nine (9) minutes stirring constantly. | 4) Pour over coconut and pecans and mix. | 5) I usually put the nuts and coconut in a metal bowl and then poor the hot mixture over them to help with cooling. | 6) If you are in a hurry, put the mixture in the refrigerator stirring occasionally until it is cool and thick enough to ice your cake. | 7) I find that box cakes are just fine for this.", "tags": ["30 mins", "stove top"], "cook_time_min": 15, "servings": null, "cuisine": ["All"], "rating_avg": 4.95, "rating_count": 29, "popularity_score": 4.884358974358975, "nutrition_calories": 3682.0, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/23/21/8/1qgSLFchTUmJPbpVuBGr_0S9A0442.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["30 mins", "stove top"], "ingredients": []}, {"recipe_id": "rec_504", "props": {"title": "Greek Baklava", "instructions": "[Instructions] 1) Preheat oven to 325. Layer half of the sheets of phyllo one sheet at a time, in a greased 11x7x2 baking pan, brushing each sheet evenly with butter and folding ends over if necessary to fit into pan. | 2) Keep unused sheets covered with plastic wrap while assembling baklava to prevent drying. | 3) Mix 1/4 cup of the sugar and cinnamon; stir in walnuts. | 4) Sprinkle nut mixture evenly over buttered phyllo in pan. | 5) Layer remaining phyllo, one sheet at a time, over nut mixture, brushing each sheet evenly with butter. | 6) Cut diagonally into squares, cutting completely through all layers. | 7) Bake in preheated oven until crisp and golden, about one hour. | 8) Combine remaining sugar, the water, lemon juice and honey in small saucepan; cook and stir over low heat until sugar dissolves. | 9) Heat to boiling; pour evenly over hot baklava. | 10) Let stand loosely covered 8 hours or overnight.", "tags": ["lemon", "citrus", "fruit", "nuts", "greek", "european", "sweet", "weeknight", "oven", "4 hours"], "cook_time_min": 1, "servings": null, "cuisine": ["All"], "rating_avg": 4.62, "rating_count": 35, "popularity_score": 4.636444444444445, "nutrition_calories": 537.5, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/54/87/2/adfOwroyTgGY7wlrsn6a_baklava-1294.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["lemon", "citrus", "fruit", "nuts", "greek", "european", "sweet", "weeknight", "oven", "4 hours"], "ingredients": []}, {"recipe_id": "rec_505", "props": {"title": "Homemade Yellow Cake and Variations", "instructions": "[Instructions] 1) Cream together butter, shortening, sugar, and pudding. | 2) Add eggs in one at a time. | 3) Add in sour cream and vanilla. Mix well. | 4) Sift together flour, baking powder, and salt. | 5) Add flour mixture into butter mixture alternately with milk starting and finishing with flour mixture. | 6) Pour into well greased and floured 13x9 pan. | 7) Bake at 350 for 40-50 minutes. | 8) Variation for White Cake: Use 4 egg whites instead of the 3 whole eggs. | 9) Variation for Spice Cake: Add 1-1/2 teaspoons cinnamon, 1/4+1/8 teaspoon ground allspice, 1/4+1/8 teaspoon ground cloves to the flour mixture. | 10) Variation for Chocolate Cake: Use chocolate pudding mix and 1/3 cup cocoa. (I then up the milk a little.).", "tags": ["mixer", "for large groups", "oven", "small appliance", "4 hours"], "cook_time_min": 45, "servings": null, "cuisine": ["All"], "rating_avg": 4.62, "rating_count": 27, "popularity_score": 4.640000000000001, "nutrition_calories": 382.3, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/20/86/45/3mcjqvWhT36ffxJu3drx_food.com-47.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["mixer", "for large groups", "oven", "small appliance", "4 hours"], "ingredients": []}, {"recipe_id": "rec_506", "props": {"title": "Honeybee Gluten-Free Dump Cake", "instructions": "[Instructions] 1) NOTE: You will need a food processor or blender for best results. | 2) Preheat oven to 350 degrees F. | 3) In a 9X9 nonstick baking pan; dump in the drained pineapple chunks then spread in the cherry pie filling. | 4) Place the polenta chunks with the honey and the yogurt into a food processor or blender and mix until blended. | 5) Add the cinnamon and cardamom to the polenta mix and process until well blended. Scrape down the sides of the processor, if necessary. | 6) Add the softened butter to the polenta mixture and process once more until well blended. | 7) Spread the polenta mixture over the cherry-pineapple mixture then bake, uncovered, for 40 minutes in the middle of the oven. | 8) Remove and let cool a little bit then enjoy!", "tags": ["60 mins"], "cook_time_min": 40, "servings": null, "cuisine": ["All"], "rating_avg": 4.25, "rating_count": 4, "popularity_score": 4.567142857142857, "nutrition_calories": 201.3, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/35/40/30/OFdn7YaQzG0PE3GPtpTm_gluten-free-dump-cake-02943.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["60 mins"], "ingredients": []}, {"recipe_id": "rec_507", "props": {"title": "Individual Baked Alaska", "instructions": "[Instructions] 1) To make the chocolate sauce: chop the chocolate to a rough consistency. | 2) Heat the cream just to a scald, then pour over the chocolate. | 3) Do not stir. | 4) Let it sit for about 5 minutes, then stir with a whisk until smooth. | 5) Makes about 1 cup. | 6) To make the raspberry sauce: Puree the raspberries in a blender with the remaining ingredients. | 7) Strain through a fine mesh strainer to remove the seeds. | 8) Refrigerate until needed. | 9) Makes about 1 cup. | 10) To assemble the ice-cream bases: line a baking sheet with parchment. | 11) Using a 3\" round cookie cutter (or a glass) cut 6 circles out of the cake, and place them on the parchment. | 12) Place a scoop of ice cream in the center of each piece of cake, making sure you leave a small margin of cake visible all the way around. | 13) Place in the freezer until the meringue is ready. | 14) To prepare the meringue: combine the sugar, corn syrup and water in a heavy, 1-quart saucepan over medium heat. | 15) Bring to a boil, then cook until the syrup reaches 230 degrees F. | 16) (thread stage) on a candy thermometer. | 17) Meanwhile, place the egg whites in the bowl of your mixer, and fit the whip attachment to your mixer. | 18) When the syrup reaches the thread stage, start whipping your egg whites on high speed. | 19) When the syrup reaches 245-250 degrees F. | 20) (firm-ball stage), lower the speed of the mixer to low, and very, very, VERY slowly start pouring the syrup in, in a slow, steady, thin stream until it is all used up. | 21) Immediately return the mixer to high speed and continue whipping until the meringue reaches a very stiff peaked consistency. | 22) Transfer the meringue to a piping bag fit with a plain tip. | 23) Remove the ice cream bases from the freezer. | 24) Now you are going to create a meringue\"beehive\" around each scoop of ice cream. | 25) I find it easier to do this by removing one ice-cream scoop at a time to a cake turntable or a flat-work surface that I can spin around, like a small plate, pipe the meringue, then using a thin spatula, returning it carefully to the parchment. | 26) To pipe the meringue you need to start at the bottom edge of the cake, pipe a ring of meringue around the icecream so that it completely covers the cake edge. | 27) Then continue to pipe a line of meringue all around the scoop of ice cream, making sure you completely cover the ice cream, and that each line of meringue rests on top of the previous one. | 28) Finish with a small circle at the top. | 29) Repeat with remaining ice cream bases. | 30) Return them to the freezer until ready to serve. | 31) Just before service, decorate your plate: choose an oversize plate, like a dinner plate. | 32) Then using the sauces, paint or spoon or swirl them on to your hearts content. | 33) Any design you like. | 34) I like to just use squiggles, but anything goes at this point. | 35) Now- if you don't have a torch, you will need to turn your oven to broil. | 36) If you have a torch, get it ready. | 37) Remove the meringues from the freezer, and dust the top of each one with the confectioners sugar in a fine mesh strainer. | 38) If you are using a broiler, place the baking sheet under the broiler but leave the door open and watch. | 39) You will only need about 30-45 seconds, just enough time for the meringue to turn golden brown. | 40) Remove from the oven, place one in the center of each plate, and serve. | 41) If you are using a torch, turn your torch to a med-low setting, and carefully, gently use the torch to brown the outside of the meringues. | 42) Place one meringue on each plate, and serve. | 43) Notes: You can use any type of cake you want here- this recipe is more a method than anything. | 44) I've used chocolate chiffon as a base, I've used spongecake, poundcake, leftover slices of cupcakes! | 45) Anything, anyflavor, but it needs to be at least 1/4\" thick. | 46) You can also use any flavor ice-cream- experiment, go wild. | 47) Sorbet is great this way- I've done mango sorbet, and lime sorbet- they taste terrific. | 48) Experiment, have fun, and don't be intimidated by this dessert. | 49) It's fun, and it's easy, and your friends and relatives will\"oooohhhh! | 50) \"and\"ahhhhh! | 51) \"you to death!", "tags": ["dessert", "low protein", "60 mins"], "cook_time_min": 12, "servings": null, "cuisine": ["All"], "rating_avg": 4.83, "rating_count": 7, "popularity_score": 4.75, "nutrition_calories": 796.8, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/51/66/7/gXKnk2ZoRqR9hlRzb7oQ_0S9A1621.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["dessert", "low protein", "60 mins"], "ingredients": []}, {"recipe_id": "rec_508", "props": {"title": "Irish Dessert", "instructions": "[Instructions] 1) Combine pineapple and juice with pudding mix. | 2) Add nuts and marshmallows (if desired) and stir until combined. | 3) Fold in Cool Whip and mix well. | 4) Place in individual serving dishes or a medium bowl. | 5) Chill for at least an hour. | 6) Enjoy!", "tags": ["pineapple", "tropical fruits", "fruit", "european", "kid friendly", "potluck", "st patrick s day", "15 mins", "no cook", "refrigerator", "easy"], "cook_time_min": 15, "servings": null, "cuisine": ["All"], "rating_avg": 4.75, "rating_count": 9, "popularity_score": 4.720526315789474, "nutrition_calories": 240.8, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/gk-static/fdc-new/img/fdc-shareGraphic.png"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["pineapple", "tropical fruits", "fruit", "european", "kid friendly", "potluck", "st patrick s day", "15 mins", "no cook", "refrigerator", "easy"], "ingredients": []}, {"recipe_id": "rec_509", "props": {"title": "Jiffy Cinnamon Rolls with Cream Cheese Frosting", "instructions": "[Instructions] 1) In a large mixing bowl, combine 3 cups flour, cake mix, yeast, salt, and warm water; mix until smooth. | 2) Add enough remaining flour to form a soft dough. | 3) Turn out onto a lightly floured surface and knead until smooth (6-8 minutes). | 4) Roll dough into a 9 X 18-inch rectangle. | 5) Spread with butter and sprinkle with sugar and cinnamon. | 6) Roll dough jelly-roll style, starting with the long end. | 7) Slice the roll into 1-inch circles with a piece of dental floss or heavy thread placed under roll. | 8) Bring ends of floss up and crisscross at top of roll and pull strings in opposite directions. | 9) Place rolls on a greased cookie sheet. | 10) Cover and let rise on a warm place until doubled, about 15 minutes. | 11) Bake at 350 for 15-18 minutes. | 12) While rolls are baking, beat together cream cheese, butter, confectioners sugar, vanilla extract, and salt. | 13) Spread frosting on warm rolls before serving.", "tags": ["breakfast", "healthy", "christmas", "sweet", "brunch", "60 mins"], "cook_time_min": 15, "servings": null, "cuisine": ["All"], "rating_avg": 4.0, "rating_count": 4, "popularity_score": 4.4957142857142856, "nutrition_calories": 509.5, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/68/59/1/LnqVVOlyRrAX7RtnIOOw_untitled-1662.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["breakfast", "healthy", "christmas", "sweet", "brunch", "60 mins"], "ingredients": []}, {"recipe_id": "rec_510", "props": {"title": "Key Lime Zucchini Bread", "instructions": "[Instructions] 1) For the bread: Position an oven rack in the center of the oven and preheat to 350 degrees F. Spray a 9-inch round tube pan with nonstick cooking spray; set aside. | 2) Whisk together the flour, granulated sugar, pumpkin spice blend, baking soda, salt and baking powder in a large bowl. Whisk together the oil, lime juice, vanilla and eggs in a medium bowl or large measuring cup. Add the wet ingredients to the flour mixture along with the grated zucchini and mix well. | 3) Spoon the batter into the prepared tube pan and spread in an even layer. Bake until a cake tester or skewer inserted in the center of the bread comes out clean, 1 hour to 1 hour 5 minutes. Transfer the pan to a wire rack to cool completely, then remove from pan to a plate or cake stand. | 4) For the glaze: Whisk together the confectioners' sugar and lime zest and juice in a medium bowl until smooth and pourable. If the icing is too thick, add water a teaspoon at a time until the desired consistency is reached. | 5) Pour the icing over the bread, then top with lime twists.", "tags": ["4 hours"], "cook_time_min": 2, "servings": null, "cuisine": ["All"], "rating_avg": 4.0, "rating_count": 1, "popularity_score": 4.63090909090909, "nutrition_calories": 488.3, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/53/85/29/RsqaAQhqT6GYmFM72xRc_0S9A0155.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["4 hours"], "ingredients": []}, {"recipe_id": "rec_511", "props": {"title": "Lemonade Pie (No Bake)", "instructions": "[Instructions] 1) Use mixer and mix the first three ingredients until fluffy. | 2) Pour into ready made crust. | 3) Refrigerate until firm. I let it set overnight. | 4) This can also be made with limeade and/or chocolate cookie crusts.", "tags": ["dessert", "weeknight", "no cook", "refrigerator", "easy"], "cook_time_min": 24, "servings": null, "cuisine": ["All"], "rating_avg": 4.54, "rating_count": 38, "popularity_score": 4.5720833333333335, "nutrition_calories": 441.0, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/11/91/3/JN9ggTZbSPuGI7czJihM_20%20(1%20of%201).jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["dessert", "weeknight", "no cook", "refrigerator", "easy"], "ingredients": []}, {"recipe_id": "rec_512", "props": {"title": "Light My Fire Brownie Sundaes", "instructions": "[Instructions] 1) Heat oven to 325\u00b0F You'll need 16 heart-shaped foil baking cups (raynoleds' fun shapes) on a rimmed baking sheet, or a 3in heart shaped cookie cutter and a 13 x 9 in baking pan lined with nonstick foil(let foil extend about 2 in above pan at both ends). | 2) Brownies: Microwave butter and chocolate in large bowl on high, stirring every 20 seconds, until melted and smooth. Whisk in sugar, then eggs, 1 at a time, then vanilla. With a rubber spatula, stir in flour, cocoa powder and salt just until blended. Stir in pecans. Divide batter evenly amoun baking cups, or spread into baking pan. | 3) Bake 20 to 22 minutes for foil cups, 24 to 26 minutes for baking pan, or until a wooden pick inserted in center comes out with moist crumbs clinging. Transfer to a wire rack; cool completely. Remove brownies from cups or, holding foil by ends, lift from pan, cut out 12 hearts with cookie cutter and carefully remove foil. | 4) Sauce: Drain pie filling in a colander; discard liquid. Mix 1 tbsp cranberry juice and the cornstarch in a small bowl. Stir remaining juice and the sugar in a 10 in skillet over medium-high heat until it boils and sugar dissolves. Using a whisk, stir in cornstarch mixture. Cook, stirring, until thickened. Add almond extract and cherries; stir 3 minutes or until hot. | 5) Slowly pour brandy over cherries and carefully ignite with a long match. Shake pan back and forth until flames die out. | 6) Top each with a small scoop of ice cream, then warm or room temperature sauce.", "tags": ["cookie and brownie", "for large groups", "4 hours"], "cook_time_min": 1, "servings": null, "cuisine": ["All"], "rating_avg": null, "rating_count": 0, "popularity_score": null, "nutrition_calories": 421.5, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/27/97/37/Z5NtEMG7TlmfblJVn23g_LightMyFireBrownieSundae%20Still%2001.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["cookie and brownie", "for large groups", "4 hours"], "ingredients": []}, {"recipe_id": "rec_513", "props": {"title": "Maple Krispie Cookies", "instructions": "[Instructions] 1) Preheat oven to 350\u00b0F degrees. | 2) In large bowl, mix all ingredients well (will be crumbly). | 3) Roll into 1-inch balls. | 4) Place 2 in apart on lightly sprayed cooking sheet. | 5) Bake for 10-12 minutes. Cool for 1 minute. | 6) Remove and cool completely.", "tags": ["lunch snacks", "cookie and brownie", "grains", "kid friendly", "potluck", "30 mins", "oven", "beginner cook", "easy"], "cook_time_min": 12, "servings": null, "cuisine": ["All"], "rating_avg": 4.85, "rating_count": 33, "popularity_score": 4.813720930232558, "nutrition_calories": 1062.7, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/21/77/0/M0C6stw0QbGvo0Tmkart_DSC05171-2.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["lunch snacks", "cookie and brownie", "grains", "kid friendly", "potluck", "30 mins", "oven", "beginner cook", "easy"], "ingredients": []}, {"recipe_id": "rec_514", "props": {"title": "Mexican Wedding Cookies", "instructions": "[Instructions] 1) Combine all ingredients. | 2) Form into 1 1/2\" balls. | 3) Bake on cookie sheet at 350\u00b0F for about 10-15 minutes or until set. | 4) Roll in additional powdered sugar while still warm.", "tags": ["cookie and brownie", "mexican", "30 mins", "for large groups", "oven", "easy"], "cook_time_min": 10, "servings": null, "cuisine": ["All"], "rating_avg": 4.78, "rating_count": 44, "popularity_score": 4.764074074074074, "nutrition_calories": 106.4, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/82/78/NIa2EZqySFaaJaBfl6xS_mexican-wedding-cookies-6035.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["cookie and brownie", "mexican", "30 mins", "for large groups", "oven", "easy"], "ingredients": []}, {"recipe_id": "rec_515", "props": {"title": "Milk and Cookie Cups", "instructions": "[Instructions] 1) Make the panna cotta filling:. | 2) Pour the water into a small bowl. Sprinkle the gelatin powder over this and set aside to bloom for 5 minutes. | 3) In a medium pot, add the milk and sugar. Heat over a medium heat whilst stirring until gently steaming. Turn the heat down to low and pour in the gelatin mixture, stir together until the gelatin has melted inches. | 4) Remove from the heat and pour in the heavy cream. | 5) Strain into a bowl resting in an ice bath. Let sit for 1-2 hours cool, stirring occasionally, until thick but still pourable. (If it isn\u2019t thickening, chill in the fridge for 30-60 minutes to speed it up). | 6) While the panna cotta filling chills, make the cookie cups:. | 7) Preheat the oven to 350 degrees F. Spray a non-stick 24-cup mini muffin pan with oil or cooking spray. | 8) In a large bowl, cream the softened butter and sugar together until smooth. Add the egg, vanilla, salt and baking powder, mix to combine. | 9) Add the flour and stir to get a thick dough. Fold in the chocolate chips until evenly distributed throughout the dough. | 10) Divide the dough between the wells in the muffin tin \u2013 you should be using about 1 level tablespoon of dough for each well. | 11) Use your fingertips to press the cookie dough in each well into a cup shape. | 12) Place in the freezer for 10-15 minutes. | 13) Bake for 10 minutes \u2013 the cookie dough should still be a bit soft in the centre but the edges should be starting to set. They may rise and lose some of their \u2018cup\u2019 shape, this is okay! | 14) While the cookies are still soft, use the end of a wooden spoon (or the end of a pestle from a pestle & mortar) to push a large indent back into the centre of each cup. | 15) Return to the oven for an additional 3 minutes. | 16) Let cool in the pan for a few minutes then remove from the pan using a small spatula or butter knife. Place into a wire rack to cool completely. | 17) Fill the cups:. | 18) Transfer the thickened, pourable panna cotta filling to a jug. | 19) Fill the cooled cookie cups with the panna cotta filling up to the brim. | 20) Place onto a tray or large plate and transfer to the fridge to chill for at least an hour until the panna cotta has completely set. | 21) Store in the fridge. | 22) Tools:. | 23) Wilton 24 cup mini muffin pan. | 24) Buy it on Amazon: https://www.amazon.com/Wilton-Perfect-Results-Non-Stick-Cupcake/dp/B004EBS16G.", "tags": ["4 hours", "easy"], "cook_time_min": 2, "servings": null, "cuisine": ["All"], "rating_avg": 5.0, "rating_count": 2, "popularity_score": 4.745, "nutrition_calories": 116.6, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/52/81/01/2jc9z0TTKI7MMbdIdA0W_untitled-1034.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["4 hours", "easy"], "ingredients": []}, {"recipe_id": "rec_516", "props": {"title": "Mimi's Red Velvet Cake", "instructions": "[Instructions] 1) Cream the shortening and sugar. | 2) Add the eggs and beat till smooth and well blended. | 3) Add the flour, cocoa, and salt to the above, alternately with the buttermilk, beating well after each addition. | 4) Add the vanilla and food coloring. | 5) Mix the baking soda and vinegar together and fold into the batter by hand; stir just enough to get it inches. | 6) Pour into a greased and floured angel pan and bake in a 350 degree oven for 30 minutes; can be baked in two layers also.", "tags": ["60 mins"], "cook_time_min": 30, "servings": null, "cuisine": ["All"], "rating_avg": 5.0, "rating_count": 7, "popularity_score": 4.82, "nutrition_calories": 3500.4, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/21/24/80/mFoVaYJSciVPnVaBvGKg_velvet%20cake-1194.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["60 mins"], "ingredients": []}, {"recipe_id": "rec_517", "props": {"title": "Momofuku Crack Pie", "instructions": "[Instructions] 1) Preheat oven to 375\u00b0F. | 2) In a large bowl, sift together flour, baking powder, baking soda and salt. | 3) In a stand mixer with the paddle attachment (or a large mixing bowl with a hand-held electric mixer), beat together butter, brown sugar and white sugar until light and fluffy. Add egg and beat until combined. | 4) With mixer running on low, add flour mixture in small increments until fully combined. Add oats and mix until combined. | 5) Spread mixture into an unlined, ungreased 9x13 baking sheet. Bake in preheated oven 20 minutes until golden brown and set. Cool a few minutes in pan, then turn out onto a rack until cool to the touch. Lower the oven to 350\u00b0F while the cookie cools. | 6) Crumble the cooled cookie into the workbowl of a food processor. Add butter, brown sugar and salt. Pulse until combined (a clump of the mixture should hold together when pinched together). Divide the mixture between 2 10\" pie pans, pressing into an even, thin layer on the bottom and sides. (The top edge will be ragged.). | 7) In a large bowl, whisk together white sugar, brown sugar, salt and powdered milk. Add melted butter, cream and vanilla and whisk until smooth. Whisk in egg yolks one at a time. Be careful not to incorporate too much air. | 8) Divide the filling evenly between the two pie crusts. Bake one pie at a time for 15 minutes, then reduce heat to 325\u00b0F for 10 minutes, until the filling is golden brown but still jiggly (like a pecan pie). Place pie pans on a rack to cool. | 9) Refrigerate the pies until well-chilled; the filling will be gooey. Dust with powdered sugar before serving.", "tags": ["dessert", "kosher", "sweet", "mixer", "for large groups", "oven", "small appliance", "4 hours"], "cook_time_min": 1, "servings": null, "cuisine": ["All"], "rating_avg": 5.0, "rating_count": 4, "popularity_score": 4.781428571428571, "nutrition_calories": 452.0, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/41/52/83/HiU7TnMtRGwadG3NZSBv_DSC_5926.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["dessert", "kosher", "sweet", "mixer", "for large groups", "oven", "small appliance", "4 hours"], "ingredients": []}, {"recipe_id": "rec_518", "props": {"title": "Mom's Caramel Rolls", "instructions": "[Instructions] 1) Mix water and yeast and wait 5 minutes. | 2) Stir in sugar, salt and 2 cups of flour. | 3) Add egg and butter and mix. | 4) Stir in rest of flour by hand, if dough is still sticky add just enough to make it not sticky anymore. | 5) Let raise until dough is double in size. | 6) Sprinkle flour on surface and roll dough out until is approx 18 X 12 inches. | 7) Spread a very thin layer of soft butter on dough and sprinkle cinnamon/sugar mixture on it. | 8) Roll dough from the long side, it should look like a log. | 9) Cut into 1 inch pieces. | 10) Should be 18 pieces. | 11) Place brown sugar and butter into microwave dish and heat until butter is just melted; stir well. | 12) Stir in 3 T water. | 13) Divide mixture into 3 pans (8-inch cake pans). | 14) Place 6 pieces in each pan. | 15) Let raise for about 45 minutes. | 16) Bake for 20 minutes in a 325\u00b0F oven. | 17) When you take out of oven, turn each pan of rolls over on a plate, otherwise you will have a hard time getting them out when they cool. | 18) If you can, let them cool slightly and enjoy them when they are still warm.", "tags": ["breads", "breakfast", "healthy", "weeknight", "brunch", "for large groups", "4 hours"], "cook_time_min": 20, "servings": null, "cuisine": ["All"], "rating_avg": 4.93, "rating_count": 44, "popularity_score": 4.886296296296296, "nutrition_calories": 352.4, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/61/93/2/EkGSiHiQSRqJ07VtvaOU_14.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["breads", "breakfast", "healthy", "weeknight", "brunch", "for large groups", "4 hours"], "ingredients": []}, {"recipe_id": "rec_519", "props": {"title": "New Orleans Double-chocolate Praline-fudge Cake", "instructions": "[Instructions] 1) Cake: | 2) Preheat oven to 350 degrees. | 3) Combine butter, cocoa and water in a saucepan. | 4) Cook, stirring constantly, over low heat until the mixture is smooth and butter has melted; remove from heat and cool. | 5) Combine the buttermilk, eggs, baking soda and vanilla; beat on medium speed with a mixer until smooth. | 6) Combine the butter mixture and buttermilk mixture; beat until well blended. | 7) Combine the sugar, flour and salt in a bowl; mix well. | 8) Gradually add the flour mixture to the buttermilk mixture; beat until blended. | 9) The batter should be thin. | 10) Spray three 8\" round cake pans with cooking spray and line them with wax paper. | 11) Pour the batter evenly into the pans and bake at 350 degrees for 22-24 minutes or until cake tests for doneness. | 12) Cool in pans on wire racks for 10 minutes; remove from pans and cool completely. | 13) To assemble the cake:. | 14) Spread 1/2 c ganache between the cake layers; spread the remainder on the sides of the cake and chill for 30 minutes. | 15) Slowly pour the frosting over the center of the cake. | 16) Spread it to the edges of the cake, allowing some frosting to run down the sides. | 17) Chocolate Ganache:. | 18) Microwave the chocolate and cream in a glass bowl for 2-3 minutes, or until the chocolate is melted; whisk until smooth. | 19) Gradually add the butter, whisking until smooth and melted. | 20) Cool, whisking often, until spreading consistency, about 15-20 minutes. | 21) Praline Frosting:. | 22) Combine the butter, brown sugar and whipping cream in a 2 quart saucepan; bring to a boil, stirring often. | 23) Boil 1 min; remove from heat and whisk in powdered sugar and vanilla. | 24) Add the pecans and stir gently for 2-5 minutes, or until the frosting begins to cool and thicken slightly. | 25) Pour immediately over the cake.", "tags": ["microwave", "oven", "4 hours"], "cook_time_min": 25, "servings": null, "cuisine": ["All"], "rating_avg": 4.93, "rating_count": 44, "popularity_score": 4.886296296296296, "nutrition_calories": 1194.5, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/11/94/49/DrsFILPSA27p4YFVCVbS_23.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["microwave", "oven", "4 hours"], "ingredients": []}, {"recipe_id": "rec_520", "props": {"title": "New York Cheesecake", "instructions": "[Instructions] 1) For crust, combine graham cracker crumbs and melted butter. | 2) Stir until well combined. | 3) Press onto bottom and about 2-1/2 inches up the sides of a 9x3-inch springform pan. | 4) Mix cream cheese, sugar, flour, and vanilla. | 5) Beat with an electric mixer until fluffy. | 6) Add eggs and egg yolks, beating on low speed just until combined. | 7) Stir in whipping cream and lemon peel. | 8) Pour into pan. | 9) Place pan in a shallow baking pan in the oven. (Does not mention anything about a water bath) | 10) Bake in a 325 degree F oven about 1-1/2 hours or until center appears nearly set when shaken. | 11) Cool 15 minutes. | 12) Loosen crust from sides of pan. | 13) Cool 30 minutes more; remove sides of pan. | 14) Cool completely. | 15) Chill 4 to 24 hours. | 16) If desired, garnish with fresh berries.", "tags": ["dessert", "cheese", "weeknight", "oven", "4 hours"], "cook_time_min": 1, "servings": null, "cuisine": ["All"], "rating_avg": 4.85, "rating_count": 196, "popularity_score": 4.842427184466019, "nutrition_calories": 630.6, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/57/02/5/10PIImsmQwqM1uXdc7FF_cheesecake-cherries-7411.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["dessert", "cheese", "weeknight", "oven", "4 hours"], "ingredients": []}, {"recipe_id": "rec_521", "props": {"title": "Oreo-Stuffed Panookie", "instructions": "[Instructions] 1) Mix butter and sugar until creamy. | 2) Sift flour, baking soda, and salt. Set aside. | 3) Add egg and vanilla extract to the butter mixture. | 4) Add flour mixture. | 5) Stir in the dark chocolate. | 6) Divide the dough in half. | 7) Spread/press one half of the dough on the bottom of an 8\u201d skillet. | 8) Lay out Oreo cookies. | 9) Then add another layer of dough on top. | 10) Bake at 350F for 20-25mins. | 11) TO MAKE CHOCOLATE SYRUP TOPPING. | 12) Add bitter chocolate, sugar, butter, cocoa powder, and water into a pan. | 13) Simmer at low heat. Stir until smooth. | 14) Then add heavy cream and simmer for approximately 3 minutes. Mix thoroughly. | 15) TO SERVE. | 16) Slice panookie and serve with a scoop of vanilla ice cream and chocolate syrup drizzled on top.", "tags": ["cookie and brownie", "60 mins"], "cook_time_min": 20, "servings": null, "cuisine": ["All"], "rating_avg": null, "rating_count": 0, "popularity_score": null, "nutrition_calories": 567.2, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/submissions/recipe/33186/vuUAiZjlTJSpJWMDNNOW_Oreo-Stuffed%20Panookie%2002.jpeg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["cookie and brownie", "60 mins"], "ingredients": []}, {"recipe_id": "rec_522", "props": {"title": "Paul Bocuse's Creme Brulee", "instructions": "[Instructions] 1) Preheat the oven to 275\u00baF. In a medium bowl, whisk the egg yolks with half of the granulated sugar. In a small saucepan, warm the cream with the vanilla scrapings and the remaining granulated sugar until steaming. Gradually whisk the hot cream into the egg yolks until blended. Strain the custard and pour it into 5-ounce ramekins or shallow gratin dishes. | 2) Set the ramekins in a small baking dish and add enough hot tap water to the dish to reach halfway up the sides of the ramekins. Bake for about 1 hour and 15 minutes, or until just set. Let cool in the water bath for 10 minutes, them remove and let cool completely. Cover and refrigerate for at least 4 hours or overnight. | 3) Preheat the broiler. Sift a thin even layer of the air-dried brown sugar over each custard. Broil 1 ramekin at a time as close as possible to the heat source, until the sugar melts, forming a caramelized crust. Serve immediately. | 4) Notes: To air dry brown sugar, sift it onto a plate and leave it out, uncovered, for 1 day. If it's humid, the sifted sugar can also be dried in a 250\u00baF oven for 20 minutes.", "tags": [], "cook_time_min": 5, "servings": null, "cuisine": ["All"], "rating_avg": 4.64, "rating_count": 11, "popularity_score": 4.6657142857142855, "nutrition_calories": 594.2, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/17/64/66/gilfGERIT4yAyf8jdC5F_cremefood2.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": [], "ingredients": []}, {"recipe_id": "rec_523", "props": {"title": "Peach Cobbler Dump Cake", "instructions": "[Instructions] 1) Preheat oven to 375\u00baF. | 2) Empty peaches into the bottom of a 13 x 9- inch pan. | 3) Cover with the dry cake mix and press down firmly. | 4) Cut butter or margarine into small pieces and place on top of cake mix. | 5) Sprinkle top with cinnamon. | 6) Bake for 45 minutes.", "tags": ["fruit", "low protein", "60 mins", "oven", "easy"], "cook_time_min": 45, "servings": null, "cuisine": ["All"], "rating_avg": 4.67, "rating_count": 40, "popularity_score": 4.6748, "nutrition_calories": 372.4, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/60/50/1/zLXlRKywR86uMJQbCQb1_PEACH_COBBLER_DUMP_CAKE_024.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["fruit", "low protein", "60 mins", "oven", "easy"], "ingredients": []}, {"recipe_id": "rec_524", "props": {"title": "Peanut Butter Chocolate Chip Muffins", "instructions": "[Instructions] 1) Preheat oven to 350/gas 4. | 2) Measure flour using the spoon (not scoop) method. | 3) Into a medium sized bowl sift flour, baking powder, baking soda and salt. Whisk to combine and set aside. | 4) In a small jug mix vanilla extract and milk, set aside. | 5) In a large bowl mix melted butter with peanut butter followed by sugar, beat until light and fluffy. | 6) With a fork, whisk egg until lightly beaten and in two steps pour into butter/sugar mixing to combine. | 7) Next in three steps start to add the flour alternating with the milk (flour, milk, flour, milk, ending with flour). | 8) Finally fold in chocolate chips. | 9) Spoon batter into paper lined muffin tin and bake for 20-23 minutes.", "tags": ["breads", "lunch snacks", "60 mins", "easy"], "cook_time_min": 23, "servings": null, "cuisine": ["All"], "rating_avg": 4.5, "rating_count": 8, "popularity_score": 4.607777777777778, "nutrition_calories": 344.4, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/24/03/40/yaSzreMlQLSdT3KdtpFg_peanut-butter-chocolate-chip-muffins-1553.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["breads", "lunch snacks", "60 mins", "easy"], "ingredients": []}, {"recipe_id": "rec_525", "props": {"title": "Peanut Butter Chocolate Cupcakes", "instructions": "[Instructions] 1) In a small mixing bowl, beat cream cheese, peanut butter, sugar and milk until smooth. | 2) Set aside. | 3) In a bowl, combine sugar, flour, cocoa, baking powder, salt and baking soda. | 4) In another bowl, whisk the eggs, water, oil and vanilla. | 5) Stir into dry ingredients just until moistened. (batter will be thin.). | 6) Fill paper-lined jumbo muffin cups half full with batter. | 7) Drop scant tablespoons of peanut butter mixture into center of each. | 8) Cover with remaining batter. | 9) Bake at 350 degrees for 25-30 minutes or until toothpick comes out clean. | 10) Cool 10 minutes. | 11) Remove from pans to wire racks. | 12) Cool completely. | 13) Combine frosting ingredients. | 14) Frost cupcakes. | 15) Store in refrigerator.", "tags": ["60 mins"], "cook_time_min": 25, "servings": null, "cuisine": ["All"], "rating_avg": 4.67, "rating_count": 7, "popularity_score": 4.684117647058823, "nutrition_calories": 6021.8, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/27/85/42/BiJJMaUcQ0mHRdRhXRbb_PB%20Chocolate%20cupcakes%20SITE-2.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["60 mins"], "ingredients": []}, {"recipe_id": "rec_526", "props": {"title": "3-Ingredient Peanut-Butter-Lover Cookies", "instructions": "[Instructions] 1) Mix ingredients together. | 2) Drop by spoonful onto baking sheet. | 3) Bake for 10 minutes at 325\u00b0F or 8-10 minutes at 350\u00b0.F.", "tags": ["cookie and brownie", "high protein", "kid friendly", "high in", "15 mins", "easy", "inexpensive"], "cook_time_min": 10, "servings": null, "cuisine": ["All"], "rating_avg": 4.52, "rating_count": 49, "popularity_score": 4.549491525423728, "nutrition_calories": 164.6, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/59/79/2/SdSSBv61SPeo2Tr3msYV_0S9A1538.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["cookie and brownie", "high protein", "kid friendly", "high in", "15 mins", "easy", "inexpensive"], "ingredients": []}, {"recipe_id": "rec_527", "props": {"title": "Peanut Butter No Bake Cookies", "instructions": "[Instructions] 1) In lg saucepan, mix sugar, margarine, and milk; bring to a full, rolling boil over med heat. (full, rolling boil = large bubbles rising to surface that can't be stirred down). | 2) Boil for one minute, stirring constantly. | 3) Remove from heat and stir in peanut butter and vanilla, stirring until peanut butter is melted; stir in oats. | 4) Working quickly, drop by spoonfuls onto waxed paper . Let cool completely.", "tags": ["dessert", "cookie and brownie", "kid friendly", "30 mins", "15 mins", "beginner cook", "easy"], "cook_time_min": 2, "servings": null, "cuisine": ["All"], "rating_avg": 4.73, "rating_count": 131, "popularity_score": 4.727446808510639, "nutrition_calories": 93.4, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/12/90/40/zFnvBQ4HSzqFNerirN8R_no-bake-peanut-butter-cookies-1467.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["dessert", "cookie and brownie", "kid friendly", "30 mins", "15 mins", "beginner cook", "easy"], "ingredients": []}, {"recipe_id": "rec_528", "props": {"title": "Pina Colada Pineapple Cakes", "instructions": "[Instructions] 1) To make yellow pieces:. | 2) Place the yellow candy melts into a medium, heatproof bowl. | 3) Fill a small pot of water with a 2-inch depth of water. Set over a low heat with the bowl of yellow candy melts on top. Stir until the yellow candy melts have melted and are smooth. Remove from the heat. | 4) Drop a small dollop (about 1/4 to 1/8 tsp) of the melted candy melt onto a baking sheet lined with parchment paper. Using a small, offset spatula make a brushstroke motion over the dollop of candy melt to spread it out into a thin oval. | 5) Repeat this with all of the melted yellow candy melts \u2013 you may need to re-melt it in the bowl if it\u2019s starting to set. | 6) Chill for 15-20 minutes until set. | 7) To make green leaf crown top:. | 8) Place the green candy melts into a small, heatproof bowl. | 9) Fill a small pot of water with a 2-inch depth of water. Set over a low heat with the bowl of green candy melts on top. Stir until the green candy melts have melted and are smooth. Remove from the heat. | 10) Drop a small dollop of green candy melt onto a baking sheet lined with baking paper. Use a brushstroke motion (similar to before, but in a longer motion to make a longer stripe) to make one thin, long leaf. Repeat with dollops of candy melt close together, connecting them at the base, to make the green leaf crown. | 11) Repeat with the green candy melts to make a total of 6 crowns. | 12) Chill for 15-20 minutes until set. | 13) To make pineapple cake:. | 14) Preheat the oven to 350 degrees F. Grease two quarter-sheet pans (9 x 13 inches). | 15) In a large bowl, mix the white cake mix, half the vanilla pudding mix, all of the vegetable oil, the 4 eggs, the water and half of the rum. | 16) Drain the crushed pineapple but reserve the juice. Add half of the crushed pineapple to the cake batter along with all of the shredded coconut. Fold together to combine. | 17) Divide the cake batter evenly between the two prepared cake pans, spreading out into even layers. Bake for 15-20 minutes until golden and a toothpick inserted into the centre of the cake comes out clean. | 18) Let cool completely before assembly. | 19) To make the frosting:. | 20) In a large bowl combine the remaining crushed pineapple, remaining light rum, the reserved pineapple juice and remaining vanilla pudding mix, stirring until smooth and thickened. | 21) Fold in the thawed cool whip. Add the yellow food colouring and fold together to combine. | 22) Assemble:. | 23) Remove the cooled cake layers from the baking sheets. Use a 3-inch round cookie cutter to punch out 9 circles from each of the cake layers (so you have a total of eighteen 3-inch circles). | 24) Stack 3 cake circles on top of each other, sandwiching them together with 1 tbsp frosting between each layer. Repeat so you get six small 3-layer cakes. | 25) Use a serrated knife to carefully carve each small cake into a pineapple shape. | 26) Cover each small cake with frosting in an even layer. | 27) Cover with the chilled yellow candy melt ovals: start at the top of the cake, layering in rings going around the cake, allowing the candy melts to overlap slightly, until each cake is completely covered. | 28) Transfer the melted semisweet chocolate chips to a disposable piping bag. Snip off the very tip so you have a tiny opening. Pipe dots of dark chocolate randomly onto the yellow candy melts to represent the \u2018eyes\u2019 of the pineapple. | 29) Top each cake with one of the green candy melt crowns. | 30) Serve. | 31) NOTE:. | 32) Adding shredded coconut to your cakes will make it easier to trim into pineapple shapes \u2013 the coconut addition is not shown in the recipe video.", "tags": ["pineapple", "tropical fruits", "fruit", "4 hours"], "cook_time_min": 20, "servings": null, "cuisine": ["All"], "rating_avg": null, "rating_count": 0, "popularity_score": null, "nutrition_calories": 852.6, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/53/58/29/HKDBlxgXTaKXTo1nzoy8_untitled-2858.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["pineapple", "tropical fruits", "fruit", "4 hours"], "ingredients": []}, {"recipe_id": "rec_529", "props": {"title": "Plum Kuchen", "instructions": "[Instructions] 1) Preheat oven to 350\u00b0F. | 2) Mix flour, 1 tablespoon sugar and baking powder together. | 3) Cut in butter until mixture looks like coarse crumbs; add 2 tablespoons heavy cream and 1 egg. | 4) Press in bottom of 9-inch square pan or pie pan and arrange plums on top. | 5) Bake for 25-30 minutes. | 6) While this is baking, in a bowl combine heavy cream, sugar, egg and vanilla, using a whisk to beat together well. | 7) Pour mixture over plums and bake an additional 20-30 minutes, until custard is set. | 8) Serve warm or cool. | 9) Store in refrigerator.", "tags": ["dessert", "plums", "fruit", "brunch", "oven", "4 hours", "easy"], "cook_time_min": 50, "servings": null, "cuisine": ["All"], "rating_avg": 4.6, "rating_count": 11, "popularity_score": 4.644761904761904, "nutrition_calories": 316.0, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/13/32/77/GFtDYpOISiauIsc5Kl87_Plum%20Kuchen_final_6.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["dessert", "plums", "fruit", "brunch", "oven", "4 hours", "easy"], "ingredients": []}, {"recipe_id": "rec_530", "props": {"title": "Puff Pastry Glazed Apricot Twists", "instructions": "[Instructions] 1) Set oven to 400 degrees. | 2) Line a baking sheet with parchment paper (you will most likely need two baking sheets for 16 pastries). | 3) Roll out one puff pastry sheet onto a lightly floured surface into a 12x10-inch rectangle, then cut in half lengthwise (I use a pizza cutter for this). | 4) Cut each half crosswise into four 5x3-inch strips (for a total of 8 strips). | 5) Spread each strip with about 1/2 tablespoon apricot jam, then fold the strips in half lengthwise to form 1-1/2-inch wide strips. | 6) Twist each strip 3 times, then place on the parchment-lined baking sheet. | 7) Repeat with the remaining puff pastry (you should have 16 pastries when done, you might have to use two baking sheets. | 8) Bake for about 15-20 minutes. | 9) Transfer the twists to a rack. | 10) In a small bowl whisk together confectioners sugar, whipping cream and lemon juice; brush over the warm pastries.", "tags": ["fruit", "kid friendly", "sweet", "brunch", "60 mins", "for large groups", "oven", "beginner cook", "easy"], "cook_time_min": 15, "servings": null, "cuisine": ["All"], "rating_avg": 4.25, "rating_count": 4, "popularity_score": 4.567142857142857, "nutrition_calories": 235.9, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/15/70/10/Tx6CtJbFS123zBltbSRl_apricot-twists-1.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["fruit", "kid friendly", "sweet", "brunch", "60 mins", "for large groups", "oven", "beginner cook", "easy"], "ingredients": []}, {"recipe_id": "rec_531", "props": {"title": "Puffed Bananas and Caramel", "instructions": "[Instructions] 1) Preheat oven to 200\u00b0C. | 2) Lay out pastry trimmings if using or cut strips from the 1/2 sheet. | 3) Place the banana down on top of pastry. | 4) Dust with icing sugar, then wrap the pastry around the length of the banana. | 5) Bake in pre-heated for 10 to 15 minutes. | 6) Caramel Sauce - in a saucepan, melt the butter and add the sugar and continue to stir until caramel consistency is achieved.", "tags": ["tropical fruits", "fruit", "australian", "low protein", "30 mins", "oven", "stove top"], "cook_time_min": 25, "servings": null, "cuisine": ["All"], "rating_avg": 4.67, "rating_count": 6, "popularity_score": 4.685, "nutrition_calories": 619.2, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/40/51/64/kyVR6eQTnaLCLBv3hEZz_puff-bananas-4.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["tropical fruits", "fruit", "australian", "low protein", "30 mins", "oven", "stove top"], "ingredients": []}, {"recipe_id": "rec_532", "props": {"title": "Raspberry Walnut Torte", "instructions": "[Instructions] 1) Preheat oven to 350\u00b0F. | 2) Combine 1 cup flour, confectioners\u2019 sugar and butter; blend well. | 3) Press mixture into bottom of 9-inch x 9-inch pan. Bake for 15 minutes. Cool. | 4) Drain raspberries (reserve liquid for sauce). Spoon berries over cooled crust; sprinkle with walnuts. | 5) Beat eggs with sugar in a small bowl until light and fluffy. Add salt, 1/4 cup flour, baking powder, and vanilla; blend well. Pour over walnuts. | 6) Bake at 350F for 30-35 minutes until golden brown. | 7) Cool and cut into squares. Serve with ice cream or whipped cream and sauce. | 8) TO MAKE SAUCE:. | 9) Combine reserved berry juice with 1/2 cup water, 1/2 cup sugar and 2 tablespoons cornstarch, in saucepan. Cook over medium heat, stirring constantly, until thickened and clear. Stir in 1 tablespoon lemon juice.", "tags": ["raspberries", "berries", "fruit", "4 hours"], "cook_time_min": 40, "servings": null, "cuisine": ["All"], "rating_avg": 4.82, "rating_count": 11, "popularity_score": 4.76, "nutrition_calories": 370.5, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/18/63/32/GxCIsA31SruPbqlF2df3_raspberry%20torte%20SITE-3.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["raspberries", "berries", "fruit", "4 hours"], "ingredients": []}, {"recipe_id": "rec_533", "props": {"title": "Rhubarb Dump Cake", "instructions": "[Instructions] 1) Preheat oven to 350 degrees. | 2) Line the bottom of an ungreased 13x9x2-inch baking pan with the rhubarb. | 3) Sprinkle sugar over the rhubarb. | 4) Sprinkle dry raspberry gelatin, ( or strawberry gelatin ) which ever you prefer; over the sugar. | 5) Next, sprinkle the cake mix over the gelatin. | 6) Melt butter; pour over the cake mix. | 7) Pour the 1 cup of water over cake mix. | 8) Bake for 45 minutes. | 9) Cool completely; then chill in refrigerator. | 10) When ready to serve, invert onto plate. | 11) Top with either vanilla ice cream or Cool Whip. | 12) Serves 12 to 16. | 13) Note: If using frozen rhubarb, reduce the amount of water to 1/2 cup. | 14) This cake was baked in a gas oven. | 15) If baking in an electric oven, you may need to increase baking time; depending upon oven and altitude. | 16) Chef sheerkerry baked hers in an electric oven for 1 hour and 10 minutes.", "tags": ["fruit", "low protein", "60 mins", "oven"], "cook_time_min": 45, "servings": null, "cuisine": ["All"], "rating_avg": 4.57, "rating_count": 7, "popularity_score": 4.642941176470588, "nutrition_calories": 340.8, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/63/95/7/ys0zFF71R9GSAl81fCx3_DSC05563-2.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["fruit", "low protein", "60 mins", "oven"], "ingredients": []}, {"recipe_id": "rec_534", "props": {"title": "Rice Pudding", "instructions": "[Instructions] 1) Bring rice, water and salt to a boil over med-high heat. | 2) Simmer covered until water has been absorbed (approximately 15 minutes). | 3) Stir in milk and sugar and cook uncovered over medium heat for 30-40 minutes, stirring frequently--especially towards the end of cooking. | 4) The pudding is done when the rice and milk have amalgamated into a thick porridge-like consistency. | 5) DO NOT OVERCOOK or the pudding will be solid instead of creamy once cooled. | 6) Remove from heat and stir in vanilla. | 7) Turn into a bowl or cups. | 8) You can sprinkle cinnamon on the top if you like. | 9) COVER with plastic wrap directly on surface \"IF\" you don't want a skin. | 10) COOL.", "tags": ["lunch snacks", "medium grain rice", "rice", "low protein", "low cholesterol", "healthy", "kid friendly", "60 mins", "stove top", "easy"], "cook_time_min": 55, "servings": null, "cuisine": ["All"], "rating_avg": 4.77, "rating_count": 240, "popularity_score": 4.766959999999999, "nutrition_calories": 757.5, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/91/60/VDQgwAoWRjClqQlZSKNz_rice%20pudding%20SITE-2.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["lunch snacks", "medium grain rice", "rice", "low protein", "low cholesterol", "healthy", "kid friendly", "60 mins", "stove top", "easy"], "ingredients": []}, {"recipe_id": "rec_535", "props": {"title": "Rocky Road Cookie Pizza", "instructions": "[Instructions] 1) Preheat oven at 350 degrees. | 2) Press or roll (using powder sugar) cookie dough to a lightly buttered 12 inch pizza pan. | 3) Cook 15- 20 minutes till lightly brown. | 4) Remove from oven. | 5) Sprinkle evenly with peanuts, chocolate chips, and marshmallows. | 6) Drizzle with caramel topping. | 7) Bake addition 5-10 till marshmallows are lightly brown. | 8) Let cool for 10 minutes. | 9) Cut into slices or squares. | 10) Yummy served with vanilla ice cream.", "tags": ["cookie and brownie", "60 mins", "for large groups", "easy", "inexpensive"], "cook_time_min": 30, "servings": null, "cuisine": ["All"], "rating_avg": 4.88, "rating_count": 8, "popularity_score": 4.776666666666666, "nutrition_calories": 119.8, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/86/64/3/EvIzjsuWRZGdv9N5JISH_Rocky%20Road%20Cookie%20Pizza_final%205.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["cookie and brownie", "60 mins", "for large groups", "easy", "inexpensive"], "ingredients": []}, {"recipe_id": "rec_536", "props": {"title": "Sangria Shortcakes", "instructions": "[Instructions] 1) Combine the red wine and 1/3 cup sugar in a medium saucepan. Bring to a boil over medium-high heat, then reduce to a simmer and continue to cook until the liquid is reduced to about 1/4 cup, 10 to 15 minutes. Let cool completely. | 2) Combine the cool syrup with the blackberries, cherries, strawberries and nectarines in a large bowl. Let marinate, refrigerated, until the fruit starts to macerate and release juices, about 1 hour and up to 4 hours. | 3) Preheat the oven to 400 degrees F. | 4) Whisk to combine the flour, baking powder, salt and remaining 3 tablespoons sugar in a large bowl. Add the heavy cream and mix until combined. | 5) Press the dough into an 8-inch square baking pan and bake until the edges are golden and the shortcake is cooked through, 18 to 20 minutes. Transfer the pan to a wire rack to cool completely. | 6) Cut into 6 pieces and split each shortcake in half horizontally. Spoon fruit on the bottom of each shortcake and top with a generous spoonful of whipped cream. Place the top of each shortcake over the whipped cream, then top with the remaining fruit. Drizzle the fruit sauce over the fruit and garnish each with a dollop of whipped cream and a mint sprig.", "tags": ["4 hours"], "cook_time_min": 2, "servings": null, "cuisine": ["All"], "rating_avg": null, "rating_count": 0, "popularity_score": null, "nutrition_calories": 671.6, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/53/85/31/wNert6lMRSaCPeoyrCav_0S9A0215.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["4 hours"], "ingredients": []}, {"recipe_id": "rec_537", "props": {"title": "Seven Layer Magic Bars", "instructions": "[Instructions] 1) Preheat oven to 350 (325 for glass dish). In 13x9\" baking pan, melt butter in oven. | 2) Sprinkle crumbs over butter. | 3) Pour sweetened condensed milk over crumbs. | 4) top with remaining ingredients in order listed; press down firmly. | 5) Bake 25 minutes or until lightly browned. | 6) Cool. | 7) Chill if desired. | 8) Cut into bars. | 9) Store covered at room temperature. TIP: for perfectly cut cookie bars: line entire pan (including sides) with a sheet of aluminum foil first. | 10) When bars are baked, cool; lift of edges of foil to remove from pan. | 11) Cut into individual squares. | 12) Lift off of foil. | 13) Keebler/ReaLemon/Borden.", "tags": ["dessert", "cookie and brownie", "60 mins", "for large groups", "oven"], "cook_time_min": 25, "servings": null, "cuisine": ["All"], "rating_avg": 4.7, "rating_count": 29, "popularity_score": 4.6984615384615385, "nutrition_calories": 157.6, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/12/93/hNSfw7TvRTVw4crZ6Fjy_IMG_9364.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["dessert", "cookie and brownie", "60 mins", "for large groups", "oven"], "ingredients": []}, {"recipe_id": "rec_538", "props": {"title": "Silky Chocolate Peanut Butter Pie", "instructions": "[Instructions] 1) Melt chocolate chips in a small bowl in microwave at high power 90 seconds. | 2) Stir until smooth. | 3) Cool slightly. | 4) Place tofu, peanut butter, sugar & vanilla in blender or food processor and whirl until smooth. | 5) Add chocolate and whirl until combined. | 6) Pour into crust. | 7) Cover with plastic wrap and refrigerate several hours until filling is set. | 8) Can garnish with peanuts, melted chocolate or whipped cream.", "tags": ["dessert", "soy tofu", "beans", "vegan", "kid friendly", "15 mins", "refrigerator"], "cook_time_min": 10, "servings": null, "cuisine": ["All"], "rating_avg": 4.82, "rating_count": 33, "popularity_score": 4.790697674418605, "nutrition_calories": 455.2, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/38/40/1/n2KbUbsUTE2dQ8UJHJj4_0S9A1081.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["dessert", "soy tofu", "beans", "vegan", "kid friendly", "15 mins", "refrigerator"], "ingredients": []}, {"recipe_id": "rec_539", "props": {"title": "Simple Jello Salad", "instructions": "[Instructions] 1) Empty whipped topping into a medium sized bowl. | 2) Sprinkle Jell-O over the top and fold in so it is well blended. | 3) Add cottage cheese and pineapple and fold into Jell-O mixture. | 4) Chill for about 4 hours so that the jello softens and slightly sets up. | 5) Serve.", "tags": ["dessert", "pineapple", "tropical fruits", "fruit", "potluck", "15 mins", "refrigerator", "easy", "inexpensive"], "cook_time_min": 15, "servings": null, "cuisine": ["All"], "rating_avg": 4.43, "rating_count": 21, "popularity_score": 4.51516129032258, "nutrition_calories": 270.7, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/49/90/2/Pxd9nkoCQJesHmMcTqoY_december%20files-5.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["dessert", "pineapple", "tropical fruits", "fruit", "potluck", "15 mins", "refrigerator", "easy", "inexpensive"], "ingredients": []}, {"recipe_id": "rec_540", "props": {"title": "Sour Cream Yellow Cake", "instructions": "[Instructions] 1) Preheat oven to 350\u00b0 and lightly grease and flour a 13x9 pan. | 2) Combine all ingredients in large mixing bowl and blend on low speed of mixer for 1 minute. | 3) Scrape down sides with spatula. | 4) Increase mixer speed to medium and beat an additional 2 minutes. | 5) Pour batter into prepared pan. | 6) Bake for 30 to 35 minutes or until golden brown and tests done when a toothpick inserted in the center comes out clean. | 7) Cool on a wire rack and frost as desired.", "tags": ["60 mins"], "cook_time_min": 30, "servings": null, "cuisine": ["All"], "rating_avg": 4.74, "rating_count": 37, "popularity_score": 4.730212765957448, "nutrition_calories": 318.0, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/99/86/6/FwssTSRTTe2VUmtGNae3_yellow-cake-06.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["60 mins"], "ingredients": []}, {"recipe_id": "rec_541", "props": {"title": "Southern Lemon Chess Pie", "instructions": "[Instructions] 1) Preheat oven to 400 degrees. | 2) In small bowl, beat egg whites until stiff. | 3) Set aside. | 4) In large bowl, cream together sugar, cornmeal, lemon juice, butter and egg yolks for 5 minutes or more until creamy. | 5) Gently fold beaten egg whites into this lemon mixture. | 6) Gently pour filling into pie crust. | 7) Bake about 15 minutes or until top of pie begins to brown. | 8) Reduce oven temperature to 300 degrees and bake an additional 25 to 30 minutes or more until pie is just set in the middle. | 9) It should be a little jiggly, not runny, in the middle. | 10) Remove from oven and cool. | 11) It can be refrigerated, but is best served at room temperature. | 12) Covered, this pie will keep unrefrigerated for up to 4 days; however, it won't last that long!", "tags": ["dessert", "lemon", "citrus", "fruit", "weeknight", "mixer", "oven", "small appliance", "4 hours", "inexpensive"], "cook_time_min": 50, "servings": null, "cuisine": ["All"], "rating_avg": 4.71, "rating_count": 18, "popularity_score": 4.704285714285715, "nutrition_calories": 268.0, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/54/34/6/3dF6L4g4S420Q65tWXaq_Southern-lemon-chess-pie-54346-2.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["dessert", "lemon", "citrus", "fruit", "weeknight", "mixer", "oven", "small appliance", "4 hours", "inexpensive"], "ingredients": []}, {"recipe_id": "rec_542", "props": {"title": "Southern Living's Cream Cheese Pound Cake", "instructions": "[Instructions] 1) Preheat oven to 300\u00b0F. | 2) Use an electric mixer to mix both butter and cream cheese until creamy. | 3) Gradually add sugar and beat for 5 minutes, then add eggs one at a time, allowing each to incorporate before adding more. Stir in vanilla. | 4) Sift flour and salt and add gradually to the mixer, beating until well blended. | 5) Pour batter into a well greased and floured bundt pan or tube cake pan. | 6) Place 2 cups water in an ovenproof container on the rack in the oven next to the cake. | 7) Bake cake at 300 for an hour and 45 minutes, or until a toothpick can be removed cleanly. | 8) Place pan on a wire rack and cool for 15 minutes, then remove the cake from the pan and complete cooling on the wire rack.", "tags": ["kid friendly", "christmas", "sweet", "oven", "4 hours"], "cook_time_min": 1, "servings": null, "cuisine": ["All"], "rating_avg": 4.72, "rating_count": 54, "popularity_score": 4.7159375, "nutrition_calories": 7371.9, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/32/28/05/NjGBuspQRuCcJfARdi0p_cream-cheese-pound-cake-1405.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["kid friendly", "christmas", "sweet", "oven", "4 hours"], "ingredients": []}, {"recipe_id": "rec_543", "props": {"title": "Special Mocha Cupcakes", "instructions": "[Instructions] 1) In a small mixing bowl, combine the flour, sugar, cocoa, baking soda and salt. In a small bowl, mix the eggs, coffee, oil, vinegar and vanilla. | 2) Add to dry ingerdients; mix well. | 3) Fill paper-lined muffin cups three-fourths full. | 4) Bake at 350 for 20-25 minutes or until a toothpick comes out clean. | 5) Cool for 10 minutes before removing from pan to a wire rack to cool. | 6) For frosting, in a small microwave-safe bowl, melt chips; stir until smooth. | 7) Add butter; beat until blended. | 8) Gradually beat in confectioners' sugar and coffee. | 9) Pipe frosting onto cupcakes. | 10) Top with sprinkles; gently press down.", "tags": ["sweet", "60 mins", "oven", "easy"], "cook_time_min": 20, "servings": null, "cuisine": ["All"], "rating_avg": 3.8, "rating_count": 6, "popularity_score": 4.35875, "nutrition_calories": 372.0, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/21/84/50/emkcEqBqQx6GvSpupW0V_mocha-cupcakes-5886.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["sweet", "60 mins", "oven", "easy"], "ingredients": []}, {"recipe_id": "rec_544", "props": {"title": "St. Louis Style Gooey Butter Cake", "instructions": "[Instructions] 1) Preheat oven to 350. | 2) Lightly grease (or spray with Pam) one deep 9x13 rectangular cake pan. I would suggest a 4 in deep pan, as the cake rises when it is cooking, but a oven-safe disposable coffee cake pan from the grocery store would work fine too. | 3) Melt butter. I do this by heating the the microwave on low power for 30 seconds. | 4) Empty cake mix into a large bowl. | 5) Stir melted butter, along with ONE egg, into the cake mix. | 6) PRESS mixture into pan. Mixture will have the consistency of sticky dough. Using a spatula works for me, but pressing with clean fingers will do the trick as well. | 7) In a large bowl, mix cream cheese, almond or vanilla extract, confectioners sugar and the remaining two eggs. | 8) Beat for three minutes with an electric mixer set on medium high speed, or until smooth with NO lumps. | 9) Pour evenly over top of the cake mixture in the pan. Use a spatula to spread. | 10) Place a large cookie sheet on the rack below the cake. Sometimes when you use a cake pan with less depth, the cake bubbles and spills over. The cookie sheet will spare your oven! Bake at 350 for 30-45 minutes until golden brown on top. Cooking time is estimated, you will really have to watch it here! I always take the cake out when it turns a darkish golden brown. Note that there will be a paper thin sugar \"crust\" that will form while the cake is baking. It the top layer of sugar hardening, and this is what will turn golden brown. It adds great texture! | 11) Allow cake to cool COMPLETELY. This is very important, as the cake will not cut easily until it is completely cool. You will notice that the cake has sunken and set. This is normal. Refrigeration is optional. I personally like it at room temperature. | 12) Dust the top with confectioners\u2019 sugar. | 13) Cut cake into bars and serve with or without utensils, but make sure you have plenty of napkins, because this treat will have you licking your fingers! (Cake should be gooey underneath the sugar \"crust\", so don't over bake!).", "tags": ["kid friendly", "sweet", "mixer", "60 mins", "refrigerator", "small appliance", "easy"], "cook_time_min": 30, "servings": null, "cuisine": ["All"], "rating_avg": 4.39, "rating_count": 38, "popularity_score": 4.453333333333333, "nutrition_calories": 588.7, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/19/59/77/W0yEYzVVSKanfRhyVyRQ_0S9A1187.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["kid friendly", "sweet", "mixer", "60 mins", "refrigerator", "small appliance", "easy"], "ingredients": []}, {"recipe_id": "rec_545", "props": {"title": "Strawberry Cream Cheese Bread", "instructions": "[Instructions] 1) With electric mixer cream butter, sugar and cream cheese until fluffy. Add eggs one at a time. Mix in vanilla. | 2) In separate bowl, mix flour, baking powder, baking soda and salt. Blend flour mixture with butter mixture just until blended. Add half 'n half and only stir just to blend -- do not overstir! | 3) Drain strawberries and blot dry. Carefully just fold in strawberries and nuts. Dough mixture will be thick. | 4) Grease and flour a 9x5 inch loaf pan. Bake in a 350 degree oven for 50 to 60 minutes. Let bread mellow for one day and then serve.", "tags": ["breads", "4 hours"], "cook_time_min": 55, "servings": null, "cuisine": ["All"], "rating_avg": 4.56, "rating_count": 30, "popularity_score": 4.5935, "nutrition_calories": 258.0, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/26/16/37/FCS9PixbRQGtiiBZzdii_DSC03747-2.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["breads", "4 hours"], "ingredients": []}, {"recipe_id": "rec_546", "props": {"title": "Easy Strawberry Jell-O Pie", "instructions": "[Instructions] 1) Bring sugar, water and cornstarch to a boil over medium high heat. | 2) Add Jell-O, stir until dissolved. | 3) Cool and then add strawberries. | 4) Refrigerate about 45 minutes or until it starts to congeal. | 5) Put in pie shell and cool completely. | 6) Top with whipped cream or ice cream to serve.", "tags": ["dessert", "strawberry", "berries", "fruit", "low protein", "low cholesterol", "healthy", "15 mins"], "cook_time_min": 15, "servings": null, "cuisine": ["All"], "rating_avg": 4.8, "rating_count": 5, "popularity_score": 4.729333333333333, "nutrition_calories": 225.0, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/97/98/4/vrVOSvu3TX6ZRGiZDfxG_strawberry-pie-13.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["dessert", "strawberry", "berries", "fruit", "low protein", "low cholesterol", "healthy", "15 mins"], "ingredients": []}, {"recipe_id": "rec_547", "props": {"title": "Super Easy Peanut Butter Fudge", "instructions": "[Instructions] 1) Prepare a 9x11 glass dish by buttering the bottom. | 2) In heavy bottom sauce pan combine sugar and milk. | 3) Measure and set aside remaining ingredients. | 4) Cook over MEDIUM HEAT (temperature too high will cause it to reach temperature sooner and lead to overcooking) stirring occasionally till it comes to a boil then stir constantly. | 5) Let boil for 4 minutes EXACTLY, over cooking leads to crumbly fudge as it has moved past softball stage and into softcrack (measure from the first sight of littlest bubbles or use a thermometer - softball stage) I use a stop watch. Remove from heat. | 6) Stir in remaining ingredients till all melted and smooth. | 7) Pour into prepared dish and refrigerate until firm.", "tags": ["dessert", "potluck", "sweet", "30 mins", "for large groups", "easy"], "cook_time_min": 4, "servings": null, "cuisine": ["All"], "rating_avg": 4.4, "rating_count": 51, "popularity_score": 4.448196721311476, "nutrition_calories": 321.3, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/33/23/23/JIveudjMQ6OlAVgHMnUu_fudge1.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["dessert", "potluck", "sweet", "30 mins", "for large groups", "easy"], "ingredients": []}, {"recipe_id": "rec_548", "props": {"title": "Sweet Potato Pie", "instructions": "[Instructions] 1) In a mixing bowl, cream butter and sugar. | 2) Add eggs; mix well. | 3) Add milk, sweet potatoes, vanilla, cinnamon, nutmeg, and salt; mix well. | 4) Pour into pie shell. | 5) Bake at 425 degrees for 15 minutes. | 6) Reduce heat to 350 degrees; bake 35-40 minutes longer or until pie tests done. | 7) Cool; Store in refrigerator.", "tags": ["dessert", "yam sweet potato", "potato", "vegetable", "potluck", "winter", "thanksgiving", "weeknight", "oven", "4 hours"], "cook_time_min": 55, "servings": null, "cuisine": ["All"], "rating_avg": 4.8, "rating_count": 105, "popularity_score": 4.790782608695651, "nutrition_calories": 459.1, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/30/76/6/ZL30qHpS02TlJSlICMaj_sweet potato pie SITE-4.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["dessert", "yam sweet potato", "potato", "vegetable", "potluck", "winter", "thanksgiving", "weeknight", "oven", "4 hours"], "ingredients": []}, {"recipe_id": "rec_549", "props": {"title": "The Best Brownies", "instructions": "[Instructions] 1) Preheat oven to 350 degrees Fahrenheit or 180 degrees Celsius. | 2) Mix oil and sugar until well blended. | 3) Add eggs and vanilla; stir just until blended. | 4) Mix all dry ingredients in a separate bowl. | 5) Stir dry ingredients into the oil/sugar mixture. | 6) Pour into greased 9 x 9 square pan. | 7) Bake for 20 minutes or until sides just starts to pull away from the pan. | 8) Cool completely before cutting. | 9) Note: I usually double the recipe and bake in a 9 x 13 pan. If you double the recipe, you will need to cook longer than 20 minutes.", "tags": ["dessert", "cookie and brownie", "sweet", "60 mins", "oven"], "cook_time_min": 20, "servings": null, "cuisine": ["All"], "rating_avg": 4.37, "rating_count": 679, "popularity_score": 4.374702467343977, "nutrition_calories": 218.6, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/54/22/5/DGMPaRDnQzSOR3Kw5Jo6_BB%204%20final%20-%20best%20brownies.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["dessert", "cookie and brownie", "sweet", "60 mins", "oven"], "ingredients": []}, {"recipe_id": "rec_550", "props": {"title": "The Best Snickerdoodles I Have Ever Eaten", "instructions": "[Instructions] 1) In a large bowl, cream butter and sugars at high speed. | 2) Add egg, vanilla, and beat until smooth. | 3) In another bowl, combine flour, salt, baking soda, and cream of tartar. | 4) Pour dry ingredients into the wet ingredients, mix well. | 5) Preheat oven to 300\u00b0 while you let dough rest 30-60 minutes in fridge. | 6) In a small bowl combine topping. | 7) Take about 2 1/2 tablespoons of dough and roll it into a ball. | 8) Roll this dough in the cinnamon/sugar mixture and press onto greased cookie sheet. | 9) Bake cookies 10-12 minutes, NO MORE. | 10) *Cookies may seem undercooked but will develop. | 11) Don't roll your dough into too big of a ball; they may not turn out in that much time if you do that. | 12) It happened to me. | 13) lol. | 14) If the cookies don't turn out, please try again. | 15) It's a very good cookie, it's just all a matter of getting the cooking time right.", "tags": ["cookie and brownie", "kid friendly", "christmas", "thanksgiving", "60 mins", "oven"], "cook_time_min": 14, "servings": null, "cuisine": ["All"], "rating_avg": 4.49, "rating_count": 166, "popularity_score": 4.501590909090909, "nutrition_calories": 146.6, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/49/53/4/eyQdF8qbTzu3I9jmDE2D_0S9A5665.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["cookie and brownie", "kid friendly", "christmas", "thanksgiving", "60 mins", "oven"], "ingredients": []}, {"recipe_id": "rec_551", "props": {"title": "The Only Chocolate Cake Recipe You'll Ever Need! (Devil's Food)", "instructions": "[Instructions] 1) Preheat oven to 325\u00b0F. | 2) In a large mixing bowl, sift together dry ingredients. Add oil, coffee and milk and mix at medium speed for 2 minutes. Add eggs and vanilla and beat 2 more minutes. Expect batter to be thin. | 3) Pour into a 9\" x 13\" greased and floured pan or 2- 9\" round pans. Bake 9 x 13 pan for about 45 minutes or 9\" pans for about 30 minutes. Cool in pans for about 15 minutes and then cool completely on racks. | 4) While cake is cooling make the icing: Combine the milk and flour in a saucepan and cook over low heat until thick, whisking constantly. Cover and refrigerate until chilled. | 5) In a medium bowl, beat butter, shortening, sugar and vanilla until creamy. Add chilled milk and flour mixture and beat for 10 minutes. Frost cooled cake and enjoy! The frosting sounds intimidating, but it is worth it! By the way, for some reason, we prefer this cake chilled, right out of the refrigerator. The rich chocolate and cool frosting just seem to taste best this way.", "tags": ["kid friendly", "potluck", "weeknight", "for large groups", "oven", "4 hours"], "cook_time_min": 45, "servings": null, "cuisine": ["All"], "rating_avg": 4.77, "rating_count": 423, "popularity_score": 4.76824480369515, "nutrition_calories": 477.9, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/26/37/0/bzwUWgTTGZ83fb1AbjMQ_CC%208%20-%20final_6.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["kid friendly", "potluck", "weeknight", "for large groups", "oven", "4 hours"], "ingredients": []}, {"recipe_id": "rec_552", "props": {"title": "The Original Bisquick\u00ae Strawberry Shortcakes", "instructions": "[Instructions] 1) In medium bowl, stir together strawberries and 1/2 cup sugar; set aside for about 1 hour. | 2) Heat oven to 425\u00b0F | 3) In another medium bowl, stir Bisquick\u00ae mix, milk, 3 tablespoons sugar, and melted butter until a soft dough forms. | 4) Drop the dough by rounded tablespoonfuls into 6 mounds onto ungreased cookie sheet; dust with sugar. | 5) Bake 10 to 12 minutes or until golden brown. | 6) Meanwhile, in a chilled small bowl whip the cream, adding a drop or two of vanilla and a teaspoon of sugar. Beat with an electric mixer on high speed until soft peaks form. | 7) Serve one of two ways:. | 8) 1. Split warm shortcakes; fill and top with strawberries and whipped cream, or | 9) 2. Break up one biscuit per person into big pieces into a dessert bowl. Ladle strawberries over the biscuit; add a dolop of whipped cream. | 10) COOK'S TIP: Alternatives to strawberries could include raspberries, blueberries & peaches, and my favorite, apricots & honey (Soak dried apricots in warm water for 1 hour; chop fine. Gently toss apricots with honey and let stand awhile to blend flavors. Serve over shortcakes.).", "tags": ["raspberries", "strawberry", "berries", "fruit", "low protein", "toddler friendly", "kid friendly", "weeknight", "brunch", "30 mins", "beginner cook", "easy"], "cook_time_min": 12, "servings": null, "cuisine": ["All"], "rating_avg": 5.0, "rating_count": 1, "popularity_score": 4.721818181818181, "nutrition_calories": 464.8, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/38/14/18/qqcnjKN6TsWWI1VlMLwe_The%20original%20bisquick%20strawberry%20shortcakes%20381418-4.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["raspberries", "strawberry", "berries", "fruit", "low protein", "toddler friendly", "kid friendly", "weeknight", "brunch", "30 mins", "beginner cook", "easy"], "ingredients": []}, {"recipe_id": "rec_553", "props": {"title": "Tiramisu Layer Cake", "instructions": "[Instructions] 1) Preheat oven to 350\u00b0F Grease and flour 3 (9-inch) round pans. | 2) Prepare the cake mix according to package directions. | 3) Divide two thirds of batter between 2 pans. | 4) Stir instant coffee into remaining batter; pour into remaining pan. | 5) Bake in the preheated oven for 20-25 minutes, or until a toothpick inserted into the center of the cake comes out clean. | 6) Let cool in pan for 10 minutes, then turn out onto a wire rack and cool completely. | 7) In a measuring cup, combine brewed coffee and 3 tablespoons Kahlua; set aside. | 8) To make the filling: In a small bowl, using an electric mixer set on low speed, combine mascarpone, 1/2 cup powdered sugar and 2 tablespoons Kahlua; beat just until smooth. | 9) Cover with plastic wrap and refrigerate. | 10) To make the frosting: In a medium bowl, using an electric mixer set on medium-high speed, beat the cream, 1/4 cup powdered sugar and 2 tablespoons Kahlua until stiff. | 11) Fold 1/2 cup of cream mixture into filling mixture. | 12) To assemble the cake: Place one plain cake layer on a serving plate. Using a thin skewer, poke holes in cake, about 1 inch apart. | 13) Spoon one third of reserved coffee mixture over cake, then spread with half of the filling mixture. | 14) Top with coffee-flavored cake layer; poke holes in cake. | 15) Spoon another third of the coffee mixture over the second layer and spread with the remaining filling. | 16) Top with remaining cake layer; poke holes in cake. | 17) Spoon remaining coffee mixture on top. | 18) Spread sides and top of cake with frosting. | 19) Place cocoa in a sieve and lightly dust top of cake. | 20) Garnish with chocolate curls. | 21) Refrigerate at least 30 minutes before serving. | 22) To make the chocolate curls, use a vegetable peeler and run it down the edge of the chocolate bar.", "tags": ["christmas", "60 mins"], "cook_time_min": 30, "servings": null, "cuisine": ["All"], "rating_avg": 4.94, "rating_count": 36, "popularity_score": 4.886521739130435, "nutrition_calories": 456.6, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/20/27/85/Ij1SHD8TQ1g4MUz24nQ3_food.com-60.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["christmas", "60 mins"], "ingredients": []}, {"recipe_id": "rec_554", "props": {"title": "Toffee Brownie Trifle", "instructions": "[Instructions] 1) Prepare and bake brownies as directed on package. | 2) Cool completely, then cut into 1-inch cubes. | 3) Beat milk and pudding mixes on low speed 2 minutes. | 4) Fold Cool Whip into pudding. | 5) Place 1/2 brownies into dish, cover with 1/2 pudding mixture. | 6) Repeat layers. | 7) Refrigerate until needed. | 8) Sprinkle top with Heath bits just before serving.", "tags": ["15 mins"], "cook_time_min": 15, "servings": null, "cuisine": ["All"], "rating_avg": 4.0, "rating_count": 1, "popularity_score": 4.63090909090909, "nutrition_calories": 388.1, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/14/06/74/06csZSOXQAq77HUY9etT_toffee-brownie-cake-04.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["15 mins"], "ingredients": []}, {"recipe_id": "rec_555", "props": {"title": "Tunnel of Fudge Banana Cake", "instructions": "[Instructions] 1) For the fudge filling:. | 2) Finely chop the chocolate and place into a medium heat-proof bowl. | 3) Heat the cream and butter in a small pot until the butter has melted and the cream is gently steaming. | 4) Pour this over the chocolate in the bowl. Let sit for 5 minutes then gently stir until all the chocolate has melted. | 5) Let this mixture cool at room temperature for 45-60 minutes, stirring occasionally, until thickened but still pipeable. | 6) Prepare the pan:. | 7) Preheat the oven to 350 degrees F. | 8) Use the 2 tablespoons of softened butter and a pastry brush to coat a 12-cup bundt pan very well. Add the cocoa powder to the the pan, tilting and tapping the pan to coat as much of the inside as possible. Tap out any excess cocoa powder. | 9) For the cake:. | 10) In a large bowl, beat the butter, granulated sugar and dark brown sugar together until smooth. Beat in the eggs one at a time until smooth. Add the salt, vanilla, baking powder, vegetable oil and mashed banana and stir together until well-combined. | 11) Add the flour and cocoa powder to the bowl and mix until just combined. | 12) Scoop 3 cups of the cake batter into the prepared bundt pan. Spread out into an even layer. | 13) Transfer the thickened, cooled fudge filling to a piping bag. Pipe the fudge filling in a thick ring all the way around in the centre of the batter. | 14) Cover the fudge filling with the remaining cake batter and spread out evenly in the pan. | 15) Bake for 35-40 minutes. The cake will look risen and dry on top. You won\u2019t be able to test this cake with a toothpick as the centre will still be gooey when the cake is finished baking, so you must ensure your oven is at the correct temperature. | 16) Remove the cake from the oven and let cool for 20 minutes in the pan. Loosen the edges of the cake with a small spatula or butter knife, flip the cake out onto a wire rack and leave to cool completely. | 17) For the frosting:. | 18) In a small bowl, stir together the powdered sugar, cocoa powder and milk until smooth. | 19) Spoon over the top of the cooled cake, letting it drip down the sides of the cake. Top with the dried banana chips and leave the icing to set for a few minutes before cutting into the cake. | 20) Tools:. | 21) 12-cup Nordicware Classic Bundt Pan (aka Anniverary Bundt Pan). Buy it now on Amazon: https://www.amazon.com/Nordic-Ware-12-Cup-Bundt-Pan/dp/B0000CFLM2.", "tags": ["dessert", "tropical fruits", "fruit", "4 hours"], "cook_time_min": 20, "servings": null, "cuisine": ["All"], "rating_avg": 2.67, "rating_count": 8, "popularity_score": 3.794444444444444, "nutrition_calories": 7032.1, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/53/49/55/G1xFm8feSua0e67vSILc_untitled-0903.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["dessert", "tropical fruits", "fruit", "4 hours"], "ingredients": []}, {"recipe_id": "rec_556", "props": {"title": "Vanilla Pudding", "instructions": "[Instructions] 1) In medium double boiler, cook sugar, cornstarch, milk and salt. When mixture begins to thicken, add part of mixture to egg yolks; mix well, then pour egg mixture back into mixture in double boiler. | 2) Cook until thick; take off stove, then add butter and vanilla. | 3) You can use as pudding and top with Cool Whip or use pudding with bananas for banana pudding You can also add 2 unsweetened chocolate squares at the beginning and make a chocolate pie or pudding. | 4) For butterscotch pie or pudding, use 3/4 cup light brown sugar firmly packed and 1/4 cup sugar instead of 3/4 cup sugar, then cook as directed. | 5) You can also make a banana plate pie with the vanilla mixture, just cook as directed. | 6) In baked pie shell, line bottom with bananas; pour a layer of pudding, then a layer of ba nanas, then pudding. | 7) You can top with Cool Whip or meringue.", "tags": ["15 mins"], "cook_time_min": 0, "servings": null, "cuisine": ["All"], "rating_avg": 4.6, "rating_count": 83, "popularity_score": 4.61010752688172, "nutrition_calories": 270.9, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/42/71/vtKZLiMzRnyiHRS1GmZ6_Vanilla-Pudding-7.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["15 mins"], "ingredients": []}, {"recipe_id": "rec_557", "props": {"title": "Very Berry Sugar Cookie Cobbler", "instructions": "[Instructions] 1) Preheat oven to 350\u00b0. | 2) In large bowl, mix berries, pie filling, sugar and cinnamon. | 3) Transfer fruit mixture to 9 x 13 baking dish. | 4) Crumble cookie dough over fruit, covering thickly and completely. | 5) Bake uncovered until cookie crust is golden and crisp and juices are bubbly, about 45 minutes.", "tags": ["apple", "berries", "fruit", "60 mins", "oven", "easy"], "cook_time_min": 45, "servings": null, "cuisine": ["All"], "rating_avg": 4.31, "rating_count": 14, "popularity_score": 4.47, "nutrition_calories": 128.3, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/70/49/3/KpNqeJWSXmqFLr4sguvS_apple-berry-cookie-cobbler-1483.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["apple", "berries", "fruit", "60 mins", "oven", "easy"], "ingredients": []}, {"recipe_id": "rec_558", "props": {"title": "Why-I-Joined-Zaar Carrot Cake", "instructions": "[Instructions] 1) Preheat oven to 350 degrees F (175 degrees C). Grease and flour a 9x13 inch pan. | 2) Mix flour, baking soda, baking powder, salt and cinnamon; make a well in the center and add sugar, oil, eggs and vanilla. Mix with wooden spoon until smooth. | 3) Stir in carrots, coconut, walnuts and pineapple. Pour into 9x13 inch pan and bake for about 45 minutes. Don't panic, the centre will sink a little. | 4) Allow to cool; when cool, ice the cake. You can certainly use your favourite cream cheese frosting to ice this cake, but the one I've included is highly recommended (I usually leave the cake in the 13x9 pan and just ice the top). | 5) To make the frosting: Cream the butter and cream cheese until smooth; add the icing sugar and beat until creamy.", "tags": ["pineapple", "coconut", "tropical fruits", "fruit", "vegetable", "nuts", "kid friendly", "kosher", "potluck", "thanksgiving", "weeknight", "brunch", "oven", "4 hours"], "cook_time_min": 45, "servings": null, "cuisine": ["All"], "rating_avg": 4.87, "rating_count": 490, "popularity_score": 4.86648, "nutrition_calories": 662.1, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/73/82/5/VIfjsbVmSubdAsbjKPXX_0S9A1692.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["pineapple", "coconut", "tropical fruits", "fruit", "vegetable", "nuts", "kid friendly", "kosher", "potluck", "thanksgiving", "weeknight", "brunch", "oven", "4 hours"], "ingredients": []}, {"recipe_id": "rec_559", "props": {"title": "Absolute Best Ever Lasagna", "instructions": "[Instructions] 1) Brown ground meat, onion and garlic. | 2) Add salt, pepper, parsley, oregano, basil, chopped tomatoes with juice, tomato paste; stirring until well mixed. | 3) Cover and simmer 1 hour (or longer,but watch for getting too dry). | 4) Cook lasagna noodles according to package directions; drain and set aside. | 5) Spray a 13 x 9\" baking pan with cooking spray. | 6) Combine riccota cheese, eggs, pepper, 2 tablespoons parsley, Parmesan cheese and 1/2 1lb of mozzarella cheese; In a lasagna pan, layer noodles, meat sauce, and cheese mixture; repeat. | 7) Top off with layer of noodles; sprinkle evenly with remaining mozzarella cheese; make sure to cover noodles completely. | 8) Bake at 375F for 40-60 minutes, or until cheese mixture is thoroughly melted. (I cover w/ foil for about 40 minutes, then uncover for 15-20 minutes. | 9) Let sit for 15-20 minutes before cutting and serving.", "tags": ["meat", "european", "weeknight", "oven", "4 hours"], "cook_time_min": 1, "servings": null, "cuisine": ["All"], "rating_avg": 4.65, "rating_count": 619, "popularity_score": 4.650699523052464, "nutrition_calories": 540.5, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/28/76/8/SyAcnUdwTHGQfekagLBj_ABEL%203%20-%20final_1.png"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["meat", "european", "weeknight", "oven", "4 hours"], "ingredients": []}, {"recipe_id": "rec_560", "props": {"title": "Amazing Chicken Tortilla Soup!", "instructions": "[Instructions] 1) Saut\u00e9 onion, garlic, jalape\u00f1o and green pepper with olive oil in a large pot until soft. | 2) Add all the rest of the ingredients to the large pot and bring to a boil. | 3) After about 15 minutes, remove the chicken breasts and shred. | 4) (Two forks work well to pull the chicken apart!). | 5) Return shredded chicken to the pot and simmer an additional 45 minutes. | 6) Serve, topped with crushed tortilla chips if desired.", "tags": ["chicken", "poultry", "meat", "mexican", "lactose free", "low cholesterol", "egg free", "healthy", "kid friendly", "free of", "spicy", "beginner cook", "4 hours", "easy"], "cook_time_min": 1, "servings": null, "cuisine": ["All"], "rating_avg": 4.78, "rating_count": 275, "popularity_score": 4.776982456140352, "nutrition_calories": 163.3, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/10/82/31/rpAxVfyiSNOekT4EPhaW_chicken-tortilla-soup-7654.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["chicken", "poultry", "meat", "mexican", "lactose free", "low cholesterol", "egg free", "healthy", "kid friendly", "free of", "spicy", "beginner cook", "4 hours", "easy"], "ingredients": []}, {"recipe_id": "rec_561", "props": {"title": "Amish Chicken", "instructions": "[Instructions] 1) Dredge the chicken pieces in the flour and spices and arrange skin side up in a baking dish. | 2) Mix the cream and water and pour over the chicken. | 3) Bake at 350* for 1 1/2 hours or until the skin is golden brown.", "tags": ["poultry", "meat", "4 hours", "easy"], "cook_time_min": 1, "servings": null, "cuisine": ["All"], "rating_avg": 4.41, "rating_count": 27, "popularity_score": 4.486756756756757, "nutrition_calories": 863.0, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/32/67/45/0ebbtCeUQqOIDpEQ42uD_Amish-Chicken-4.png"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["poultry", "meat", "4 hours", "easy"], "ingredients": []}, {"recipe_id": "rec_562", "props": {"title": "Angel Chicken Pasta", "instructions": "[Instructions] 1) Preheat oven to 325\u00b0F. | 2) In large saucepan melt butter. | 3) Add dressing mix, wine and soup. | 4) Mix in cream cheese and stir until smooth. | 5) Place chicken in baking dish and cover with sauce. | 6) Bake for 60 minutes. | 7) Ten minutes before chicken is done cook pasta. | 8) Serve chicken and sauce over pasta.", "tags": ["chicken", "poultry", "meat", "weeknight", "oven", "4 hours"], "cook_time_min": 1, "servings": null, "cuisine": ["All"], "rating_avg": 4.33, "rating_count": 19, "popularity_score": 4.45551724137931, "nutrition_calories": 316.6, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/62/01/2/sjENVyYTQyulQZ8kOZjq_pastadip-5.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["chicken", "poultry", "meat", "weeknight", "oven", "4 hours"], "ingredients": []}, {"recipe_id": "rec_563", "props": {"title": "Asian Noodle Bowl", "instructions": "[Instructions] 1) Bring a large pot of water to a boil. Toast the almonds in a dry skillet over a medium-heat heat, stirring frequently, until they are golden, about 3 minutes. | 2) Cook the pasta according to the directions on the package. Three minutes before the pasta is ready add the broccoli to the pasta pot. One minute before it is ready add the snow peas and red peppers to the pot. | 3) While the pasta is cooking, make the sauce. Place the almond butter, soy sauce, lime juice, brown sugar, chili-garlic sauce and three tablespoon of boiling water (from the pasta pot) into a large bowl and whisk until smooth. | 4) Drain the noodles and vegetables, return them to the pasta pot, add the sauce and toss to coat. Serve garnished with the toasted almonds and scallion greens.", "tags": ["spaghetti", "peppers", "vegetable", "asian", "weeknight", "15 mins", "easy"], "cook_time_min": 10, "servings": null, "cuisine": ["All"], "rating_avg": 4.5, "rating_count": 4, "popularity_score": 4.638571428571428, "nutrition_calories": 409.9, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/45/10/00/picmU7XVF.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["spaghetti", "peppers", "vegetable", "asian", "weeknight", "15 mins", "easy"], "ingredients": []}, {"recipe_id": "rec_564", "props": {"title": "Award Winning Chili", "instructions": "[Instructions] 1) In a medium Dutch oven over medium-high heat add the olive oil. Add the ground meat and cook, breaking up into pieces, until browned. Add the onions, bell pepper and jalapeno and cook until softened. Drain excess grease. | 2) Add the tomatoes, tomato sauce, cumin, chili powder, salt, cayenne, paprika and 1 cup water. Mix to combine. | 3) Add the kidney beans and black beans, mix and bring to a simmer. Cover and cook for 1-2 hours. | 4) Serve with desired toppings.", "tags": ["beans", "meat", "low cholesterol", "healthy", "4 hours", "easy", "inexpensive"], "cook_time_min": 2, "servings": null, "cuisine": ["All"], "rating_avg": 4.8, "rating_count": 465, "popularity_score": 4.797768421052632, "nutrition_calories": 300.6, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/10/58/65/G9Ez7rFmQOmtdHERTPgK_AWC%204%20-%20final_2.png"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["beans", "meat", "low cholesterol", "healthy", "4 hours", "easy", "inexpensive"], "ingredients": []}, {"recipe_id": "rec_565", "props": {"title": "Baked Salmon", "instructions": "[Instructions] 1) In a medium glass bowl, prepare marinade by mixing garlic, light olive oil, basil, salt, pepper, lemon juice and parsley. | 2) Place salmon fillets in a medium glass baking dish, and cover with the marinade. | 3) Marinate in the refrigerator about 1 hour, turning occasionally. | 4) Preheat oven to 375 degrees F (190 degrees C). | 5) Place fillets in aluminum foil, cover with marinade, and seal. | 6) Place sealed salmon in the glass dish, and bake 35 to 45 minutes, until easily flaked with a fork.", "tags": ["high protein", "high in", "60 mins", "oven"], "cook_time_min": 45, "servings": null, "cuisine": ["All"], "rating_avg": 4.75, "rating_count": 443, "popularity_score": 4.7487637969094925, "nutrition_calories": 582.3, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/28/19/9/GoX0mmhFTHeYfppn5QH7_herb-salmon-4749.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["high protein", "high in", "60 mins", "oven"], "ingredients": []}, {"recipe_id": "rec_566", "props": {"title": "Balsamic Chicken Thighs", "instructions": "[Instructions] 1) Spray large frying pan, preheat. | 2) Rinse and pat dry thighs. | 3) Season with salt and pepper. | 4) Brown well on all sides. | 5) Cover, reduce heat to medium and cook for approximately 25 minutes,or'til thighs are done depending on size. | 6) Add shallots,cook for 2-3 minutes,until they soften. | 7) Stir in balsamic vinegar, cook for about 1 more minute,turn chicken to coat thoroughly. | 8) Spoon sauce over thighs to serve.", "tags": ["chicken", "poultry", "meat", "very low carbs", "lactose free", "high protein", "healthy", "free of", "high in", "60 mins", "easy"], "cook_time_min": 25, "servings": null, "cuisine": ["All"], "rating_avg": 4.57, "rating_count": 197, "popularity_score": 4.575990338164251, "nutrition_calories": 291.1, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/71/55/7/TWRoGlxASseOfsZWQ46u_0S9A0151.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["chicken", "poultry", "meat", "very low carbs", "lactose free", "high protein", "healthy", "free of", "high in", "60 mins", "easy"], "ingredients": []}, {"recipe_id": "rec_567", "props": {"title": "Beef Nacho Crescent Bake", "instructions": "[Instructions] 1) Set oven to 375 degrees. | 2) Grease a 13 x 9-inch baking dish. | 3) In a large skillet cook the ground beef with onion, garlic and green bell pepper (if using) until beef is browned; drain fat. | 4) Add in salt, pepper, chili powder, cumin and oregano and Parmesan cheese; cook stirring for 2 minutes longer; remove the skillet from heat. | 5) In a bowl whisk together the cheese soup and milk; set aside. | 6) Separate the crescent dough into 4 rectangles; press perforations together firmly. | 7) Roll each rectangle to 8x4 inches. | 8) Cut each rectangle in half crosswise to form 8 (4-inch) squares (use a pizza cutter for this!). | 9) Spoon about 1/4 cup beef mixture into center of each square. | 10) Lift 4 corners of the dough up over the filling to meet in the center; pinch and twist firmly to seal. | 11) Place the squares into the prepared baking dish. | 12) Drizzle the soup/milk mixture around the squares in the baking dish. | 13) Bake uncovered for about 20-25 minutes, or until the crusts are golden brown. | 14) Remove from oven and sprinkle the grated cheese over each square and return to oven for 5 minutes or until the cheese melted.", "tags": ["savory", "60 mins", "oven", "beginner cook", "easy"], "cook_time_min": 30, "servings": null, "cuisine": ["All"], "rating_avg": 4.8, "rating_count": 5, "popularity_score": 4.729333333333333, "nutrition_calories": 322.8, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/15/90/97/dWpNiCl8QCeN11JTTtnx_pancakespastry2-4.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["savory", "60 mins", "oven", "beginner cook", "easy"], "ingredients": []}, {"recipe_id": "rec_568", "props": {"title": "Beer Bread", "instructions": "[Instructions] 1) Preheat oven to 375 degrees. | 2) Mix dry ingredients and beer. | 3) Pour into a greased loaf pan. | 4) Pour melted butter over mixture. | 5) Bake 1 hour, remove from pan and cool for at least 15 minutes. | 6) UPDATED NOTES: This recipe makes a very hearty bread with a crunchy, buttery crust. If you prefer a softer crust (like a traditional bread) mix the butter into the batter instead of pouring it over the top. | 7) Sifting flour for bread recipes is a must-do. Most people just scoop the 1 cup measure in the flour canister and level it off. That compacts the flour and will turn your bread into a \"hard biscuit\" as some have described. That's because they aren't sifting their flour! If you do not have a sifter, use a spoon to spoon the flour into the 1 cup measure. Try it once the \"correct\" way and you will see an amazing difference in the end product. | 8) I have had many email from you kind folks about using non-alcoholic beverages instead of beer. That is fine to do but I highly recommend adding a packet of Dry Active Yeast or 2 teaspoons of Bread (Machine) Yeast so that you get a proper rise. | 9) The final result should be a thick, hearty and very tasteful bread, NOT A BRICK! ;). | 10) Thank you all for the incredibly nice comments and those of you who left a bad review - learn to sift sift SIFT! You will be amazed at the results you get.", "tags": ["breads", "weeknight", "oven", "beginner cook", "4 hours", "easy", "inexpensive"], "cook_time_min": 1, "servings": null, "cuisine": ["All"], "rating_avg": 4.79, "rating_count": 1103, "popularity_score": 4.789137466307277, "nutrition_calories": 422.1, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/73/44/0/A5wJAHiTGmrCubWmruoJ_0S9A2475.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["breads", "weeknight", "oven", "beginner cook", "4 hours", "easy", "inexpensive"], "ingredients": []}, {"recipe_id": "rec_569", "props": {"title": "Beth's Melt in Your Mouth Barbecue Ribs (Oven)", "instructions": "[Instructions] 1) Preheat oven to 300 degrees F. Line a baking sheet with two layers of foil, shiny side out. | 2) Peel off tough membrane that covers the bony side of the ribs. | 3) Season the ribs on both sides with salt and pepper. If using, divide the Hickory liquid smoke evenly over the ribs. | 4) In a medium bowl, combine the light brown sugar, paprika, garlic powder and ground red pepper. Apply the rub to all sides of the ribs. | 5) Lay ribs on the prepared baking sheet, meaty side down. BONE SIDE DOWN FOR GRILLING! | 6) Lay two layers of foil on top of ribs and roll and crimp edges tightly, edges facing up to seal. | 7) Transfer to the oven and = bake for 2-2 1/2 hours or until meat is starting to shrink away from the ends of the bone. | 8) Remove from oven. | 9) Heat broiler. | 10) Cut ribs into serving sized portions of 2 or 3 ribs. | 11) Arrange on broiler pan, bony side up. | 12) Brush on sauce. | 13) Broil for 1 or 2 minutes until sauce is cooked on and bubbly. | 14) Turn ribs over. | 15) Repeat on other side. | 16) Alternately, you can grill the ribs on your grill to cook on the sauce.", "tags": ["meat", "broil grill", "oven", "beginner cook", "4 hours", "easy"], "cook_time_min": 3, "servings": null, "cuisine": ["All"], "rating_avg": 4.94, "rating_count": 761, "popularity_score": 4.936809338521401, "nutrition_calories": 1229.3, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/10/77/86/mr5ViaW4TBmhRU3uCtLB_0S9A8585.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["meat", "broil grill", "oven", "beginner cook", "4 hours", "easy"], "ingredients": []}, {"recipe_id": "rec_570", "props": {"title": "Bev's Spaghetti Sauce", "instructions": "[Instructions] 1) Brown the ground beef, onion and garlic in olive oil with bay leaves, oregano, basil, Italian Seasoning, salt and pepper. | 2) Add tomato paste, tomato sauce and diced tomatoes. | 3) Stir well and bring to a simmer over medium heat. | 4) Cover and simmer for 1 1/2 hours. | 5) Use sauce to top your cooked spaghetti. | 6) Top with sauteed mushroom. | 7) Pass the Parmesan.", "tags": ["vegetable", "stove top", "4 hours"], "cook_time_min": 1, "servings": null, "cuisine": ["All"], "rating_avg": 4.77, "rating_count": 374, "popularity_score": 4.768020833333333, "nutrition_calories": 565.1, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/26/21/7/ZF3VGfKMT8Wyf0Cve4bD_untitled-0860.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["vegetable", "stove top", "4 hours"], "ingredients": []}, {"recipe_id": "rec_571", "props": {"title": "Bourbon Chicken", "instructions": "[Instructions] 1) Editor's Note: Named Bourbon Chicken because it was supposedly created by a Chinese cook who worked in a restaurant on Bourbon Street. | 2) Heat oil in a large skillet. | 3) Add chicken pieces and cook until lightly browned. | 4) Remove chicken. | 5) Add remaining ingredients, heating over medium Heat until well mixed and dissolved. | 6) Add chicken and bring to a hard boil. | 7) Reduce heat and simmer for 20 minutes. | 8) Serve over hot rice and ENJOY.", "tags": ["chicken", "poultry", "meat", "chinese", "asian", "high protein", "high in", "60 mins", "easy"], "cook_time_min": 20, "servings": null, "cuisine": ["All"], "rating_avg": 4.58, "rating_count": 3104, "popularity_score": 4.580366088631984, "nutrition_calories": 521.4, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/45/80/9/MwuCd6HpQ5mDvn4OLRkA_0S9A9886.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["chicken", "poultry", "meat", "chinese", "asian", "high protein", "high in", "60 mins", "easy"], "ingredients": []}, {"recipe_id": "rec_572", "props": {"title": "Broil a Perfect Steak", "instructions": "[Instructions] 1) ADDITIONAL ITEMS - Cast Iron Skillet, Spatula or Tongs. | 2) Bring your 1 to 2 inch steaks to room temperature and use a clean cloth to remove excess moisture. | 3) Move oven rack 6 inches from heating element. | 4) Pre-heat oven and skillet by setting the oven to broiler for 15 to 20 minutes. | 5) Rub steaks with olive oil, kosher salt and coarsely ground pepper. NOTE: Use any seasonings of your choice. | 6) Once the skillet is pre-heated, pull out the oven rack and carefully lay steaks on the skillet. NOTE: Pan is Extermely Hot and will spit and splatter. | 7) Close oven and sear the steaks for 3 minutes on one side, turn and sear the opposite side for 3 minutes. DO NOT USE A FORK TO TURN STEAKS! | 8) Once seared, set the oven to 500F and cook using this Time Chart. Turn steaks half way through the remaining cooking time. | 9) Rare (120-130F)1\" 0-1 minute, 1 1/4\" 2-3 minute, 1 3/4\" 4-5 minute | 10) Medium (140-150F) 1\" 2-3 minute, 1 1/4\" 4-5 minute, 1 3/4\" 6-7 minute | 11) Medium Well(150-160F) 1\" 4-5 minute, 1 1/4\" 6-7 minute, 1 3/4\" 8-9 minute | 12) Remove steaks from the oven and let rest for 5 minutes. | 13) Serving on warm plates is recommended to maintain meat temperature. | 14) I can not stress this tip enough -- Keep the fork in the drawer until ready to eat. Never pierce the meat during cooking.", "tags": ["meat", "very low carbs", "high protein", "healthy", "high in", "broil grill", "30 mins", "oven", "easy"], "cook_time_min": 10, "servings": null, "cuisine": ["All"], "rating_avg": 4.56, "rating_count": 135, "popularity_score": 4.569241379310345, "nutrition_calories": 178.0, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/16/52/54/XE7h7mpTK69lpb05OhGB_broil-perfect-steak_4984.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["meat", "very low carbs", "high protein", "healthy", "high in", "broil grill", "30 mins", "oven", "easy"], "ingredients": []}, {"recipe_id": "rec_573", "props": {"title": "Chicken Alfredo!", "instructions": "[Instructions] 1) Cook your pasta, while your chicken sautes, then add a little olive oil or butter to pasta to prevent sticking, lay on large platter or casserole dish; set aside. | 2) Coat the bottom of a skillet w/olive oil,and heat on med-high heat. | 3) Add chicken strips or chunks, lower heat to med. | 4) Sprinkle seasonings over meat to your liking. | 5) Saute meat until chicken is no longer pink. | 6) Pour chicken and pan drippings over pasta. | 7) In a heavy sauce pan, begin to heat cream cheese and butter on medium heat; slowly add milk. | 8) Stir until all clumps are out, add cheese, continue to stir, then add pepper. | 9) Once all is melted and hot, pour over pasta and chicken.", "tags": ["chicken breast", "chicken", "poultry", "meat", "60 mins"], "cook_time_min": 20, "servings": null, "cuisine": ["All"], "rating_avg": 4.49, "rating_count": 37, "popularity_score": 4.533404255319149, "nutrition_calories": 928.4, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/62/34/3/rn9vs2E9Rvy7C6EyD7Cj_chicken-alfredo-7.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["chicken breast", "chicken", "poultry", "meat", "60 mins"], "ingredients": []}, {"recipe_id": "rec_574", "props": {"title": "Chicken-Macaroni Casserole", "instructions": "[Instructions] 1) In a large skillet over med-high heat, saute onions in butter until onions are tender. | 2) Add in soup and 1 \u00bd cups cheese; gradually stir in milk. | 3) Cook over medium heat until cheese melts; stir in chicken and macaroni; taste and adjust seasoning with salt and pepper. | 4) Transfer mixture to a greased 2 \u00bd quart casserole; sprinkle with cracker crumbs. | 5) Bake in a preheated 350\u00b0 oven for 30 minutes or until heated through. | 6) Top with remaining \u00bd cup cheese and bake 5 minutes.", "tags": [], "cook_time_min": 30, "servings": null, "cuisine": ["All"], "rating_avg": 4.54, "rating_count": 42, "popularity_score": 4.569615384615385, "nutrition_calories": 412.6, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/35/16/55/2ayEpndxRBOZggIbpvok_0S9A5523.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": [], "ingredients": []}, {"recipe_id": "rec_575", "props": {"title": "Chicken Parmesan", "instructions": "[Instructions] 1) Pound chicken to flatten. | 2) Salt and pepper to taste. | 3) Dip chicken in egg; then in bread crumbs. | 4) Fry in butter in hot skillet, turning and browning for 10 minutes or until chicken is done. | 5) Remove from skillet. | 6) To skillet add spaghetti sauce. | 7) Heat thoroughly. | 8) Add chicken. | 9) Place slices of mozzarella on top of chicken. | 10) Sprinkle with parmesan. | 11) Cover and cook until cheese is melted. | 12) Serve with a side of spaghetti. Optional, garnish with chopped parsley and more parmesan cheese.", "tags": ["poultry", "meat", "european", "30 mins", "stove top", "easy"], "cook_time_min": 15, "servings": null, "cuisine": ["All"], "rating_avg": 4.87, "rating_count": 497, "popularity_score": 4.866528599605522, "nutrition_calories": 454.0, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/19/13/5/Ri4L6zUSRSqPnAvReVAn_0S9A8372.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["poultry", "meat", "european", "30 mins", "stove top", "easy"], "ingredients": []}, {"recipe_id": "rec_576", "props": {"title": "Chicken Tikka Masala", "instructions": "[Instructions] 1) Soak bamboo skewers in water. | 2) Thread chicken on skewers, and marinate (in the refrigerator) for an hour or so. | 3) Discard marinade. | 4) For sauce, melt butter on medium heat. | 5) Add garlic & jalapeno; cook 1 minute. | 6) Stir in coriander, cumin, paprika, garam masala & salt. | 7) Stir in tomato sauce. | 8) Simmer 15 minutes. | 9) Stir in cream; simmer to thicken- about 5 minutes. | 10) Grill or broil chicken, turning occasionally, to cook through- about 8 minutes. | 11) Remove chicken from skewers; add to sauce. | 12) Simmer 5 minutes. | 13) Garnish with cilantro Serve with basmati rice, naan or pita bread. | 14) Note: You can make your own garam masala. McCormick also makes garam masala; it's available in super markets.", "tags": ["poultry", "meat", "asian", "indian", "weeknight", "4 hours"], "cook_time_min": 30, "servings": null, "cuisine": ["All"], "rating_avg": 4.8, "rating_count": 415, "popularity_score": 4.797505882352941, "nutrition_calories": 499.1, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/25/58/7/NxufAx8GTP2G3zUhgxyc_THE%20FOOD%20GAYS%20-%20CHICKEN%20TIKA.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["poultry", "meat", "asian", "indian", "weeknight", "4 hours"], "ingredients": []}, {"recipe_id": "rec_577", "props": {"title": "Chinese Fried Rice", "instructions": "[Instructions] 1) Heat 1 tbsp oil in wok; add chopped onions and stir-fry until onions turn a nice brown color, about 8-10 minutes; remove from wok. | 2) Allow wok to cool slightly. | 3) Mix egg with 3 drops of soy and 3 drops of sesame oil; set aside. | 4) Add 1/2 tbsp oil to wok, swirling to coat surfaces; add egg mixture; working quickly, swirl egg until egg sets against wok; when egg puffs, flip egg and cook other side briefly; remove from wok, and chop into small pieces. | 5) Heat 1 tbsp oil in wok; add selected meat to wok, along with carrots, peas, and cooked onion; stir-fry for 2 minutes. | 6) Add rice, green onions, and bean sprouts, tossing to mix well; stir-fry for 3 minutes. | 7) Add 2 tbsp of light soy sauce and chopped egg to rice mixture and fold in; stir-fry for 1 minute more; serve. | 8) Set out additional soy sauce on the table, if desired.", "tags": ["pork", "poultry", "rice", "meat", "chinese", "asian", "low cholesterol", "healthy", "kid friendly", "30 mins", "stir fry", "easy", "inexpensive"], "cook_time_min": 18, "servings": null, "cuisine": ["All"], "rating_avg": 4.6, "rating_count": 548, "popularity_score": 4.6016845878136206, "nutrition_calories": 497.8, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/38/74/8/TCTWMVk2RVmMC8K039qk_0S9A2600.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["pork", "poultry", "rice", "meat", "chinese", "asian", "low cholesterol", "healthy", "kid friendly", "30 mins", "stir fry", "easy", "inexpensive"], "ingredients": []}, {"recipe_id": "rec_578", "props": {"title": "Classic Potato Salad", "instructions": "[Instructions] 1) Boil peeled potatoes in salted water until done. Cool to room temperature. | 2) Place diced potatoes in large bowl. | 3) Mix mayonnaise, cider vinegar, sugar, mustard, salt, garlic powder, and pepper in another bowl. | 4) Add to potatoes. | 5) Add celery and onions and mix well. | 6) Stir in eggs. | 7) Sprinkle a little paprika on top.", "tags": ["potato", "vegetable", "german", "european", "potluck", "15 mins", "easy", "inexpensive"], "cook_time_min": 15, "servings": null, "cuisine": ["All"], "rating_avg": 4.79, "rating_count": 326, "popularity_score": 4.7871428571428565, "nutrition_calories": 237.9, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/22/74/7/j31txphRKpaYLFhrGyYg_CPS%204%20-%20final_2.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["potato", "vegetable", "german", "european", "potluck", "15 mins", "easy", "inexpensive"], "ingredients": []}, {"recipe_id": "rec_579", "props": {"title": "Creamy Burrito Casserole", "instructions": "[Instructions] 1) Brown ground meat/turkey & onion; drain. | 2) Add taco seasoning and stir in refried beans. | 3) Mix soup and sour cream in a separate bowl. | 4) Spread 1/2 sour cream mixture in the bottom of a casserole dish. | 5) Tear up 3 tortillas and spread over sour cream mixture. | 6) Put 1/2 the meat bean mixture over that. | 7) Add a layer of cheese. | 8) You could put some hot sauce on this now. | 9) Repeat the layers. | 10) Sprinkle cheese over the top and bake, uncovered, at 350\u00b0F for 20-30 minutes.", "tags": ["mexican", "60 mins", "oven"], "cook_time_min": 30, "servings": null, "cuisine": ["All"], "rating_avg": 4.63, "rating_count": 944, "popularity_score": 4.630670859538784, "nutrition_calories": 512.6, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/33/91/9/eK932J5iRgKgQGjoAwMG_IMG_7036.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["mexican", "60 mins", "oven"], "ingredients": []}, {"recipe_id": "rec_580", "props": {"title": "Creamy Cajun Chicken Pasta", "instructions": "[Instructions] 1) Place chicken and Cajun seasoning in a bowl and toss to coat. | 2) In a large skillet over medium heat, saut\u00e9 chicken in butter or margarine until chicken is tender, about 5 to 7 minutes. | 3) Reduce heat add green onion, heavy cream, tomatoes, basil, salt, garlic powder, black pepper and heat through. | 4) Pour over hot linguine and toss with Parmesan cheese.", "tags": ["chicken", "poultry", "meat", "cajun", "kid friendly", "spicy", "30 mins", "stove top", "easy"], "cook_time_min": 15, "servings": null, "cuisine": ["All"], "rating_avg": 4.84, "rating_count": 1609, "popularity_score": 4.839098208770846, "nutrition_calories": 719.1, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/39/08/7/VPeSMiYHRce4BWsyj7Nl_0S9A5582.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["chicken", "poultry", "meat", "cajun", "kid friendly", "spicy", "30 mins", "stove top", "easy"], "ingredients": []}, {"recipe_id": "rec_581", "props": {"title": "Crock Pot Chicken \u00e1 La Antoinette", "instructions": "[Instructions] 1) Saute onions and mushrooms in olive oil. | 2) Add chicken. | 3) Combine remaining ingredients and pour over chicken mixture. Slow cook on top of stove for 1 1/2 to 2 hours. (You can also combine ingredients in the Crock Pot and cook on low for up to 12 hours). | 4) Serve over Rice or Pasta.", "tags": ["chicken", "poultry", "meat", "4 hours"], "cook_time_min": 2, "servings": null, "cuisine": ["All"], "rating_avg": 4.25, "rating_count": 32, "popularity_score": 4.355714285714286, "nutrition_calories": 382.6, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/49/81/BhQJFIgQbWIlhRHn9Fow_0S9A5564.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["chicken", "poultry", "meat", "4 hours"], "ingredients": []}, {"recipe_id": "rec_582", "props": {"title": "Crock Pot - Style Loaded Baked Potato Soup", "instructions": "[Instructions] 1) Combine first seven ingredients in a large crock pot; cover and cook on HIGH for 4 hours or LOW for 8 hours (potato should be tender). | 2) Mash mixture until potatoes are coarsely chopped and soup is slightly thickened. | 3) Stir in cream, cheese and chives. | 4) Top with sour cream (if used), sprinkle with bacon and more cheese.", "tags": ["one dish meal", "pork", "potato", "cheese", "vegetable", "meat", "low protein", "egg free", "kid friendly", "kosher", "free of", "potluck", "savory", "easy", "inexpensive"], "cook_time_min": 5, "servings": null, "cuisine": ["All"], "rating_avg": 4.62, "rating_count": 166, "popularity_score": 4.624204545454545, "nutrition_calories": 478.7, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/30/17/54/Sx7f7ZauSmqAhj7XakxM_0S9A3354.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["one dish meal", "pork", "potato", "cheese", "vegetable", "meat", "low protein", "egg free", "kid friendly", "kosher", "free of", "potluck", "savory", "easy", "inexpensive"], "ingredients": []}, {"recipe_id": "rec_583", "props": {"title": "Crock Pot White Chicken Chili", "instructions": "[Instructions] 1) Place chicken in a 4 quart slow cooker. | 2) Top with beans and corn. | 3) In a medium bowl, combine taco seasoning, chiles, condensed soup, and chicken broth. Pour over top of ingredients in the crock pot. | 4) Cover and cook on low for 8 to 10 hours. | 5) Before serving, stir gently to break up chicken, then stir in the sour cream. | 6) Serve topped with green onions and jack cheese, if desired.", "tags": ["chicken breast", "chicken thigh and leg", "chicken", "poultry", "beans", "meat", "winter", "beginner cook", "stove top", "easy", "inexpensive"], "cook_time_min": 10, "servings": null, "cuisine": ["All"], "rating_avg": 4.78, "rating_count": 167, "popularity_score": 4.7751412429378535, "nutrition_calories": 302.6, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/11/47/89/ISH9RfKLSNamLhE1Wf6e_314-crock-pot-white-chicken-chili.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["chicken breast", "chicken thigh and leg", "chicken", "poultry", "beans", "meat", "winter", "beginner cook", "stove top", "easy", "inexpensive"], "ingredients": []}, {"recipe_id": "rec_584", "props": {"title": "Crusty French Bread", "instructions": "[Instructions] 1) Dissolve yeast in warm water (110 degrees) and sugar in large bowl; allow yeast to proof or foam (about 10 minutes). | 2) Add salt, oil, and 3 cups flour; beat for 2 minutes. | 3) Stir in 2 cups flour to make a stiff dough. | 4) Knead until smooth and elastic, about 10 minutes. | 5) Place in oiled bowl, turn dough to coat all sides, cover and let rise until doubled. | 6) Punch down and divide in half. | 7) Shape dough into two long slender loaves. | 8) Grease and sprinkle with cornmeal either a french bread pan or large cookie sheet. | 9) Place loaves in pan and cut diagonal gashes on top of each loaf (I use scissors). | 10) Cover and let rise until doubled. | 11) Bake at 375 degrees for about 30 minutes. | 12) Note: You can sprinkle or spray water on the loaves during baking if you want a really crunchy crust.", "tags": ["breads", "low cholesterol", "healthy", "60 mins"], "cook_time_min": 30, "servings": null, "cuisine": ["All"], "rating_avg": 4.75, "rating_count": 213, "popularity_score": 4.747488789237668, "nutrition_calories": 1241.5, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/10/14/76/T9kb9tQwRqOsl5fVXPzW_newsize-2.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["breads", "low cholesterol", "healthy", "60 mins"], "ingredients": []}, {"recipe_id": "rec_585", "props": {"title": "Curry Chicken", "instructions": "[Instructions] 1) preheat oven to 350. | 2) heat butter, honey, dijon mustard, and curry together in a pan. | 3) place chicken in a baking dish and pour sauce over chicken. | 4) bake for 50-55 mins.", "tags": ["one dish meal", "chicken", "poultry", "meat", "asian", "indian", "sweet", "oven", "4 hours", "easy", "inexpensive"], "cook_time_min": 55, "servings": null, "cuisine": ["All"], "rating_avg": 4.57, "rating_count": 79, "popularity_score": 4.583932584269663, "nutrition_calories": 771.5, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/81/59/1/e5InOkLSzGQBpNeyZWFs_Easy-curry-chicken-01251.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["one dish meal", "chicken", "poultry", "meat", "asian", "indian", "sweet", "oven", "4 hours", "easy", "inexpensive"], "ingredients": []}, {"recipe_id": "rec_586", "props": {"title": "Delicious Chicken Pot Pie", "instructions": "[Instructions] 1) Preheat oven to 400\u00b0F. | 2) Saute onion, celery, carrots and potatoes in margarine for 10 minutes. | 3) Add flour to sauteed mixture, stirring well, cook one minute stirring constantly. | 4) Combine broth and half and half. | 5) Gradually stir into vegetable mixture. | 6) Cook over medium heat stirring constantly until thickened and bubbly. | 7) Stir in salt and pepper; add chicken and stir well. | 8) Pour into shallow 2 quart casserole dish and top with pie shells. | 9) Cut slits to allow steam to escape. | 10) Bake for 40-50 minutes or until pastry is golden brown and filling is bubbly and cooked through.", "tags": ["one dish meal", "chicken", "potato", "poultry", "vegetable", "meat", "potluck", "winter", "weeknight", "oven", "4 hours", "easy"], "cook_time_min": 45, "servings": null, "cuisine": ["All"], "rating_avg": 4.87, "rating_count": 773, "popularity_score": 4.867752234993614, "nutrition_calories": 538.3, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/10/74/4/AyB790BXQZSOoGfb5I8o_0S9A2765.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["one dish meal", "chicken", "potato", "poultry", "vegetable", "meat", "potluck", "winter", "weeknight", "oven", "4 hours", "easy"], "ingredients": []}, {"recipe_id": "rec_587", "props": {"title": "Easy, Creamy Hamburger Stroganoff", "instructions": "[Instructions] 1) Brown hamburger in large skillet with onion and garlic. | 2) Drain out fat and add soup, sour cream, mustard and milk. | 3) Simmer for 5 minutes. | 4) Add salt and pepper for taste, and serve with egg noodles or rice.", "tags": ["15 mins", "stove top", "easy"], "cook_time_min": 10, "servings": null, "cuisine": ["All"], "rating_avg": 4.21, "rating_count": 96, "popularity_score": 4.255660377358491, "nutrition_calories": 417.6, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/36/78/4/xBMfLf5lQRuCtb7Hublv_DSC_0083.JPG"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["15 mins", "stove top", "easy"], "ingredients": []}, {"recipe_id": "rec_588", "props": {"title": "Easy! Oven-Baked Cod", "instructions": "[Instructions] 1) Preheat oven to 400\u00b0F Line your pan with aluminum foil and lightly brush with olive oil, or use a bit of cooking spray. | 2) Combine parsley, garlic, lemon zest, and coarse salt on the cutting board. Finely chop, then combine with the breadcrumbs in a shallow plate. | 3) Brush top of each fillet with olive oil. Press fillet into the crumb mixture. Place fillets in baking dish, crust-side up. Bake until firm, about 12-15 minutes, depending on the thickness of the fish. Serve with lemon wedges.", "tags": ["beginner cook", "easy"], "cook_time_min": 15, "servings": null, "cuisine": ["All"], "rating_avg": 4.6, "rating_count": 60, "popularity_score": 4.613428571428571, "nutrition_calories": 305.5, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/13/37/18/NFhjpaePRMqNuQonZG13_0S9A5509.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["beginner cook", "easy"], "ingredients": []}, {"recipe_id": "rec_589", "props": {"title": "Easy Stove-Top Macaroni and Cheese", "instructions": "[Instructions] 1) Cook macaroni according to package directions. | 2) In medium saucepan, melt butter over medium heat; stir in flour, and cook for 3-5 minutes stirring constantly to form a roux; add salt and pepper; slowly add milk, stirring well after each addition. | 3) Cook and stir until bubbly. | 4) Stir in cheese a small amount at a time until fully melted. | 5) Drain macaroni; add to cheese sauce; stir to coat.", "tags": ["cheese", "30 mins"], "cook_time_min": 15, "servings": null, "cuisine": ["All"], "rating_avg": 4.48, "rating_count": 597, "popularity_score": 4.483525535420099, "nutrition_calories": 590.7, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/60/35/0/JWYBZJMdS2uM1SwQaI7Q_stovetop-macaroni-cheese-8831.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["cheese", "30 mins"], "ingredients": []}, {"recipe_id": "rec_590", "props": {"title": "Famous Challah", "instructions": "[Instructions] 1) First measure out all your ingredients. | 2) Now from the 1/2 of cup sugar take 1 tablespoon of the sugar & combine it with the yeast& warm water (you know you have the right temperature of warm water when it's the same temperature as the inside of your wrist). | 3) I let my mixer bowl which is metal (kitchen aid) sit in a hot water bath while the yeast dissolves, 10 minutes. | 4) After the yeast has dissolved (it's nice & foamy) add to it the rest of the sugar, salt & 3 1/2 cups flour. | 5) Mix well (I use the bread hook). | 6) Add egg (already beaten) & oil. | 7) Slowly start mixing in most of the remaining 3 1/2 cups of flour. | 8) The dough will become quite thick. | 9) When the dough pulls away from the sides of the bowl, turn it onto a floured surface& knead for approximately 10 minute. | 10) Add only enough additional flour to make dough manageable. | 11) Knead until dough has acquired a \"life of its own\"; it should be smooth & elastic, springing back when pressed lightly with your fingertip. | 12) Place dough into a large oiled bowl turning the dough once so its oiled on all sides. | 13) Cover with a damp towel & let rise in a warm place for 2 hours, punching down in 4-5 places every 20 minutes. | 14) Now, I always write down what time I started so I don't forget when the 2 hours are up & set a timer every 20 minutes. (In the summer I let the dough rise on my balcony & in the winter in front of my oven where something is always baking, turning it every time I punch down the dough). | 15) After the 2 hours, turn your dough onto your working surface. | 16) Now comes the forming part. | 17) For Shabbos I always make a 2 level braided challah which looks great & is really easy. | 18) Prepare your baking sheet lining it with parchment paper. | 19) Preheat oven to 375\u00b0F. | 20) First, take a large knife & cut the dough in half. | 21) Next, from each 1/2 now cut off a third & place the 2 thirds on the side. | 22) Now, from the first half (where you've removed a third) divide the remaining dough into approximately equal thirds. | 23) Roll each third out till its about 10-12 inches (I'm guessing I never measured it) & braid all 3 roll together pinching the top & bottom half together& turning them slightly under. | 24) Place on baking sheet. | 25) Repeat the same for other half. | 26) Now take the first third you removed earlier& divide in 3, braid just like you did before& place on top of the already braided challah. | 27) Repeat same for other third. | 28) Now let the challah rise for 1/2 an hour. | 29) After the challah has risen glaze with beaten egg & add mohn or sesame if you wish. | 30) Almost done! | 31) Put in preheated oven & let bake for exactly 25 minutes! | 32) Turn off oven & leave Challahs in for exactly another 10 minutes! | 33) Remove from oven. | 34) Enjoy--you deserve every compliment you get!", "tags": ["breads", "healthy", "kosher", "oven", "4 hours"], "cook_time_min": 35, "servings": null, "cuisine": ["All"], "rating_avg": 4.88, "rating_count": 139, "popularity_score": 4.867516778523489, "nutrition_calories": 2362.3, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/90/76/5/5yf9KKk6S5G1XnpQ7Ymo_batch23-6520.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["breads", "healthy", "kosher", "oven", "4 hours"], "ingredients": []}, {"recipe_id": "rec_591", "props": {"title": "Fantastic Taco Casserole", "instructions": "[Instructions] 1) Brown ground beef and drain. | 2) Add taco seasoning and cook according to package directions, adding proper amount of water. | 3) Put corn chips on bottom of 8x8\" dish. | 4) Cook refried beans on stove until hot. | 5) Add 1 cup cheese and 1 cup salsa. Stir until combined. | 6) Pour beans over corn chips in dish. | 7) Add beef to top of beans. | 8) Sprinkle remaining cheese over top. | 9) Sprinkle green onions and black olives over cheese. | 10) Bake in a 375 degree oven until the cheese is sufficiently melted. | 11) Take out of oven and sprinkle chopped tomatoes on top. Wait 1-2 minutes and then serve.", "tags": ["beans", "meat", "mexican", "kid friendly", "30 mins", "oven", "easy", "inexpensive"], "cook_time_min": 10, "servings": null, "cuisine": ["All"], "rating_avg": 4.66, "rating_count": 296, "popularity_score": 4.661111111111111, "nutrition_calories": 349.9, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/15/51/86/iYi3OirmTM2ZelGLCJPf_0S9A5670.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["beans", "meat", "mexican", "kid friendly", "30 mins", "oven", "easy", "inexpensive"], "ingredients": []}, {"recipe_id": "rec_592", "props": {"title": "Frank and Potato Bake", "instructions": "[Instructions] 1) In saucepan cook onion in butter till tender but not brown. | 2) Blend in flour and salt. Add milk all at once; cook and stir over medium heat till thickened and bubbly. | 3) Add cheese, stirring to melt. | 4) Stir in parsley and mustard. | 5) Fold in potatoes and Frankfurters. | 6) Place in a 1 quart casserole. | 7) Cover and bake at 350 degrees for about 35 minutes or till heated through. | 8) Prep time does not include cooking and cooling of the potatoes.", "tags": ["kid friendly", "60 mins", "oven", "beginner cook", "easy"], "cook_time_min": 35, "servings": null, "cuisine": ["All"], "rating_avg": 4.52, "rating_count": 27, "popularity_score": 4.567027027027027, "nutrition_calories": 450.0, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/13/59/97/9EupokkUQ3qDZcuroubc_hotdogpotato-3.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["kid friendly", "60 mins", "oven", "beginner cook", "easy"], "ingredients": []}, {"recipe_id": "rec_593", "props": {"title": "Garlic and Oregano Stove Top Chicken", "instructions": "[Instructions] 1) Combine butter, garlic, salt, oregano and cayenne pepper. | 2) Cut a 2-inch long pocket horizontally in chicken breasts, cutting deeply but not all the way through. | 3) Put a tablespoon of the butter mixture into each pocket, being sure to get it all the way down in there. | 4) In a large skillet, heat olive oil. | 5) Cook chicken, skin side down, uncovered,until well-browned, about 10 minutes. | 6) Turn chicken and cover skillet, then cook until chicken is cooked through, another 10 to 15 minutes. | 7) Uncover, spread the remaining garlic-oregano butter on the chicken and turn chicken once more skin-side down. | 8) Cover and brown for another 5 to 10 minutes.", "tags": ["chicken", "poultry", "meat", "very low carbs", "high protein", "high in", "60 mins", "stove top", "easy", "inexpensive"], "cook_time_min": 30, "servings": null, "cuisine": ["All"], "rating_avg": 4.52, "rating_count": 27, "popularity_score": 4.567027027027027, "nutrition_calories": 517.0, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/85/37/3/LKFyFyeoS9WjtGPV4XI4_garlic-oregano-chicken-breasts-9500.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["chicken", "poultry", "meat", "very low carbs", "high protein", "high in", "60 mins", "stove top", "easy", "inexpensive"], "ingredients": []}, {"recipe_id": "rec_594", "props": {"title": "General Tso's Chicken", "instructions": "[Instructions] 1) Place sauce ingredients in a quart jar with a lid and shake to mix. If you make this ahead of time just refrigerate until needed, shaking it again when you are ready to use it. This also keeps your dirty dishes down. | 2) Mix cornstarch slurry in a large bowl- the mixture will be strange but trust me it works. It will be VERY thick almost paste like. Add ALL the chicken pieces and stir to coat. Using a fork remove ONE chicken piece at a time and let the excess mixture drip off. YES even though the mixture has a weird consistency it will not stick like paste and the excess will drip off. Add chicken to the hot (350 degree) oil and fry until crispy. Only cook 7 or 8 chicken pieces at a time. You do not want to lower the temp of the oil by cooking too many at a time. You can use a simple cooking or candy thermometer to judge the temp of the oil. | 3) Drain on paper towels. Want them extra crispy? Put them on a rack over a sheet pan. Keep warm- I just put them in the oven with the oven off. Repeating until all chicken is fried. | 4) In a separate wok or large skillet add a small amount of oil and heat to 400 degrees. Again, a candy thermometer works great. (Want less dishes? You can just drain the oil after you fry all the chicken, leave a small amount (about a tsp) in the pan and use the same pan if you like.) | 5) Add green onions and hot peppers and stir fry about 30 seconds. | 6) Stir (or shake jar) sauce mixture, and then add to pan with onions and peppers, cook until thick. Some reviews didn't kniw what \"thick\" meant. Thick like the same sauce you get at a restaurant.you want it to just coat the chicken. If it gets too thick, add a little water or other liquid. The thickness of the sauce should be similar to what you get when ordering this at a restaurant. | 7) Add chicken to sauce in wok and heat just until the chicken is hot enough for you. It may not even need a minute if you kept the chicken warm. The quicker you serve it the crispier the chicken stays. | 8) Don't be scared by any negative reviews. It's not rocket science though if you have never cooked with a cornstarch slurry it may feel like an experiment. Trust yourself! You've got this! If you have any doubts reread the recipe and get everything in order before you start to cook. I promise you will thank yourself and maybe even me! Enjoy! | 9) Oh it's great served over rice!", "tags": ["chicken", "poultry", "meat", "asian", "60 mins", "deep fried", "inexpensive"], "cook_time_min": 20, "servings": null, "cuisine": ["All"], "rating_avg": 4.27, "rating_count": 336, "popularity_score": 4.282254335260115, "nutrition_calories": 410.1, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/16/47/06/lSfuBJlS6WKSVp6VUkAy_general-tsos-chicken-4.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["chicken", "poultry", "meat", "asian", "60 mins", "deep fried", "inexpensive"], "ingredients": []}, {"recipe_id": "rec_595", "props": {"title": "Grandmas Sloppy Joes", "instructions": "[Instructions] 1) Brown hamburger and onion. | 2) Drain out grease. | 3) Add the rest of the ingredients and simmer 15-20 minutes with lid.", "tags": ["meat", "60 mins", "stove top", "easy"], "cook_time_min": 30, "servings": null, "cuisine": ["All"], "rating_avg": 4.77, "rating_count": 137, "popularity_score": 4.7648299319727885, "nutrition_calories": 349.5, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/32/52/2/kTsWTDzwTOyMctbywBtv_0S9A8648.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["meat", "60 mins", "stove top", "easy"], "ingredients": []}, {"recipe_id": "rec_596", "props": {"title": "Greek Potatoes (Oven-Roasted and Delicious!)", "instructions": "[Instructions] 1) Preheat oven to 420\u00b0F A reviewer has suggested spraying the baking pan with Pam - that sounds like a great idea! | 2) Put all the ingredients into a baking pan large enough to hold them. | 3) Season generously with sea salt and black pepper. | 4) Make sure your hands are very clean and put them in the pan and give everything a toss to distribute. | 5) The garlic will drop into the water/oil solution but its flavour will permeate the potatoes, and this way, it won't burn. | 6) Bake for 40 minutes. | 7) When a nice golden-brown crust has formed on the potatoes, give them a stir to bring the white underside up, season lightly with a bit more sea salt and pepper and just a light sprinkling of oregano. | 8) Add 1/2 cup more water if pan appears to be getting dry, and pop back into oven to brown other side of potatoes. | 9) This will take about another 40 minutes. | 10) Do not be afraid of overcooking the potatoes- they will be delicious. | 11) Note: I often melt a bouillon cube in the water; if you do, make sure to cut back some on the salt.", "tags": ["vegetable", "greek", "european", "low protein", "low cholesterol", "kid friendly", "4 hours"], "cook_time_min": 1, "servings": null, "cuisine": ["All"], "rating_avg": 4.76, "rating_count": 641, "popularity_score": 4.758986175115207, "nutrition_calories": 409.7, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/87/78/2/GvYCvLdzQb2AyElhhEou_batch23-7123.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["vegetable", "greek", "european", "low protein", "low cholesterol", "kid friendly", "4 hours"], "ingredients": []}, {"recipe_id": "rec_597", "props": {"title": "Ground Beef Gyros", "instructions": "[Instructions] 1) In a bowl, combine first 5 ingredients. | 2) Cover and refrigerate. (If possible overnight). | 3) In separate bowl, combine ground beef and seasonings. | 4) Mix well. | 5) Shape into 4 patties. | 6) Grill, covered, (you can also use a toaster oven or broil these) over medium to high heat for 10 to 12 minutes or until meat is no longer pink, turning once. | 7) Cut patties into thin slices. | 8) Stuff into pitas. | 9) Add lettuce,cucumber, tomato, and onion. | 10) Serve with yogurt sauce.", "tags": ["meat", "greek", "european", "healthy", "spring", "summer", "broil grill", "30 mins", "oven", "easy"], "cook_time_min": 12, "servings": null, "cuisine": ["All"], "rating_avg": 4.44, "rating_count": 259, "popularity_score": 4.449442379182157, "nutrition_calories": 436.4, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/30/08/1/uaSpHBwtSIuQpcHZKQeu_0S9A0050.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["meat", "greek", "european", "healthy", "spring", "summer", "broil grill", "30 mins", "oven", "easy"], "ingredients": []}, {"recipe_id": "rec_598", "props": {"title": "Ground Beef Stuffed Green Bell Peppers With Cheese", "instructions": "[Instructions] 1) Cut off the tops of green peppers; discard seeds and membranes. | 2) Chop enough of the tops to make 1/4 cup, set aside. | 3) Cook the whole green peppers, uncovered in boiling water for about 5 minutes; invert to drain well. | 4) Sprinkle insides of the peppers lightly with salt. | 5) In a skillet cook ground beef, onion and 1/4 cup chopped pepper till meat is browned and vegetables are tender. | 6) Drain off excess fat. Add drained tomatoes, salt, Worcestershire, and a dash of pepper. | 7) in a separate pot put water bring to boil add rice cook until rice is soft. if needed add more water. | 8) add rice to beef mixture. | 9) Stir in cheese. Stuff peppers with meat mixture. Place in a 10x6x2 baking dish. | 10) Bake, covered in a 350 degree oven for 30 minutes. in the last 5 minutes add any remaining cheese to the top of the peppers.", "tags": ["rice", "cheese", "vegetable", "meat", "60 mins", "oven"], "cook_time_min": 35, "servings": null, "cuisine": ["All"], "rating_avg": 4.64, "rating_count": 347, "popularity_score": 4.641512605042016, "nutrition_calories": 1389.5, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/13/56/skXTuUHHQ1mExOEcczaT_stuffedpeppers3.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["rice", "cheese", "vegetable", "meat", "60 mins", "oven"], "ingredients": []}, {"recipe_id": "rec_599", "props": {"title": "Huey's Italian Sausage Dog", "instructions": "[Instructions] 1) Preheat the grill. | 2) Blanch the sausages in simmering water until just firm to the touch; drain well. | 3) Heat 1 tablespoon of oil from the capsicums in a large pan and gently saut\u00e9 the garlic and onion until they have softened but not browned. | 4) Add the olives, the capsicums, the tomato cooking sauce and the seasonings. Mix well and cook until thickish. Then stir in 8 torn basil leaves. | 5) While the sauce is cooking, pan fry the sausages in a thin layer of oil in another pan until they are golden brown. | 6) Then cut the two baguettes into three pieces about the length of the sausages; make cuts in the centre (but NOT right through) and insert a sausage topped with the sauce inside each piece of the baguette. | 7) Place on the sausage-filled baguettes on a baking tray, top with cheeses and grill until golden and bubbling. | 8) Serve with a garnish of basil.", "tags": ["pork", "onions", "peppers", "vegetable", "meat", "australian", "european", "lactose free", "egg free", "free of", "halloween", "brunch", "broil grill", "30 mins", "oven", "beginner cook", "stove top", "easy", "inexpensive"], "cook_time_min": 15, "servings": null, "cuisine": ["All"], "rating_avg": 4.57, "rating_count": 7, "popularity_score": 4.642941176470588, "nutrition_calories": 393.3, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/16/80/34/picTSGOTk.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["pork", "onions", "peppers", "vegetable", "meat", "australian", "european", "lactose free", "egg free", "free of", "halloween", "brunch", "broil grill", "30 mins", "oven", "beginner cook", "stove top", "easy", "inexpensive"], "ingredients": []}, {"recipe_id": "rec_600", "props": {"title": "Japanese Mum's Chicken", "instructions": "[Instructions] 1) Place all the ingredients in a saucepan over a high heat. | 2) Bring to the boil, then reduce to a simmer for about 20 minutes. | 3) Remove any scum that rises to the surface. | 4) Increase the heat, turning the drumsticks frequently in the liquid, and cook until the liquid has reduced to a sticky glaze. | 5) Arrange the chicken on a serving platter, remove the garlic clove and chili from the liquid, and spoon the glaze over. | 6) NOTE It's a glaze rather than a sauce, so there's not a whole lot of it.", "tags": ["chicken", "poultry", "meat", "japanese", "asian", "potluck", "spicy", "savory", "60 mins", "beginner cook", "stove top", "easy", "inexpensive"], "cook_time_min": 40, "servings": null, "cuisine": ["All"], "rating_avg": 4.62, "rating_count": 976, "popularity_score": 4.620750507099392, "nutrition_calories": 313.1, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/68/95/5/TnfcMfTwRVulI0xETm67_jchicken.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["chicken", "poultry", "meat", "japanese", "asian", "potluck", "spicy", "savory", "60 mins", "beginner cook", "stove top", "easy", "inexpensive"], "ingredients": []}, {"recipe_id": "rec_601", "props": {"title": "Jo Mama's World Famous Spaghetti", "instructions": "[Instructions] 1) In large, heavy stockpot, brown Italian sausage, breaking up as you stir. | 2) Add onions and continue to cook, stirring occasionally until onions are softened. | 3) Add garlic, tomatoes, tomato paste, tomato sauce and water. | 4) Add basil, parsley, brown sugar, salt, crushed red pepper, and black pepper. | 5) Stir well and barely bring to a boil. | 6) Stir in red wine. | 7) Simmer on low, stirring frequently for at least an hour. A longer simmer makes for a better sauce, just be careful not to let it burn! | 8) Cook spaghetti according to package directions. | 9) Spoon sauce over drained spaghetti noodles and sprinkle with parmesan cheese.", "tags": ["pork", "meat", "european", "kid friendly", "weeknight", "stove top", "4 hours", "easy"], "cook_time_min": 1, "servings": null, "cuisine": ["All"], "rating_avg": 4.73, "rating_count": 1376, "popularity_score": 4.72974025974026, "nutrition_calories": 555.9, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/22/78/2/xy39o2sOTtudkgyDgZtv_spaghettisauce.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["pork", "meat", "european", "kid friendly", "weeknight", "stove top", "4 hours", "easy"], "ingredients": []}, {"recipe_id": "rec_602", "props": {"title": "Jolean's Cheese Potato and Smoked Sausage Casserole", "instructions": "[Instructions] 1) Cut skinless smoked sausage in half, lengthwise, and then chop into 1/2 inch \"half moon\" cuts. Cook in a frying pan for about 15 minutes, turning frequently to SLIGHTLY brown. | 2) Meanwhile, put cooked & diced potatoes in 2 quart casserole. Add cooked meat and give it a gentle toss. | 3) Mix all remaining ingredients (except for shredded cheddar cheese & the paprika) in a saucepan over medium heat until warm, melted and smooth. (Use a whisk and stir constantly.). | 4) Pour white/cheese sauce over potatoes and meat. Sprinkle shredded sharp cheddar cheese on top, and then sprinkle paprika evenly over the top. | 5) Bake in preheated 350\u00b0F oven for 35-45 minutes (watch, until golden brown on top). | 6) NOTE: You can substitute: 1/2 lb. hot dogs, sliced into 1/2-inch slices OR 1/2 lb. ham diced into 1/2-inch dices OR 12 oz. can of Spam diced into 1/2-inch dices, instead of the smoked sausage.", "tags": ["pork", "potato", "vegetable", "meat", "kid friendly", "60 mins", "oven", "beginner cook", "easy"], "cook_time_min": 40, "servings": null, "cuisine": ["All"], "rating_avg": 4.63, "rating_count": 184, "popularity_score": 4.633298969072165, "nutrition_calories": 871.4, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/12/66/23/hbXbBzmQTHWGzuks3rrH_0S9A5405.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["pork", "potato", "vegetable", "meat", "kid friendly", "60 mins", "oven", "beginner cook", "easy"], "ingredients": []}, {"recipe_id": "rec_603", "props": {"title": "Leftover Mashed Potato Pancakes", "instructions": "[Instructions] 1) Mix mashed potatoes, egg, flour, salt, pepper, garlic, and any optional ingredients, into mashed potatoes. | 2) Preheat skillet and add a couple of tablespoons of Crisco shortening or oil. | 3) Make sure the mixture is not too thin. | 4) Pour 1/4 cup batter into hot pan; brown on both sides. | 5) Enjoy with sour cream or applesauce. | 6) Enjoy!", "tags": ["potato", "vegetable", "healthy", "hanukkah", "60 mins", "easy"], "cook_time_min": 30, "servings": null, "cuisine": ["All"], "rating_avg": 4.56, "rating_count": 162, "popularity_score": 4.567790697674418, "nutrition_calories": 266.9, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/90/54/QgpKo1rxQpSiZmN5F5jj_untitled-4303.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["potato", "vegetable", "healthy", "hanukkah", "60 mins", "easy"], "ingredients": []}, {"recipe_id": "rec_604", "props": {"title": "Lemon Baked Cod", "instructions": "[Instructions] 1) If fish fillets are large, cut into serving pieces. | 2) Mix butter and lemon juice. | 3) In another bowl, mix flour, salt and white pepper. | 4) Dip fish into butter mixture; coat fish with flour mixture. | 5) Place fish in ungreased square baking dish, 8x8x2 inches. | 6) Pour remaining butter mixture over fish; sprinkle with paprika. | 7) Cook uncovered in 350 degree oven until fish flakes easily with fork, 25-30 minutes. Garnish with parsley sprigs and lemon slices if desired.", "tags": ["scandinavian", "european", "60 mins", "oven", "easy"], "cook_time_min": 25, "servings": null, "cuisine": ["All"], "rating_avg": 4.35, "rating_count": 209, "popularity_score": 4.3657077625570775, "nutrition_calories": 225.3, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/13/52/72/aML6ha46QVqfQuw5Fgu5_THE%20FOOD%20GAYS%20-%20BAKED%20LEMON%20COD.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["scandinavian", "european", "60 mins", "oven", "easy"], "ingredients": []}, {"recipe_id": "rec_605", "props": {"title": "Lemon Pepper Chicken Breasts on a Bed of Rice", "instructions": "[Instructions] 1) Preheat oven to 350. | 2) Sprinkle lemon pepper on both sides of breasts. Sprinkle the lemon pepper to your own taste. | 3) Using a non-greased 9\"x13\" glass baking dish place the chicken, and melted margarine (or butter) inside. Cover. | 4) Bake for 30 Minutes. | 5) Remove from oven. Remove chicken and set aside. Add one cup of long grain white rice, one can of chicken broth (or equal amount of bouillion). Stir together and cover tightly with foil. | 6) Put pan back in the oven. | 7) Bake 30 Minutes. | 8) Remove from oven, and place chicken back inside. | 9) Cook for another 15 minutes. | 10) This update to the recipe (11/19/13) brings it back to its roots and eliminates the problems people were having with under cooked rice/overcooked chicken.", "tags": ["chicken breast", "chicken", "long grain rice", "poultry", "rice", "meat", "free of", "oven", "4 hours", "easy"], "cook_time_min": 1, "servings": null, "cuisine": ["All"], "rating_avg": 4.46, "rating_count": 48, "popularity_score": 4.500344827586207, "nutrition_calories": 523.2, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/95/31/2/JlGbeLjhR46bdLR8nwlN_lemon-pepper-chicken-rice-01123.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["chicken breast", "chicken", "long grain rice", "poultry", "rice", "meat", "free of", "oven", "4 hours", "easy"], "ingredients": []}, {"recipe_id": "rec_606", "props": {"title": "Loaded Potato and Buffalo Chicken Casserole", "instructions": "[Instructions] 1) Preheat oven to 500F (This is NOT a typo, 500F is correct!) . | 2) In a large bowl mix together the olive oil, hot sauce, salt, pepper, garlic powder & paprika. | 3) Add the potatoes and stir to coat. | 4) Add the potatoes to a greased baking dish. | 5) When scooping the potatoes into the baking dish, leave behind any extra olive oil/hot sauce mix. | 6) Add the diced chicken to the \u201cleft behind\u201d olive oil/hot sauce mix and stir to coat all the chicken. Allow to marinate as the potatoes bake. | 7) Roast the potatoes for 45-50 minutes, stirring every 10-15 minutes, until cooked through and nice and crispy on the outside. | 8) Once the potatoes are fully cooked add the marinated chicken. | 9) Once the potatoes are fully cooked, remove from the oven and lower the oven temperature to 400\u00b0F. | 10) In a large bowl mix all the topping ingredients together. | 11) Top the raw chicken with the topping. | 12) Bake 15 minutes or until until the chicken is cooked through and the topping is melted and bubbly delicious. | 13) Serve with extra hot sauce and/or ranch dressing.", "tags": ["meat", "toddler friendly", "kid friendly", "weeknight", "4 hours", "easy"], "cook_time_min": 1, "servings": null, "cuisine": ["All"], "rating_avg": 4.65, "rating_count": 89, "popularity_score": 4.654444444444445, "nutrition_calories": 1138.3, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/49/34/13/c9HvoSAVQ86y2PgJfYsO_buffalo casserole SITE-2.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["meat", "toddler friendly", "kid friendly", "weeknight", "4 hours", "easy"], "ingredients": []}, {"recipe_id": "rec_607", "props": {"title": "Meatloaf", "instructions": "[Instructions] 1) Combine meatloaf ingredients. | 2) Put in loaf pan. | 3) Top with glaze. | 4) Bake at 350 degrees for 45 minutes or until no longer pink in center.", "tags": ["canadian", "60 mins", "easy"], "cook_time_min": 45, "servings": null, "cuisine": ["All"], "rating_avg": 4.67, "rating_count": 103, "popularity_score": 4.67212389380531, "nutrition_calories": 285.0, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/41/75/5/p0f9AvGwTr6jN48rqXzz_DSC_6014.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["canadian", "60 mins", "easy"], "ingredients": []}, {"recipe_id": "rec_608", "props": {"title": "Melt-In-Your-Mouth Chicken Breasts", "instructions": "[Instructions] 1) Mix mayonnaise or yogurt, cheese and seasonings. | 2) Spread mixture over chicken breast and place in baking dish. | 3) Bake at 375\u00b0F for 45 minutes.", "tags": ["oven", "easy"], "cook_time_min": 45, "servings": null, "cuisine": ["All"], "rating_avg": 4.45, "rating_count": 607, "popularity_score": 4.453954619124798, "nutrition_calories": 250.2, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/37/33/6/1KevDZYLSSuYcrmrXpeu_0S9A1389.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["oven", "easy"], "ingredients": []}, {"recipe_id": "rec_609", "props": {"title": "Mexican Rice", "instructions": "[Instructions] 1) Adjust rack to middle position and preheat oven to 350. | 2) Process tomato and onion in processor or blender until pureed and thoroughly smooth. Transfer mixture to measuring cup and reserve exactly 2 cups. Discard excess. | 3) Remove ribs and seeds from 2 jalapenos and discard. Mince flesh and set aside. Mince remaining jalapeno. Set aside. | 4) Place rice in a fine mesh strainer and rinse under cold running water until water runs clear- about 1 1/2 minutes.Shake rice vigorously to remove excess water.This step removes the starch from the rice so it will not stick. IF YOU OMIT THIS STEP YOUR RICE WILL NOT BE DRY AND FLUFFY. | 5) Heat oil in heavy bottomed ovensafe 12 inch straight sided sautee pan or Dutch oven with tight fitting lid over low-medium heat about 2 minutes. (The recipe is very specific about this but I used a 10 inch dutch oven and it worked out fine.) Drop a few rice grains in and if they sizzle then it is ready. Add rice and fry stirring until rice is light golden and translucent, about 6-8 minutes. Be careful that the oil doesn't get too hot too fast or the oil will splatter. | 6) Reduce heat to medium, add garlic and 2 minced jalapenos and cook, stirring constantly until fragrant, about 1 1/2 minutes. | 7) Stir in broth, pureed mixture,tomato paste, and salt. Increase heat to medium high, and bring to a boil. | 8) Cover pan and transfer pan to oven to bake until liquid is absorbed and rice is tender, 30-35 minutes.Stir well after 15 minutes. | 9) Stir in cilantro, minced jalapeno to taste, and pass lime wedges separately. | 10) Edited to add 6-15-05: If you can't get good fresh tomatoes you are better off using canned tomatoes. Don't use those awful hard and underipe tomatoes that are at most supermarket chains. Just be sure that the processed tomatoes and the one onion equals 2 cups. One the other hand- if you find that after processing your tomatoes and onions that you have less than 2 cups- simply add enough bottled salsa to make up the difference. | 11) Edited 8-21-06: Do not skip any of the steps. It may seem stupid- but rinsing the rice to remove the starch is very important if you want fluffy rice. It will only take two minutes of your time but it makes the difference. | 12) Edited 8-15-08: Leftovers are just as delicious the next day so this is a perfect dish to make ahead time for potlucks. This rice also freezes well. For Freezing Ahead: Cool, portion and freeze in a ziploc bag. To reheat from frozen: Place in a pyrex dish and warm in the microwave, stirring every 2-3 minutes until heated through. | 13) You'll love this rice! Money back guarantee.", "tags": ["rice", "mexican", "lactose free", "low protein", "low cholesterol", "free of", "60 mins", "inexpensive"], "cook_time_min": 35, "servings": null, "cuisine": ["All"], "rating_avg": 4.82, "rating_count": 652, "popularity_score": 4.81809667673716, "nutrition_calories": 280.1, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/11/78/92/WlojZNwSSKqBLqEXjpWA_THE%20FOOD%20GAYS%20-%20MEXICAN%20RICE-2.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["rice", "mexican", "lactose free", "low protein", "low cholesterol", "free of", "60 mins", "inexpensive"], "ingredients": []}, {"recipe_id": "rec_610", "props": {"title": "My Favorite King Ranch Chicken", "instructions": "[Instructions] 1) Steam or boil the chicken breasts until cooked through (I use my steamer and find it makes the chicken perfectly moist and tender). | 2) When cool, dice into bite-size pieces. | 3) In a large saucepan over medium heat, mix the soups, onion, Ro-tel tomatoes and Cheez Whiz until blended. | 4) Preheat oven to 350 degrees Farenheit. | 5) Layer the bottom of a greased 9x12 casserole dish with crushed chips. | 6) Next, layer half the chicken pieces. | 7) Top with half the sauce. | 8) Sprinkle with half the cheddar cheese. | 9) Repeat the layers, but top with the Cheddar and Mozzarella. | 10) Sprinkle paprika over the top to garnish. | 11) Bake for 30-45 minutes, or until hot and bubbly.", "tags": ["poultry", "meat", "potluck", "weeknight", "oven", "4 hours"], "cook_time_min": 45, "servings": null, "cuisine": ["All"], "rating_avg": 4.45, "rating_count": 70, "popularity_score": 4.4805, "nutrition_calories": 929.3, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/54/08/6/VzvvVi7WTWm3g21zAJMo_DSC_0743.JPG"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["poultry", "meat", "potluck", "weeknight", "oven", "4 hours"], "ingredients": []}, {"recipe_id": "rec_611", "props": {"title": "N. Y. C. Corned Beef and Cabbage", "instructions": "[Instructions] 1) ------------Selecting the corned beef brisket------------. | 2) Go to the store several days ahead of time or you will have to pick out the best of what has been picked over again and again. The best will disappear first. | 3) Do not freeze. | 4) Pick out a nice thick slab checking the sides to make sure it isn't a very gristly one. | 5) Feel it because some butchers fold it over hiding the gristle if there is a lot of it. | 6) There will always be some gristle and it runs the length of the slab in the center. | 7) The thicker the slab the better. If you are lucky, you may see some chunk style at a higher price per pound. | 8) If there isn't a spice bag in with the brisket, you will need to get some whole peppercorns (white and black) and bay leaves. | 9) ------------Selecting the Cabbage-------------------. | 10) The heavier and more solid it is, the better it is. | 11) Smell it to make sure it isn't too bitter. | 12) You may have to go to another store if the whole batch has a very strong bitter smell. I have had to visit several stores to find a decent batch. | 13) Keep in mind that the outer leaves will be discarded even if the store has already removed the natural outer leaves to make them look better and fresher. | 14) --------------Selecting the Potatoes----------------. | 15) Watch out for the red dyed ones. | 16) Pick out a bag of medium to small sized ones. | 17) The smaller the better. | 18) If you are lucky enough to find the ones as small as salad tomatoes, they are the best. | 19) -------------Selecting the Carrots----------. | 20) Get the smallest bag they have unless you like carrots, because you will only use one per pot of cabbage to take any bitterness out of the cabbage. | 21) Serving a bowl of carrots is a big no no on Saint Patrick's Day. | 22) Preparing and cooking the meal-----------------------. | 23) (It's going to take 3 hours with you there). | 24) Use a large Dutch oven or stock pot that will hold everything all at once. | 25) Place the brisket (best side up) in the bottom of the pot. | 26) There's no need to rinse it because nothing bad will survive what you are about to do to it and you will remove the outer marinate. | 27) Add the spice packet or a teaspoonful of peppercorns and two bay leaves. | 28) Cover the brisket generously with water and a bottle of beer (optional - adds flavor and is a tenderizer). | 29) Bring to a boil. | 30) Reduce heat, cover and simmer for 2 hours. | 31) During the 2 hours------------------------. | 32) Scrub and rinse the new red potatoes. | 33) Remove any eyes and bad spots. | 34) Leave as much of the peel as you can. | 35) Quarter them (halve or whole if tiny). | 36) Cover with water until ready for them. | 37) Remove the outer leaves from the cabbage until the leaves are entirely light green, rinse and cut it into quarters through the spine so they stay together. Set aside. | 38) Peel one carrot and cut it into quarters. Set aside. | 39) Peel the onion and cut it into eighths. Set aside. | 40) Rinse the bunch of fresh parsley and chop up just the tops into very tiny pieces. | 41) I find that kitchen scissors do just fine. | 42) After the 2 hours----------------------. | 43) Add the potatoes on top of the brisket. | 44) Add water to cover everything. | 45) Bring to a boil. | 46) Reduce heat, cover and simmer for 10 minutes. | 47) Add the cabbage on top of the potatoes and add onion and carrot on top of the cabbage. | 48) Add water to cover everything. | 49) Bring to a boil. | 50) Reduce heat, cover and simmer for 20 minutes. | 51) Check the cabbage to see if it is tender. | 52) If not, simmer another 5 minutes. You shouldn't undercook it and it's hard to overcook it. | 53) When done-----------------------. | 54) In a large serving bowl where you can stir the potatoes, crush the garlic clove and rub the inside of the bowl with it. | 55) Place the potatoes in the bowl while still piping hot and add (at least) a quarter pound of butter and add a handful (more is better than less) of chopped fresh parsley. | 56) Gently stir until butter is melted, it coats all the potato pieces and the parsley is evenly distributed. | 57) Put the rest of the parsley into a tiny serving bowl for those who want to add more to their potatoes. | 58) As I said, more is better. | 59) Slice the brisket cross grain. | 60) Hope there is leftovers for breakfast. | 61) See my March 18th Breakfast! It's a family tradition. We make sure we make enough to ensure leftovers for breakfast the next morning. Finely chopped fried corned beef and cabbage (the entire meal) and coffee is divine. We throw in any leftover parsley.", "tags": ["potato", "vegetable", "meat", "european", "spring", "weeknight", "st patrick s day", "beginner cook", "stove top", "4 hours", "easy"], "cook_time_min": 3, "servings": null, "cuisine": ["All"], "rating_avg": 4.8, "rating_count": 163, "popularity_score": 4.793872832369942, "nutrition_calories": 563.8, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/15/84/6/DbERKvW9SWeTU3BYvVxR_DSC_0790.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["potato", "vegetable", "meat", "european", "spring", "weeknight", "st patrick s day", "beginner cook", "stove top", "4 hours", "easy"], "ingredients": []}, {"recipe_id": "rec_612", "props": {"title": "Olive Garden Copycat Zuppa Toscana", "instructions": "[Instructions] 1) Chop or slice uncooked sausage into small pieces and cook until browned and meat is ground in bottom of your soup pan over med-high heat. | 2) Add onions, garlic, salt, pepper, and red pepper flakes to Sausage and cook until onions are clear and aromatics of the seasonings blend together. | 3) Reduce heat back to medium and place, potatoes, in the pot. and slowly add the Chicken Stock and water and stir. (use Chicken Bouillon envelope for extra flavor is Chicken Stock is weak). | 4) Cook on medium heat until potatoes are done and stir occasionally. Once Potatoes are done, Add flour or cornstarch and simmer for another 15 minutes. | 5) Reduce heat to lowest setting and sprinkle in your kale and cooked bacon and slowly pour cream while stirring. | 6) Check for taste and then serve.", "tags": ["potato", "vegetable", "meat", "european", "weeknight", "60 mins", "stove top"], "cook_time_min": 40, "servings": null, "cuisine": ["All"], "rating_avg": 4.88, "rating_count": 733, "popularity_score": 4.87749663526245, "nutrition_calories": 840.4, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/38/29/8/Z8MMxtVfQfCLy4zZJtZU_0S9A7184.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["potato", "vegetable", "meat", "european", "weeknight", "60 mins", "stove top"], "ingredients": []}, {"recipe_id": "rec_613", "props": {"title": "Oven-baked Parmesan Chicken Strips", "instructions": "[Instructions] 1) Spray a baking sheet with non-stick spray. | 2) In a shallow dish, combine milk and egg. | 3) In a plastic zipper bag, combine Parmesan cheese, bread crumbs, onion powder, garlic powder, thyme, basil, pepper and paprika. | 4) Dip chicken strips first in milk mixture, then toss to coat evenly in the breadcrumb/cheese mixture. | 5) Place on baking sheets and bake at 400 degrees F for 20 minutes or until golden.", "tags": ["chicken", "poultry", "cheese", "meat", "high protein", "kid friendly", "high in", "60 mins", "oven", "easy"], "cook_time_min": 20, "servings": null, "cuisine": ["All"], "rating_avg": 4.52, "rating_count": 74, "popularity_score": 4.5407142857142855, "nutrition_calories": 484.7, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/94/90/7/lLnZgVKRQsOnzLTeXQ5P_chicken-parmesan-strips-4.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["chicken", "poultry", "cheese", "meat", "high protein", "kid friendly", "high in", "60 mins", "oven", "easy"], "ingredients": []}, {"recipe_id": "rec_614", "props": {"title": "Panera Broccoli Cheese Soup", "instructions": "[Instructions] 1) Saut\u00e9 onion in butter. Set aside. | 2) Cook melted butter and flour using a whisk over medium heat for 3-5 minutes or until you see a noticeable golden brown color in your pan. | 3) Slowly add in the chicken stock and whisk again to combine. Simmer contents covered (stirring occasionally) for 20 minutes on medium heat. | 4) Add the broccoli, carrots and the sauteed onions, into the pot. Stir, add the milk and half & half. Cook covered over low heat 20-25 minutes but do not bring to a boil. This may cause the milk to curdle. | 5) Add salt, pepper & nutmeg. Note: you can pur\u00e9e half of your soup in a blender or with a handheld immersion blender if you choose however it isn't a requirement. Continue to cook the soup on low heat and slowly add the grated cheese a handful at a time and stir to avoid clumps. Once all the cheese has been added is melted, remove from heat, and serve immediately. Suggestion: serve with crusty bread or in a breadbowl. | 6) Refrigerate leftovers after they have cooled and store in a airtight container up to 5 days in the refrigerator.", "tags": ["4 hours", "easy"], "cook_time_min": 40, "servings": null, "cuisine": ["All"], "rating_avg": 4.58, "rating_count": 605, "popularity_score": 4.581853658536586, "nutrition_calories": 702.6, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/15/03/84/CsokZG1NTuqBSLb2lOcf_copycat-panera-cheesy-broccoli-soup-3266.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["4 hours", "easy"], "ingredients": []}, {"recipe_id": "rec_615", "props": {"title": "Perfect Basic White Rice", "instructions": "[Instructions] 1) In a saucepan with a good fitting lid bring water, salt and optional ingredients if desired to a boil. The salt and butter are simply for flavor. The vinegar keeps your grains separated and gives you a prettier dish. No one will taste the vinegar at all! | 2) Add rice and stir. | 3) Cover and reduce heat to low. You will know that your temperature is correct if a little steam is visible leaking from the lid. A lot of steam means your heat is too high. | 4) Cook for 20 minutes. | 5) DO NOT LIFT LID! | 6) The steam that is trapped inside the pan is what allows the rice to cook properly. | 7) Remove from heat and fluff with fork. | 8) Serve!", "tags": ["asian", "low protein", "low cholesterol", "healthy", "30 mins", "easy", "inexpensive"], "cook_time_min": 20, "servings": null, "cuisine": ["All"], "rating_avg": 4.74, "rating_count": 175, "popularity_score": 4.737513513513514, "nutrition_calories": 168.8, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/13/73/64/4mN6Zjh5SNmTNKFsca1D_0S9A2673.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["asian", "low protein", "low cholesterol", "healthy", "30 mins", "easy", "inexpensive"], "ingredients": []}, {"recipe_id": "rec_616", "props": {"title": "Perfect Pot Roast (Slow-Cooker)", "instructions": "[Instructions] 1) Place roast into crockpot and surround with vegetables. | 2) Combine beef broth and vegetable soup mix, then add to crockpot. | 3) Cover and cook on LOW 6-8 hours or HIGH 3-4 hours.", "tags": ["roast beef", "potato", "vegetable", "meat", "healthy", "4 hours", "easy"], "cook_time_min": 3, "servings": null, "cuisine": ["All"], "rating_avg": 4.46, "rating_count": 88, "popularity_score": 4.4838775510204085, "nutrition_calories": 343.8, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/23/98/29/Oq4Yc2NySRyayCO1oG90_Perfect%20Pot%20Roast%20Slow%20Cooker_final%202.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["roast beef", "potato", "vegetable", "meat", "healthy", "4 hours", "easy"], "ingredients": []}, {"recipe_id": "rec_617", "props": {"title": "Perfect Rump Roast", "instructions": "[Instructions] 1) DO NOT USE A GLASS PAN FOR THIS RECIPE. | 2) Pre-Heat the oven to 500 degrees. | 3) Prep the roast by making 4-5 slits in the roast and filling the holes with salt, pepper and 1/2 of a clove of Garlic. | 4) Now Salt and Pepper the rest of the roast. | 5) Put the Roast in the oven and sear for 20 minutes. | 6) Then add the water, the chopped onion and reduce the temperature to 275 degrees. | 7) Cook for 20 minutes per lb. I like mine rare so that is what you will get if you cook for this period of time.", "tags": ["meat", "very low carbs", "high protein", "high in", "beginner cook", "4 hours", "easy"], "cook_time_min": 2, "servings": null, "cuisine": ["All"], "rating_avg": 4.28, "rating_count": 206, "popularity_score": 4.299166666666667, "nutrition_calories": 916.8, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/29/41/96/AwMJ2h3lQp2SodD7s7UJ_0S9A5997.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["meat", "very low carbs", "high protein", "high in", "beginner cook", "4 hours", "easy"], "ingredients": []}, {"recipe_id": "rec_618", "props": {"title": "Perfect Southern Fried Chicken", "instructions": "[Instructions] 1) Soak chicken in water and salt at least 2 hours in the refrigerator. | 2) Mix buttermilk, eggs and Season All and dip chicken pieces in this mixture. | 3) Combine 1 cup flour, 2 tbsp corn meal, 2 tsp dried oregano, and 2 tsp Season All in a bag. | 4) Drop two pieces of dipped chicken in the bag at one time. | 5) Shake to coat. | 6) Place on wire rack to rest. | 7) (I place wax paper under the rack to catch any flour that falls off.) Heat a shallow layer of oil or shortening to 360 F in a jumbo chicken skillet (cast iron is great for this job) or an electric skillet. | 8) Place the chicken in the pan, trying not to crowd the pieces. | 9) Cover for the first five minutes. | 10) Check the chicken. | 11) When golden brown, turn. | 12) Cover for the next five minutes. | 13) Remove cover and cook uncovered, turning occasionally, as needed for a total of an additional 20 minutes or until cooked through. | 14) Watch carefully, and don't allow it to get too dark. | 15) If it's frying too fast, reduce heat slightly. | 16) NOTE- the key is to cover in the beginning to start the cooking process inside the chicken, but to uncover during the last part of the cooking time to get the outside nice and crispy and golden brown.", "tags": ["poultry", "meat", "weeknight", "deep fried", "4 hours"], "cook_time_min": 35, "servings": null, "cuisine": ["All"], "rating_avg": 4.7, "rating_count": 137, "popularity_score": 4.699591836734694, "nutrition_calories": 683.6, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/39/61/8/3izidX0TR4eB7BJzCpQJ_SFC%203%20-%20final_1.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["poultry", "meat", "weeknight", "deep fried", "4 hours"], "ingredients": []}, {"recipe_id": "rec_619", "props": {"title": "Properly Prepared Spaghetti Squash", "instructions": "[Instructions] 1) Preheat oven to 350-375. | 2) Halve raw spaghetti squash with a sturdy sharp knife, scoop out, and discard the squash poop with a spoon. | 3) Place halves onto an oven safe cooking dish face up. | 4) Clean head of garlic and thinly slice garlic, (the larger pieces of garlic brown nicely, and offer a wonderful layer of complexity to the dish). | 5) Spread garlic into the bowl like shape of the squash, salt and pepper vigorously, drizzle with a 50/50 mixture of olive oil, and vegetable oil (get the oil everywhere inside the squash). | 6) Place onto the upper middle rack of the oven for about 30-40 minutes. (You will know it is ready when the squash separates with little resistance from the skin). | 7) Remove from oven, and place in coldest location possible for at least 20 minutes, before separating from skin. | 8) Use a fork to scoop and separate squash strands, add any other ingredients you like at this point. | 9) Parmesan, Romano, or Pecorino, Feta, are all excellent additions to this dish, as well as, meat, sausage, veggies, olives, the list is endless. | 10) WARNING **** If you use a loose tomato based sauce DO NOT add it immediately to the squash; this makes the squash runny, mushy, and unpalatable. Instead garnish the dish with a little bit of sauce atop the squash, and then offer more sauce on the side, in a separate dish. | 11) If you ever had it served this way you know what I mean. | 12) You can also take any leftovers and add a little bit of flour, and make into patties and fry.", "tags": ["vegetable", "european", "low protein", "vegan", "low cholesterol", "egg free", "healthy", "free of", "potluck", "brunch", "oven", "beginner cook", "4 hours", "easy", "inexpensive"], "cook_time_min": 50, "servings": null, "cuisine": ["All"], "rating_avg": 4.9, "rating_count": 93, "popularity_score": 4.88, "nutrition_calories": 45.8, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/16/27/65/igx6WO7FR1ebiQ7aszvH_THE%20FOOD%20GAYS%20-%20SQUASH.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["vegetable", "european", "low protein", "vegan", "low cholesterol", "egg free", "healthy", "free of", "potluck", "brunch", "oven", "beginner cook", "4 hours", "easy", "inexpensive"], "ingredients": []}, {"recipe_id": "rec_620", "props": {"title": "Pulled Pork BBQ, BBQ Rub, and BBQ Sauce", "instructions": "[Instructions] 1) Place Dry rub ingredients in a large Ziplock Bag and mix well. | 2) Rinse Pork Buttes and sprinkle heavily with the Dry Rub,& using a Knife, poke some holes over entire surface of the Pork. | 3) Make sure Buttes are well coated with the rub. | 4) Place in a large container covered with saran wrap and refrigerate Buttes for 8 hours or over night. | 5) Add all the Sauce ingredients in a sauce pan and bring to a boil, stirring constantly so it doesn't stick. | 6) Let sauce cool and either pour into a Quart jar or some kind of seal able container. | 7) This Sauce will Keep at least 6 Months if kept sealed and in the fridge. | 8) 8 hours later or the next day, Preheat oven to 300 degrees. | 9) Place Butts in the oven uncovered for 6 hours. Test to see if the Pork pulls apart after 6 hours. If not, continue cooking until it does. | 10) Pork will be dark and crusty on the outside. | 11) Inside will be moist and delicious. | 12) After the Pork is Pulled, Pour your Sauce over it and mix well. | 13) This makes a lot of BBQ and I usually Freeze Half. | 14) Freeze up to 6 months. | 15) Serve BBQ on a Bun or just eat it with a fork! | 16) Enjoy!", "tags": ["meat", "free of", "for large groups"], "cook_time_min": 6, "servings": null, "cuisine": ["All"], "rating_avg": 4.74, "rating_count": 21, "popularity_score": 4.72516129032258, "nutrition_calories": 129.7, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/94/78/1/q3wSvNICT6aXn1K7FuyY_IMG_4594%20bbq%20pork%20sandwich.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["meat", "free of", "for large groups"], "ingredients": []}, {"recipe_id": "rec_621", "props": {"title": "Quick and Easy Stove Top Tuna \" Casserole \"", "instructions": "[Instructions] 1) Cook pasta according to the package directions; drain well, set aside and keep warm. | 2) Cook celery and onion in butter in a large skillet over medium high heat, stirring constantly until tender. Add English peas, stir until warm. | 3) Add cream cheese, milk, salt, and pepper; cook over medium heat until smooth, stirring occasionally. Stir in tuna and Parmesan cheese; cook until thoroughly heated, stirring occasionally. | 4) Add pasta and toss well. Cover at low or warm heat until pasta is warmed up. Sprinkle with fresh parsley. Serve immediately.", "tags": ["tuna", "30 mins", "stove top", "inexpensive"], "cook_time_min": 20, "servings": null, "cuisine": ["All"], "rating_avg": 4.67, "rating_count": 32, "popularity_score": 4.675714285714285, "nutrition_calories": 1026.4, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/34/40/25/A9pMM0P9SWi57wIeeIMy_tuna-casserole-9.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["tuna", "30 mins", "stove top", "inexpensive"], "ingredients": []}, {"recipe_id": "rec_622", "props": {"title": "Addicting Red Lobster Cheddar Bay Biscuit", "instructions": "[Instructions] 1) Heat oven to 450. | 2) Combine baking mix, water and grated cheese in a bowl. | 3) Roll out on a lightly floured surface, until 1 inch thick. | 4) Cut biscuits, and place on an ungreased pan. | 5) Melt butter and spices together. | 6) Brush the biscuits with the butter and bake for 8 to 10 minutes.", "tags": ["30 mins", "oven"], "cook_time_min": 10, "servings": null, "cuisine": ["All"], "rating_avg": 4.47, "rating_count": 46, "popularity_score": 4.51, "nutrition_calories": 185.1, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/89/68/4/HkbVfes5TkiIDM3Eyrpl_0S9A5340.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["30 mins", "oven"], "ingredients": []}, {"recipe_id": "rec_623", "props": {"title": "Scalloped Potatoes", "instructions": "[Instructions] 1) In a small sauce pan, melt butter and blend in flour. | 2) Let sit for a minute. | 3) Add all of cold milk, stirring with a whisk. | 4) Season with salt and cayenne. | 5) Cook sauce on low until smooth and boiling, stirring occasionally with a whisk. | 6) Reduce heat and stir in cheese. | 7) Place a half of the sliced potatoes in a lightly greased one quart casserole dish. | 8) Pour half of cheese sauce over potatoes. | 9) Repeat with second layer of potatoes and cheese sauce. | 10) Sprinkle the remaining cheese on top. | 11) Top with some paprika for color. | 12) Bake uncovered for about 1 hour at 350\u00b0F.", "tags": ["vegetable", "oven", "4 hours"], "cook_time_min": 1, "servings": null, "cuisine": ["All"], "rating_avg": 4.74, "rating_count": 872, "popularity_score": 4.739478458049887, "nutrition_calories": 288.3, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/85/62/9/ALhTKCBsRHu6JnlXk8Qy_0S9A3426.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["vegetable", "oven", "4 hours"], "ingredients": []}, {"recipe_id": "rec_624", "props": {"title": "Sesame Crusted Tuna Steaks With Balsamic Sauce", "instructions": "[Instructions] 1) In a small sauce pan, heat sesame oil. | 2) Stir in the green onion and garlic and cook, stirring, for about 1 minute. | 3) Add remaining ingredients and heat on medium until reduced by half. | 4) Sprinkle the tuna with the pepper, salt, and sesame seeds. | 5) Rub into meat to create crust. | 6) Heat cooking oil in a large skillet set over medium high. | 7) Add the tuna and cook until almost the desired degree of doneness. | 8) The tuna will continue to cook slightly after it is removed from the pan. | 9) Two or 3 minutes on each side should result in a pink center. | 10) Drizzle sauce over the tuna and serve immediately.", "tags": ["30 mins"], "cook_time_min": 10, "servings": null, "cuisine": ["All"], "rating_avg": 4.57, "rating_count": 7, "popularity_score": 4.642941176470588, "nutrition_calories": 422.3, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/89/90/1/cGuFE2BPQlmhSTVmZq8S_grilled%20tuna.JPG"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["30 mins"], "ingredients": []}, {"recipe_id": "rec_625", "props": {"title": "Simple Baked Chicken Drumsticks", "instructions": "[Instructions] 1) Put some olive oil in the bottom of a 9x13 pan (just enough to put the drumsticks on). | 2) Add drumsticks (space enough apart so they aren't touching each other). | 3) Sprinkle generously with pepper and garlic powder. Sprinkle lightly with salt. Add rosemary to the chicken, if desired. | 4) Bake at 375\u00b0 F for half an hour. Turn drumsticks over and add more garlic powder, pepper and salt (same as before). Top with the parsley. | 5) Bake another half an hour, or until cooked until 160\u00b0F.", "tags": ["high protein", "high in", "oven", "beginner cook", "4 hours", "easy"], "cook_time_min": 1, "servings": null, "cuisine": ["All"], "rating_avg": 4.74, "rating_count": 127, "popularity_score": 4.736642335766423, "nutrition_calories": 528.9, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/44/37/58/P0HhytrsTj2hjf9lUqJ9_0S9A9740.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["high protein", "high in", "oven", "beginner cook", "4 hours", "easy"], "ingredients": []}, {"recipe_id": "rec_626", "props": {"title": "Simple Oven-Roasted Corn on the Cob", "instructions": "[Instructions] 1) Preheat oven to 450 degrees. | 2) Remove husks and silks from corn. | 3) Butter corn and wrap in foil. | 4) Place on cookie sheet and roast for 20 to 25 minutes.", "tags": ["vegetable", "30 mins", "easy"], "cook_time_min": 25, "servings": null, "cuisine": ["All"], "rating_avg": 4.6, "rating_count": 48, "popularity_score": 4.616206896551724, "nutrition_calories": 164.2, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/24/91/68/Em4Eg8X8Q8iZcyRte9NR_oven-roasted-corn-on-cob_3521.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["vegetable", "30 mins", "easy"], "ingredients": []}, {"recipe_id": "rec_627", "props": {"title": "Simple Pasta Toss", "instructions": "[Instructions] 1) Cook and drain pasta as directed. | 2) While pasta is cooking, in a large pot, heat olive oil and saute chicken, garlic, salt, garlic powder, basil, and oregano until chicken is cooked. | 3) Add sun-dried tomatoes and cook for two minutes. | 4) Remove from heat and toss with pasta. | 5) Serve with grated Parmesan cheese if desired.", "tags": ["poultry", "meat", "high protein", "healthy", "high in", "15 mins", "beginner cook", "easy"], "cook_time_min": 15, "servings": null, "cuisine": ["All"], "rating_avg": 4.22, "rating_count": 9, "popularity_score": 4.469473684210526, "nutrition_calories": 719.5, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/28/52/84/aF0eWDOQ5y0FnCXd3TwQ_DSC03008.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["poultry", "meat", "high protein", "healthy", "high in", "15 mins", "beginner cook", "easy"], "ingredients": []}, {"recipe_id": "rec_628", "props": {"title": "Simply Sour Cream Chicken Enchiladas", "instructions": "[Instructions] 1) In a frying pan, cook chicken and onion together in oil over medium-high heat until chicken is just done. | 2) Divide cooked chicken evenly between 8 tortillas; add 1 1/2 tablespoons cheese to each tortilla. | 3) Roll enchiladas and place seam-side down in a 9x13\" baking dish that has been lightly sprayed with no-stick cooking spray. | 4) Melt butter in a medium saucepan; stir in flour to make a roux, stir and cook until bubbly, and gradually whisk in chicken broth then bring to boiling, stirring frequently. | 5) Remove from heat; stir in sour cream and green chilies. | 6) Pour sauce evenly over enchiladas. | 7) Top with remaining 3/4 cup cheese (a baking dish may be double-wrapped and frozen at this point) and bake at 400\u00b0 F for 20 minutes until cheese is melted and sauce near edges of baking dish is bubbly.", "tags": ["chicken", "poultry", "cheese", "meat", "tex mex", "southwestern u s", "mexican", "60 mins", "oven", "beginner cook", "easy"], "cook_time_min": 20, "servings": null, "cuisine": ["All"], "rating_avg": 4.66, "rating_count": 832, "popularity_score": 4.660403800475059, "nutrition_calories": 507.3, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/12/99/26/fqaHKUZ5Qxe1JYEmj5sO_DSC02592.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["chicken", "poultry", "cheese", "meat", "tex mex", "southwestern u s", "mexican", "60 mins", "oven", "beginner cook", "easy"], "ingredients": []}, {"recipe_id": "rec_629", "props": {"title": "Skillet Tarragon Chicken", "instructions": "[Instructions] 1) Sprinkle chicken with salt and pepper and dredge in flour. Set aside remaining flour. | 2) Heat 3 tablespoons of butter over medium heat in large skillet and brown chicken on both sides. Remove chicken and keep warm. | 3) Saute onion in same skillet until it begins to become clear. | 4) Add wine and cook until liquid is almost evaporated, stirring to loosen browned bits (deglaze) on bottom of skillet. Watch closely- this happens fast! | 5) Reduce heat to medium-low and stir in reserved flour until it becomes a thick paste. | 6) Add tarragon, chicken broth and the cooked chicken. Cover and cook until tender. | 7) Place chicken on a warm platter. | 8) Add remaining butter and heavy cream to the liquid that is in the skillet and heat through. | 9) Pour sauce over the chicken and garnish with a little more tarragon or some chopped fresh parsley or green onion if desired.", "tags": ["chicken thigh and leg", "chicken", "poultry", "meat", "very low carbs", "brunch", "30 mins", "easy", "inexpensive"], "cook_time_min": 20, "servings": null, "cuisine": ["All"], "rating_avg": 4.69, "rating_count": 13, "popularity_score": 4.691739130434783, "nutrition_calories": 269.5, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/25/30/68/fo5M5VKQTlCk8HFxcfO9_THE%20FOOD%20GAYS%20--%20TERAGON%20CHICKEN_.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["chicken thigh and leg", "chicken", "poultry", "meat", "very low carbs", "brunch", "30 mins", "easy", "inexpensive"], "ingredients": []}, {"recipe_id": "rec_630", "props": {"title": "Smothered Flat Iron Steak in a Parmesan Pepper Sauce", "instructions": "[Instructions] 1) Pour 1/4 cup dressing over steak and seal in a Ziploc bag. Refrigerate at least 30 minutes or overnight to marinate. | 2) Combine sour cream, 2 tbsp of the remaining dressing, Parmesan cheese, salt and pepper. Refrigerate until serving time. | 3) Heat remaining 2 tbsp dressing and garlic in large nonstick skillet on medium heat. Add onions; cook until golden brown, stirring frequently. Remove onions; set aside. | 4) Drain steak; discard marinade. Cook steak in same skillet on medium heat 3-4 on each side for medium doneness. Place on cutting board; slice crosswise into thin strips. Serve steak topped with sauce and onions.", "tags": ["meat", "30 mins"], "cook_time_min": 10, "servings": null, "cuisine": ["All"], "rating_avg": 4.45, "rating_count": 12, "popularity_score": 4.560909090909091, "nutrition_calories": 355.2, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/29/91/48/xCNoKL9HTLCOWghO1gr7_flat-iron-steak-1.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["meat", "30 mins"], "ingredients": []}, {"recipe_id": "rec_631", "props": {"title": "Southern Buttermilk Biscuits", "instructions": "[Instructions] 1) Preheat your oven to 450\u00b0F. | 2) Combine the dry ingredients in a bowl, or in the bowl of a food processor. | 3) Cut the butter into chunks and cut into the flour until it resembles course meal. | 4) If using a food processor, just pulse a few times until this consistency is achieved. | 5) Add the buttermilk and mix JUST until combined. | 6) If it appears on the dry side, add a bit more buttermilk. It should be very wet. | 7) Turn the dough out onto a floured board. | 8) Gently, gently PAT (do NOT roll with a rolling pin) the dough out until it's about 1/2\" thick. Fold the dough about 5 times, gently press the dough down to a 1 inch thick. | 9) Use a round cutter to cut into rounds. | 10) You can gently knead the scraps together and make a few more, but they will not be anywhere near as good as the first ones. | 11) Place the biscuits on a cookie sheet- if you like soft sides, put them touching each other. | 12) If you like\"crusty\" sides, put them about 1 inch apart- these will not rise as high as the biscuits put close together. | 13) Bake for about 10-12 minutes- the biscuits will be a beautiful light golden brown on top and bottom. | 14) Do not overbake. | 15) Note: The key to real biscuits is not in the ingredients, but in the handling of the dough. | 16) The dough must be handled as little as possible or you will have tough biscuits. | 17) I have found that a food processor produces superior biscuits, because the ingredients stay colder and there's less chance of overmixing. | 18) You also must pat the dough out with your hands, lightly. | 19) Rolling with a rolling pin is a guaranteed way to overstimulate the gluten, resulting in a tougher biscuit. | 20) Note 2: You can make these biscuits, cut them, put them on cookie sheets and freeze them for up to a month. | 21) When you want fresh biscuits, simply place them frozen on the cookie sheet and bake at 450\u00b0F for about 20 minutes.", "tags": ["high in", "30 mins", "oven"], "cook_time_min": 12, "servings": null, "cuisine": ["All"], "rating_avg": 4.72, "rating_count": 817, "popularity_score": 4.71968561064087, "nutrition_calories": 162.6, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/26/11/0/DmfK6TnxRUqzDwn2P4tb_batch23-7025.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["high in", "30 mins", "oven"], "ingredients": []}, {"recipe_id": "rec_632", "props": {"title": "Sweet and Sour Chicken", "instructions": "[Instructions] 1) Mix together first 6 ingredients. | 2) Add chicken; coat well. | 3) Heat oil in electric skillet to 375 degrees. | 4) Fry chicken until lightly browned. | 5) Removed chicken; drain. | 6) Drain pineapple, reserving liquid. | 7) Add enough water to juice to make 1 cup. | 8) Add 2 T. cornstarch, mixing well. | 9) Combine pineapple juice mixture and next 4 ingredients in a medium saucepan. | 10) Bring mixture to a boil. | 11) Stir green pepper and chicken into sauce; cook until thoroughly heated. | 12) Serve over rice.", "tags": ["pineapple", "poultry", "tropical fruits", "fruit", "meat", "chinese", "asian", "kid friendly", "weeknight", "4 hours"], "cook_time_min": 1, "servings": null, "cuisine": ["All"], "rating_avg": 4.75, "rating_count": 79, "popularity_score": 4.743707865168539, "nutrition_calories": 1367.4, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/25/48/7/NnbkR9iSTGF5TrsNpleK_sweet-sour-chicken-1690.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["pineapple", "poultry", "tropical fruits", "fruit", "meat", "chinese", "asian", "kid friendly", "weeknight", "4 hours"], "ingredients": []}, {"recipe_id": "rec_633", "props": {"title": "Tabbouli / Tabouli / Tabbouleh Salad (Parsley Salad)", "instructions": "[Instructions] 1) Add one cup of boiled water and one cup of bourghul (bulgur) in a small bowl and mix. Place a tea towel over the bowl so the steam is unable to escape. Set aside until cool. | 2) Finely chop the parsley, spring onions and tomatoes and place them into your separate large salad bowl. | 3) Juice all the fresh lemons and pour it over the salad mixture. Add olive oil, black pepper and salt in the salad mixture. Mix well. | 4) Place over the cool bourghul and mix well. | 5) Serve. | 6) Refrigerate any left overs for about 2-3 days.", "tags": ["greens", "onions", "vegetable", "lebanese", "turkish", "southwest asia middle east", "asian", "low protein", "vegan", "low cholesterol", "30 mins", "no cook", "refrigerator"], "cook_time_min": 30, "servings": null, "cuisine": ["All"], "rating_avg": 4.6, "rating_count": 58, "popularity_score": 4.613823529411764, "nutrition_calories": 165.2, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/19/79/22/2JAPN3nWTGylAkuSNqlh_tabouli-2.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["greens", "onions", "vegetable", "lebanese", "turkish", "southwest asia middle east", "asian", "low protein", "vegan", "low cholesterol", "30 mins", "no cook", "refrigerator"], "ingredients": []}, {"recipe_id": "rec_634", "props": {"title": "Teriyaki Chicken Noodle Salad", "instructions": "[Instructions] 1) Marinade chicken in teriyaki sauce for approx 10 minutes. | 2) Prepare noodles according to packet directions. | 3) Drain noodles. Add oil, seeds and onions, toss to combine. | 4) Cook chicken pieces in a hot pan for approx 3-4 minutes or until cooked through. | 5) Add chicken to noodles and toss to combine.", "tags": ["chicken breast", "chicken", "poultry", "meat", "asian", "australian", "kid friendly", "30 mins", "easy"], "cook_time_min": 10, "servings": null, "cuisine": ["All"], "rating_avg": 3.82, "rating_count": 11, "popularity_score": 4.236190476190476, "nutrition_calories": 447.8, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/28/00/12/NCwp5EwOQZSpm2c2bhyF_teriyaki-chicken-noodle-salad_4503.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["chicken breast", "chicken", "poultry", "meat", "asian", "australian", "kid friendly", "30 mins", "easy"], "ingredients": []}, {"recipe_id": "rec_635", "props": {"title": "Teriyaki Pork Chops", "instructions": "[Instructions] 1) Combine all ingredients,except meat, in a bowl then pour over chops. | 2) Marinade for two hours. | 3) Broil or grill.", "tags": ["high in", "4 hours", "easy"], "cook_time_min": 2, "servings": null, "cuisine": ["All"], "rating_avg": 4.79, "rating_count": 16, "popularity_score": 4.753076923076923, "nutrition_calories": 398.0, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/33/41/40/UrUfscmCSQWYoxAV1kGP_THE%20FOOD%20GAYS%20--%20TERIKYAKI%20PORK%20CHOP.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["high in", "4 hours", "easy"], "ingredients": []}, {"recipe_id": "rec_636", "props": {"title": "The Best Easy Beef and Broccoli Stir-Fry", "instructions": "[Instructions] 1) In a bowl, combine 2 tablespoons cornstarch, 2 tablespoons water and garlic powder until smooth. | 2) Add beef and toss. | 3) In a large skillet or wok over medium-high heat, stir-fry beef in 1 tablespoon oil until beef reaches desired doneness; remove and keep warm. | 4) Stir-fry onion in remaining oil for 4-5 minutes until softened. Add the broccoli and cook for 3 minutes until the broccoli is tender but still crisp. Return beef to pan. | 5) Combine soy sauce, brown sugar, ginger and remaining 1 tablespoon cornstarch and 1/2 cup water until smooth; add to the pan. | 6) Cook and stir for 2 minutes. | 7) Serve over rice and garnish with toasted sesame seeds (optional).", "tags": ["steak", "vegetable", "meat", "chinese", "asian", "lactose free", "free of", "30 mins"], "cook_time_min": 10, "servings": null, "cuisine": ["All"], "rating_avg": 4.65, "rating_count": 855, "popularity_score": 4.650508670520232, "nutrition_calories": 150.1, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/99/47/6/01z114QRWGncDabUUJod_0S9A5937.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["steak", "vegetable", "meat", "chinese", "asian", "lactose free", "free of", "30 mins"], "ingredients": []}, {"recipe_id": "rec_637", "props": {"title": "The Perfect Burger", "instructions": "[Instructions] 1) Lightly oil grill& heat BBQ to medium. | 2) Whisk egg in a bowl& add next 6 ingredients. | 3) Add any of the \u201cstir-ins\u201d that appeal to you. | 4) Crumble in beef& using your hands or a fork, gently mix together. | 5) Handle the meat as little as possible \u2013 the more you work it, the tougher it gets. | 6) Gently shape (don\u2019t firmly press) mixture into burgers about \u00be inch thick. | 7) Using your thumb, make a shallow depression in the centre of each burger to prevent puffing up during cooking. | 8) Place burgers on the grill, close lid& BBQ until NO LONGER PINK INSIDE, turning once, about 6 \u2013 8 minutes per side. | 9) An instant read thermometer should read 160F. | 10) Don't abuse your burgers by pressing with a spatula, pricking with a fork or turning frequently as precious juices will be lost! | 11) Tuck into a warm crusty bun& add your favourite toppings.", "tags": ["kid friendly", "spring", "summer", "camping", "30 mins", "easy", "inexpensive"], "cook_time_min": 15, "servings": null, "cuisine": ["All"], "rating_avg": 4.52, "rating_count": 195, "popularity_score": 4.528487804878048, "nutrition_calories": 320.4, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/92/02/1/ArhyYe9RTCrWPsuTu5hw_0S9A9973.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["kid friendly", "spring", "summer", "camping", "30 mins", "easy", "inexpensive"], "ingredients": []}, {"recipe_id": "rec_638", "props": {"title": "The Ultimate Greek Salad", "instructions": "[Instructions] 1) Whisk dressing ingredients together until blended. | 2) Season to taste. | 3) Drain onion from ice water and pat dry with paper towels. | 4) Combine all salad ingredients, except cheese, in large bowl. | 5) Toss with dressing. | 6) Sprinkle cheese over and serve.", "tags": ["greek", "european", "low protein", "kid friendly", "15 mins"], "cook_time_min": 15, "servings": null, "cuisine": ["All"], "rating_avg": 4.88, "rating_count": 132, "popularity_score": 4.866901408450704, "nutrition_calories": 223.3, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/90/97/5/xfirb0rQRMPAHtkSwTyA_THE%20FOOD%20GAYS%20-%20GREEK%20SALAD-2.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["greek", "european", "low protein", "kid friendly", "15 mins"], "ingredients": []}, {"recipe_id": "rec_639", "props": {"title": "The Very Best Salisbury Steak", "instructions": "[Instructions] 1) In a large bowl, mix together 1/3 cup condensed French onion soup with ground beef, bread crumbs, egg, salt and black pepper. | 2) Shape into 6 oval patties. | 3) In a large skillet over medium-high heat, brown both sides of patties. | 4) Pour off excess fat. | 5) In a small bowl, blend flour and remaining soup until smooth. | 6) Mix in ketchup, water, Worcestershire sauce and mustard powder. | 7) Pour over meat in skillet. | 8) Cover, and cook for 20 minutes, stirring occasionally.", "tags": ["60 mins", "oven", "stove top"], "cook_time_min": 30, "servings": null, "cuisine": ["All"], "rating_avg": 4.59, "rating_count": 241, "popularity_score": 4.594143426294821, "nutrition_calories": 332.0, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/56/69/4/42Ci6hYOTp5pIswQ8Eoa_salisbury-steak-01143.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["60 mins", "oven", "stove top"], "ingredients": []}, {"recipe_id": "rec_640", "props": {"title": "Thin Pizza Crust", "instructions": "[Instructions] 1) Dissolve yeast and sugar in hot water. | 2) Let sit for 8 minutes. | 3) Meanwhile mix flour and salt. | 4) Pour yeast mixture over flour mixture and mix well with a heavy spoon. | 5) Turn onto floured surface and knead for 2 minutes. | 6) Spread into a 12-14\" circle. | 7) (I do this directly onto a pizza stone with a marble rolling pin). | 8) If you roll it out on a counter top, transfer to a greased pizza pan, stretching to edges. | 9) Cover with sauce and desired topping. | 10) Bake at 500 degrees for 8-12 minutes or until edges are golden.", "tags": ["vegetable", "meat", "low cholesterol", "healthy", "30 mins", "oven"], "cook_time_min": 8, "servings": null, "cuisine": ["All"], "rating_avg": 4.72, "rating_count": 50, "popularity_score": 4.7156666666666665, "nutrition_calories": 130.5, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/95/04/8/iO2aNFIgTIFwAUdaMTHk_0S9A5737.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["vegetable", "meat", "low cholesterol", "healthy", "30 mins", "oven"], "ingredients": []}, {"recipe_id": "rec_641", "props": {"title": "Traditional Irish Shepherd's Pie", "instructions": "[Instructions] 1) Pre-heat oven to 200C/400\u00b0F. | 2) Saute carrots in the olive oil until starting to get tender. | 3) Add in the onions and saute for a minute or two then add the meat. | 4) Season with black pepper and thyme. | 5) Cook until browned then drain fat. | 6) Add the butter and peas. | 7) Sprinkle with flour and stir through. | 8) Add tomato paste, wine and Worcestershire sauce. | 9) Let this reduce slightly then add the chicken stock. Allow to reduce down until you have a thick meaty gravy. Season to your taste. | 10) Remove from heat. Grease an oven proof dish** (9x13 works for me, as does an oval baker) with butter and add the sauce. | 11) Spoon or pipe the mashed potatoes over top. Brush with egg and sprinkle with Parmesan cheese if using. | 12) Bake for about 20 minutes or until the potato is nice and browned on top. | 13) Serve as is or with some crusty bread to mop up that yummy sauce!", "tags": ["meat", "european", "kid friendly", "st patrick s day", "60 mins", "oven", "inexpensive"], "cook_time_min": 20, "servings": null, "cuisine": ["All"], "rating_avg": 4.78, "rating_count": 289, "popularity_score": 4.777123745819398, "nutrition_calories": 387.2, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/30/21/20/LYpurGNlQvWQfP1Ueyjf_0S9A8345.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["meat", "european", "kid friendly", "st patrick s day", "60 mins", "oven", "inexpensive"], "ingredients": []}, {"recipe_id": "rec_642", "props": {"title": "Turkey Meatloaf", "instructions": "[Instructions] 1) Melt butter in a skillet. | 2) Cook onion and garlic in melted butter for 5 minutes, stirring occasionally. | 3) Place mixture in a large bowl to cool for 5 minutes. | 4) Combine turkey, bread crumbs, egg, 1/4 cup of the katchup, Worcestershire sauce, salt, and pepper with onion mixture. | 5) Press meatloaf into an 8x4-inch loaf pan. | 6) Spread remaining catsup on top. | 7) Bake in a 350 degree oven for 50-55 minutes. | 8) (Internal temperature should reach 165 degrees.) Remove from oven and let stand 5 minutes before serving.", "tags": ["meat", "weeknight", "oven", "4 hours"], "cook_time_min": 55, "servings": null, "cuisine": ["All"], "rating_avg": 4.73, "rating_count": 391, "popularity_score": 4.729102244389027, "nutrition_calories": 318.4, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/54/75/2/wc0parMsS9OTwRMHrOch_0S9A6332.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["meat", "weeknight", "oven", "4 hours"], "ingredients": []}, {"recipe_id": "rec_643", "props": {"title": "Yakisoba", "instructions": "[Instructions] 1) In a small bowl, mix together soy sauce, rice wine, and sugar, stirring to dissolve. | 2) Cook noodles in boiling water about 8 minutes, or until tender. | 3) Drain noodles and rinse under cold water. | 4) In a large deep skillet or wok, cook onion in oil for about 3 minutes. | 5) Add the cabbage, carrot and ginger and cook until cabbage is softened, about 3-5 minutes. | 6) Add the pork and cook for 2 minutes more. | 7) Cover the mixture with noodles and pour the sauce over all. | 8) Cover and cook for 3-5 minutes, the remove the lid and toss the mixture together until it is well combined. | 9) Place on a serving platter and garnish with chopped scallions, if desired.", "tags": ["spaghetti", "pork", "vegetable", "meat", "japanese", "asian", "savory", "60 mins", "stir fry"], "cook_time_min": 35, "servings": null, "cuisine": ["All"], "rating_avg": 4.57, "rating_count": 74, "popularity_score": 4.584761904761905, "nutrition_calories": 438.3, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/82/26/2/naTqLAhTTQCC5YwGVPQi_DSC05318-2.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["spaghetti", "pork", "vegetable", "meat", "japanese", "asian", "savory", "60 mins", "stir fry"], "ingredients": []}, {"recipe_id": "rec_644", "props": {"title": "5 Ingredient Spaghetti", "instructions": "[Instructions] 1) Grate lemon peels to yield 1 tablespoon of lemon zest. Juice the lemons to yield 1/2 cup of fresh lemon juice. Whisk together the oil, Parmesan cheese, lemon juice, salt and pepper in large bowl. | 2) Meanwhile, cook pasta according to the package instructions. Drain, reserving 1 cup of the cooking water. | 3) Add the spaghetti to the lemon sauce, and toss with the basil and lemon zest. Season the pasta with salt and pepper to taste.", "tags": ["citrus", "fruit", "kid friendly", "15 mins", "easy"], "cook_time_min": 10, "servings": null, "cuisine": ["All"], "rating_avg": 5.0, "rating_count": 1, "popularity_score": 4.721818181818181, "nutrition_calories": 200.0, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/submissions/recipe/0/76q1vVUkSmaRbuS7gvEq_85513H.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["citrus", "fruit", "kid friendly", "15 mins", "easy"], "ingredients": []}, {"recipe_id": "rec_645", "props": {"title": "Apple-Cheddar Panini", "instructions": "[Instructions] 1) Preheat panini press on medium heat(or use 2 heavy skillets-one to put on top of the panini while cooking to press it). | 2) Lightly spread honey mustard evenly over each slice of bread. | 3) Layer apple slices and cheese over 4 slices of bread, using about \u00bd apple and 2 ounces of cheese for each sandwich. Top each with remaining bread slices. Lightly coat panini press with cooking spray(or coat skillet. | 4) Grill each sandwich for 3 to 5 minutes or until cheese has melted and bread has toasted. | 5) Remove from pan and allow to cool slightly before serving. Enjoy!", "tags": ["cheese", "apple", "fruit", "european", "high in", "brunch", "30 mins", "easy"], "cook_time_min": 10, "servings": null, "cuisine": ["All"], "rating_avg": 4.64, "rating_count": 12, "popularity_score": 4.664545454545454, "nutrition_calories": 445.6, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/22/16/85/pic0lJuoN.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["cheese", "apple", "fruit", "european", "high in", "brunch", "30 mins", "easy"], "ingredients": []}, {"recipe_id": "rec_646", "props": {"title": "Baked Chicken Tenders", "instructions": "[Instructions] 1) Preheat Oven to 425\u00b0F. | 2) Mix chicken tenders and mayonnaise in a bowl to lightly coat chicken with mayonnaise. | 3) Mix bread crumbs and cheese in a gallon-size zippie bag. | 4) Prepare baking sheet with cooking spray. | 5) Put 1-2 chicken tenders in the zippie bag with the bread crumbs and shake to coat. | 6) Place chicken tenders in a single layer on prepared baking sheet. | 7) Continue until all tenders are coated and on the baking sheet. | 8) Bake in preheated oven for 8 minutes. Gently flip each one, so as not to remove the breading, and bake an additional 8 minutes. | 9) Serve with your favorite dipping sauce.", "tags": ["chicken", "poultry", "meat", "30 mins", "easy", "inexpensive"], "cook_time_min": 16, "servings": null, "cuisine": ["All"], "rating_avg": 4.67, "rating_count": 57, "popularity_score": 4.673582089552239, "nutrition_calories": 354.4, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/19/44/00/54Jim9iVTQkU7tkVebbK_chicken tenders SITE-2.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["chicken", "poultry", "meat", "30 mins", "easy", "inexpensive"], "ingredients": []}, {"recipe_id": "rec_647", "props": {"title": "Baked Pesto Chicken", "instructions": "[Instructions] 1) Preheat oven to 400 degrees F. | 2) Line baking sheet with heavy-duty foil. | 3) Place chicken and pesto in medium bowl; toss to coat. | 4) Place chicken on prepared baking sheet. | 5) Bake for 20-25 minutes or until chicken is no longer pink in center. | 6) Remove from oven; top with tomatoes and cheese. | 7) Bake for an additional 3-5 minutes or until cheese is melted.", "tags": ["poultry", "meat", "very low carbs", "high protein", "healthy", "high in", "60 mins", "oven", "easy"], "cook_time_min": 30, "servings": null, "cuisine": ["All"], "rating_avg": 4.75, "rating_count": 139, "popularity_score": 4.746241610738255, "nutrition_calories": 197.5, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/23/42/5/4KwovvcLSByVJFfBjhWU_0S9A6651.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["poultry", "meat", "very low carbs", "high protein", "healthy", "high in", "60 mins", "oven", "easy"], "ingredients": []}, {"recipe_id": "rec_648", "props": {"title": "Boston Fenway Franks", "instructions": "[Instructions] 1) Grill or Steam the frank. | 2) Grill the bun, cut side down. | 3) Push the cooked frank down into the grilled bun and cover with the condiments in the order given, to taste. | 4) Enjoy!", "tags": ["meat", "15 mins", "beginner cook", "easy"], "cook_time_min": 10, "servings": null, "cuisine": ["All"], "rating_avg": 4.88, "rating_count": 9, "popularity_score": 4.782105263157895, "nutrition_calories": 347.5, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/34/09/35/pic5BQwid.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["meat", "15 mins", "beginner cook", "easy"], "ingredients": []}, {"recipe_id": "rec_649", "props": {"title": "Bow Tie Pepperoni Pasta Salad", "instructions": "[Instructions] 1) Bring a pot of lightly salted water to a boil. | 2) Add Bow Tie Pasta and cook for 8 to 10 minutes or all dente; drain. | 3) While pasta is boiling, brown pepperoni in skillet until crisp on both sides and place on paper towels to absorb the grease. | 4) Toss pasta with pepperoni, italian dressing, parmesian cheese and italian seasoning.", "tags": ["meat", "toddler friendly", "kid friendly", "brunch", "15 mins", "beginner cook", "easy", "inexpensive"], "cook_time_min": 10, "servings": null, "cuisine": ["All"], "rating_avg": 4.73, "rating_count": 13, "popularity_score": 4.714347826086957, "nutrition_calories": 313.4, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/16/27/22/340Gm57qTuubVLuAWoB3_BOW_TIE_PEPPERONI_PASTA_SALAD_012.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["meat", "toddler friendly", "kid friendly", "brunch", "15 mins", "beginner cook", "easy", "inexpensive"], "ingredients": []}, {"recipe_id": "rec_650", "props": {"title": "Buffalo Chicken Wrap in a Snap", "instructions": "[Instructions] 1) Mix mayo and hot sauce. | 2) Fill tortilla with sauce, lettuce and chicken. | 3) Roll to eat.", "tags": ["chicken", "poultry", "meat", "spicy", "camping", "15 mins", "no cook", "beginner cook", "easy"], "cook_time_min": 5, "servings": null, "cuisine": ["All"], "rating_avg": 4.75, "rating_count": 5, "popularity_score": 4.712666666666666, "nutrition_calories": 281.0, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/30/81/63/pic9tmppB.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["chicken", "poultry", "meat", "spicy", "camping", "15 mins", "no cook", "beginner cook", "easy"], "ingredients": []}, {"recipe_id": "rec_651", "props": {"title": "California Rollwich for Kids", "instructions": "[Instructions] 1) Avocado Spread:. | 2) Scoop the flesh from the avocado and mash, mixing with a dash of lemon or lime juice. | 3) Mix in diced tomatoes and optional vegetables. | 4) Set aside. | 5) Rollwich:. | 6) Spread the tortilla or pita with mayonnaise, leaving at least 1/2 inch around the outside. | 7) Spread avocado spread over mayonnaise. | 8) Top spread with shredded lettuce. | 9) Carefully place turkey or ham slices on top of topping (leaving room on the edge for rolling). | 10) Add cheese strips down the middle. | 11) Carefully roll the tortilla into a wrap. | 12) Cut into two pieces.", "tags": ["toddler friendly", "kid friendly", "15 mins", "easy"], "cook_time_min": 10, "servings": null, "cuisine": ["All"], "rating_avg": 5.0, "rating_count": 1, "popularity_score": 4.721818181818181, "nutrition_calories": 784.9, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/32/04/15/pic725Xvr.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["toddler friendly", "kid friendly", "15 mins", "easy"], "ingredients": []}, {"recipe_id": "rec_652", "props": {"title": "Cheater's Chicken Noodle Soup", "instructions": "[Instructions] 1) Place water and one bouillon cube in a 3 quart saucepan. (I never measure, I just fill it up about halfway.) | 2) Bring to a boil. Add egg noodles and boil for 3 minutes. (Adjust your time if you aren't using fine egg noodles. Cook for the lowest time in package directions.) Do not drain noodles! | 3) Turn heat to OFF. Add remaining bouillon cubes and stir until dissolved. | 4) Add carrots and chicken. Stir to heat thoroughly. Add a sprinkling of dried parsley, if desired.", "tags": ["chicken", "poultry", "vegetable", "meat", "low cholesterol", "healthy", "kid friendly", "30 mins", "beginner cook", "stove top", "easy", "inexpensive"], "cook_time_min": 3, "servings": null, "cuisine": ["All"], "rating_avg": 4.67, "rating_count": 3, "popularity_score": 4.688461538461539, "nutrition_calories": 247.8, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/21/05/34/picaYVKoM.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["chicken", "poultry", "vegetable", "meat", "low cholesterol", "healthy", "kid friendly", "30 mins", "beginner cook", "stove top", "easy", "inexpensive"], "ingredients": []}, {"recipe_id": "rec_653", "props": {"title": "Cheesy Turkey Burger", "instructions": "[Instructions] 1) Mix all ingredients together in large bowl. Add more bread crumbs if necessary. Should form a firm ball. Add salt and pepper to taste. | 2) Shape into six patties, not too thin. | 3) Pan-fry, broil, or grill inside or out until lightly browned and cooked through, about 5 minutes per side.", "tags": ["meat", "15 mins", "easy"], "cook_time_min": 5, "servings": null, "cuisine": ["All"], "rating_avg": 4.78, "rating_count": 37, "popularity_score": 4.761702127659575, "nutrition_calories": 155.1, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/21/97/82/l5HLsa9cQWWh2iHseHrX_turkey%20burgers.jpg2.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["meat", "15 mins", "easy"], "ingredients": []}, {"recipe_id": "rec_654", "props": {"title": "Chicken Breast With Honey-Balsamic Glaze", "instructions": "[Instructions] 1) Combine first 3 ingredients; sprinkle over both sides of chicken. | 2) Heat oil in a large nonstick skillet over medium-high heat. Add chicken; cook 7 to 8 minutes on each side or until chicken is done. | 3) Transfer chicken to a platter; keep warm. Reduce heat to medium-low; add vinegar and honey to pan. Simmer 1 minute or until glaze thickens; stir constantly. Pour glaze over chicken.", "tags": ["chicken", "poultry", "meat", "high protein", "healthy", "high in", "savory", "15 mins", "beginner cook", "stove top", "easy"], "cook_time_min": 8, "servings": null, "cuisine": ["All"], "rating_avg": 4.56, "rating_count": 62, "popularity_score": 4.578611111111111, "nutrition_calories": 180.0, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/15/18/29/D2zqov5bSsaHHh5AKZRT_chicken-breast-honey-balsamic-glaze_0940.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["chicken", "poultry", "meat", "high protein", "healthy", "high in", "savory", "15 mins", "beginner cook", "stove top", "easy"], "ingredients": []}, {"recipe_id": "rec_655", "props": {"title": "Chorizo and Egg Burritos", "instructions": "[Instructions] 1) Fry a chopped onion and chorizo (broken up)together until onion is tender and translucent. | 2) add 6 to 8 beaten eggs after everything is nice and brown. | 3) Keep'em moving until cooked. | 4) Serve it on a sour cream coated pan-grilled tortilla, add a bit of grated Monterrey jack and avocado (if desired). | 5) Serve with more sour cream and hot sauce.", "tags": ["lunch snacks", "pork", "meat", "mexican", "30 mins", "easy"], "cook_time_min": 20, "servings": null, "cuisine": ["All"], "rating_avg": 4.86, "rating_count": 15, "popularity_score": 4.7936, "nutrition_calories": 816.9, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/52/03/9/oUfI6eDQGRUiM7Kn9AFH_DSC03351-2.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["lunch snacks", "pork", "meat", "mexican", "30 mins", "easy"], "ingredients": []}, {"recipe_id": "rec_656", "props": {"title": "Chunky Chicken Nachos", "instructions": "[Instructions] 1) Arrange chips on a large microwavable platter. | 2) Top with 1 cup of cheese, chicken, salsa, olives and remaining cheese. | 3) Microwave on High 3 to 4 Minutes or until cheese is melted, turning platter halfway through cooking time.", "tags": ["chicken", "poultry", "meat", "mexican", "kid friendly", "spicy", "brunch", "microwave", "15 mins", "easy", "inexpensive"], "cook_time_min": 4, "servings": null, "cuisine": ["All"], "rating_avg": 4.57, "rating_count": 7, "popularity_score": 4.642941176470588, "nutrition_calories": 173.0, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/13/82/96/zLGWEQWXQRW7WGjxJ9aS_chunky%20chx%20nachos.JPG"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["chicken", "poultry", "meat", "mexican", "kid friendly", "spicy", "brunch", "microwave", "15 mins", "easy", "inexpensive"], "ingredients": []}, {"recipe_id": "rec_657", "props": {"title": "Classic BLT Sandwich", "instructions": "[Instructions] 1) Cook bacon until crispy, then drain on paper towels. | 2) Toast the 8 slices of bread. | 3) Spread 1 tablespoon mayo on each slice of toasted bread. (More or less, to taste). | 4) Add 1 slice of lettuce to 4 pieces of mayo-spreaded toast. | 5) Add 2 slices of tomato on top of lettuce. | 6) Arrange 3 slices of bacon evenly on top of tomato. (Break bacon slices in half to fit, if needed.). | 7) Add 1 slice of lettuce on top of bacon. | 8) Put the remaining 4 pieces of mayo-spreaded toast on top to finish the sandwiches. | 9) Enjoy! | 10) NOTE: I also like to butter the toast slices before adding the mayo -- higher in fat, but tastier, in my opinion!", "tags": ["pork", "vegetable", "meat", "15 mins", "beginner cook", "easy", "inexpensive"], "cook_time_min": 5, "servings": null, "cuisine": ["All"], "rating_avg": 4.92, "rating_count": 68, "popularity_score": 4.891025641025641, "nutrition_calories": 516.8, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/12/96/15/RCNa1fLaTS2U0FY3yOUq_BLT%205%20-%20final_6.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["pork", "vegetable", "meat", "15 mins", "beginner cook", "easy", "inexpensive"], "ingredients": []}, {"recipe_id": "rec_658", "props": {"title": "Club Wrap", "instructions": "[Instructions] 1) Streak the tortilla with a bit of your fav sandwich dressing. | 2) Top with lettuce, then tomato. Lay down you meats and then top it off with the cheese. | 3) Wrap, slice in 1/2 and bag it up! | 4) Great Heated UP! or Made HOt!", "tags": ["15 mins", "easy"], "cook_time_min": 5, "servings": null, "cuisine": ["All"], "rating_avg": 4.88, "rating_count": 8, "popularity_score": 4.776666666666666, "nutrition_calories": 462.6, "image_urls": ["https://img.sndimg.com/food/image/upload/q_92,fl_progressive,w_1200,c_scale/v1/img/recipes/22/28/55/M5VOfkYQESd0eN7LdGcg_222-club-wrap.jpg"], "allergens": [], "popularity_views": 0, "popularity_saves": 0, "popularity_cooks": 0, "popularity_likes": 0, "cost_estimate": null, "equipment_needed": [], "video_url": null, "alternative_ingredients": []}, "tags": ["15 mins", "easy"], "ingredients": []}, {"recipe_id": "rec_659", "props": {"title": "Creamy Italian Pasta Salad", "instructions": "[Instructions] 1) Cook pasta as directed, rinse with cold water and drain well. | 2) In a large bowl, combine rest of ingredients and toss to coat. | 3) Add pasta and toss to coat. | 4) Chill at least 2 hours before serving. | 5) *** If pasta \"absorbs\" the dressing, you may need to add a little more dressing after chill time before serving.", "tags": [], "cook_time_min": 25, "servings": null, "cuisine": ["All"], "rating_avg": 4.88, "rating_count": 9, "popularity_score": 4.78210526