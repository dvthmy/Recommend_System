UNWIND $rows AS ing
MERGE (i:Ingredient {ingredient_id: ing.ingredient_id})
SET i.canonical_name = ing.canonical_name,
    i.category = ing.category,
    i.alt_names = coalesce(ing.alt_names, []),
    i.variations = coalesce(ing.variations_json, null)